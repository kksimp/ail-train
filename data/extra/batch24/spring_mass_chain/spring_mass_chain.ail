## Spring chain: three 1 kg masses joined by four springs (k = 10) between two walls 4 m apart; the first is
## pulled 0.5 m aside and let go. Semi-implicit Euler steps of 0.01 s keep the total energy nearly fixed.

fn forces(x List[float]) List[float]
    k := 10.0
    left := [0.0, x[0], x[1]]
    right := [x[1], x[2], 4.0]
    [k * (right[0] - x[0] - 1.0) - k * (x[0] - left[0] - 1.0), k * (right[1] - x[1] - 1.0) - k * (x[1] - left[1] - 1.0), k * (right[2] - x[2] - 1.0) - k * (x[2] - left[2] - 1.0)]

fn energy(x List[float], v List[float]) float
    k := 10.0
    mut e := 0.0
    for s in v
        e += 0.5 * s * s
    ends := [0.0, x[0], x[1], x[2], 4.0]
    for i in 0..4
        stretch := ends[i + 1] - ends[i] - 1.0
        e += 0.5 * k * stretch * stretch
    e

fn main()
    mut x := [1.5, 2.0, 3.0]
    mut v := [0.0, 0.0, 0.0]
    e0 := energy(x, v)
    dt := 0.01
    for step in 1..=600
        f := forces(x)
        for i in 0..3
            v[i] += f[i] * dt
            x[i] += v[i] * dt
        if step % 100 == 0
            print("t {step / 100} s: {x[0]:.3} {x[1]:.3} {x[2]:.3}")
    e1 := energy(x, v)
    print("energy {e0:.4} J at the start, {e1:.4} J after 6 s")

@test fn rest_has_no_force()
    f := forces([1.0, 2.0, 3.0])
    assert_eq(f, [0.0, 0.0, 0.0])
