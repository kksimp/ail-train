## Gem row: an original placing game; each gem (level 1 to 3) may be slid into any gap of a row, and any
## three equal gems side by side fuse into one gem a level higher for 3 x level points, which can chain.

fn settle(mut row List[int]) int
    mut score := 0
    while row.len() >= 3
        mut hit := -1
        for i in 0..(row.len() - 2)
            if row[i] == row[i + 1] and row[i + 1] == row[i + 2]
                hit = i
                break
        if hit < 0
            break
        level := row[hit]
        row.remove_at(hit)
        row.remove_at(hit)
        row[hit] = level + 1
        score += 3 * level
    score

fn main()
    gems := [1, 2, 1, 1, 3, 2, 2, 1, 3, 1, 2, 2, 3, 1, 1, 2, 3, 3, 1, 2]
    mut row := List[int]()
    mut total := 0
    for i, g in gems.enumerate()
        mut best_score := -1
        mut best_row := row
        mut best_pos := 0
        for pos in 0..=row.len()
            mut trial := row
            trial.insert(pos, g)
            got := settle(mut trial)
            if got > best_score
                best_score = got
                best_row = trial
                best_pos = pos
        row = best_row
        total += best_score
        if best_score > 0
            shown := row.join("")
            print("gem {i + 1:>2} (level {g}) into gap {best_pos}: {shown:<8} +{best_score}")
    final := row.join("")
    print("final row {final}, {row.len()} gems, score {total}")

@test fn chain()
    mut row := [2, 2, 1, 1, 1]
    assert_eq(settle(mut row), 9)
    assert_eq(row, [3])
