## Piston gas: six particles bounce between a fixed wall and a piston that moves in at 0.02 m/s; a hit on
## the moving piston sends a particle back faster (v' = 2u - v), so pressure and speed climb as it closes.

fn main()
    mut x := [0.5, 1.3, 2.1, 3.7, 4.4, 5.6]
    mut v := [1.0, -0.8, 1.3, -1.1, 0.6, -1.5]
    mut wall := 8.0
    u := -0.02
    dt := 0.01
    for window in 0..6
        mut hits := 0
        for step in 0..2000
            wall += u * dt
            for i in 0..6
                x[i] += v[i] * dt
                if x[i] < 0.0
                    x[i] = -x[i]
                    v[i] = -v[i]
                if x[i] > wall
                    x[i] = 2.0 * wall - x[i]
                    v[i] = 2.0 * u - v[i]
                    hits += 1
        mut speed := 0.0
        for s in v
            speed += s.abs()
        speed = speed / 6.0
        print("t {(window + 1) * 20:>3} s: piston at {wall:.2} m, {hits:>3} piston hits, mean speed {speed:.3}")

@test fn reflect_off_moving_wall()
    assert_eq(2.0 * -0.5 - 1.0, -2.0)
