## Loot with pity: a rare item drops on 4% of kills (seeded draws), but the 30th kill without one always
## drops it; groups the kills each rare took and compares the mean with the 25 kills a pure 4% would give.

struct Rng
    state int

fn Rng.below(mut self, n int) int
    self.state = (self.state * 1103515245 + 12345) % 2147483648
    (self.state / 65536) % n

fn bucket(kills int) str
    match kills
        1..=10 => "1-10"
        11..=20 => "11-20"
        21..=29 => "21-29"
        _ => "30 (pity)"

fn main()
    mut rng := Rng(state: 4096)
    mut groups := Map[str, int]()
    for name in ["1-10", "11-20", "21-29", "30 (pity)"]
        groups[name] = 0
    mut streak := 0
    mut rares := 0
    mut kills := 0
    while rares < 200
        kills += 1
        streak += 1
        if streak >= 30 or rng.below(100) < 4
            groups[bucket(streak)] += 1
            rares += 1
            streak = 0
    for name, n in groups
        bar := "#".repeat(n / 4)
        print("{name:<9} {n:>3} {bar}")
    mean := kills.to_float() / rares.to_float()
    print("{rares} rares in {kills} kills, {mean:.3} kills each")

@test fn pity_bucket()
    assert_eq(bucket(30), "30 (pity)")
    assert_eq(bucket(11), "11-20")
