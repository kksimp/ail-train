## Mirror quilt: a seeded 4 by 4 corner of arrow tiles is mirrored left to right (swapping < and >) and top
## to bottom (swapping ^ and v) into an 8 by 8 quilt with both symmetries; counts each tile in the result.

struct Rng
    state int

fn Rng.below(mut self, n int) int
    self.state = (self.state * 1103515245 + 12345) % 2147483648
    (self.state / 65536) % n

fn flip_across(c char) char
    match c
        '<' => '>'
        '>' => '<'
        _ => c

fn flip_down(c char) char
    match c
        '^' => 'v'
        'v' => '^'
        _ => c

fn main()
    tiles := ['<', '>', '^', 'v', 'o', '.']
    mut rng := Rng(state: 8080)
    mut quarter := List[List[char]]()
    for r in 0..4
        mut row := List[char]()
        for c in 0..4
            row.push(tiles[rng.below(tiles.len())])
        quarter.push(row)
    mut top := List[List[char]]()
    for row in quarter
        mut full := row
        for k in 0..4
            full.push(flip_across(row[3 - k]))
        top.push(full)
    mut quilt := top
    for k in 0..4
        quilt.push(top[3 - k].map(flip_down))
    mut counts := Map[char, int]()
    for row in quilt
        print(row.join(""))
        for ch in row
            counts[ch] += 1
    shown := tiles.map(|t| "{t} {counts.get_or(t, 0)}").join(", ")
    print(shown)

@test fn flips()
    assert_eq(flip_across('<'), '>')
    assert_eq(flip_down('o'), 'o')
