## Lemonade stand: cups sold fall linearly with price and depend on the weather (sunny 120 - price, cloudy
## 80 - price, rainy 40 - price / 2); finds the best price for each weather and prices a fortnight two ways.

fn cups(weather int, price int) int
    n := match weather
        0 => 120 - price
        1 => 80 - price
        _ => 40 - price / 2
    n.max(0)

fn profit(weather int, price int) int
    cups(weather, price) * (price - 20)

fn best_price(weather int) int
    mut pick := 20
    for p in 20..=120
        if profit(weather, p) > profit(weather, pick)
            pick = p
    pick

fn main()
    names := ["sunny", "cloudy", "rainy"]
    mut tuned := List[int]()
    for w in 0..3
        p := best_price(w)
        tuned.push(p)
        print("{names[w]:<6}: best price {p} cents, {cups(w, p)} cups, profit {profit(w, p)}")
    days := [0, 0, 1, 2, 2, 1, 0, 0, 0, 1, 2, 0, 1, 0]
    flexible := days.fold(0, |acc, w| acc + profit(w, tuned[w]))
    fixed := days.fold(0, |acc, w| acc + profit(w, tuned[0]))
    print("two weeks: weather prices earn {flexible}, the sunny price every day earns {fixed}")

@test fn rain_demand()
    assert_eq(cups(2, 40), 20)
