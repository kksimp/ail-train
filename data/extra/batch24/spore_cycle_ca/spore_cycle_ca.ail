## Spore cycle: an original three-phase automaton on an 8 by 8 bed; a dormant cell wakes when exactly two
## of its eight neighbours are active, an active cell is spent for two steps, then goes dormant again.

fn active_near(g List[List[int]], r int, c int) int
    mut n := 0
    for dr in -1..=1
        for dc in -1..=1
            rr := r + dr
            cc := c + dc
            if (dr != 0 or dc != 0) and rr >= 0 and rr < 8 and cc >= 0 and cc < 8
                if g[rr][cc] == 1
                    n += 1
    n

fn next_phase(cur int, near int) int
    match cur
        0 => if near == 2 then 1 else 0
        1 => 3
        3 => 2
        _ => 0

fn glyph(v int) char
    match v
        0 => '.'
        1 => 'O'
        3 => 'x'
        _ => '+'

fn main()
    mut g := List[List[int]]()
    for r in 0..8
        mut row := List[int]()
        for c in 0..8
            row.push(0)
        g.push(row)
    g[3][3] = 1
    g[3][4] = 1
    mut counts := List[int]()
    for s in 1..=7
        mut nxt := List[List[int]]()
        for r in 0..8
            mut row := List[int]()
            for c in 0..8
                row.push(next_phase(g[r][c], active_near(g, r, c)))
            nxt.push(row)
        g = nxt
        act := g.fold(0, |acc, cells| acc + cells.count(|v| v == 1))
        counts.push(act)
    print("active cells per step: {counts}")
    for cells in g
        print(cells.map(glyph).join(""))

@test fn wakes_on_two()
    assert_eq(next_phase(0, 2), 1)
    assert_eq(next_phase(3, 2), 2)
