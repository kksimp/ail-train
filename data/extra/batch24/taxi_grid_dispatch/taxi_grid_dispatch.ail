## Taxi dispatch: three taxis on a street grid; each ride request goes to the free taxi nearest the pickup
## (Manhattan distance, lower number on a tie), or waits for the first taxi to come free. Times in minutes.

struct Taxi
    x int
    y int
    free_at int
    empty_km int

fn dist(x1 int, y1 int, x2 int, y2 int) int
    (x1 - x2).abs() + (y1 - y2).abs()

fn main()
    mut taxis := [Taxi(x: 0, y: 0, free_at: 0, empty_km: 0), Taxi(x: 5, y: 5, free_at: 0, empty_km: 0), Taxi(x: 9, y: 1, free_at: 0, empty_km: 0)]
    rides := [[0, 1, 1, 6, 4], [2, 8, 2, 3, 7], [3, 4, 4, 9, 9], [4, 0, 8, 2, 0], [6, 6, 6, 1, 1], [7, 9, 9, 0, 9]]
    mut total_wait := 0
    for q in rides
        t := q[0]
        mut pick := -1
        for i in 0..3
            if taxis[i].free_at <= t
                if pick < 0 or dist(taxis[i].x, taxis[i].y, q[1], q[2]) < dist(taxis[pick].x, taxis[pick].y, q[1], q[2])
                    pick = i
        if pick < 0
            pick = 0
            for i in 1..3
                if taxis[i].free_at < taxis[pick].free_at
                    pick = i
        start := taxis[pick].free_at.max(t)
        reach := dist(taxis[pick].x, taxis[pick].y, q[1], q[2])
        wait := start - t + reach
        total_wait += wait
        taxis[pick].empty_km += reach
        taxis[pick].free_at = start + reach + dist(q[1], q[2], q[3], q[4])
        taxis[pick].x = q[3]
        taxis[pick].y = q[4]
        print("minute {t}: taxi {pick + 1} picks up at ({q[1]},{q[2]}) after {wait} min, free again at {taxis[pick].free_at}")
    empty := taxis.map(|tx| tx.empty_km)
    print("total wait {total_wait} min, empty km per taxi {empty}")

@test fn manhattan()
    assert_eq(dist(1, 1, 4, 5), 7)
