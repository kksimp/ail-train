## Two-port ferry: a ferry for six cars shuttles between ports A and B, 20 minutes a crossing plus 5 to
## load; at each departure it takes up to six cars that have arrived, oldest first, and the rest wait.

fn main()
    mut waiting := [List[int](), List[int]()]
    arrivals := [[2, 4, 5, 9, 11, 12, 14, 15, 16, 30, 33, 41, 44, 50, 58, 61, 63], [1, 3, 8, 20, 22, 24, 26, 27, 28, 29, 31, 35, 47, 66, 70]]
    mut next_car := [0, 0]
    mut port := 0
    mut sail_at := 0
    mut carried := 0
    mut waited := 0
    for trip in 1..=8
        depart := sail_at + 5
        for p in 0..2
            while next_car[p] < arrivals[p].len() and arrivals[p][next_car[p]] <= depart
                waiting[p].push(arrivals[p][next_car[p]])
                next_car[p] += 1
        load := waiting[port].len().min(6)
        for k in 0..load
            waited += depart - waiting[port][k]
        waiting[port] = waiting[port].slice(load)
        carried += load
        name := if port == 0 then "A" else "B"
        print("trip {trip}: leaves {name} at {depart:>3} with {load} cars, {waiting[port].len()} left behind")
        sail_at = depart + 20
        port = 1 - port
    print("{carried} cars carried, mean wait {waited.to_float() / carried.to_float():.2} minutes")

@test fn slice_rest()
    assert_eq([1, 2, 3].slice(2), [3])
