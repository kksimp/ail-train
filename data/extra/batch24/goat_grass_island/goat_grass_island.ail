## Goats on an island: ten grass patches in a ring regrow one unit a day up to five; each goat moves to the
## richest of its patch and the two beside it, eats up to two units, burns one, starves at zero, splits at eight.

struct Goat
    pos int
    energy int

fn Goat.graze(mut self, mut grass List[int])
    n := grass.len()
    mut best := self.pos
    for p in [(self.pos + n - 1) % n, (self.pos + 1) % n]
        if grass[p] > grass[best]
            best = p
    self.pos = best
    bite := grass[best].min(2)
    grass[best] -= bite
    self.energy += bite - 1

fn main()
    mut grass := [5, 1, 0, 3, 5, 2, 0, 4, 1, 3]
    mut goats := [Goat(pos: 0, energy: 4), Goat(pos: 5, energy: 4), Goat(pos: 7, energy: 3)]
    for day in 1..=12
        mut next_herd := List[Goat]()
        for mut g in goats
            g.graze(mut grass)
            if g.energy >= 8
                next_herd.push(Goat(pos: g.pos, energy: g.energy / 2))
                next_herd.push(Goat(pos: g.pos, energy: g.energy - g.energy / 2))
            elif g.energy > 0
                next_herd.push(g)
        goats = next_herd
        for i in 0..grass.len()
            grass[i] = (grass[i] + 1).min(5)
        print("day {day:>2}: {goats.len()} goats, grass {grass.sum()} {grass}")

@test fn eats_richest()
    mut grass := [1, 0, 4]
    mut g := Goat(pos: 0, energy: 2)
    g.graze(mut grass)
    assert_eq(g.pos, 2)
    assert_eq(g.energy, 3)
