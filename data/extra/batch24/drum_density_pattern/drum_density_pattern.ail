## Drum pattern: two bars of sixteen steps; each step has a weight (4 on the beat, 2 on the off-beat eighth,
## 1 otherwise) and a seeded draw sets kick, snare and hat hits with chances that grow with the weight.

struct Rng
    state int

fn Rng.below(mut self, n int) int
    self.state = (self.state * 1103515245 + 12345) % 2147483648
    (self.state / 65536) % n

fn weight(step int) int
    if step % 4 == 0 then 4 elif step % 2 == 0 then 2 else 1

fn chance(voice int, step int) int
    w := weight(step)
    if voice == 0
        top := if step == 0 then 100 else 20 * w
        return top
    if voice == 1
        top := if step % 8 == 4 then 100 else 5 * w
        return top
    40 + 15 * w

fn main()
    voices := ["kick ", "snare", "hat  "]
    mut rng := Rng(state: 2718)
    mut hits := [0, 0, 0]
    for bar in 1..=2
        for v in 0..3
            mut line := List[char]()
            for step in 0..16
                if rng.below(100) < chance(v, step)
                    line.push('x')
                    hits[v] += 1
                else
                    line.push('.')
            shown := line.join("")
            print("bar {bar} {voices[v]} {shown}")
    print("hits: kick {hits[0]}, snare {hits[1]}, hat {hits[2]}")

@test fn weights()
    assert_eq(weight(8), 4)
    assert_eq(weight(6), 2)
    assert_eq(chance(1, 12), 100)
