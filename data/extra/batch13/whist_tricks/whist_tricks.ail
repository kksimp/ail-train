## Whist tricks: each trick is won by the highest trump played, or if there is none by the highest
## card of the suit led; the winner leads the next trick and partners (seats 0 and 2) pool tricks.

fn rank_value(card str) int
    "23456789TJQKA".find(card.slice(0, 1)) else 0

fn winner(trick List[str], trumps str) int
    led := trick[0].slice(1, 2)
    mut best := 0
    mut best_power := -1
    for i, card in trick.enumerate()
        suit := card.slice(1, 2)
        power := if suit == trumps then 100 + rank_value(card) elif suit == led then rank_value(card) else -1
        if power > best_power
            best = i
            best_power = power
    best

fn main()
    seats := ["North", "East", "South", "West"]
    trumps := "S"
    tricks := [["KH", "2H", "AH", "5H"], ["4D", "KD", "3S", "AD"], ["QC", "2C", "TC", "9C"], ["7H", "6H", "4S", "8H"], ["JD", "QD", "5D", "2S"], ["AS", "6S", "9S", "KS"]]
    mut leader := 0
    mut won := [0, 0]
    for n, trick in tricks.enumerate()
        w := (leader + winner(trick, trumps)) % 4
        cards := trick.join(" ")
        print("trick {n + 1}: {seats[leader]} leads {cards}, {seats[w]} wins")
        won[w % 2] += 1
        leader = w
    print("North-South {won[0]}, East-West {won[1]}")

@test fn trump_beats_ace()
    assert_eq(winner(["AD", "KD", "2S", "QD"], "S"), 2)
