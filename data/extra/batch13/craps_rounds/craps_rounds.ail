## Craps rounds: on the come-out roll 7 or 11 wins and 2, 3 or 12 loses; any other total becomes the
## point, and the shooter rolls until the point (win) or a 7 (loss). Ten-unit bets on the pass line.

struct Dice
    seed int

fn Dice.roll(mut self) int
    self.seed = (self.seed * 1103515245 + 12345) % 2147483648
    a := (self.seed / 65536) % 6 + 1
    self.seed = (self.seed * 1103515245 + 12345) % 2147483648
    b := (self.seed / 65536) % 6 + 1
    a + b

fn main()
    mut dice := Dice(seed: 4242)
    mut bank := 100
    mut wins := 0
    for round in 1..=9
        first := dice.roll()
        mut won := false
        mut note := ""
        if first == 7 or first == 11
            won = true
            note = "natural {first}"
        elif first == 2 or first == 3 or first == 12
            note = "craps {first}"
        else
            mut rolls := 1
            mut r := dice.roll()
            while r != first and r != 7
                rolls += 1
                r = dice.roll()
            won = r == first
            note = "point {first}, settled after {rolls + 1} rolls"
        if won
            bank += 10
            wins += 1
        else
            bank -= 10
        result := if won then "win" else "lose"
        print("round {round}: {note}: {result}, bank {bank}")
    print("won {wins} of 9 rounds")

@test fn dice_in_range()
    mut d := Dice(seed: 1)
    r := d.roll()
    assert(r >= 2 and r <= 12)
