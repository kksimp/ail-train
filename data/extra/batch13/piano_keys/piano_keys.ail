## Piano keys: key 1 of an 88-key piano is A0 (MIDI 21), so key k is MIDI k + 20; the pitch class
## gives the note name and whether it is a black key, and the octave number changes at each C.

fn key_name(k int) str
    names := ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"]
    m := k + 20
    "{names[m % 12]}{m / 12 - 1}"

fn is_black(k int) bool
    [1, 3, 6, 8, 10].contains((k + 20) % 12)

fn main()
    for k in [1, 2, 40, 42, 49, 54, 88]
        colour := if is_black(k) then "black" else "white"
        print("key {k:>2}: {key_name(k):<4} {colour}")
    mut white := 0
    mut black := 0
    for k in 1..=88
        if is_black(k)
            black += 1
        else
            white += 1
    print("{white} white keys and {black} black keys")
    mut octave_four := List[str]()
    for k in 1..=88
        if key_name(k).ends_with("4") and not is_black(k)
            octave_four.push(key_name(k))
    keys_four := octave_four.join(" ")
    print("white keys in octave 4: {keys_four}")

@test fn middle_c_is_key_40()
    assert_eq(key_name(40), "C4")
