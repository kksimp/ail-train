## Jet lag days: the body clock shifts about one hour a day after flying east and an hour and a half
## after flying west; moving bedtime an hour a day for up to three days before leaving shortens recovery.

enum Direction
    East
    West

fn recovery(dir Direction, hours int) int
    match dir
        East => hours
        West => (hours * 2 + 2) / 3

fn clock(minutes int) str
    m := ((minutes % 1440) + 1440) % 1440
    "{m / 60:02}:{m % 60:02}"

fn main()
    trips := [("London to Tokyo", Direction.East, 9), ("New York to Paris", Direction.East, 6), ("Sydney to Perth", Direction.West, 2), ("Berlin to Chicago", Direction.West, 7), ("Delhi to Dubai", Direction.West, 1)]
    for t in trips
        name, dir, hours := t
        pre := hours.min(3)
        before := recovery(dir, hours)
        after := recovery(dir, hours - pre)
        print("{name:<18} {dir} {hours} h: {before} days to adjust, {after} after {pre} days of shifting")
    bedtime := 23 * 60
    mut plan := List[str]()
    for d in 1..=3
        plan.push("day -{4 - d} {clock(bedtime - d * 60)}")
    shown := plan.join(", ")
    print("bedtimes before flying to Tokyo: {shown}")

@test fn west_is_slower()
    assert_eq(recovery(Direction.West, 6), 4)
