## Baccarat coup: hands count modulo 10 (tens and faces 0); an 8 or 9 is a natural, the player draws
## on 0 to 5, and the banker's third card depends on its total and the player's third card.

fn banker_draws(total int, third int) bool
    match total
        0 | 1 | 2 => true
        3 => third != 8
        4 => third >= 2 and third <= 7
        5 => third >= 4 and third <= 7
        6 => third == 6 or third == 7
        _ => false

fn play(c List[int]) str
    mut p := (c[0] + c[1]) % 10
    mut b := (c[2] + c[3]) % 10
    if p >= 8 or b >= 8
        return "natural, player {p} banker {b}"
    mut next := 4
    mut drew := "player stands"
    if p <= 5
        third := c[next]
        next += 1
        p = (p + third) % 10
        drew = "player draws {third}"
        if banker_draws(b, third)
            b = (b + c[next]) % 10
            drew = "{drew}, banker draws {c[next]}"
    elif b <= 5
        b = (b + c[next]) % 10
        drew = "{drew}, banker draws {c[next]}"
    result := if p > b then "player wins" elif b > p then "banker wins" else "tie"
    "{drew}: player {p} banker {b}, {result}"

fn main()
    coups := [[3, 4, 5, 3, 2, 1], [9, 0, 2, 5, 7, 7], [2, 1, 3, 0, 8, 6], [6, 0, 4, 1, 5, 3], [0, 4, 6, 0, 6, 2], [7, 0, 3, 2, 9, 4], [1, 2, 4, 2, 3, 5]]
    for i, c in coups.enumerate()
        print("coup {i + 1}: {play(c)}")

@test fn banker_three_against_eight()
    assert(not banker_draws(3, 8))
