## Visa days: a visitor may spend at most 90 days in any rolling 180-day window; each trip is checked
## by counting the days present in the 180 days ending on its last day, and the longest next trip is found.

fn days_in_window(trips List[List[int]], last int) int
    first := last - 179
    mut n := 0
    for t in trips
        a := t[0].max(first)
        b := t[1].min(last)
        if b >= a
            n += b - a + 1
    n

fn main()
    trips := [[10, 40], [70, 95], [130, 150], [160, 178], [250, 262]]
    mut taken := List[List[int]]()
    for t in trips
        taken.push(t)
        used := days_in_window(taken, t[1])
        status := if used > 90 then "OVERSTAY by {used - 90}" else "ok, {90 - used} left"
        print("trip day {t[0]:>3} to {t[1]:>3}: {used:>2} days in window, {status}")
    start := 290
    mut length := 0
    while true
        mut plan := taken
        plan.push([start, start + length])
        if days_in_window(plan, start + length) > 90
            break
        length += 1
    print("a trip from day {start} can last {length} days")

@test fn window_clips()
    assert_eq(days_in_window([[1, 10]], 185), 5)
