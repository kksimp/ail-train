## Australian football scores: a goal is worth six and a behind one, written goals.behinds (total),
## e.g. 12.8 (80); quarter scores are added up and the margin is shown at each break.

struct Score
    goals int
    behinds int

fn Score.total(self) int
    goals * 6 + behinds

fn Score.show(self) str
    "{goals}.{behinds} ({total()})"

fn Score.add(mut self, g int, b int)
    goals += g
    behinds += b

fn main()
    home := "Swans"
    away := "Eagles"
    quarters := [[3, 4, 2, 2], [4, 1, 5, 3], [2, 5, 3, 1], [3, 2, 4, 5]]
    mut h := Score(goals: 0, behinds: 0)
    mut a := Score(goals: 0, behinds: 0)
    labels := ["quarter time", "half time", "three quarter time", "full time"]
    for i, q in quarters.enumerate()
        h.add(q[0], q[1])
        a.add(q[2], q[3])
        margin := h.total() - a.total()
        leader := if margin > 0 then home else away
        state := if margin == 0 then "level" else "{leader} by {margin.abs()}"
        print("{labels[i]:<18} {home} {h.show():<10} {away} {a.show():<10} {state}")
    acc_h := h.goals * 100 / (h.goals + h.behinds)
    acc_a := a.goals * 100 / (a.goals + a.behinds)
    print("goal kicking accuracy: {home} {acc_h}%, {away} {acc_a}%")

@test fn shows_total()
    assert_eq(Score(goals: 12, behinds: 8).show(), "12.8 (80)")
