## Snooker breaks: while reds remain each red (1) must be followed by a colour (2 to 7) that is
## re-spotted; then the colours go down in order. Breaks are checked and the points left are tracked.

fn value(ball char) int
    match ball
        'R' => 1
        'Y' => 2
        'G' => 3
        'N' => 4
        'B' => 5
        'P' => 6
        'K' => 7
        _ => 0

fn run_break(balls str, mut reds List[int], mut next_colour List[int]) int ! str
    mut total := 0
    mut want_colour := false
    for ball in balls.chars()
        v := value(ball)
        if v == 0
            return "unknown ball {ball}"
        if reds[0] > 0 or want_colour
            if v == 1 and want_colour
                return "red after red"
            if v > 1 and not want_colour
                return "colour without a red"
            if v == 1
                reds[0] -= 1
            want_colour = v == 1
        else
            if v != next_colour[0]
                return "colour out of order"
            next_colour[0] += 1
        total += v
    total

fn left_on_table(reds int, next_colour int) int
    mut colours := 0
    for v in next_colour..8
        colours += v
    reds * 8 + colours

fn main()
    mut reds := [15]
    mut next_colour := [2]
    breaks := ["RKRKRPRKRB", "RKRKRY", "RG", "RKRKRBRKRKRP", "KR", "YGN", "BPK"]
    for i, b in breaks.enumerate()
        if pts := run_break(b, mut reds, mut next_colour)
            print("break {i + 1}: {pts:>3} points, {reds[0]:>2} reds left, {left_on_table(reds[0], next_colour[0]):>3} left to score")
        else err
            print("break {i + 1}: foul, {err}")

@test fn full_clearance_left()
    assert_eq(left_on_table(15, 2), 147)
