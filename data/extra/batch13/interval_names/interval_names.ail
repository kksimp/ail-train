## Interval names: two notes with octaves ("C4", "Eb5") are turned into MIDI numbers; the semitone
## distance names the interval (compound ones beyond an octave) and its inversion within the octave.

fn midi(note str) int
    letter := note.slice(0, 1)
    octave := note.slice(note.len() - 1).to_int() else 4
    accidental := note.slice(1, note.len() - 1)
    base := ["C", "", "D", "", "E", "F", "", "G", "", "A", "", "B"].index_of(letter) else 0
    shift := if accidental == "#" then 1 elif accidental == "b" then -1 else 0
    (octave + 1) * 12 + base + shift

fn simple_name(n int) str
    names := ["unison", "minor second", "major second", "minor third", "major third", "perfect fourth", "tritone", "perfect fifth", "minor sixth", "major sixth", "minor seventh", "major seventh"]
    names[n % 12]

fn describe(n int) str
    if n == 12
        return "octave"
    if n > 12
        return "compound {simple_name(n)} ({n} semitones)"
    simple_name(n)

fn main()
    pairs := [("C4", "G4"), ("E4", "C5"), ("A3", "C4"), ("F4", "B4"), ("D4", "D5"), ("C4", "E5"), ("Bb3", "Ab4"), ("G4", "F#5")]
    for p in pairs
        a, b := p
        n := midi(b) - midi(a)
        inv := (12 - n % 12) % 12
        print("{a:<3} -> {b:<4} {describe(n)}, inverts to {simple_name(inv)}")

@test fn middle_c()
    assert_eq(midi("C4"), 60)
