## Rugby bonus points: a win is worth 4 and a draw 2, plus one bonus point for scoring four or more
## tries and one for losing by seven points or fewer; the table sorts by points, then points difference.

struct Row
    played int
    points int
    diff int
    bonus int

fn award(mut table Map[str, Row], team str, score int, other int, tries int)
    mut r := table.get(team) else Row(played: 0, points: 0, diff: 0, bonus: 0)
    r.played += 1
    r.diff += score - other
    if score > other
        r.points += 4
    elif score == other
        r.points += 2
    mut extra := 0
    if tries >= 4
        extra += 1
    if score < other and other - score <= 7
        extra += 1
    r.points += extra
    r.bonus += extra
    table[team] = r

fn main()
    results := [("Lions", 31, 5, "Bears", 24, 3), ("Hawks", 18, 1, "Wolves", 18, 2), ("Bears", 40, 6, "Hawks", 10, 1), ("Wolves", 22, 2, "Lions", 27, 4), ("Lions", 12, 1, "Hawks", 15, 0), ("Bears", 33, 4, "Wolves", 29, 4)]
    mut table := Map[str, Row]()
    for res in results
        home, hs, ht, away, aws, at := res
        award(mut table, home, hs, aws, ht)
        award(mut table, away, aws, hs, at)
    names := table.keys().sorted(by: |n| (-table[n].points, -table[n].diff))
    print("team     P  BP  diff  pts")
    for n in names
        r := table[n]
        print("{n:<7} {r.played:>2} {r.bonus:>3} {r.diff:>5} {r.points:>4}")

@test fn losing_bonus()
    mut t := Map[str, Row]()
    award(mut t, "x", 20, 25, 4)
    assert_eq(t["x"].points, 2)
