## Fencing pool: every fencer meets every other in a bout to five touches; the ranking goes by the
## share of bouts won, then the indicator (touches scored minus received), then touches scored.

struct Fencer
    name str
    wins int
    bouts int
    scored int
    received int

fn Fencer.ratio(self) float
    wins.to_float() / bouts.to_float()

fn main()
    mut pool := ["Arno", "Bea", "Cato", "Dina", "Eli"].map(|n| Fencer(name: n, wins: 0, bouts: 0, scored: 0, received: 0))
    bouts := [[0, 1, 5, 3], [0, 2, 4, 5], [0, 3, 5, 2], [0, 4, 5, 4], [1, 2, 5, 1], [1, 3, 2, 5], [1, 4, 5, 3], [2, 3, 5, 4], [2, 4, 3, 5], [3, 4, 5, 0]]
    for b in bouts
        pool[b[0]].bouts += 1
        pool[b[1]].bouts += 1
        pool[b[0]].scored += b[2]
        pool[b[0]].received += b[3]
        pool[b[1]].scored += b[3]
        pool[b[1]].received += b[2]
        if b[2] > b[3]
            pool[b[0]].wins += 1
        else
            pool[b[1]].wins += 1
    ranked := pool.sorted(by: |f| (-f.wins * 1000 / f.bouts, -(f.scored - f.received), -f.scored))
    print("place fencer  V/M   ind  TS  TR")
    for i, f in ranked.enumerate()
        ind := f.scored - f.received
        print("{i + 1:>5} {f.name:<6} {f.ratio():.2} {ind:>5} {f.scored:>3} {f.received:>3}")

@test fn ratio_of_wins()
    assert_eq(Fencer(name: "x", wins: 3, bouts: 4, scored: 0, received: 0).ratio(), 0.75)
