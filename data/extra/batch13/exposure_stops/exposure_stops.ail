## Exposure stops: shutter speeds, apertures and ISO settings move in third-stop steps on their
## scales; opening the aperture by some thirds is balanced by a shorter shutter or a lower ISO by as many.

fn main()
    shutters := ["1/30", "1/40", "1/50", "1/60", "1/80", "1/100", "1/125", "1/160", "1/200", "1/250", "1/320", "1/400", "1/500", "1/640", "1/800", "1/1000"]
    apertures := ["2.8", "3.2", "3.5", "4", "4.5", "5", "5.6", "6.3", "7.1", "8", "9", "10", "11"]
    isos := [100, 125, 160, 200, 250, 320, 400, 500, 640, 800]
    base_s := shutters.index_of("1/125") else 0
    base_a := apertures.index_of("8") else 0
    base_i := 0
    print("metered: {shutters[base_s]} s at f/{apertures[base_a]}, ISO {isos[base_i]}")
    for wanted in ["5.6", "4", "2.8", "11"]
        a := apertures.index_of(wanted) else base_a
        thirds := base_a - a
        s := base_s + thirds
        if s >= 0 and s < shutters.len()
            print("f/{wanted:<4} {thirds:>3} thirds brighter -> {shutters[s]} s at ISO {isos[base_i]}")
        else
            iso_shift := if s < 0 then -s else 0
            print("f/{wanted:<4} off the shutter scale, needs {iso_shift} thirds more ISO")
    for wanted_iso in [400, 800]
        steps := isos.index_of(wanted_iso) else 0
        s := base_s + steps
        print("ISO {wanted_iso}: {steps} thirds more light -> {shutters[s]} s at f/8")

@test fn two_stops()
    assert_eq(9 - 3, 6)
