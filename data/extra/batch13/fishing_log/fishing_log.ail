## Fishing log: each catch is checked against the water's rules, a minimum length and a daily bag
## limit per species; undersized fish, fish over the limit and species with no rule are released.

fn verdict(rules Map[str, List[int]], kept Map[str, int], species str, cm int) int ! str
    rule := rules.get(species) else return "no rule for {species}"
    if cm < rule[0]
        return "under {rule[0]} cm"
    if kept.get_or(species, 0) >= rule[1]
        return "bag limit of {rule[1]} reached"
    rule[1]

fn main()
    rules := {"trout": [30, 2], "perch": [20, 5], "pike": [60, 1]}
    catches := [("trout", 34), ("perch", 18), ("pike", 72), ("trout", 28), ("perch", 23), ("trout", 41), ("trout", 36), ("carp", 55), ("pike", 65), ("perch", 21)]
    mut kept := Map[str, int]()
    mut released := 0
    for c in catches
        species, cm := c
        if limit := verdict(rules, kept, species, cm)
            kept[species] += 1
            print("{species:<6} {cm:>3} cm: keep, {kept[species]} of {limit}")
        else why
            released += 1
            print("{species:<6} {cm:>3} cm: release, {why}")
    mut bag := List[str]()
    for s, n in kept
        bag.push("{n} {s}")
    summary := bag.join(", ")
    print("kept {summary}; released {released}")

@test fn undersized()
    rules := {"perch": [20, 5]}
    kept := Map[str, int]()
    assert_err(verdict(rules, kept, "perch", 15))
