## Potluck sign-up: guests list what they will bring by category; targets per category grow with the
## head count (one main per 8 guests, side per 6, dessert per 10, drink per 12), and gaps are reported.

fn target(category str, guests int) int
    per := match category
        "main" => 8
        "side" => 6
        "dessert" => 10
        _ => 12
    (guests + per - 1) / per

fn main()
    guests := 30
    signups := [("Ola", "main", "lasagne"), ("Pip", "dessert", "brownies"), ("Quin", "side", "coleslaw"), ("Ros", "main", "curry"), ("Sid", "drink", "lemonade"), ("Tia", "side", "potato salad"), ("Uri", "dessert", "brownies"), ("Val", "side", "garlic bread"), ("Wim", "main", "chilli")]
    mut have := Map[str, int]()
    mut dishes := Set[str]()
    for s in signups
        who, cat, dish := s
        if not dishes.add(dish)
            print("{who} also signed up for {dish}; asked to pick something else")
            continue
        have[cat] += 1
    mut gaps := List[str]()
    for cat in ["main", "side", "dessert", "drink"]
        want := target(cat, guests)
        got := have.get_or(cat, 0)
        print("{cat:<8} {got} of {want}")
        if got < want
            gaps.push("{want - got} {cat}")
    pending := if gaps.is_empty() then "nothing" else gaps.join(", ")
    print("yet to come for {guests} guests: {pending}")

@test fn mains_for_thirty()
    assert_eq(target("main", 30), 4)
