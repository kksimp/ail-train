## Bracket pool: entrants pick the winners of an eight-team knockout; a correct pick is worth 1 point
## in the quarter-finals, 2 in the semis and 4 in the final (12 for a perfect bracket), and the pool table is ranked.

struct Entry
    name str
    points int

fn score(picks List[List[str]], actual List[List[str]]) int
    mut total := 0
    mut worth := 1
    for r in 0..actual.len()
        for team in picks[r]
            if actual[r].contains(team)
                total += worth
        worth *= 2
    total

fn main()
    actual := [["Ajax", "Celta", "Fiorentina", "Genk"], ["Celta", "Genk"], ["Genk"]]
    entrants := ["Mo", "Ines", "Tariq", "Vera"]
    picks := [[["Ajax", "Celta", "Elche", "Genk"], ["Ajax", "Genk"], ["Genk"]], [["Ajax", "Dynamo", "Fiorentina", "Hertha"], ["Ajax", "Fiorentina"], ["Ajax"]], [["Benfica", "Celta", "Fiorentina", "Genk"], ["Celta", "Genk"], ["Celta"]], [["Ajax", "Celta", "Fiorentina", "Hertha"], ["Celta", "Hertha"], ["Hertha"]]]
    mut table := List[Entry]()
    for i, name in entrants.enumerate()
        table.push(Entry(name: name, points: score(picks[i], actual)))
    ranked := table.sorted(by: |t| -t.points)
    for t in ranked
        print("{t.name:<6} {t.points:>2}")
    best := ranked[0]
    champ := actual[2][0]
    print("pool winner {best.name} with {best.points} of 12; champion {champ}")

@test fn perfect_bracket()
    a := [["a", "b", "c", "d"], ["a", "c"], ["a"]]
    assert_eq(score(a, a), 12)
