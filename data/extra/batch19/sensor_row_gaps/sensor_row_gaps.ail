## Sensor row gaps: each sensor reports its nearest beacon, so it rules out every cell within that Manhattan
## distance; counts the ruled-out cells on row 10, then scans a 21 by 21 field for cells no sensor covers.

struct Sensor
    x int
    y int
    bx int
    by int

fn Sensor.radius(self) int
    (x - bx).abs() + (y - by).abs()

fn Sensor.covers(self, px int, py int) bool
    (x - px).abs() + (y - py).abs() <= radius()

fn main()
    lines := ["8,1 12,7", "0,5 3,8", "14,5 14,12", "5,16 0,12", "18,5 22,0", "15,16 10,21", "19,18 22,22"]
    mut sensors := List[Sensor]()
    for l in lines
        halves := l.split(" ")
        s := halves[0].split(",")
        b := halves[1].split(",")
        sensors.push(Sensor(x: s[0].to_int() else 0, y: s[1].to_int() else 0, bx: b[0].to_int() else 0, by: b[1].to_int() else 0))
    for s in sensors
        print("sensor ({s.x},{s.y}) reaches {s.radius()}")
    row := 10
    mut ruled := 0
    for x in -20..40
        if sensors.any(|s| s.covers(x, row)) and not sensors.any(|s| s.bx == x and s.by == row)
            ruled += 1
    print("part 1: {ruled} cells on row {row} cannot hold a beacon")
    mut gaps := 0
    mut first := ""
    for y in 0..=20
        for x in 0..=20
            if not sensors.any(|s| s.covers(x, y))
                gaps += 1
                if first == ""
                    first = "({x},{y}) tuning {x * 4000 + y}"
    print("part 2: {gaps} uncovered cells, first at {first}")

@test fn reach()
    s := Sensor(x: 0, y: 0, bx: 2, by: 1)
    assert_eq(s.radius(), 3)
    assert(s.covers(-1, 2) and not s.covers(2, 2))
