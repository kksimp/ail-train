## Warehouse box push: a robot follows arrow moves on a floor plan and shoves a whole row of boxes when
## there is free floor behind them; scores boxes by 100 x row + column after one and after three runs of the moves.

fn push(mut g List[List[char]], mut at List[int], dir char) bool
    dr := if dir == '^' then -1 elif dir == 'v' then 1 else 0
    dc := if dir == '<' then -1 elif dir == '>' then 1 else 0
    mut r := at[0] + dr
    mut c := at[1] + dc
    while g[r][c] == 'O'
        r += dr
        c += dc
    if g[r][c] == '#'
        return false
    nr := at[0] + dr
    nc := at[1] + dc
    if r != nr or c != nc
        g[r][c] = 'O'
    g[nr][nc] = '@'
    g[at[0]][at[1]] = '.'
    at[0] = nr
    at[1] = nc
    true

fn score(g List[List[char]]) int
    mut s := 0
    for r in 0..g.len()
        for c in 0..g[r].len()
            if g[r][c] == 'O'
                s += 100 * r + c
    s

fn main()
    plan := ["########", "#..O..O#", "#.O@...#", "#..O.#.#", "#O...O.#", "#......#", "########"]
    moves := ">>v<<<^^>vv>>>^<<v".chars()
    mut g := [row.chars() for row in plan]
    mut at := [2, 3]
    print("start score {score(g)}, {moves.len()} moves")
    mut blocked := 0
    for round in 1..=3
        for m in moves
            if not push(mut g, mut at, m)
                blocked += 1
        if round == 1
            print("part 1, after one run: score {score(g)}, robot at row {at[0]} col {at[1]}")
    print("part 2, after three runs: score {score(g)}")
    print("{blocked} moves hit a wall")
    for row in g
        print(row.join(""))

@test fn shove_two()
    mut g := ["#@OO.#".chars()]
    mut at := [0, 1]
    assert(push(mut g, mut at, '>'))
    assert(not push(mut g, mut at, '>'))
