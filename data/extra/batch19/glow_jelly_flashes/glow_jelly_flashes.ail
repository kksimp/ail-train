## Glow jelly flashes: jellies in a tank gain one energy a step; any above 9 flashes, lifting all eight
## neighbours (which may flash in turn) and drops to 0; counts flashes in 50 steps and finds the first step all flash together.

fn step(mut g List[List[int]]) int
    mut ready := List[List[int]]()
    for r in 0..g.len()
        for c in 0..g[0].len()
            g[r][c] += 1
            if g[r][c] == 10
                ready.push([r, c])
    mut flashes := 0
    while p := ready.pop()
        flashes += 1
        for dr in -1..=1
            for dc in -1..=1
                nr := p[0] + dr
                nc := p[1] + dc
                if (dr != 0 or dc != 0) and nr >= 0 and nr < g.len() and nc >= 0 and nc < g[0].len()
                    g[nr][nc] += 1
                    if g[nr][nc] == 10
                        ready.push([nr, nc])
    for r in 0..g.len()
        for c in 0..g[0].len()
            if g[r][c] > 9
                g[r][c] = 0
    flashes

fn main()
    rows := ["38152", "61746", "27439", "54617", "19286"]
    start := rows.map(|r| r.chars().map(|ch| (ch.to_digit(10) else 0)))
    mut g := start
    mut total := 0
    for _ in 0..50
        total += step(mut g)
    print("part 1: {total} flashes in 50 steps")
    mut h := start
    mut n := 1
    while step(mut h) != 25 and n < 2000
        n += 1
    print("part 2: every jelly flashes together on step {n}")
    for row in h
        print(row.map(|v| "{v}").join(""))

@test fn chain()
    mut g := [[9, 8]]
    assert_eq(step(mut g), 2)
