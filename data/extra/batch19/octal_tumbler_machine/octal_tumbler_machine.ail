## Octal tumbler machine: a lock's little register machine (cpy, add, mul, div, mod, out, jnz) prints one
## digit per octal digit of its input; part 1 runs it on 2024, part 2 searches for the smallest input printing 3,6,1,4.

fn value(regs Map[str, int], arg str) int
    arg.to_int() else regs.get_or(arg, 0)

fn run(prog List[str], start int) List[int]
    mut regs := Map[str, int]()
    regs["a"] = start
    mut out := List[int]()
    mut pc := 0
    while pc >= 0 and pc < prog.len()
        w := prog[pc].split(" ")
        match w[0]
            "cpy" => regs[w[1]] = value(regs, w[2])
            "add" => regs[w[1]] += value(regs, w[2])
            "mul" => regs[w[1]] = regs.get_or(w[1], 0) * value(regs, w[2])
            "div" => regs[w[1]] = regs.get_or(w[1], 0) / value(regs, w[2])
            "mod" => regs[w[1]] = regs.get_or(w[1], 0) % value(regs, w[2])
            "out" => out.push(value(regs, w[1]))
            "jnz" =>
                if value(regs, w[1]) != 0
                    pc += value(regs, w[2]) - 1
            _ => pc += 0
        pc += 1
    out

fn main()
    prog := ["cpy b a", "mod b 8", "mul b 3", "add b 1", "mod b 8", "out b", "div a 8", "jnz a -7"]
    print("{prog.len()} instructions")
    print("part 1: input 2024 prints {run(prog, 2024)}")
    want := [3, 6, 1, 4]
    mut n := 1
    while run(prog, n) != want
        n += 1
    print("part 2: smallest input printing {want} is {n}")
    print("check: {n} prints {run(prog, n)}")

@test fn one_digit()
    prog := ["cpy b a", "mod b 8", "mul b 3", "add b 1", "mod b 8", "out b", "div a 8", "jnz a -7"]
    assert_eq(run(prog, 5), [0])
