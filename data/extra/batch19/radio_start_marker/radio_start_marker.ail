## Radio start marker: a receiver locks on after the first run of K characters that are all different;
## for each captured burst, reports how many characters it read before the 4-wide and the 9-wide markers.

fn marker(s str, k int) int
    cs := s.chars()
    for i in k..=cs.len()
        mut window := Set[char]()
        for j in i - k..i
            window.add(cs[j])
        if window.len() == k
            return i
    -1

fn main()
    bursts := ["qpqzrqpwtyxvnmbbcda", "aabbccddeeffgghhijklmnop", "xyxyzzwvutsrqponmlk", "hellohelloabcdefghij", "zzzzzzzzzzzz"]
    mut found := 0
    for b in bursts
        p1 := marker(b, 4)
        p2 := marker(b, 9)
        if p2 > 0
            found += 1
        print("{b:<26} part 1: {p1:>3}  part 2: {p2:>3}")
    print("{found} of {bursts.len()} bursts carry a full message marker")

@test fn first_four()
    assert_eq(marker("abcd", 4), 4)
    assert_eq(marker("aabcd", 4), 5)
