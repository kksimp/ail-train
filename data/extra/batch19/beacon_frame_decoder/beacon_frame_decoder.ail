## Beacon frame decoder: a hex frame holds nested packets of 2-bit version and 2-bit type; type 0 carries an
## 8-bit number, types 1-3 hold a 3-bit count of sub-packets to sum, multiply or take the max of; sums versions, then evaluates.

fn read(bits List[int], mut pos List[int], n int) int
    mut v := 0
    for _ in 0..n
        v = v * 2 + bits[pos[0]]
        pos[0] += 1
    v

fn packet(bits List[int], mut pos List[int], mut versions List[int]) int
    versions[0] += read(bits, mut pos, 2)
    kind := read(bits, mut pos, 2)
    if kind == 0
        return read(bits, mut pos, 8)
    count := read(bits, mut pos, 3)
    mut vals := List[int]()
    for i in 0..count
        vals.push(packet(bits, mut pos, mut versions))
    match kind
        1 => vals.sum()
        2 => vals.fold(1, |acc, v| acc * v)
        _ => vals.max() else 0

fn decode(hex str) List[int]
    mut bits := List[int]()
    for c in hex.chars()
        d := c.to_digit(16) else 0
        for k in [3, 2, 1, 0]
            bits.push((d >> k) & 1)
    mut pos := [0]
    mut versions := [0]
    value := packet(bits, mut pos, mut versions)
    [versions[0], value, pos[0]]

fn main()
    for frame in ["9680BC800E011DE0480120D8", "642901901E00C", "4A0"]
        r := decode(frame)
        print("{frame}: {r[2]} bits used")
        print("  part 1 version sum {r[0]}, part 2 value {r[1]}")

@test fn literal()
    assert_eq(decode("4A0"), [1, 160, 12])
