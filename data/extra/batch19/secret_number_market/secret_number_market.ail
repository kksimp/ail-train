## Secret number market: each trader's secret evolves by mixing (xor) with s x 32, s / 16 and s x 512, pruned
## mod 2^20; part 1 sums the 500th secrets, part 2 picks the run of four price changes (last digits) that sells for the most.

fn evolve(s int) int
    mut v := ((s * 32) ^ s) % 1048576
    v = ((v / 16) ^ v) % 1048576
    ((v * 512) ^ v) % 1048576

fn main()
    traders := [1, 10, 100, 2024]
    mut total := 0
    mut sales := Map[str, int]()
    for t in traders
        mut s := t
        mut prices := [s % 10]
        for _ in 0..500
            s = evolve(s)
            prices.push(s % 10)
        print("trader {t}: 500th secret {s}")
        total += s
        mut first := Set[str]()
        for i in 4..prices.len()
            a := prices[i - 3] - prices[i - 4]
            b := prices[i - 2] - prices[i - 3]
            c := prices[i - 1] - prices[i - 2]
            d := prices[i] - prices[i - 1]
            key := "{a},{b},{c},{d}"
            if first.add(key)
                sales[key] += prices[i]
    print("part 1: sum of secrets {total}")
    best := sales.keys().max(by: |k| sales[k]) else ""
    print("part 2: changes {best} sell for {sales[best]}")
    print("{sales.len()} distinct change runs seen")

@test fn step()
    assert_eq(evolve(1), 17955)
