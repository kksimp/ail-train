## Valley basin lows: a height map of a valley floor; part 1 sums 1 + height of every low point (lower than all
## four neighbours), part 2 grows a basin from each low point up to the 9 ridges and multiplies the three largest sizes.

fn height(g List[List[int]], r int, c int) int
    if r < 0 or r >= g.len() or c < 0 or c >= g[0].len() then 9 else g[r][c]

fn basin(g List[List[int]], r0 int, c0 int) int
    mut seen := Set[int]()
    seen.add(r0 * 100 + c0)
    mut queue := [[r0, c0]]
    while p := queue.pop()
        for d in [[1, 0], [-1, 0], [0, 1], [0, -1]]
            r := p[0] + d[0]
            c := p[1] + d[1]
            if height(g, r, c) < 9 and seen.add(r * 100 + c)
                queue.push([r, c])
    seen.len()

fn main()
    rows := ["3318931946", "3669451918", "2449233914", "9999995799", "2552961794", "4187922987"]
    g := rows.map(|r| r.chars().map(|ch| (ch.to_digit(10) else 9)))
    mut risk := 0
    mut sizes := List[int]()
    for r in 0..g.len()
        for c in 0..g[0].len()
            h := g[r][c]
            if h < height(g, r - 1, c) and h < height(g, r + 1, c) and h < height(g, r, c - 1) and h < height(g, r, c + 1)
                size := basin(g, r, c)
                print("low point {h} at ({r},{c}), basin of {size}")
                risk += h + 1
                sizes.push(size)
    print("part 1: risk level {risk}")
    top := sizes.sorted().reversed()
    print("part 2: {top[0]} x {top[1]} x {top[2]} = {top[0] * top[1] * top[2]}")

@test fn border()
    assert_eq(height([[1]], -1, 0), 9)
