## Lantern card hands: five-card hands are ranked by kind (five, four, full house, three, two pair, pair, high)
## then card by card; winnings are rank x bid, and part 2 makes J a wild card that is also the weakest.

fn kind(cards str, wild bool) int
    mut counts := Map[char, int]()
    mut jokers := 0
    for c in cards.chars()
        if wild and c == 'J'
            jokers += 1
        else
            counts[c] += 1
    mut sizes := counts.values().sorted().reversed()
    if sizes.is_empty()
        sizes = [0]
    sizes[0] += jokers
    match sizes[0]
        5 => 6
        4 => 5
        3 => if sizes[1] == 2 then 4 else 3
        2 => if sizes[1] == 2 then 2 else 1
        _ => 0

fn strength(cards str, wild bool) int
    order := if wild then "J23456789TQKA" else "23456789TJQKA"
    mut s := kind(cards, wild)
    for c in cards.chars()
        s = s * 15 + (order.find(c) else 0)
    s

fn winnings(hands List[str], wild bool) int
    ranked := hands.sorted(by: |h| strength(h.split(" ")[0], wild))
    mut total := 0
    for i, h in ranked.enumerate()
        total += (i + 1) * (h.split(" ")[1].to_int() else 0)
    total

fn main()
    hands := ["KTJJT 220", "Q2Q2Q 15", "T3T3J 340", "A98J7 61", "55J55 503", "2345A 7"]
    for h in hands
        cards := h.split(" ")[0]
        print("{cards}: kind {kind(cards, false)}, with jokers {kind(cards, true)}")
    print("part 1: winnings {winnings(hands, false)}")
    print("part 2: winnings {winnings(hands, true)}")

@test fn full_house()
    assert_eq(kind("Q2Q2Q", false), 4)
    assert_eq(kind("JJJJJ", true), 6)
