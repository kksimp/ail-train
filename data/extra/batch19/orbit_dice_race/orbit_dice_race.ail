## Orbit dice race: two pawns circle an 8-space track adding the space they land on to their score; part 1 uses a
## counting die 1..50 to 300 points, part 2 a three-sided die where every roll splits the game, counting wins with memoised recursion.

fn wins(p1 int, s1 int, p2 int, s2 int, mut memo Map[str, List[int]]) List[int]
    if s2 >= 15
        return [0, 1]
    key := "{p1},{s1},{p2},{s2}"
    if memo.contains(key)
        return memo[key]
    mut total := [0, 0]
    for a in 1..=3
        for b in 1..=3
            for c in 1..=3
                pos := (p1 + a + b + c - 1) % 8 + 1
                sub := wins(p2, s2, pos, s1 + pos, mut memo)
                total[0] += sub[1]
                total[1] += sub[0]
    memo[key] = total
    total

fn main()
    starts := [3, 7]
    mut pos := starts
    mut score := [0, 0]
    mut die := 0
    mut rolls := 0
    mut turn := 0
    while score[0] < 300 and score[1] < 300
        mut moved := 0
        for _ in 0..3
            die = die % 50 + 1
            moved += die
            rolls += 1
        pos[turn] = (pos[turn] + moved - 1) % 8 + 1
        score[turn] += pos[turn]
        turn = 1 - turn
    loser := score.min() else 0
    print("counting die: scores {score} after {rolls} rolls")
    print("part 1: loser x rolls = {loser * rolls}")
    mut memo := Map[str, List[int]]()
    w := wins(starts[0], 0, starts[1], 0, mut memo)
    print("split die to 15: pawn 1 wins in {w[0]} games, pawn 2 in {w[1]}")
    print("part 2: {w.max() else 0}")

@test fn track()
    assert_eq((8 + 3 - 1) % 8 + 1, 3)
