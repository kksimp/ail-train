## Spin buffer insert: a circular buffer starts as [0]; for each value 1, 2, 3 ... the cursor steps forward 7 places,
## inserts the value after itself and moves onto it; part 1 reads the value after 600, part 2 tracks only the value after 0 for 60000 inserts.

fn main()
    step := 7
    mut buf := [0]
    mut pos := 0
    for v in 1..=600
        pos = (pos + step) % buf.len() + 1
        buf.insert(pos, v)
    print("first values: {buf.take(8)}")
    print("part 1: after 600 comes {buf[(pos + 1) % buf.len()]}")
    mut p := 0
    mut after_zero := 0
    for v in 1..=60000
        p = (p + step) % v + 1
        if p == 1
            after_zero = v
    print("part 2: after 0 comes {after_zero}")

@test fn small()
    mut buf := [0]
    mut pos := 0
    for v in 1..=3
        pos = (pos + 3) % buf.len() + 1
        buf.insert(pos, v)
    assert_eq(buf, [0, 2, 3, 1])
