## Charger chain counts: travel chargers step a voltage up by 1, 2 or 3 at a time from the wall (0) to the
## device (top + 3); part 1 multiplies the counts of 1-steps and 3-steps, part 2 counts every valid chain by dynamic programming.

fn main()
    chargers := [4, 1, 7, 10, 5, 13, 2, 8, 11, 16, 14, 6, 17, 19]
    mut chain := [0]
    chain.extend(chargers.sorted())
    device := (chain.last() else 0) + 3
    chain.push(device)
    mut gaps := Map[int, int]()
    for w in chain.windows(2)
        gaps[w[1] - w[0]] += 1
    print("steps of 1: {gaps.get_or(1, 0)}, of 2: {gaps.get_or(2, 0)}, of 3: {gaps.get_or(3, 0)}")
    print("part 1: {gaps.get_or(1, 0) * gaps.get_or(3, 0)}")
    mut ways := Map[int, int]()
    ways[0] = 1
    for v in chain.slice(1)
        ways[v] = ways.get_or(v - 1, 0) + ways.get_or(v - 2, 0) + ways.get_or(v - 3, 0)
    print("part 2: {ways[device]} possible chains")

@test fn pairs()
    assert_eq([1, 3, 4].windows(2).len(), 2)
