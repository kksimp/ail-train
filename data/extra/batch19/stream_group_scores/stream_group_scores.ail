## Stream group scores: a character stream nests groups in ( ) and garbage in < >, where ! cancels the next
## character; part 1 scores every group by its depth, part 2 counts the uncancelled characters inside garbage.

fn scan(s str) List[int]
    mut depth := 0
    mut score := 0
    mut junk := 0
    mut in_junk := false
    mut skip := false
    for c in s.chars()
        if skip
            skip = false
        elif c == '!'
            skip = true
        elif in_junk
            if c == '>'
                in_junk = false
            else
                junk += 1
        elif c == '<'
            in_junk = true
        elif c == '('
            depth += 1
            score += depth
        elif c == ')'
            depth -= 1
    [score, junk]

fn main()
    streams := ["()", "((()))", "(<a>,<b>)", "((<!>),<x>),(<q!!>))", "(<(()>,((!))<zz>))", "(((<ab!c>),()),(<>))"]
    mut total := [0, 0]
    for s in streams
        r := scan(s)
        print("{s:<24} score {r[0]:>2}, garbage {r[1]}")
        total[0] += r[0]
        total[1] += r[1]
    print("part 1: total score {total[0]}")
    print("part 2: total garbage {total[1]}")

@test fn nested()
    assert_eq(scan("(())"), [3, 0])
    assert_eq(scan("(<!>x>)"), [1, 1])
