## Heat loss carts: a lava cart crosses a city grid of heat-loss digits and can't reverse; Dijkstra over
## (cell, heading, run) states finds the least loss with at most 3 straight blocks, then for a heavy cart needing 4 to 7.

fn least(g List[List[int]], lo int, hi int) int
    h := g.len()
    w := g[0].len()
    dr := [0, 1, 0, -1]
    dc := [1, 0, -1, 0]
    big := 10000
    mut best := Map[int, int]()
    mut heap := Heap[int]()
    heap.push(0)
    while top := heap.pop()
        cost := top / big
        st := top % big
        run := st % 11
        d := st / 11 % 4
        cell := st / 44
        r := cell / w
        c := cell % w
        if r == h - 1 and c == w - 1 and run >= lo
            return cost
        if cost > best.get_or(st, cost)
            continue
        for nd in 0..4
            turning := nd != d
            if nd == (d + 2) % 4 or (not turning and run >= hi) or (turning and run > 0 and run < lo)
                continue
            nr := r + dr[nd]
            nc := c + dc[nd]
            if nr < 0 or nr >= h or nc < 0 or nc >= w
                continue
            nrun := if turning then 1 else run + 1
            ncost := cost + g[nr][nc]
            nst := ((nr * w + nc) * 4 + nd) * 11 + nrun
            if ncost < best.get_or(nst, 1000000)
                best[nst] = ncost
                heap.push(ncost * big + nst)
    -1

fn main()
    rows := ["8252524", "8511325", "3278312", "5662879", "8296313", "5369222"]
    g := rows.map(|r| r.chars().map(|ch| (ch.to_digit(10) else 0)))
    for r in rows
        print(r)
    print("part 1, light cart (1 to 3 straight): least loss {least(g, 1, 3)}")
    print("part 2, heavy cart (4 to 7 straight): least loss {least(g, 4, 7)}")

@test fn straight_line()
    assert_eq(least([[1, 1, 1, 1]], 1, 3), 3)
