## Grain pour ledges: grain poured at (20,0) into a silo with rock ledges falls down, then down-left, then
## down-right until it rests; part 1 counts grains before one drops past the lowest ledge, part 2 adds a floor.

fn pour(rock Set[int], floor int, has_floor bool) int
    mut filled := rock
    mut count := 0
    while not filled.contains(2000)
        mut x := 20
        mut y := 0
        mut moving := true
        while moving
            if y + 1 == floor
                if not has_floor
                    return count
                moving = false
            elif not filled.contains(x * 100 + y + 1)
                y += 1
            elif not filled.contains((x - 1) * 100 + y + 1)
                x -= 1
                y += 1
            elif not filled.contains((x + 1) * 100 + y + 1)
                x += 1
                y += 1
            else
                moving = false
        filled.add(x * 100 + y)
        count += 1
    count

fn main()
    paths := ["14,5 -> 18,5", "22,7 -> 22,4 -> 26,4", "17,10 -> 23,10", "16,7 -> 19,7"]
    mut rock := Set[int]()
    mut lowest := 0
    for p in paths
        pts := p.split(" -> ").map(|t| t.split(",").map(|v| (v.to_int() else 0)))
        for i in 1..pts.len()
            a := pts[i - 1]
            b := pts[i]
            for x in a[0].min(b[0])..=a[0].max(b[0])
                for y in a[1].min(b[1])..=a[1].max(b[1])
                    rock.add(x * 100 + y)
                    lowest = lowest.max(y)
    print("{rock.len()} rock cells, lowest ledge at depth {lowest}")
    print("part 1: {pour(rock, lowest + 2, false)} grains rest before the spill")
    print("part 2: {pour(rock, lowest + 2, true)} grains until the spout is buried")

@test fn flat_floor()
    assert_eq(pour(Set[int](), 2, true), 4)
