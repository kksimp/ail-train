## Hand game league: four fixed strategies for rock-paper-scissors play 30 rounds against each
## other; wins score 3, draws 1, and the league table is printed.

fn beats(a int, b int) bool
    (a == 0 and b == 2) or (a == 1 and b == 0) or (a == 2 and b == 1)

fn play(strategy int, round int, last_other int) int
    if strategy == 0
        return 0
    if strategy == 1
        return round % 3
    if strategy == 2
        return (last_other + 1) % 3
    (round * round + 1) % 3

fn main()
    names := ["Rocky", "Cycler", "Copycat-beater", "Squares"]
    mut pts := [0, 0, 0, 0]
    for a in 0..4
        for b in a + 1..4
            mut la := 0
            mut lb := 0
            mut wa := 0
            mut wb := 0
            for r in 0..30
                ma := play(a, r, lb)
                mb := play(b, r, la)
                if beats(ma, mb)
                    wa += 1
                elif beats(mb, ma)
                    wb += 1
                la = ma
                lb = mb
            if wa > wb
                pts[a] += 3
            elif wb > wa
                pts[b] += 3
            else
                pts[a] += 1
                pts[b] += 1
            print("{names[a]} v {names[b]}: {wa}-{wb}")
    order := [0, 1, 2, 3]
    for i in order.sorted(by: |i| (-pts[i], i))
        print("{names[i]:<15} {pts[i]}")

@test fn paper()
    assert(beats(1, 0))
