## HTML escape: replaces the five special characters in text with entities so it is safe to
## show in a page, and unescapes it again, checking the round trip.

fn escape(s str) str
    mut out := ""
    for c in s.chars()
        piece := if c == '&' then "&amp;" elif c == '<' then "&lt;" elif c == '>' then "&gt;" elif c == '"' then "&quot;" elif c.code() == 39 then "&#39;" else "{c}"
        out = "{out}{piece}"
    out

fn unescape(s str) str
    s.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", "\"").replace("&#39;", "'").replace("&amp;", "&")

fn main()
    for t in ["Fish & Chips", "<b>bold</b>", "say \"hi\"", "it's 5 > 3 & 2 < 4", "plain text", "&amp; already"]
        e := escape(t)
        print("{e} | round trip {unescape(e) == t}")

@test fn amp()
    assert_eq(escape("a&b"), "a&amp;b")
