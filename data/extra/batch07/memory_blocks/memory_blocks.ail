## Memory blocks: places process requests into free memory holes by first fit, best fit and
## worst fit, and reports which requests each strategy could not place.

fn place(holes List[int], requests List[int], how str) (List[str], List[int])
    mut free := holes
    mut placed := List[str]()
    mut failed := List[int]()
    for r in requests
        mut pick := -1
        for i, h in free.enumerate()
            if h < r
                continue
            if pick < 0 or (how == "best" and h < free[pick]) or (how == "worst" and h > free[pick])
                pick = i
            if how == "first"
                break
        if pick < 0
            failed.push(r)
        else
            placed.push("{r}->{pick + 1}")
            free[pick] -= r
    (placed, failed)

fn main()
    holes := [100, 500, 200, 300, 600]
    requests := [212, 417, 112, 426]
    for how in ["first", "best", "worst"]
        r := place(holes, requests, how)
        shown := r.0.join(" ")
        miss := if r.1.is_empty() then "none" else r.1.map(|x| "{x}").join(", ")
        print("{how:<5} fit: {shown}; unplaced {miss}")

@test fn fits()
    assert_eq(place([10], [5], "first").1.len(), 0)
