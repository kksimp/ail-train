## Commission tiers: sales staff earn 3% on the first 10,000 of monthly sales, 5% on the next
## 15,000 and 8% above 25,000, computed in cents per band like a tax table.

fn commission(sales int) int
    bands := [(1000000, 3), (1500000, 5), (-1, 8)]
    mut left := sales
    mut total := 0
    for b in bands
        width, rate := b
        part := if width < 0 or left < width then left else width
        total += part * rate / 100
        left -= part
        if left <= 0
            break
    total

fn main()
    staff := [("Ines", 840000), ("Jon", 1000000), ("Kemi", 2150000), ("Lars", 2500000), ("Mia", 4120000)]
    mut paid := 0
    for s in staff
        c := commission(s.1)
        paid += c
        print("{s.0:<5} sales {s.1 / 100:>6}: commission {c / 100}.{c % 100:02}")
    print("total commission {paid / 100}.{paid % 100:02}")

@test fn first_band()
    assert_eq(commission(100000), 3000)
