## Middle scramble: keeps each word's first and last letters and reverses the letters between,
## leaving punctuation in place, to show that such text stays readable.

fn scramble(w str) str
    cs := w.chars()
    mut end := cs.len()
    while end > 0 and not cs[end - 1].is_alpha()
        end -= 1
    if end <= 3
        return w
    mut out := List[char]()
    out.push(cs[0])
    mut i := end - 2
    while i >= 1
        out.push(cs[i])
        i -= 1
    for k in end - 1..cs.len()
        out.push(cs[k])
    out.map(|c| "{c}").join("")

fn main()
    for line in ["according to research at a university, it does not matter", "the order of letters inside a word is less important", "only the first and last letters stay put!"]
        words := line.split(" ").map(scramble)
        print(words.join(" "))

@test fn short()
    assert_eq(scramble("cat"), "cat")
