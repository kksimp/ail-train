## Human sizes: shows byte counts in binary units (KiB, MiB, GiB) with one decimal, and sums a
## folder listing to a total.

fn human(n int) str
    units := ["B", "KiB", "MiB", "GiB", "TiB"]
    if n < 1024
        return "{n} B"
    mut size := n.to_float()
    mut u := 0
    while size >= 1024.0 and u < 4
        size /= 1024.0
        u += 1
    "{size:.1} {units[u]}"

fn main()
    files := [("notes.txt", 812), ("photo.jpg", 3460211), ("song.flac", 31812664), ("backup.tar", 5370000000), ("thumb.png", 20890), ("movie.mkv", 1610612736)]
    mut total := 0
    for f in files
        total += f.1
        print("{f.0:<11} {human(f.1):>10}")
    label := "total"
    print("{label:<11} {human(total):>10}")

@test fn small()
    assert_eq(human(500), "500 B")
