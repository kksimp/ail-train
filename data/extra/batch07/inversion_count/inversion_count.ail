## Inversions: counts pairs that are out of order with a merge sort, checked against the
## simple double loop, as a measure of how far rankings disagree.

fn sort_count(xs List[int]) (List[int], int)
    if xs.len() <= 1
        return (xs, 0)
    mid := xs.len() / 2
    left, a := sort_count(xs[0..mid])
    right, b := sort_count(xs[mid..])
    mut out := List[int]()
    mut i := 0
    mut j := 0
    mut c := a + b
    while i < left.len() and j < right.len()
        if left[i] <= right[j]
            out.push(left[i])
            i += 1
        else
            out.push(right[j])
            c += left.len() - i
            j += 1
    out.extend(left[i..])
    out.extend(right[j..])
    (out, c)

fn brute(xs List[int]) int
    mut c := 0
    for i in 0..xs.len()
        for j in i + 1..xs.len()
            if xs[i] > xs[j]
                c += 1
    c

fn main()
    for xs in [[2, 4, 1, 3, 5], [5, 4, 3, 2, 1], [1, 2, 3, 4, 5], [3, 1, 2, 5, 4, 8, 6, 7], [9, 1, 8, 2, 7, 3, 6, 4, 5]]
        r := sort_count(xs)
        shown := xs.map(|x| "{x}").join(" ")
        n := xs.len()
        print("[{shown}]: {r.1} inversions of {n * (n - 1) / 2} pairs, brute force agrees {r.1 == brute(xs)}")

@test fn rev()
    assert_eq(sort_count([3, 2, 1]).1, 3)
