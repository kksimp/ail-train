## Exchange loops: checks every three-currency round trip in a rate table for a profit after
## a 0.2% fee per trade, printing loops that would turn 1000 into more than 1000.

fn main()
    names := ["USD", "EUR", "GBP", "JPY"]
    rates := [
        [1.0, 0.92, 0.79, 151.2],
        [1.089, 1.0, 0.862, 164.9],
        [1.285, 1.162, 1.0, 191.0],
        [0.00662, 0.00607, 0.00524, 1.0],
    ]
    fee := 0.998
    mut found := 0
    for a in 0..4
        for b in 0..4
            for c in 0..4
                if a == b or b == c or a == c or a > b or a > c
                    continue
                end_value := 1000.0 * rates[a][b] * fee * rates[b][c] * fee * rates[c][a] * fee
                mark := if end_value > 1000.0 then " profit" else ""
                if end_value > 1000.0
                    found += 1
                print("{names[a]}>{names[b]}>{names[c]}>{names[a]}: {end_value:.2}{mark}")
    print("{found} profitable loop(s)")

@test fn same()
    assert_eq(1000.0 * 1.0, 1000.0)
