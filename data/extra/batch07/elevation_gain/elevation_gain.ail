## Elevation gain: total climb and descent along a hike from GPS heights, ignoring changes
## smaller than a noise threshold by only counting moves from the last accepted height.

fn gain(heights List[int], noise int) (int, int)
    mut up := 0
    mut down := 0
    mut base := heights[0]
    for h in heights[1..]
        diff := h - base
        if diff >= noise
            up += diff
            base = h
        elif -diff >= noise
            down -= diff
            base = h
    (up, down)

fn main()
    track := [212, 214, 213, 220, 231, 229, 240, 238, 241, 255, 251, 248, 236, 239, 230, 218, 219, 214]
    for noise in [1, 3, 5, 10]
        g := gain(track, noise)
        print("threshold {noise:>2} m: up {g.0} m, down {g.1} m")
    peak := track.max() else 0
    print("start {track[0]} m, peak {peak} m, finish {track[track.len() - 1]} m")

@test fn flat()
    assert_eq(gain([5, 5, 5], 1), (0, 0))
