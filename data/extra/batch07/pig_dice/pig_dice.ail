## Pig dice: two players with different hold strategies (hold at 20, hold at 15) take turns
## rolling from a fixed list of rolls; a 1 loses the turn's points. First to 100 wins.

fn main()
    rolls := [4, 6, 3, 5, 2, 6, 1, 5, 5, 6, 4, 3, 6, 2, 5, 6, 1, 4, 4, 6, 5, 3, 2, 6, 6, 1, 5, 4, 6, 3, 2, 5, 6, 4, 1, 6, 6, 5, 3, 4, 2, 6, 5, 6, 4, 3, 1, 5, 6, 6, 2, 4, 5, 3, 6, 6, 4, 2, 5, 1, 6, 3, 4, 5, 6, 2, 6, 4, 3, 5, 6, 6, 1, 4, 5, 2, 3, 6, 4, 6]
    holds := [20, 15]
    mut scores := [0, 0]
    mut player := 0
    mut turn_pts := 0
    mut turns := 0
    mut winner := -1
    for r in rolls
        if r == 1
            turn_pts = 0
            player = 1 - player
            turns += 1
            continue
        turn_pts += r
        if scores[player] + turn_pts >= 100
            scores[player] += turn_pts
            winner = player
            break
        if turn_pts >= holds[player]
            scores[player] += turn_pts
            print("P{player + 1} holds {turn_pts} -> {scores[player]}")
            turn_pts = 0
            player = 1 - player
            turns += 1
    if winner >= 0
        print("P{winner + 1} wins {scores[winner]} to {scores[1 - winner]} after {turns + 1} turns")
    else
        print("rolls ran out at {scores[0]} to {scores[1]}")

@test fn swap()
    assert_eq(1 - 0, 1)
