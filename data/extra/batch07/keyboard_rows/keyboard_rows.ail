## Keyboard rows: finds words that can be typed using letters from only one row of a QWERTY
## keyboard, and the longest such word for each row.

fn row_of(c char) int
    top := "qwertyuiop"
    middle := "asdfghjkl"
    if top.contains("{c}")
        return 1
    if middle.contains("{c}")
        return 2
    3

fn main()
    words := ["typewriter", "alaska", "dad", "peace", "rupture", "flask", "proprietor", "zxcv", "mom", "gaffs", "pottery", "quiet", "hello"]
    mut best := ["", "", "", ""]
    for w in words
        rows := w.chars().map(row_of)
        r := rows[0]
        if rows.all(|x| x == r)
            print("{w}: row {r}")
            if w.len() > best[r].len()
                best[r] = w
    for r in 1..=3
        shown := if best[r] == "" then "none" else best[r]
        print("longest on row {r}: {shown}")

@test fn rows()
    assert_eq(row_of('z'), 3)
