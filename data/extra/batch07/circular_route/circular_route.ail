## Circular route: a delivery van drives a loop of depots, collecting fuel at each and using
## fuel to reach the next; finds the depot to start from so it never runs dry.

fn start_point(fuel List[int], cost List[int]) int
    mut total := 0
    mut tank := 0
    mut start := 0
    for i in 0..fuel.len()
        gain := fuel[i] - cost[i]
        total += gain
        tank += gain
        if tank < 0
            start = i + 1
            tank = 0
    if total < 0 then -1 else start

fn main()
    loops := [([1, 2, 3, 4, 5], [3, 4, 5, 1, 2]), ([2, 3, 4], [3, 4, 3]), ([5, 1, 2, 3, 4], [4, 4, 1, 5, 1]), ([4, 6, 7, 4], [6, 5, 3, 5])]
    for l in loops
        fuel, cost := l
        s := start_point(fuel, cost)
        if s < 0
            print("fuel {fuel.sum()} < cost {cost.sum()}: no start works")
        else
            print("start at depot {s + 1} (fuel {fuel.sum()}, cost {cost.sum()})")

@test fn short()
    assert_eq(start_point([1], [2]), -1)
