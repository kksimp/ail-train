## Seat grid: a 2-D table with `Grid.fill`, cells read and written as `g[row, col]`, the
## sizes `g.rows` and `g.cols`, and one row as a list with `g.row(i)`.

fn book(mut g Grid[int], row int, col int) bool
    if row < 0 or row >= g.rows or col < 0 or col >= g.cols
        return false
    if g[row, col] == 1
        return false
    g[row, col] = 1
    true

fn free_in_row(g Grid[int], row int) int
    g.row(row).count(|c| c == 0)

fn draw(g Grid[int]) str
    mut lines := List[str]()
    for r in 0..g.rows
        cells := [if c == 1 then "#" else "." for c in g.row(r)]
        lines.push(cells.join(""))
    lines.join("\n")

fn main()
    mut seats := Grid.fill(3, 5, 0)
    print(book(mut seats, 0, 0))
    print(book(mut seats, 0, 0))
    print(book(mut seats, 2, 4))
    print(book(mut seats, 3, 0))
    print(book(mut seats, 1, 2))
    print(book(mut seats, 1, 3))
    print(draw(seats))
    for r in 0..seats.rows
        print("row {r}: {free_in_row(seats, r)} free")
    print(seats.to_list().sum())
    mut tally := Grid.fill(2, 2, 0)
    tally[0, 1] += 5
    tally[0, 1] += 2
    print("{tally[0, 1]} {tally[1, 0]}")

@test fn a_seat_books_once()
    mut g := Grid.fill(1, 1, 0)
    assert(book(mut g, 0, 0))
    assert(not book(mut g, 0, 0))

@test fn empty_row_is_all_free()
    assert_eq(free_in_row(Grid.fill(2, 4, 0), 1), 4)
