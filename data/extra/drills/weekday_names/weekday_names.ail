## Weekday names: uses the reflection of a fieldless enum: `variants()`, `from_str` (which
## gives an optional and needs the exact variant name) and `name()`.

enum Day
    Mon
    Tue
    Wed
    Thu
    Fri
    Sat
    Sun

fn is_weekend(d Day) bool
    match d
        Sat | Sun => true
        _ => false

fn parse_day(text str) Day?
    t := text.trim()
    if t.len() < 3
        return none
    fixed := "{t.slice(0, 1).to_upper()}{t.slice(1, 3).to_lower()}"
    Day.from_str(fixed)

fn next_day(d Day) Day
    days := Day.variants()
    i := days.index_of(d) else 0
    days[(i + 1) % days.len()]

fn main()
    for d in Day.variants()
        kind := if is_weekend(d) then "weekend" else "workday"
        print("{d.name()} {kind} -> {next_day(d).name()}")
    print(Day.variants().len())
    for text in ["fri", " SUNDAY ", "Mon", "xx", "noday"]
        if d := parse_day(text)
            print("{text.trim()} is {d.name()}")
        else
            print("{text.trim()} is not a day")
    print(Day.from_str("mon") == none)
    print(Day.from_str("Mon") == Day.Mon)

@test fn week_wraps_around()
    assert_eq(next_day(Day.Sun), Day.Mon)

@test fn parsing_ignores_case_and_tail()
    assert_eq(parse_day("tuesday") else Day.Mon, Day.Tue)
    assert(parse_day("t") == none)
