## Find in text: splits paths with `find`, `rfind`, `slice` and `char_at`, and counts
## separators with `count`. `find`, `rfind` and `char_at` give optionals.

fn dir_of(path str) str
    cut := path.rfind("/") else return "."
    if cut == 0
        return "/"
    path.slice(0, cut)

fn base_of(path str) str
    cut := path.rfind("/") else return path
    path.slice(cut + 1)

fn ext_of(path str) str
    name := base_of(path)
    dot := name.rfind(".") else return ""
    if dot == 0
        return ""
    name.slice(dot + 1)

fn first_segment(path str) str
    cut := path.find("/") else return path
    path.slice(0, cut)

fn main()
    paths := ["src/store/report.ail", "/etc/hosts", "notes.txt", "a/b/.hidden", "/top"]
    for p in paths
        print("{p}: dir={dir_of(p)} base={base_of(p)} ext=[{ext_of(p)}] depth={p.count("/")}")
    print(first_segment("src/store/report.ail"))
    print(first_segment("plain"))
    word := "ale"
    first := word.char_at(0) else '?'
    past := word.char_at(9) else '?'
    print("{first} {past}")
    print("banana".find("an") else -1)
    print("banana".rfind("an") else -1)
    print("banana".find("x") else -1)

@test fn splits_a_path()
    assert_eq(dir_of("a/b/c.txt"), "a/b")
    assert_eq(base_of("a/b/c.txt"), "c.txt")
    assert_eq(ext_of("a/b/c.txt"), "txt")

@test fn no_separator()
    assert_eq(dir_of("c.txt"), ".")
    assert_eq(ext_of(".hidden"), "")
