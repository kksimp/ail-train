## Savings goal: monthly deposits with monthly interest; finds how many months it takes to
## reach several goals, working in cents with interest rounded down.

fn months_to(goal int, deposit int, rate_bp int) int
    mut bal := 0
    mut m := 0
    while bal < goal
        bal += bal * rate_bp / 120000
        bal += deposit
        m += 1
    m

fn main()
    for g in [100000, 500000, 1000000, 2500000]
        plain := months_to(g, 25000, 0)
        saver := months_to(g, 25000, 480)
        print("goal {g / 100:>6}: {plain:>3} months without interest, {saver:>3} with 4.8%")

@test fn simple()
    assert_eq(months_to(100, 10, 0), 10)
