## Grade curve: raises raw exam scores so the class mean becomes 70 without any score going
## over 100, then assigns letter grades and counts them.

fn letter(s int) str
    if s >= 90
        return "A"
    if s >= 80
        return "B"
    if s >= 70
        return "C"
    if s >= 60
        return "D"
    "F"

fn main()
    raw := [("Abe", 58), ("Bo", 71), ("Cai", 64), ("Dov", 49), ("Eli", 88), ("Fay", 95), ("Gus", 55), ("Hal", 60)]
    mean := raw.map(|p| p.1).sum() / raw.len()
    bump := 70 - mean
    print("raw mean {mean}, bump {bump}")
    mut counts := Map[str, int]()
    for g in ["A", "B", "C", "D", "F"]
        counts[g] = 0
    for p in raw
        curved := if p.1 + bump > 100 then 100 else p.1 + bump
        g := letter(curved)
        counts[g] += 1
        print("{p.0:<4} {p.1:>3} -> {curved:>3} {g}")
    shown := ["A", "B", "C", "D", "F"].map(|g| "{g}:{counts[g]}").join(" ")
    print(shown)

@test fn edges()
    assert_eq(letter(90), "A")
