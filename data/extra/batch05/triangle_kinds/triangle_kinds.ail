## Triangle kinds: classifies triangles from three side lengths as invalid, equilateral,
## isosceles or scalene, and also as right, acute or obtuse.

fn classify(a int, b int, c int) str
    sides := [a, b, c].sorted()
    x := sides[0]
    y := sides[1]
    z := sides[2]
    if x <= 0 or x + y <= z
        return "invalid"
    shape := if x == z then "equilateral" elif x == y or y == z then "isosceles" else "scalene"
    lhs := x * x + y * y
    rhs := z * z
    angle := if lhs == rhs then "right" elif lhs > rhs then "acute" else "obtuse"
    "{shape}, {angle}"

fn main()
    for t in [(3, 4, 5), (2, 2, 2), (5, 5, 8), (1, 2, 3), (7, 8, 9), (6, 6, 1), (5, 12, 13), (0, 1, 1)]
        print("{t.0} {t.1} {t.2}: {classify(t.0, t.1, t.2)}")

@test fn right()
    assert_eq(classify(5, 3, 4), "scalene, right")
