## Word chain: builds the longest chain from a word list where each word starts with the
## last letter of the previous one, using depth-first search without reuse.

fn longest(words List[str], used List[bool], last char) List[str]
    mut best := List[str]()
    for i in 0..words.len()
        if used[i]
            continue
        w := words[i]
        first := w.char_at(0) else ' '
        if last != ' ' and first != last
            continue
        mut u := used
        u[i] = true
        end := w.char_at(w.len() - 1) else ' '
        rest := longest(words, u, end)
        if rest.len() + 1 > best.len()
            mut chain := [w]
            chain.extend(rest)
            best = chain
    best

fn main()
    words := ["apple", "egg", "giraffe", "elephant", "tiger", "rabbit", "toad", "dog", "goat"]
    used := [false for _ in 0..words.len()]
    chain := longest(words, used, ' ')
    shown := chain.join(" -> ")
    print("{chain.len()} words: {shown}")

@test fn single()
    assert_eq(longest(["ab"], [false], ' '), ["ab"])
