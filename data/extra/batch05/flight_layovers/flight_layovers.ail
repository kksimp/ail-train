## Flight layovers: finds two-leg journeys between cities from a flight list where the
## connection leaves at least 45 minutes after landing, sorted by arrival time.

fn mins(t str) int
    p := t.split(":")
    (p[0].to_int() else 0) * 60 + (p[1].to_int() else 0)

fn main()
    flights := [
        ("BHX", "AMS", "07:10", "09:20"),
        ("AMS", "OSL", "09:50", "11:45"),
        ("AMS", "OSL", "10:20", "12:15"),
        ("BHX", "CPH", "08:00", "10:55"),
        ("CPH", "OSL", "11:30", "12:40"),
        ("CPH", "OSL", "11:20", "12:30"),
        ("BHX", "OSL", "13:00", "16:10"),
        ("AMS", "OSL", "12:05", "14:00"),
    ]
    mut trips := List[(int, str)]()
    for a in flights
        if a.0 != "BHX"
            continue
        if a.1 == "OSL"
            trips.push((mins(a.3), "direct {a.2}-{a.3}"))
            continue
        for b in flights
            if b.0 == a.1 and b.1 == "OSL"
                gap := mins(b.2) - mins(a.3)
                if gap >= 45
                    trips.push((mins(b.3), "via {a.1} {a.2}-{a.3}, {b.2}-{b.3} (wait {gap} min)"))
    for t in trips.sorted(by: |t| (t.0, t.1))
        print(t.1)

@test fn clock()
    assert_eq(mins("01:30"), 90)
