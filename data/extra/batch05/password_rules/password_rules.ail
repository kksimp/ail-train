## Password rules: checks candidate passwords against length, character-class and
## repetition rules, listing every rule each one breaks.

fn problems(p str) List[str]
    cs := p.chars()
    mut out := List[str]()
    if cs.len() < 10
        out.push("too short")
    if not cs.any(|c| c.is_upper())
        out.push("no capital")
    if not cs.any(|c| c.is_digit())
        out.push("no digit")
    if cs.all(|c| c.is_alnum())
        out.push("no symbol")
    for i in 2..cs.len()
        if cs[i] == cs[i - 1] and cs[i] == cs[i - 2]
            out.push("triple {cs[i]}")
            break
    out

fn main()
    for p in ["hunter2", "CorrectHorse9!", "aaaBBB111###", "Pa55w0rd", "tr0ub4dor&3X"]
        ps := problems(p)
        if ps.is_empty()
            print("{p}: ok")
        else
            shown := ps.join(", ")
            print("{p}: {shown}")

@test fn good()
    assert(problems("Zebra-Crossing7").is_empty())
