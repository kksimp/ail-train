## Merge sorted: merges sorted lists two at a time and then all at once with a k-way merge,
## counting comparisons for each approach.

fn merge2(a List[int], b List[int]) (List[int], int)
    mut out := List[int]()
    mut i := 0
    mut j := 0
    mut cmps := 0
    while i < a.len() and j < b.len()
        cmps += 1
        if a[i] <= b[j]
            out.push(a[i])
            i += 1
        else
            out.push(b[j])
            j += 1
    out.extend(a[i..])
    out.extend(b[j..])
    (out, cmps)

fn main()
    lists := [[1, 9, 14, 30], [2, 3, 22], [5, 6, 7, 8, 40], [4, 18]]
    mut acc := List[int]()
    mut total := 0
    for l in lists
        merged, c := merge2(acc, l)
        acc = merged
        total += c
    shown := acc.map(|x| "{x}").join(" ")
    print("pairwise: {shown}")
    print("comparisons: {total}")
    mut idx := [0 for _ in 0..lists.len()]
    mut out := List[int]()
    mut kcmps := 0
    while out.len() < acc.len()
        mut pick := -1
        for k in 0..lists.len()
            if idx[k] < lists[k].len()
                if pick >= 0
                    kcmps += 1
                if pick < 0 or lists[k][idx[k]] < lists[pick][idx[pick]]
                    pick = k
        out.push(lists[pick][idx[pick]])
        idx[pick] += 1
    print("k-way same: {out == acc}, comparisons: {kcmps}")

@test fn two()
    m, _ := merge2([1, 3], [2])
    assert_eq(m, [1, 2, 3])
