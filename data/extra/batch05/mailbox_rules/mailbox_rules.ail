## Mailbox rules: incoming messages are filed by the first matching rule (sender domain,
## subject keyword) into folders, and folder counts are printed.

fn folder_for(sender str, subject str) str
    domain := sender.split("@")[1]
    low := subject.to_lower()
    if domain == "bank.example"
        return "finance"
    if low.contains("invoice") or low.contains("receipt")
        return "finance"
    if domain == "school.example"
        return "family"
    if low.contains("sale") or low.contains("offer")
        return "promotions"
    "inbox"

fn main()
    mail := [
        ("alerts@bank.example", "Your statement"),
        ("shop@store.example", "Big SALE this weekend"),
        ("office@school.example", "Trip letter"),
        ("ann@friends.example", "Lunch?"),
        ("billing@host.example", "Invoice 2291"),
        ("deals@store.example", "A special offer"),
        ("head@school.example", "Receipt for dinner money"),
    ]
    mut counts := Map[str, int]()
    for m in mail
        f := folder_for(m.0, m.1)
        counts[f] += 1
        print("{m.1:<26} -> {f}")
    for f in counts.keys().sorted()
        print("{f}: {counts[f]}")

@test fn fallback()
    assert_eq(folder_for("a@b.c", "hi"), "inbox")
