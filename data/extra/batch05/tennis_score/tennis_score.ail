## Tennis score: plays out a game from a string of point winners and prints the score
## after each point in tennis terms, including deuce and advantage.

fn call(a int, b int) str
    names := ["love", "15", "30", "40"]
    if a >= 3 and b >= 3
        if a == b
            return "deuce"
        if a == b + 1
            return "advantage A"
        if b == a + 1
            return "advantage B"
    if a >= 4 and a >= b + 2
        return "game A"
    if b >= 4 and b >= a + 2
        return "game B"
    "{names[a]}-{names[b]}"

fn main()
    for game in ["AAAA", "ABABABBB", "AABBABABAA", "BBBAAAB"]
        mut a := 0
        mut b := 0
        mut calls := List[str]()
        for p in game.chars()
            if p == 'A'
                a += 1
            else
                b += 1
            calls.push(call(a, b))
        shown := calls.join(", ")
        print("{game}: {shown}")

@test fn deuce()
    assert_eq(call(4, 4), "deuce")
