## Base64 by hand: encodes short ASCII strings to base64 using bit shifts and a 64-letter
## alphabet, with padding, and checks against known answers.

fn encode(s str) str
    table := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".chars()
    bs := s.chars().map(|c| c.code())
    mut out := ""
    mut i := 0
    while i < bs.len()
        b0 := bs[i]
        b1 := if i + 1 < bs.len() then bs[i + 1] else 0
        b2 := if i + 2 < bs.len() then bs[i + 2] else 0
        n := (b0 << 16) | (b1 << 8) | b2
        c0 := table[(n >> 18) & 63]
        c1 := table[(n >> 12) & 63]
        c2 := if i + 1 < bs.len() then table[(n >> 6) & 63] else '='
        c3 := if i + 2 < bs.len() then table[n & 63] else '='
        out = "{out}{c0}{c1}{c2}{c3}"
        i += 3
    out

fn main()
    for s in ["Man", "Ma", "M", "hello world", "AIL"]
        print("{s} -> {encode(s)}")

@test fn known()
    assert_eq(encode("Man"), "TWFu")
