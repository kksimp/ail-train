## Draw audit: checks a gift draw for problems (someone giving to themselves, a person
## receiving twice, someone left out) and prints the cycles the draw forms.

fn main()
    draws := [
        [("A", "B"), ("B", "C"), ("C", "A"), ("D", "E"), ("E", "D")],
        [("A", "B"), ("B", "B"), ("C", "A"), ("D", "C")],
        [("A", "C"), ("B", "C"), ("C", "D"), ("D", "A")],
    ]
    for d in draws
        mut problems := List[str]()
        givers := d.map(|p| p.0)
        takers := d.map(|p| p.1)
        for p in d
            if p.0 == p.1
                problems.push("{p.0} draws self")
        for t in takers
            if takers.filter(|x| x == t).len() > 1 and not problems.contains("{t} drawn twice")
                problems.push("{t} drawn twice")
        for g in givers
            if not takers.contains(g)
                problems.push("{g} gets nothing")
        if problems.is_empty()
            mut seen := Set[str]()
            mut cycles := List[str]()
            for g in givers
                if seen.contains(g)
                    continue
                mut loop_names := List[str]()
                mut cur := g
                while not seen.contains(cur)
                    seen.add(cur)
                    loop_names.push(cur)
                    now := cur
                    cur = d.filter(|p| p.0 == now)[0].1
                cycles.push(loop_names.join(">"))
            shown := cycles.join(" + ")
            print("ok: {shown}")
        else
            shown := problems.join("; ")
            print("problems: {shown}")

@test fn self_draw()
    assert(("A", "A").0 == ("A", "A").1)
