## Happy numbers: repeatedly sums the squares of digits; numbers reaching 1 are happy.
## Prints the happy numbers up to 50 and the chain for a few starts.

fn next_val(n int) int
    mut x := n
    mut s := 0
    while x > 0
        d := x % 10
        s += d * d
        x /= 10
    s

fn chain(n int) List[int]
    mut seen := List[int]()
    mut x := n
    while x != 1 and not seen.contains(x)
        seen.push(x)
        x = next_val(x)
    seen.push(x)
    seen

fn main()
    happy := [n for n in 1..=50 if (chain(n).last() else 0) == 1]
    shown := happy.map(|n| "{n}").join(" ")
    print("happy: {shown}")
    for n in [7, 4, 19]
        steps := chain(n).map(|x| "{x}").join(" -> ")
        print("{n}: {steps}")

@test fn seven()
    assert_eq(chain(7).last() else 0, 1)
