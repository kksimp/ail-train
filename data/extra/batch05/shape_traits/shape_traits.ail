## Shape traits: a trait with area and perimeter, implemented by circles, squares and
## triangles; a mixed list is sorted by area and summarised.

trait Shape
    fn area(self) float
    fn perimeter(self) float
    fn name(self) str

struct Circle
    r float

struct Square
    side float

struct Tri
    a float
    b float
    c float

impl Shape for Circle
    fn area(self) float
        3.141592653589793 * self.r * self.r
    fn perimeter(self) float
        2.0 * 3.141592653589793 * self.r
    fn name(self) str
        "circle"

impl Shape for Square
    fn area(self) float
        self.side * self.side
    fn perimeter(self) float
        4.0 * self.side
    fn name(self) str
        "square"

impl Shape for Tri
    fn area(self) float
        s := (self.a + self.b + self.c) / 2.0
        (s * (s - self.a) * (s - self.b) * (s - self.c)).sqrt()
    fn perimeter(self) float
        self.a + self.b + self.c
    fn name(self) str
        "triangle"

fn main()
    mut all := List[any Shape]()
    all.push(Circle(r: 1.5))
    all.push(Square(side: 2.5))
    all.push(Tri(a: 3.0, b: 4.0, c: 5.0))
    all.push(Circle(r: 0.8))
    all.push(Tri(a: 5.0, b: 5.0, c: 6.0))
    ordered := all.sorted(by: |s| s.area())
    for s in ordered
        print("{s.name():<8} area {s.area():>6.2} perimeter {s.perimeter():>6.2}")
    total := all.map(|s| s.area()).sum()
    print("total area {total:.2}")

@test fn right_tri()
    t := Tri(a: 3.0, b: 4.0, c: 5.0)
    assert_eq(t.area(), 6.0)
