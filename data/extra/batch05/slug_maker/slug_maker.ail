## Slug maker: turns article titles into URL slugs (lower case, letters and digits kept,
## everything else collapsed to single hyphens, trimmed) and de-duplicates them.

fn slug(title str) str
    mut out := ""
    mut dash := false
    for c in title.to_lower().chars()
        if c.is_alnum()
            if dash and out != ""
                out = "{out}-"
            out = "{out}{c}"
            dash = false
        else
            dash = true
    out

fn main()
    titles := ["Hello, World!", "  AIL 0.2 is out  ", "Tips & Tricks: Part 2", "Hello World", "C'est la vie"]
    mut used := Map[str, int]()
    for t in titles
        base := slug(t)
        used[base] += 1
        n := used[base]
        final := if n == 1 then base else "{base}-{n}"
        print("{t.trim()} => {final}")

@test fn basic()
    assert_eq(slug("A  B"), "a-b")
