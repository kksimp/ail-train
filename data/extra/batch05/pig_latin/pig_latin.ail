## Pig Latin: translates sentences word by word (consonant clusters move to the end plus
## "ay", vowel-initial words add "way"), keeping punctuation in place.

fn is_vowel(c char) bool
    "aeiou".contains(c)

fn word(w str) str
    cs := w.chars()
    if cs.is_empty()
        return w
    if is_vowel(cs[0])
        return "{w}way"
    mut i := 0
    while i < cs.len() and not is_vowel(cs[i])
        if cs[i] == 'q' and i + 1 < cs.len() and cs[i + 1] == 'u'
            i += 2
            break
        i += 1
    "{w.slice(i)}{w.slice(0, i)}ay"

fn main()
    for line in ["the quick brown fox", "i eat apples, then sleep.", "strength through rhythm"]
        mut out := List[str]()
        for raw in line.split(" ")
            mut tail := ""
            mut core := raw
            if raw.ends_with(",") or raw.ends_with(".")
                tail = raw.slice(raw.len() - 1)
                core = raw.slice(0, raw.len() - 1)
            out.push("{word(core)}{tail}")
        print(out.join(" "))

@test fn vowel_start()
    assert_eq(word("egg"), "eggway")
