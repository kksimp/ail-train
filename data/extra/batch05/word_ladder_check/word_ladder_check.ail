## Ladder check: verifies proposed word ladders, where each step changes exactly one letter
## and every word is in the dictionary, naming the first bad step.

fn one_apart(a str, b str) bool
    xs := a.chars()
    ys := b.chars()
    if xs.len() != ys.len()
        return false
    mut diff := 0
    for i in 0..xs.len()
        if xs[i] != ys[i]
            diff += 1
    diff == 1

fn main()
    known := {"cold", "cord", "card", "ward", "warm", "word", "worm", "corm", "core", "care"}
    ladders := [["cold", "cord", "card", "ward", "warm"], ["cold", "cord", "word", "worm", "warm"], ["cold", "cord", "core", "care", "card"], ["cold", "colt", "cord"], ["cold", "card", "ward"]]
    for l in ladders
        mut verdict := "ok"
        for i, w in l.enumerate()
            if not known.contains(w)
                verdict = "{w} is not a word"
                break
            if i > 0 and not one_apart(l[i - 1], w)
                verdict = "{l[i - 1]} -> {w} changes more than one letter"
                break
        shown := l.join(" > ")
        print("{shown}: {verdict}")

@test fn apart()
    assert(one_apart("cold", "cord"))
