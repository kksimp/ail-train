## Alert rules: each monitoring rule implements a `Rule` trait whose `check` gives an alert text
## or `none`; every host snapshot runs through a `List[any Rule]` and its alerts are listed.

struct Snapshot
    host str
    cpu int
    disk_free int
    errors int

trait Rule
    fn check(self, s Snapshot) str?

struct CpuHigh
    limit int

struct DiskLow
    min_free int

impl Rule for CpuHigh
    fn check(self, s Snapshot) str?
        if s.cpu > limit
            return "cpu {s.cpu}% over {limit}%"
        none

impl Rule for DiskLow
    fn check(self, s Snapshot) str?
        if s.disk_free < min_free
            return "only {s.disk_free} GB free"
        none

fn alerts(rules List[any Rule], s Snapshot) List[str]
    mut out := List[str]()
    for r in rules
        if msg := r.check(s)
            out.push(msg)
    out

fn main()
    mut rules := List[any Rule]()
    rules.push(CpuHigh(limit: 85))
    rules.push(DiskLow(min_free: 20))
    snaps := [
        Snapshot(host: "web-1", cpu: 92, disk_free: 120, errors: 3),
        Snapshot(host: "web-2", cpu: 40, disk_free: 80, errors: 0),
        Snapshot(host: "db-1", cpu: 88, disk_free: 12, errors: 75),
        Snapshot(host: "cache", cpu: 15, disk_free: 9, errors: 0),
    ]
    mut quiet := 0
    for s in snaps
        found := alerts(rules, s)
        if found.is_empty()
            quiet += 1
            continue
        joined := found.join("; ")
        print("{s.host}: {joined}")
    print("{quiet} of {snaps.len()} hosts quiet")

@test fn cpu_rule()
    s := Snapshot(host: "x", cpu: 90, disk_free: 50, errors: 0)
    assert_eq(CpuHigh(limit: 85).check(s) else "", "cpu 90% over 85%")
