## Opening times: shop hours like "09:30-17:00" are read by functions returning `int?`, where
## `x?` passes on `none` from any bad piece; a shop with unreadable hours is reported as unknown.

fn minutes(t str) int?
    parts := t.split(":")
    if parts.len() != 2
        return none
    h := parts[0].to_int()?
    m := parts[1].to_int()?
    if h > 23 or m > 59
        return none
    h * 60 + m

fn span(text str) List[int]?
    halves := text.split("-")
    if halves.len() != 2
        return none
    a := minutes(halves[0])?
    b := minutes(halves[1])?
    [a, b]

fn main()
    shops := [("bakery", "07:00-13:30"), ("library", "10:00-18:00"), ("barber", "9am-5pm"), ("pharmacy", "08:30-21:15"), ("cafe", "08:00-25:00")]
    now := minutes("12:45") else 0
    mut open := 0
    for s in shops
        name, hours := s
        if hs := span(hours)
            from := hs[0]
            to := hs[1]
            state := if from <= now and now < to then "open" else "closed"
            if state == "open"
                open += 1
            print("{name:<9} {hours}: {state}, {to - from} min a day")
        else
            print("{name:<9} {hours}: hours unknown")
    print("{open} shops open at 12:45")

@test fn bad_minutes()
    assert(minutes("7:75") == none)
    assert_eq(minutes("01:05") else 0, 65)
