## Shelf relabel: a price rise changes items in place with `for mut item in items`; each price
## goes up by its category's percentage and is then rounded up to end in 99 pence.

struct Product
    name str
    category str
    pence int

fn ends_in_99(p int) int
    (p / 100) * 100 + 99

fn main()
    rises := {"dairy": 8, "bakery": 5, "household": 3}
    mut items := [
        Product(name: "milk 2l", category: "dairy", pence: 145),
        Product(name: "cheddar", category: "dairy", pence: 329),
        Product(name: "bloomer", category: "bakery", pence: 180),
        Product(name: "bin bags", category: "household", pence: 210),
        Product(name: "bananas", category: "fruit", pence: 99),
    ]
    old := items.map(|p| p.pence)
    for mut item in items
        pct := rises.get_or(item.category, 0)
        if pct > 0
            raised := item.pence + (item.pence * pct + 99) / 100
            item.pence = ends_in_99(raised)
    for i, p in items.enumerate()
        change := p.pence - old[i]
        print("{p.name:<9} {old[i]:>4} -> {p.pence:>4} (+{change})")
    unchanged := items.count(|p| rises.get_or(p.category, 0) == 0)
    print("{unchanged} items kept their price")

@test fn rounding_up()
    assert_eq(ends_in_99(157), 199)
