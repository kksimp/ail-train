## Cramer's rule: solves 3x3 linear systems with integer coefficients by determinants,
## printing exact fractions, or saying the system has no single solution.

fn det3(m List[List[int]]) int
    m[0][0] * (m[1][1] * m[2][2] - m[1][2] * m[2][1]) - m[0][1] * (m[1][0] * m[2][2] - m[1][2] * m[2][0]) + m[0][2] * (m[1][0] * m[2][1] - m[1][1] * m[2][0])

fn gcd(a int, b int) int
    if b == 0 then a.abs() else gcd(b, a % b)

fn frac(n int, d int) str
    g := gcd(n, d)
    mut a := n / g
    mut b := d / g
    if b < 0
        a = -a
        b = -b
    if b == 1 then "{a}" else "{a}/{b}"

fn main()
    systems := [
        ([[2, 1, -1], [-3, -1, 2], [-2, 1, 2]], [8, -11, -3]),
        ([[1, 1, 1], [0, 2, 5], [2, 5, -1]], [6, -4, 27]),
        ([[1, 2, 3], [2, 4, 6], [1, 0, 1]], [1, 2, 3]),
        ([[3, 0, 2], [1, 4, 0], [0, 2, 5]], [7, 1, 2]),
    ]
    for s in systems
        a, rhs := s
        d := det3(a)
        if d == 0
            print("determinant 0: no single solution")
            continue
        mut parts := List[str]()
        for col in 0..3
            mut m := a
            for r in 0..3
                m[r][col] = rhs[r]
            parts.push(frac(det3(m), d))
        print("det {d}: x = {parts[0]}, y = {parts[1]}, z = {parts[2]}")

@test fn identity()
    assert_eq(det3([[1, 0, 0], [0, 1, 0], [0, 0, 1]]), 1)
