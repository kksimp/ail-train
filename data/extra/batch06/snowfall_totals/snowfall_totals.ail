## Snowfall: daily snowfall and melt over a fortnight give the snow depth each day, the
## deepest day, and the days the ground was clear.

fn main()
    snow := [0, 4, 12, 3, 0, 0, 7, 15, 2, 0, 0, 0, 5, 0]
    melt := [2, 1, 1, 3, 5, 6, 2, 1, 4, 6, 7, 8, 2, 5]
    mut depth := 0
    mut deepest := (0, 0)
    mut clear := List[int]()
    for d in 0..snow.len()
        depth += snow[d]
        depth -= melt[d]
        if depth < 0
            depth = 0
        if depth > deepest.1
            deepest = (d + 1, depth)
        if depth == 0
            clear.push(d + 1)
        bar := "*".repeat(depth / 2)
        print("day {d + 1:>2}: {depth:>2} cm |{bar}")
    shown := clear.map(|d| "{d}").join(", ")
    print("deepest day {deepest.0} ({deepest.1} cm); clear on days {shown}")

@test fn floor()
    assert_eq(if 0 - 2 < 0 then 0 else 1, 0)
