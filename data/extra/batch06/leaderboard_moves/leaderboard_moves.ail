## Leaderboard moves: compares two weekly rankings and prints each player's movement with
## arrows, new entries and players who dropped out.

fn main()
    last := ["Kim", "Lou", "Max", "Ned", "Oz", "Pia"]
    now := ["Lou", "Kim", "Pia", "Qi", "Max", "Ned"]
    for i, p in now.enumerate()
        if old := last.index_of(p)
            move := old - i
            arrow := if move > 0 then "up {move}" elif move < 0 then "down {-move}" else "same"
            print("{i + 1}. {p:<4} {arrow}")
        else
            print("{i + 1}. {p:<4} new")
    gone := last.filter(|p| not now.contains(p))
    shown := gone.join(", ")
    print("dropped out: {shown}")

@test fn index()
    assert_eq(["a", "b"].index_of("b") else -1, 1)
