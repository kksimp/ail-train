## Stamp combos: finds the fewest stamps from a set of denominations that make each postage
## value exactly, by dynamic programming, and shows one combination.

fn main()
    stamps := [1, 7, 12, 25]
    for target in [14, 24, 30, 37, 50, 61]
        mut best := [0]
        mut pick := [0]
        for v in 1..=target
            mut b := 1000000
            mut p := 0
            for s in stamps
                if s <= v and best[v - s] + 1 < b
                    b = best[v - s] + 1
                    p = s
            best.push(b)
            pick.push(p)
        mut used := List[int]()
        mut v := target
        while v > 0
            used.push(pick[v])
            v -= pick[v]
        shown := used.sorted().reversed().map(|s| "{s}").join(" + ")
        print("{target}: {best[target]} stamps ({shown})")

@test fn exact()
    assert_eq(7 + 7, 14)
