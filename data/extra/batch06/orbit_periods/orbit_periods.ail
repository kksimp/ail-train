## Orbit periods: Kepler's third law gives each planet's year from its distance in AU;
## prints the period in Earth years and days, compared with known values.

fn main()
    planets := [("Mercury", 0.387, 88.0), ("Venus", 0.723, 224.7), ("Earth", 1.0, 365.256), ("Mars", 1.524, 687.0), ("Jupiter", 5.203, 4331.0)]
    for p in planets
        name, au, known := p
        years := (au * au * au).sqrt()
        days := years * 365.256
        err := (days - known).abs() / known * 100.0
        print("{name:<8} {years:>7.3} years {days:>8.1} days (off by {err:.2}%)")

@test fn earth()
    assert_eq((1.0 * 1.0 * 1.0).sqrt(), 1.0)
