## Binary clock: shows times as columns of binary digits for hours, minutes and seconds
## tens and units, with 'o' for on and '.' for off, rows from 8 down to 1.

fn main()
    for t in ["12:34:56", "07:08:09", "23:59:59"]
        digits := t.chars().filter(|c| c != ':').map(|c| c.to_digit(10) else 0)
        print(t)
        for bit in [8, 4, 2, 1]
            mut row := ""
            for i, d in digits.enumerate()
                mark := if (d & bit) != 0 then "o" else "."
                gap := if i == 2 or i == 4 then "  " elif i == 0 then "" else " "
                row = "{row}{gap}{mark}"
            print("{bit} {row}")

@test fn bits()
    assert_eq(5 & 4, 4)
