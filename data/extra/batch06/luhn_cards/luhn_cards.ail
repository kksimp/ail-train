## Luhn check: validates card-like numbers with the Luhn algorithm (double every second digit
## from the right) and computes the check digit to append to partial numbers.

fn luhn_sum(ds List[int], double_first bool) int
    mut total := 0
    mut dbl := double_first
    mut i := ds.len() - 1
    while i >= 0
        mut d := ds[i]
        if dbl
            d *= 2
            if d > 9
                d -= 9
        total += d
        dbl = not dbl
        i -= 1
    total

fn digits(s str) List[int]
    s.chars().filter(|c| c.is_digit()).map(|c| c.to_digit(10) else 0)

fn main()
    for n in ["4539 1488 0343 6467", "4539 1488 0343 6468", "79927398713", "1234 5678 9012 3456"]
        ok := luhn_sum(digits(n), false) % 10 == 0
        print("{n}: {ok}")
    for part in ["7992739871", "453914880343646"]
        check := (10 - luhn_sum(digits(part), true) % 10) % 10
        print("{part} + {check}")

@test fn known()
    assert_eq(luhn_sum(digits("79927398713"), false) % 10, 0)
