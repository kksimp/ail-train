## ISO weeks: computes the ISO-8601 week number and weekday of dates, using day of year and
## the weekday of the date (Monday = 1), handling weeks that belong to the next or last year.

fn leap(y int) bool
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0

fn day_of_year(y int, m int, d int) int
    feb := if leap(y) then 29 else 28
    lens := [31, feb, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    mut n := d
    for i in 0..m - 1
        n += lens[i]
    n

fn weekday(y int, m int, d int) int
    t := [0, 3, 2, 5, 0, 3, 5, 1, 4, 6, 2, 4]
    yy := if m < 3 then y - 1 else y
    w := (yy + yy / 4 - yy / 100 + yy / 400 + t[m - 1] + d) % 7
    if w == 0 then 7 else w

fn weeks_in(y int) int
    p := (y + y / 4 - y / 100 + y / 400) % 7
    q := (y - 1 + (y - 1) / 4 - (y - 1) / 100 + (y - 1) / 400) % 7
    if p == 4 or q == 3 then 53 else 52

fn iso(y int, m int, d int) (int, int)
    w := (day_of_year(y, m, d) - weekday(y, m, d) + 10) / 7
    if w < 1
        return (y - 1, weeks_in(y - 1))
    if w > weeks_in(y)
        return (y + 1, 1)
    (y, w)

fn main()
    names := ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    for date in [(2027, 1, 1), (2026, 12, 31), (2027, 3, 15), (2026, 6, 30), (2020, 12, 31), (2021, 1, 3), (2028, 12, 31)]
        y, m, d := date
        yw := iso(y, m, d)
        wd := weekday(y, m, d)
        print("{y}-{m:02}-{d:02} is {names[wd - 1]}, week {yw.1:02} of {yw.0}")

@test fn new_year()
    assert_eq(day_of_year(2024, 3, 1), 61)
