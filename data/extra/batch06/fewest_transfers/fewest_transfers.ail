## Fewest transfers: bus lines are lists of stops; a breadth-first search over lines finds
## the fewest buses needed between two stops.

fn buses(lines List[(str, List[str])], from str, to str) int
    if from == to
        return 0
    mut used := Set[str]()
    mut reached := {from}
    mut count := 0
    while true
        count += 1
        mut grew := false
        mut next := reached
        for l in lines
            if used.contains(l.0)
                continue
            if l.1.any(|s| reached.contains(s))
                used.add(l.0)
                grew = true
                for s in l.1
                    next.add(s)
        if next.contains(to)
            return count
        if not grew
            return -1
        reached = next
    -1

fn main()
    lines := [("1", ["Ash", "Bay", "Cove", "Dell"]), ("2", ["Cove", "Elm", "Fen"]), ("3", ["Fen", "Glen", "Hill"]), ("4", ["Bay", "Glen"]), ("5", ["Isle", "Jetty"])]
    for trip in [("Ash", "Dell"), ("Ash", "Elm"), ("Ash", "Hill"), ("Dell", "Fen"), ("Ash", "Jetty"), ("Elm", "Elm")]
        n := buses(lines, trip.0, trip.1)
        verdict := if n < 0 then "no route" elif n == 0 then "already there" else "{n} bus(es)"
        print("{trip.0} -> {trip.1}: {verdict}")

@test fn same()
    assert_eq(buses([("1", ["a", "b"])], "a", "b"), 1)
