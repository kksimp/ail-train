## Kettle energy: energy to heat water (4.186 kJ per kg per degree) at a kettle's power and
## efficiency, giving boil time in seconds and cost per boil at a unit price.

fn main()
    price := 0.31
    kettles := [("travel", 1000.0, 0.8, 0.5), ("standard", 2200.0, 0.85, 1.0), ("rapid", 3000.0, 0.9, 1.0), ("large", 2200.0, 0.85, 1.7)]
    for k in kettles
        name, watts, eff, litres := k
        kj := litres * 4.186 * (100.0 - 18.0)
        seconds := kj * 1000.0 / (watts * eff)
        kwh := kj / 3600.0 / eff
        print("{name:<8} {litres:.1} l: {seconds:.0} s, {kwh:.3} kWh, cost {kwh * price * 100.0:.2}p")

@test fn heat()
    assert(1.0 * 4.186 * 82.0 > 343.0)
