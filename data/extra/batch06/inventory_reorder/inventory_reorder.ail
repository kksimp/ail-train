## Reorder points: for each stock item, the reorder point is daily use times lead time plus
## safety stock; items at or below it get an order sized to cover 30 days.

fn main()
    items := [("bolts", 420, 35, 5, 60), ("nuts", 900, 40, 5, 80), ("washers", 150, 20, 7, 50), ("hinges", 75, 4, 14, 20), ("screws", 260, 30, 3, 40)]
    mut orders := 0
    for it in items
        name, stock, daily, lead, safety := it
        point := daily * lead + safety
        if stock <= point
            qty := daily * 30 + point - stock
            orders += 1
            print("{name}: stock {stock} <= {point}, order {qty}")
        else
            days := (stock - point) / daily
            print("{name}: stock {stock}, reorder in {days} days")
    print("{orders} orders to place")

@test fn point()
    assert_eq(35 * 5 + 60, 235)
