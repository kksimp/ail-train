## Tag cloud: counts tags across blog posts and assigns each tag a size from 1 to 5 by its
## share of the largest count, printing tags alphabetically with their size.

fn main()
    posts := [["ail", "compilers", "speed"], ["ail", "testing"], ["gardening"], ["ail", "speed", "benchmarks"], ["compilers", "ail"], ["testing", "speed"], ["ail"]]
    mut counts := Map[str, int]()
    for p in posts
        for t in p
            counts[t] += 1
    biggest := counts.values().max() else 1
    for t in counts.keys().sorted()
        size := 1 + (counts[t] - 1) * 4 / (biggest - 1).max(1)
        stars := "*".repeat(size)
        print("{t:<11} {counts[t]} {stars}")

@test fn sizes()
    assert_eq(1 + (5 - 1) * 4 / 4, 5)
