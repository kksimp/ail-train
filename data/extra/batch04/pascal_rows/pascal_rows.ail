## Pascal rows: builds Pascal's triangle row by row, prints it centred, and checks that each
## row sums to a power of two.

fn next_row(row List[int]) List[int]
    mut out := [1]
    for i in 1..row.len()
        out.push(row[i - 1] + row[i])
    out.push(1)
    out

fn main()
    mut row := [1]
    for n in 0..9
        text := row.map(|x| "{x}").join(" ")
        mut pad := ""
        for _ in 0..(40 - text.len()) / 2
            pad = "{pad} "
        print("{pad}{text}")
        assert_eq(row.sum(), 1 << n)
        row = next_row(row)
    print("row 9 middle: {row[4]}")

@test fn third()
    assert_eq(next_row([1, 2, 1]), [1, 3, 3, 1])
