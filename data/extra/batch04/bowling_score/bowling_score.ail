## Bowling score: scores ten-pin bowling games from roll lists, with strike and spare
## bonuses, and prints the running frame totals.

fn frames(rolls List[int]) List[int]
    mut totals := List[int]()
    mut i := 0
    mut score := 0
    for _ in 0..10
        if rolls[i] == 10
            score += 10 + rolls[i + 1] + rolls[i + 2]
            i += 1
        elif rolls[i] + rolls[i + 1] == 10
            score += 10 + rolls[i + 2]
            i += 2
        else
            score += rolls[i] + rolls[i + 1]
            i += 2
        totals.push(score)
    totals

fn main()
    games := [
        [10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10],
        [9, 1, 9, 1, 9, 1, 9, 1, 9, 1, 9, 1, 9, 1, 9, 1, 9, 1, 9, 1, 9],
        [10, 7, 3, 9, 0, 10, 0, 8, 8, 2, 0, 6, 10, 10, 10, 8, 1],
        [3, 4, 3, 4, 3, 4, 3, 4, 3, 4, 3, 4, 3, 4, 3, 4, 3, 4, 3, 4],
    ]
    for g in games
        t := frames(g)
        shown := t.map(|x| "{x}").join(" ")
        print("{shown} => {t[9]}")

@test fn perfect()
    assert_eq(frames([10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10, 10])[9], 300)
