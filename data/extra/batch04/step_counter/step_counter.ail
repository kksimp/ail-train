## Step counter: a week of step counts per person; prints each person's total, their best
## day, the days that met a 10,000 goal, and the weekly leader.

fn main()
    days := ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    log := [
        ("Rae", [8200, 10400, 9100, 12050, 7600, 15300, 4300]),
        ("Sol", [11000, 10100, 9900, 10020, 10800, 6000, 13400]),
        ("Tam", [5400, 6100, 7200, 6600, 8800, 9900, 10001]),
    ]
    mut leader := ""
    mut lead_total := 0
    for entry in log
        who, steps := entry
        total := steps.sum()
        mut best := 0
        for i in 1..steps.len()
            if steps[i] > steps[best]
                best = i
        met := [days[i] for i in 0..7 if steps[i] >= 10000]
        shown := met.join(" ")
        print("{who}: {total:,} steps, best {days[best]}, goal met {met.len()}x ({shown})")
        if total > lead_total
            lead_total = total
            leader = who
    print("leader: {leader}")

@test fn goal()
    assert(10001 >= 10000)
