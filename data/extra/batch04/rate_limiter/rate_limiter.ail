## Rate limiter: a sliding window allows at most 3 requests per client in any 10 seconds;
## older timestamps drop out of each client's window as new requests arrive.

fn main()
    requests := [(1, "ann"), (2, "ann"), (3, "bob"), (4, "ann"), (5, "ann"), (9, "bob"), (11, "ann"), (12, "ann"), (13, "ann"), (14, "bob"), (15, "ann"), (25, "ann")]
    mut windows := Map[str, List[int]]()
    mut refused := 0
    for r in requests
        t, who := r
        recent := (windows.get(who) else List[int]()).filter(|x| x > t - 10)
        if recent.len() >= 3
            refused += 1
            print("t={t:>2} {who}: refused ({recent.len()} in window)")
            windows[who] = recent
            continue
        mut kept := recent
        kept.push(t)
        windows[who] = kept
        print("t={t:>2} {who}: ok")
    print("{refused} refused")

@test fn filter_window()
    assert_eq([1, 5, 9].filter(|x| x > 3), [5, 9])
