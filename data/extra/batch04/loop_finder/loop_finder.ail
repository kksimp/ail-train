## Loop finder: a "next index" table forms a chain that may end in a cycle; Floyd's tortoise
## and hare finds where the cycle starts and how long it is, without extra memory.

fn find_cycle(next_of List[int], start int) (int, int)?
    mut slow := start
    mut fast := start
    while true
        if next_of[fast] < 0 or next_of[next_of[fast]] < 0
            return none
        slow = next_of[slow]
        fast = next_of[next_of[fast]]
        if slow == fast
            break
    mut a := start
    mut b := slow
    while a != b
        a = next_of[a]
        b = next_of[b]
    mut length := 1
    mut c := next_of[a]
    while c != a
        c = next_of[c]
        length += 1
    (a, length)

fn main()
    tables := [[1, 2, 3, 4, 5, 2], [1, 2, 3, -1], [3, 0, 1, 1], [0]]
    for t in tables
        if found := find_cycle(t, 0)
            at, length := found
            print("{t}: cycle starts at {at}, length {length}")
        else
            print("{t}: no cycle")

@test fn self_loop()
    assert_eq(find_cycle([0], 0) else (-1, -1), (0, 1))
