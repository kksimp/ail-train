## Polynomial eval: polynomials as coefficient lists (lowest power first) with Horner's
## rule for evaluation, addition, multiplication and a pretty printer.

fn value_at(p List[int], x int) int
    mut acc := 0
    for c in p.reversed()
        acc = acc * x + c
    acc

fn coef(p List[int], i int) int
    if i < p.len() then p[i] else 0

fn poly_add(a List[int], b List[int]) List[int]
    n := a.len().max(b.len())
    [coef(a, i) + coef(b, i) for i in 0..n]

fn power_text(i int) str
    if i == 0
        return ""
    if i == 1
        return "x"
    "x^{i}"

fn poly_mul(a List[int], b List[int]) List[int]
    mut out := [0 for _ in 0..a.len() + b.len() - 1]
    for i in 0..a.len()
        for j in 0..b.len()
            out[i + j] += a[i] * b[j]
    out

fn show(p List[int]) str
    mut terms := List[str]()
    mut i := p.len() - 1
    while i >= 0
        c := p[i]
        if c != 0
            power := power_text(i)
            coef := if c == 1 and i > 0 then "" else "{c}"
            terms.push("{coef}{power}")
        i -= 1
    if terms.is_empty() then "0" else terms.join(" + ")

fn main()
    p := [1, 2, 3]
    q := [-1, 0, 1]
    print("p = {show(p)}")
    print("q = {show(q)}")
    print("p + q = {show(poly_add(p, q))}")
    print("p * q = {show(poly_mul(p, q))}")
    print("p(2) = {value_at(p, 2)}, q(3) = {value_at(q, 3)}, (p*q)(2) = {value_at(poly_mul(p, q), 2)}")

@test fn horner()
    assert_eq(value_at([5, 0, 1], 3), 14)
