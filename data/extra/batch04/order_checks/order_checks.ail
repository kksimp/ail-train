## Order checks: validates order lines with a function that fails with text, passes failures
## up with the line number added, and handles each order's outcome with `if` and `else err`.

fn parse_line(line str) int ! str
    parts := line.split("x")
    if parts.len() != 2
        return "expected QTYxPRICE"
    qty := parts[0].trim().to_int() else return "bad quantity"
    price := parts[1].trim().to_int() else return "bad price"
    if qty <= 0
        return "quantity must be positive"
    qty * price

fn order_total(lines List[str]) int ! str
    mut total := 0
    for i, l in lines.enumerate()
        v := parse_line(l) else err
            return "line {i + 1}: {err}"
        total += v
    total

fn main()
    orders := [["2x150", "1x999", "3x20"], ["1x100", "two x 5"], ["4x25", "0x10"], ["5"]]
    for o in orders
        if t := order_total(o)
            print("{o}: total {t}")
        else err
            print("{o}: rejected, {err}")

@test fn good_line()
    assert_eq(parse_line("3x4") else 0, 12)
