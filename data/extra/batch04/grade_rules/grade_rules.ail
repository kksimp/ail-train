## Grade rules: grade boundaries kept as a list of (minimum, letter) pairs and a function
## value that adjusts raw marks (a curve); both are swapped to compare two policies.

fn letter(mark int, bounds List[(int, str)]) str
    for b in bounds
        if mark >= b.0
            return b.1
    "F"

fn grades(marks List[int], curve fn(int) int, bounds List[(int, str)]) List[str]
    marks.map(|m| letter(curve(m).min(100), bounds))

fn plain(m int) int
    m

fn lift(m int) int
    m + 5

fn main()
    marks := [91, 78, 65, 59, 84, 40, 72]
    strict := [(90, "A"), (80, "B"), (70, "C"), (60, "D")]
    gentle := [(85, "A"), (75, "B"), (65, "C"), (50, "D")]
    print("strict, no curve: {grades(marks, plain, strict).join(" ")}")
    print("strict, +5 curve: {grades(marks, lift, strict).join(" ")}")
    print("gentle, no curve: {grades(marks, plain, gentle).join(" ")}")
    passed := grades(marks, lift, gentle).filter(|g| g != "F").len()
    print("gentle with curve passes {passed} of {marks.len()}")

@test fn boundary()
    assert_eq(letter(90, [(90, "A")]), "A")
