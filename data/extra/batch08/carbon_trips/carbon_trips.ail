## Travel carbon: a month of regular trips by mode, with kg of CO2 per km for each mode, gives
## each mode's share and how much switching the car commute to the train would save.

fn main()
    factors := [("car", 0.17), ("bus", 0.10), ("train", 0.035), ("bike", 0.0), ("plane", 0.25)]
    mut per_km := Map[str, float]()
    for f in factors
        per_km[f.0] = f.1
    trips := [("car", 24.0, 10), ("train", 60.0, 2), ("bus", 8.0, 6), ("plane", 900.0, 1), ("bike", 5.0, 8)]
    mut total := 0.0
    for t in trips
        mode, km, times := t
        kg := km * times.to_float() * per_km[mode]
        total += kg
        print("{mode:<6} {times:>2} x {km:>5.1} km: {kg:>6.1} kg")
    print("month total: {total:.1} kg")
    car_km := 24.0 * 10.0
    saved := car_km * (per_km["car"] - per_km["train"])
    print("car commute by train instead saves {saved:.1} kg")

@test fn bike_free()
    assert_eq(5.0 * 8.0 * 0.0, 0.0)
