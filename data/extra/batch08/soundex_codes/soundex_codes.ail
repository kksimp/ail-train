## Soundex: codes surnames by sound (first letter plus three digits) so that spellings like
## Robert and Rupert match; H and W do not separate repeated codes, vowels do.

fn digit(c char) int
    match c
        'B' | 'F' | 'P' | 'V' => 1
        'C' | 'G' | 'J' | 'K' | 'Q' | 'S' | 'X' | 'Z' => 2
        'D' | 'T' => 3
        'L' => 4
        'M' | 'N' => 5
        'R' => 6
        _ => 0

fn soundex(name str) str
    cs := name.to_upper().chars()
    mut code := "{cs[0]}"
    mut last := digit(cs[0])
    for i in 1..cs.len()
        c := cs[i]
        d := digit(c)
        if d != 0 and d != last and code.len() < 4
            code = "{code}{d}"
        if c != 'H' and c != 'W'
            last = d
    code.pad_right(4, '0')

fn main()
    names := ["Robert", "Rupert", "Rubin", "Ashcraft", "Ashcroft", "Tymczak", "Pfister", "Honeyman", "Lee", "Jackson"]
    mut groups := Map[str, List[str]]()
    for n in names
        code := soundex(n)
        print("{n:<9} {code}")
        if not groups.contains(code)
            groups[code] = List[str]()
        groups[code].push(n)
    for code in groups.keys().sorted()
        if groups[code].len() > 1
            joined := groups[code].join(", ")
            print("sound alike {code}: {joined}")

@test fn pair()
    assert_eq(soundex("Robert"), soundex("Rupert"))
