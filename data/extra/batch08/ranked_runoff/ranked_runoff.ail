## Instant runoff: ranked ballots are counted by first live choice; with no majority the
## weakest candidate (later in the list on a tie) is dropped and their ballots move on.

fn main()
    candidates := ["Ana", "Ben", "Cy", "Dee"]
    groups := [(4, ["Ana", "Ben", "Cy", "Dee"]), (3, ["Ben", "Cy", "Ana", "Dee"]), (2, ["Cy", "Ben", "Ana", "Dee"]), (2, ["Dee", "Cy", "Ben", "Ana"])]
    mut dropped := Set[str]()
    mut round := 1
    while true
        mut counts := Map[str, int]()
        for c in candidates
            if not dropped.contains(c)
                counts[c] = 0
        for g in groups
            for c in g.1
                if not dropped.contains(c)
                    counts[c] += g.0
                    break
        mut total := 0
        mut parts := List[str]()
        mut weakest := ""
        for c in candidates
            if not dropped.contains(c)
                total += counts[c]
                parts.push("{c} {counts[c]}")
                if weakest == "" or counts[c] <= counts[weakest]
                    weakest = c
        shown := parts.join(", ")
        print("round {round}: {shown}")
        mut winner := ""
        for c in candidates
            if not dropped.contains(c) and counts[c] * 2 > total
                winner = c
        if winner != ""
            print("{winner} wins with a majority")
            break
        print("  drop {weakest}")
        dropped.add(weakest)
        round += 1

@test fn majority()
    assert(7 * 2 > 11)
