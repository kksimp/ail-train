## Lorenz system: the weather model dx = s(y - x), dy = x(r - z) - y, dz = xy - bz stepped with
## small time steps; two starts a billionth apart drift completely apart (the butterfly effect).

fn main()
    s := 10.0
    r := 28.0
    b := 8.0 / 3.0
    dt := 0.005
    mut a := [1.0, 1.0, 1.0]
    mut c := [1.000000001, 1.0, 1.0]
    for step in 0..=6000
        if step % 1000 == 0
            dx := a[0] - c[0]
            dy := a[1] - c[1]
            dz := a[2] - c[2]
            gap := (dx * dx + dy * dy + dz * dz).sqrt()
            t := step.to_float() * dt
            print("t {t:>4.1}: x {a[0]:>7.2} y {a[1]:>7.2} z {a[2]:>6.2}, gap {gap:.6}")
        a = [a[0] + s * (a[1] - a[0]) * dt, a[1] + (a[0] * (r - a[2]) - a[1]) * dt, a[2] + (a[0] * a[1] - b * a[2]) * dt]
        c = [c[0] + s * (c[1] - c[0]) * dt, c[1] + (c[0] * (r - c[2]) - c[1]) * dt, c[2] + (c[0] * c[1] - b * c[2]) * dt]

@test fn still()
    assert_eq(10.0 * (0.0 - 0.0), 0.0)
