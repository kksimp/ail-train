## Delivery zone: an odd-shaped zone drawn as a polygon; ray casting counts how many edges a
## line from each address crosses, and an odd count means the address is inside.

fn inside(px List[float], py List[float], x float, y float) bool
    mut hit := false
    mut j := px.len() - 1
    for i in 0..px.len()
        if (py[i] > y) != (py[j] > y)
            cross_x := (px[j] - px[i]) * (y - py[i]) / (py[j] - py[i]) + px[i]
            if x < cross_x
                hit = not hit
        j = i
    hit

fn main()
    px := [0.0, 10.0, 10.0, 6.0, 6.0, 0.0]
    py := [0.0, 0.0, 4.0, 4.0, 9.0, 9.0]
    addresses := [("12 Mill Rd", 2.0, 2.0), ("3 Oak Ave", 8.0, 6.0), ("40 Quay St", 5.0, 7.5), ("7 Bell Ln", 9.5, 3.5), ("19 High St", -1.0, 4.0), ("2 Ford Way", 6.5, 4.5)]
    mut count := 0
    for a in addresses
        name, x, y := a
        ok := inside(px, py, x, y)
        if ok
            count += 1
        verdict := if ok then "deliver" else "out of zone"
        print("{name:<11} ({x}, {y}): {verdict}")
    print("{count} of {addresses.len()} in the zone")

@test fn centre()
    assert(inside([0.0, 2.0, 2.0, 0.0], [0.0, 0.0, 2.0, 2.0], 1.0, 1.0))
