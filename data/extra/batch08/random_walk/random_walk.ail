## Random walk: a linear congruential generator (seeded, so the run repeats) flips a coin for each
## step left or right; tracks the position, the furthest point reached and returns to the start.

fn next_seed(x int) int
    (1103515245 * x + 12345) % 2147483648

fn main()
    mut seed := 2026
    mut pos := 0
    mut furthest := 0
    mut returns := 0
    for step in 1..=200
        seed = next_seed(seed)
        if ((seed >> 16) & 1) == 1
            pos += 1
        else
            pos -= 1
        if pos.abs() > furthest
            furthest = pos.abs()
        if pos == 0
            returns += 1
        if step % 40 == 0
            print("step {step:>3}: position {pos:>3}")
    print("furthest {furthest} steps away, back at the start {returns} times")
    mut x := 0
    mut y := 0
    for step in 0..400
        seed = next_seed(seed)
        dir := (seed >> 16) % 4
        if dir == 0
            x += 1
        elif dir == 1
            x -= 1
        elif dir == 2
            y += 1
        else
            y -= 1
    dist := (x * x + y * y).to_float().sqrt()
    print("400 steps on a grid end at ({x}, {y}), {dist:.2} from the start")

@test fn repeat()
    assert_eq(next_seed(1), next_seed(1))
