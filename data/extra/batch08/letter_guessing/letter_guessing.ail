## Letter guessing: a hidden word is shown as blanks; each guessed letter fills every place it
## appears or costs a miss, and the round ends when the word is complete or six misses are used.

fn shown(word str, found Set[char]) str
    mut parts := List[str]()
    for c in word.chars()
        parts.push(if found.contains(c) then "{c}" else "_")
    parts.join(" ")

fn play(word str, guesses List[char])
    mut found := Set[char]()
    mut misses := 0
    for g in guesses
        hit := word.contains(g)
        if hit
            found.add(g)
        else
            misses += 1
        mark := if hit then "hit" else "miss {misses}"
        board := shown(word, found)
        print("{g}: {board} ({mark})")
        if not board.contains("_")
            print("solved with {misses} misses")
            return
        if misses == 6
            print("out of guesses, the word was {word}")
            return

fn main()
    play("PLANET", ['E', 'A', 'S', 'T', 'R', 'L', 'N', 'P'])
    play("RHYTHM", ['E', 'A', 'I', 'O', 'U', 'S', 'T'])

@test fn blank()
    assert_eq(shown("AB", Set[char]()), "_ _")
