## Convex hull: the fence around a set of trees using the monotone chain method, building the
## lower and upper halves from points sorted by x; trees not on the fence stand inside it.

fn cross(o List[int], a List[int], b List[int]) int
    (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])

fn drop_last(mut xs List[List[int]])
    _ := xs.pop()

fn hull(points List[List[int]]) List[List[int]]
    pts := points.sorted(by: |p| (p[0], p[1]))
    mut lower := List[List[int]]()
    for p in pts
        while lower.len() >= 2 and cross(lower[lower.len() - 2], lower[lower.len() - 1], p) <= 0
            drop_last(mut lower)
        lower.push(p)
    mut upper := List[List[int]]()
    for i in 0..pts.len()
        p := pts[pts.len() - 1 - i]
        while upper.len() >= 2 and cross(upper[upper.len() - 2], upper[upper.len() - 1], p) <= 0
            drop_last(mut upper)
        upper.push(p)
    drop_last(mut lower)
    drop_last(mut upper)
    lower.extend(upper)
    lower

fn main()
    trees := [[0, 0], [4, 0], [4, 4], [0, 4], [2, 2], [1, 3], [3, 1], [2, 5], [5, 2], [2, -1], [1, 1], [3, 3]]
    fence := hull(trees)
    shown := fence.map(|p| "({p[0]}, {p[1]})").join(" ")
    print("fence posts: {shown}")
    inside := trees.len() - fence.len()
    print("{fence.len()} on the fence, {inside} inside")

@test fn square()
    assert_eq(hull([[0, 0], [2, 0], [2, 2], [0, 2], [1, 1]]).len(), 4)
