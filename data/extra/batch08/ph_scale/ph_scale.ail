## pH: the negative log of the hydrogen ion concentration; each tenfold dilution of a strong acid
## raises pH by one, and pOH is 14 - pH at room temperature.

fn ph(conc float) float
    0.0 - conc.log10()

fn kind(p float) str
    if p < 6.9 then "acidic" elif p > 7.1 then "basic" else "neutral"

fn main()
    samples := [("stomach acid", 0.01), ("lemon juice", 0.005), ("coffee", 0.00001), ("pure water", 0.0000001), ("sea water", 0.00000001), ("soap", 0.0000000001)]
    for s in samples
        name, conc := s
        p := ph(conc)
        print("{name:<12} pH {p:>5.2}, pOH {14.0 - p:>5.2} ({kind(p)})")
    mut c := 0.1
    mut steps := List[str]()
    for k in 0..5
        p := ph(c)
        steps.push("{p:.1}")
        c = c / 10.0
    shown := steps.join(" -> ")
    print("diluting 0.1 M acid tenfold: {shown}")

@test fn tenth()
    assert((ph(0.1) - 1.0).abs() < 0.000001)
