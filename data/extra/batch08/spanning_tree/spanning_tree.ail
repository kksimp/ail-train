## Cheapest road network: Kruskal's algorithm joins seven towns with the least total road,
## taking roads shortest first and skipping any that would close a loop (union-find).

fn root(parent List[int], x int) int
    mut r := x
    while parent[r] != r
        r = parent[r]
    r

fn main()
    towns := ["Ash", "Birch", "Cedar", "Dale", "Elm", "Fir", "Gorse"]
    roads := [(0, 1, 7), (0, 3, 5), (1, 2, 8), (1, 3, 9), (1, 4, 7), (2, 4, 5), (3, 4, 15), (3, 5, 6), (4, 5, 8), (4, 6, 9), (5, 6, 11)]
    mut parent := List[int]()
    for i in 0..towns.len()
        parent.push(i)
    mut total := 0
    mut built := 0
    for r in roads.sorted(by: |r| (r.2, r.0, r.1))
        a := root(parent, r.0)
        b := root(parent, r.1)
        if a == b
            print("skip {towns[r.0]}-{towns[r.1]} ({r.2} km): would close a loop")
        elif built < towns.len() - 1
            parent[a] = b
            total += r.2
            built += 1
            print("build {towns[r.0]}-{towns[r.1]} ({r.2} km)")
    print("{built} roads, {total} km in all")

@test fn own_root()
    assert_eq(root([0, 0, 1], 2), 0)
