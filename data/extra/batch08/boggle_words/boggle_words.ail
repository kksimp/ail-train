## Letter grid words: checks which words can be traced on a 4 by 4 grid of letters by moving to
## any of the eight neighbours without reusing a square, and scores them by length.

fn trace(grid List[List[char]], word List[char], k int, r int, c int, mut used List[bool]) bool
    if r < 0 or r > 3 or c < 0 or c > 3
        return false
    if used[r * 4 + c] or grid[r][c] != word[k]
        return false
    if k == word.len() - 1
        return true
    used[r * 4 + c] = true
    for dr in -1..=1
        for dc in -1..=1
            if (dr != 0 or dc != 0) and trace(grid, word, k + 1, r + dr, c + dc, mut used)
                used[r * 4 + c] = false
                return true
    used[r * 4 + c] = false
    false

fn found(grid List[List[char]], word str) bool
    letters := word.chars()
    mut used := List[bool]()
    for i in 0..16
        used.push(false)
    for r in 0..4
        for c in 0..4
            if trace(grid, letters, 0, r, c, mut used)
                return true
    false

fn points(n int) int
    if n <= 4 then 1 elif n == 5 then 2 elif n == 6 then 3 else 5

fn main()
    rows := ["SERT", "TAEL", "OPIN", "DRAC"]
    mut grid := List[List[char]]()
    for row in rows
        grid.push(row.chars())
    words := ["SEAT", "TEAL", "PAIN", "RAIN", "PLAIN", "STAR", "TAPIR", "OPAL", "SEATED", "LINE", "CARD", "PATIO"]
    mut total := 0
    for w in words
        if found(grid, w)
            p := points(w.len())
            total += p
            print("{w:<7} yes, {p} pt")
        else
            print("{w:<7} not on the grid")
    print("score {total}")

@test fn short()
    assert_eq(points(3), 1)
