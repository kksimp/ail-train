## Nonogram clues: a picture puzzle gives the lengths of the filled runs in each row and column;
## works the clues out from a finished picture, printing a 0 for an empty line.

fn runs(cells List[char]) str
    mut out := List[int]()
    mut n := 0
    for c in cells
        if c == '#'
            n += 1
        elif n > 0
            out.push(n)
            n = 0
    if n > 0
        out.push(n)
    if out.is_empty() then "0" else out.join(" ")

fn main()
    picture := [".##.##.", "#######", "#######", ".#####.", "..###..", "...#...", "......."]
    mut grid := List[List[char]]()
    for row in picture
        grid.push(row.chars())
    for r in 0..grid.len()
        print("{picture[r]}  {runs(grid[r])}")
    mut cols := List[str]()
    for c in 0..grid[0].len()
        mut column := List[char]()
        for r in 0..grid.len()
            column.push(grid[r][c])
        cols.push(runs(column))
    shown := cols.join(" | ")
    print("columns: {shown}")

@test fn split_runs()
    assert_eq(runs("##.#".chars()), "2 1")
