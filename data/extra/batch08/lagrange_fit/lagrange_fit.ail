## Lagrange interpolation: the one polynomial through a few measured points, evaluated between
## and beyond them; four points from x^3 + x + 1 give that cubic back exactly.

fn lagrange(xs List[float], ys List[float], x float) float
    mut total := 0.0
    for i in 0..xs.len()
        mut term := ys[i]
        for j in 0..xs.len()
            if j != i
                term = term * (x - xs[j]) / (xs[i] - xs[j])
        total += term
    total

fn main()
    xs := [0.0, 1.0, 2.0, 3.0]
    ys := [1.0, 3.0, 11.0, 31.0]
    for x in [0.5, 1.5, 2.5, 4.0]
        cube := x * x * x + x + 1.0
        print("x {x}: fit {lagrange(xs, ys, x):.3}, cubic {cube:.3}")
    hours := [6.0, 9.0, 12.0, 15.0, 18.0]
    temps := [11.0, 16.0, 21.0, 22.0, 17.0]
    for h in [7.5, 10.5, 13.5, 16.5]
        print("{h:.1} h: about {lagrange(hours, temps, h):.1} C")

@test fn through()
    assert_eq(lagrange([0.0, 1.0], [2.0, 4.0], 1.0), 4.0)
