## K-means in one dimension: delivery times are grouped around three centres; each round
## assigns every time to its nearest centre, then moves each centre to its group's mean.

fn main()
    times := [8.0, 9.5, 11.0, 12.0, 19.0, 21.5, 22.0, 24.0, 23.0, 41.0, 38.5, 45.0, 44.0, 10.0]
    mut centres := [10.0, 20.0, 30.0]
    mut groups := List[List[float]]()
    for round in 1..=20
        groups = [List[float](), List[float](), List[float]()]
        for t in times
            mut best := 0
            for k in 1..3
                if (t - centres[k]).abs() < (t - centres[best]).abs()
                    best = k
            groups[best].push(t)
        mut moved := false
        for k in 0..3
            if groups[k].len() > 0
                mean := groups[k].sum() / groups[k].len().to_float()
                if mean != centres[k]
                    moved = true
                centres[k] = mean
        print("round {round}: centres {centres[0]:.3}, {centres[1]:.3}, {centres[2]:.3}")
        if not moved
            break
    for k in 0..3
        shown := groups[k].sorted().join(" ")
        print("group {k + 1}: {shown}")

@test fn nearest()
    assert((12.0 - 10.0).abs() < (12.0 - 20.0).abs())
