## Hand combinations: counts five-card hands from a 52-card deck with binomial coefficients
## (flushes, four of a kind, full houses, one pair) and gives each as "1 in N".

fn choose(n int, k int) int
    mut r := 1
    for i in 0..k
        r = r * (n - i) / (i + 1)
    r

fn main()
    total := choose(52, 5)
    print("all hands: {total}")
    hands := [
        ("four of a kind", 13 * choose(4, 4) * 48),
        ("full house", 13 * choose(4, 3) * 12 * choose(4, 2)),
        ("flush (incl. straight flushes)", 4 * choose(13, 5)),
        ("three of a kind", 13 * choose(4, 3) * choose(12, 2) * 16),
        ("two pair", choose(13, 2) * choose(4, 2) * choose(4, 2) * 44),
        ("one pair", 13 * choose(4, 2) * choose(12, 3) * 64),
    ]
    for h in hands
        name, count := h
        print("{name}: {count} hands, 1 in {(total + count / 2) / count}")

@test fn small()
    assert_eq(choose(5, 2), 10)
