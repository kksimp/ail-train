## Pythagorean triples: Euclid's formula (m^2 - n^2, 2mn, m^2 + n^2) with m, n coprime and of
## opposite parity gives every primitive right triangle; a brute force counts all of them.

fn gcd(a int, b int) int
    mut x := a
    mut y := b
    while y != 0
        t := x % y
        x = y
        y = t
    x

fn main()
    limit := 60
    mut found := List[List[int]]()
    for m in 2..9
        for n in 1..m
            if (m - n) % 2 == 1 and gcd(m, n) == 1
                a0 := m * m - n * n
                b0 := 2 * m * n
                c := m * m + n * n
                if c <= limit
                    a := if a0 < b0 then a0 else b0
                    b := if a0 < b0 then b0 else a0
                    found.push([c, a, b])
    for t in found.sorted(by: |t| (t[0], t[1]))
        print("{t[1]}, {t[2]}, {t[0]}")
    mut all_count := 0
    for a in 1..limit
        for b in a..limit
            c2 := a * a + b * b
            c := c2.to_float().sqrt().to_int()
            if c * c == c2 and c <= limit
                all_count += 1
    print("{found.len()} primitive, {all_count} in all with hypotenuse up to {limit}")

@test fn coprime()
    assert_eq(gcd(12, 18), 6)
