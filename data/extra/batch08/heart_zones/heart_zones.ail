## Heart zones: training zones from maximum heart rate (220 minus age) and resting rate by the
## Karvonen method, then classifies a workout's minute-by-minute readings into zones.

fn main()
    age := 38
    rest := 58
    top := 220 - age
    reserve := top - rest
    bounds := [50, 60, 70, 80, 90]
    lows := bounds.map(|p| rest + reserve * p / 100)
    for i in 0..4
        print("zone {i + 1}: {lows[i]}-{lows[i + 1] - 1} bpm")
    readings := [96, 110, 121, 128, 135, 141, 150, 158, 163, 155, 149, 138, 126, 112]
    mut minutes := [0, 0, 0, 0, 0, 0]
    for r in readings
        mut z := 0
        for i in 0..5
            if r >= lows[i]
                z = i + 1
        minutes[z] += 1
    for z in 0..6
        if minutes[z] > 0
            label := if z == 0 then "below zone 1" elif z == 5 then "zone 5" else "zone {z}"
            print("{label}: {minutes[z]} min")

@test fn max_rate()
    assert_eq(220 - 38, 182)
