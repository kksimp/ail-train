## Bell numbers: the Bell triangle starts each row with the last number of the row above and
## adds along; its first column counts the ways to split n guests into groups.

fn main()
    mut row := [1]
    mut bells := [1]
    print(row.join(" "))
    for n in 1..8
        mut nxt := [row[row.len() - 1]]
        for x in row
            nxt.push(nxt[nxt.len() - 1] + x)
        row = nxt
        bells.push(row[0])
        print(row.join(" "))
    shown := bells.join(", ")
    print("Bell numbers: {shown}")
    print("5 guests can be split into groups {bells[5]} ways")

@test fn third()
    assert_eq(1 + 1 + 3, 5)
