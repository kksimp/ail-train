## PageRank: a page is important when important pages link to it; repeatedly shares each page's
## rank among its links with damping 0.85, until the ranks settle, then lists pages by rank.

fn main()
    pages := ["home", "about", "blog", "shop", "help"]
    links := [[1, 2, 3], [0], [0, 3], [0, 4], [0, 3]]
    n := pages.len()
    d := 0.85
    mut rank := List[float]()
    for i in 0..n
        rank.push(1.0 / n.to_float())
    for it in 0..60
        mut next_rank := List[float]()
        for i in 0..n
            next_rank.push((1.0 - d) / n.to_float())
        for i in 0..n
            share := rank[i] / links[i].len().to_float()
            for j in links[i]
                next_rank[j] += d * share
        rank = next_rank
    mut used := Set[int]()
    for k in 0..n
        mut pick := -1
        for i in 0..n
            if not used.contains(i) and (pick < 0 or rank[i] > rank[pick])
                pick = i
        used.add(pick)
        print("{k + 1}. {pages[pick]:<6} {rank[pick]:.3}")
    total := rank.sum()
    print("ranks sum to {total:.3}")

@test fn start()
    assert_eq(1.0 / 4.0, 0.25)
