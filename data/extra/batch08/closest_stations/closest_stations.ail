## Closest stations: weather stations on a map grid in km; checks every pair to find the two
## that sit closest together (likely duplicates) and the two furthest apart.

fn main()
    names := ["Alder", "Brook", "Crest", "Dune", "Eyre", "Fell"]
    xs := [2.0, 14.5, 7.0, 30.0, 14.0, 22.0]
    ys := [3.0, 8.0, 21.0, 4.5, 9.5, 18.0]
    mut near := (0, 1, 1000000.0)
    mut far := (0, 1, 0.0)
    for i in 0..names.len()
        for j in i + 1..names.len()
            dx := xs[i] - xs[j]
            dy := ys[i] - ys[j]
            d := dx.hypot(dy)
            if d < near.2
                near = (i, j, d)
            if d > far.2
                far = (i, j, d)
    print("closest: {names[near.0]} and {names[near.1]}, {near.2:.2} km")
    print("furthest: {names[far.0]} and {names[far.1]}, {far.2:.2} km")
    pairs := names.len() * (names.len() - 1) / 2
    print("{pairs} pairs checked")

@test fn three_four_five()
    assert_eq(3.0.hypot(4.0), 5.0)
