## Burst order: popping a balloon scores its number times its two current neighbours; an interval
## table chooses which balloon to pop last in each range, giving the best order and total score.

fn plan(i int, j int, last List[List[int]], vals List[int], mut out List[int])
    if j - i < 2
        return
    k := last[i][j]
    plan(i, k, last, vals, mut out)
    plan(k, j, last, vals, mut out)
    out.push(vals[k])

fn main()
    balloons := [3, 1, 5, 8, 2]
    mut vals := [1]
    vals.extend(balloons)
    vals.push(1)
    n := vals.len()
    mut best := List[List[int]]()
    mut last := List[List[int]]()
    for i in 0..n
        mut row := List[int]()
        for j in 0..n
            row.push(0)
        best.push(row)
        last.push(row)
    for gap in 2..n
        for i in 0..n - gap
            j := i + gap
            for k in i + 1..j
                score := best[i][k] + best[k][j] + vals[i] * vals[k] * vals[j]
                if score > best[i][j]
                    best[i][j] = score
                    last[i][j] = k
    mut order := List[int]()
    plan(0, n - 1, last, vals, mut order)
    print("balloons: {balloons}")
    print("pop in order: {order}")
    print("best score: {best[0][n - 1]}")
    mut left := balloons
    mut naive := 0
    while left.len() > 0
        a := if left.len() > 1 then left[1] else 1
        naive += left[0] * a
        left.remove_at(0)
    print("popping left to right scores {naive}")

@test fn single()
    mut out := List[int]()
    plan(0, 2, [[0, 0, 1], [0, 0, 0], [0, 0, 0]], [1, 7, 1], mut out)
    assert_eq(out, [7])
