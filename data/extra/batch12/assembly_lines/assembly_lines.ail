## Assembly lines: a car body passes six stations on one of two lines; moving to the other line
## costs transfer time, and a two-row table finds the quickest route and which line each step uses.

fn main()
    work := [[7, 9, 3, 4, 8, 4], [8, 5, 6, 4, 5, 7]]
    hop := [[2, 3, 1, 3, 4], [2, 1, 2, 2, 1]]
    enter := [2, 4]
    leave := [3, 2]
    n := work[0].len()
    mut best := [[enter[0] + work[0][0]], [enter[1] + work[1][0]]]
    mut came := [[0], [1]]
    for s in 1..n
        for line in 0..2
            other := 1 - line
            stay := best[line][s - 1] + work[line][s]
            cross := best[other][s - 1] + hop[other][s - 1] + work[line][s]
            if stay <= cross
                best[line].push(stay)
                came[line].push(line)
            else
                best[line].push(cross)
                came[line].push(other)
    a := best[0][n - 1] + leave[0]
    b := best[1][n - 1] + leave[1]
    mut cur := if a <= b then 0 else 1
    total := a.min(b)
    mut route := [cur]
    mut step := n - 1
    while step > 0
        cur = came[cur][step]
        route.push(cur)
        step -= 1
    route.reverse()
    print("line 1 times: {best[0]}")
    print("line 2 times: {best[1]}")
    steps := route.map(|l| l + 1).join(" ")
    print("stations use lines {steps}")
    print("finished in {total} minutes")

@test fn exit_choice()
    assert_eq((30 + 3).min(31 + 2), 33)
