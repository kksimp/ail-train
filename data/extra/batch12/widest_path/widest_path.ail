## Widest path: the route between data centres whose narrowest link is as wide as possible, by a
## Dijkstra-style search on a max-heap that keeps the best bottleneck width found for each site.

fn widest(n int, links List[List[int]], src int, mut prev List[int]) List[int]
    mut best := List[int]()
    for i in 0..n
        best.push(0)
    best[src] = 1000
    mut h := Heap[int](max_first: true)
    h.push(1000 * 100 + src)
    while v := h.pop()
        w := v / 100
        u := v % 100
        if w < best[u]
            continue
        for l in links
            mut other := -1
            if l[0] == u
                other = l[1]
            elif l[1] == u
                other = l[0]
            if other >= 0
                cand := w.min(l[2])
                if cand > best[other]
                    best[other] = cand
                    prev[other] = u
                    h.push(cand * 100 + other)
    best

fn main()
    sites := ["Oslo", "Paris", "Rome", "Sofia", "Turin", "Vienna"]
    links := [[0, 1, 40], [0, 2, 10], [1, 2, 25], [1, 3, 15], [2, 3, 30], [2, 4, 35], [3, 5, 20], [4, 5, 12], [1, 4, 18]]
    mut prev := [-1, -1, -1, -1, -1, -1]
    best := widest(sites.len(), links, 0, mut prev)
    for t in 1..sites.len()
        mut path := [sites[t]]
        mut u := t
        while prev[u] >= 0
            u = prev[u]
            path.push(sites[u])
        path.reverse()
        shown := path.join(" > ")
        print("{sites[t]:<7} {best[t]:>3} Gbps via {shown}")

@test fn single_link()
    mut prev := [-1, -1]
    assert_eq(widest(2, [[0, 1, 7]], 0, mut prev), [1000, 7])
