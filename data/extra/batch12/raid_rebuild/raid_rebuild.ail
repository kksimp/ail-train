## RAID rebuild: four data disks and a parity disk holding the XOR of each stripe; when one data
## disk dies, XOR of the survivors and the parity gives its bytes back, stripe by stripe.

fn xor_all(xs List[int]) int
    xs.fold(0, |acc, x| acc ^ x)

fn hex2(n int) str
    "{n:02x}"

fn main()
    disks := [[0x41, 0x6e, 0x20, 0x45], [0x62, 0x79, 0x74, 0x65], [0x7f, 0x00, 0x13, 0xc4], [0x99, 0x2a, 0x5e, 0x01]]
    stripes := disks[0].len()
    parity := [xor_all(disks.map(|d| d[s])) for s in 0..stripes]
    for i, d in disks.enumerate()
        row := d.map(|b| hex2(b)).join(" ")
        print("disk {i}:   {row}")
    prow := parity.map(|b| hex2(b)).join(" ")
    print("parity:   {prow}")
    lost := 2
    print("disk {lost} fails")
    mut rebuilt := List[int]()
    for s in 0..stripes
        mut others := [parity[s]]
        for i in 0..disks.len()
            if i != lost
                others.push(disks[i][s])
        rebuilt.push(xor_all(others))
    shown := rebuilt.map(|b| hex2(b)).join(" ")
    print("rebuilt:  {shown}")
    print("matches original: {rebuilt == disks[lost]}")

@test fn xor_back()
    p := xor_all([5, 9, 12])
    assert_eq(xor_all([p, 5, 12]), 9)
