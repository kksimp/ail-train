## Skyline clues: in a towers puzzle a clue says how many towers are seen from that edge, taller
## ones hiding shorter ones behind; this checks a filled 4x4 grid against all sixteen clues.

fn seen(line List[int]) int
    mut tallest := 0
    mut count := 0
    for h in line
        if h > tallest
            tallest = h
            count += 1
    count

fn main()
    grid := [[2, 1, 4, 3], [3, 4, 1, 2], [4, 2, 3, 1], [1, 3, 2, 4]]
    top := [3, 2, 1, 2]
    bottom := [2, 2, 3, 1]
    left := [2, 2, 1, 3]
    right := [2, 2, 3, 2]
    mut wrong := 0
    for i in 0..4
        col := grid.map(|row| row[i])
        checks := [("top", i, top[i], seen(col)), ("bottom", i, bottom[i], seen(col.reversed())), ("left", i, left[i], seen(grid[i])), ("right", i, right[i], seen(grid[i].reversed()))]
        for ch in checks
            side, idx, want, got := ch
            if want != got
                wrong += 1
                print("{side} clue {idx + 1}: wants {want}, sees {got}")
    for row in grid
        print(row.join(" "))
    print("{16 - wrong} of 16 clues satisfied")

@test fn visible()
    assert_eq(seen([1, 3, 2, 4]), 3)
