## Nesting boxes: the longest chain of gift boxes that fit strictly inside each other, by sorting
## on width (ties by height, largest first) and a longest-increasing-heights table with links back.

struct Box
    w int
    h int

fn main()
    boxes := [Box(w: 5, h: 4), Box(w: 6, h: 4), Box(w: 6, h: 7), Box(w: 2, h: 3), Box(w: 8, h: 9), Box(w: 3, h: 5), Box(w: 7, h: 8), Box(w: 4, h: 6), Box(w: 1, h: 1), Box(w: 9, h: 2)]
    bs := boxes.sorted(by: |b| (b.w, -b.h))
    n := bs.len()
    mut len_at := List[int]()
    mut back := List[int]()
    for i in 0..n
        len_at.push(1)
        back.push(-1)
        for j in 0..i
            if bs[j].w < bs[i].w and bs[j].h < bs[i].h and len_at[j] + 1 > len_at[i]
                len_at[i] = len_at[j] + 1
                back[i] = j
    mut end := 0
    for i in 0..n
        if len_at[i] > len_at[end]
            end = i
    mut chain := List[str]()
    mut k := end
    while k >= 0
        chain.push("{bs[k].w}x{bs[k].h}")
        k = back[k]
    shown := chain.join(" in ")
    codes := bs.map(|b| b.w * 10 + b.h)
    print("sorted: {codes}")
    print("longest chain has {len_at[end]} boxes")
    print(shown)

@test fn sort_key()
    bs := [Box(w: 2, h: 1), Box(w: 2, h: 5)].sorted(by: |b| (b.w, -b.h))
    assert_eq(bs[0].h, 5)
