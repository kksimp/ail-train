## Interpolation probe: looks up customer ids by guessing a position from where the id falls
## between the ends of the range; on evenly spread ids it needs far fewer probes than halving.

fn binary_probes(xs List[int], want int) List[int]
    mut lo := 0
    mut hi := xs.len() - 1
    mut probes := 0
    while lo <= hi
        mid := (lo + hi) / 2
        probes += 1
        if xs[mid] == want
            return [mid, probes]
        if xs[mid] < want
            lo = mid + 1
        else
            hi = mid - 1
    [-1, probes]

fn interp_probes(xs List[int], want int) List[int]
    mut lo := 0
    mut hi := xs.len() - 1
    mut probes := 0
    while lo <= hi and want >= xs[lo] and want <= xs[hi]
        mut pos := lo
        if xs[hi] != xs[lo]
            pos = lo + (want - xs[lo]) * (hi - lo) / (xs[hi] - xs[lo])
        probes += 1
        if xs[pos] == want
            return [pos, probes]
        if xs[pos] < want
            lo = pos + 1
        else
            hi = pos - 1
    [-1, probes]

fn main()
    mut seed := 7
    mut even := List[int]()
    for i in 0..500
        seed = (seed * 1103515245 + 12345) % 2147483648
        even.push(10000 + i * 40 + seed % 30)
    squares := [i * i for i in 1..=500]
    for want in [even[17], even[250], even[431], 25013]
        b := binary_probes(even, want)
        t := interp_probes(even, want)
        print("even ids, find {want}: at {b[0]}, halving {b[1]} probes, guessing {t[1]} probes")
    for want in [squares[3], squares[399]]
        b := binary_probes(squares, want)
        t := interp_probes(squares, want)
        print("square ids, find {want}: halving {b[1]} probes, guessing {t[1]} probes")

@test fn finds()
    assert_eq(interp_probes([10, 20, 30, 40], 30), [2, 1])
