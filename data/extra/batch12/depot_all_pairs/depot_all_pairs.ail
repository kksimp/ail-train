## Depot all pairs: Floyd-Warshall relaxes every pair of depots through each depot in turn,
## keeping a next-hop table so the fastest route between any two depots can be printed.

INF := 1000000

fn route(nxt List[List[int]], a int, b int, names List[str]) str
    mut parts := [names[a]]
    mut u := a
    while u != b
        u = nxt[u][b]
        parts.push(names[u])
    parts.join(" > ")

fn main()
    names := ["Ash", "Birch", "Cedar", "Dale", "Elm"]
    roads := [[0, 1, 7], [0, 2, 3], [2, 1, 2], [1, 3, 4], [2, 3, 9], [3, 4, 2], [2, 4, 12]]
    n := names.len()
    mut dist := List[List[int]]()
    mut nxt := List[List[int]]()
    for i in 0..n
        mut row := List[int]()
        mut hop := List[int]()
        for j in 0..n
            start := if i == j then 0 else INF
            row.push(start)
            hop.push(j)
        dist.push(row)
        nxt.push(hop)
    for r in roads
        dist[r[0]][r[1]] = r[2]
        dist[r[1]][r[0]] = r[2]
    for k in 0..n
        for i in 0..n
            for j in 0..n
                if dist[i][k] + dist[k][j] < dist[i][j]
                    dist[i][j] = dist[i][k] + dist[k][j]
                    nxt[i][j] = nxt[i][k]
    for i in 0..n
        cells := dist[i].map(|d| "{d:>4}").join("")
        print("{names[i]:<6}{cells}")
    print(route(nxt, 0, 4, names))
    print(route(nxt, 1, 4, names))
    print(route(nxt, 4, 0, names))

@test fn direct_hop()
    assert_eq(route([[0, 1], [0, 1]], 0, 1, ["a", "b"]), "a > b")
