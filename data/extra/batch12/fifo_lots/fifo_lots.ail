## FIFO lots: goods are bought in lots at different unit costs; each sale uses up the oldest lots
## first, so the cost of goods sold and the value of what is left follow first-in, first-out.

struct Lot
    qty int
    cost int

fn cents(c int) str
    "{c / 100}.{c % 100:02}"

fn sell(mut lots List[Lot], qty int) int
    mut need := qty
    mut total := 0
    while need > 0 and lots.len() > 0
        take := need.min(lots[0].qty)
        total += take * lots[0].cost
        lots[0].qty -= take
        need -= take
        if lots[0].qty == 0
            lots.remove_at(0)
    total

fn main()
    mut lots := List[Lot]()
    events := [("buy", 100, 250), ("buy", 50, 275), ("sell", 80, 400), ("buy", 120, 260), ("sell", 100, 420), ("sell", 60, 410)]
    mut profit := 0
    for e in events
        kind, qty, price := e
        if kind == "buy"
            lots.push(Lot(qty: qty, cost: price))
            print("buy  {qty:>3} at {cents(price)}")
        else
            cogs := sell(mut lots, qty)
            sales := qty * price
            profit += sales - cogs
            print("sell {qty:>3} at {cents(price)}: cost of goods {cents(cogs)}, margin {cents(sales - cogs)}")
    left := lots.map(|l| "{l.qty}@{cents(l.cost)}").join(", ")
    value := lots.fold(0, |acc, l| acc + l.qty * l.cost)
    print("left: {left} worth {cents(value)}")
    print("total margin {cents(profit)}")

@test fn spans_lots()
    mut lots := [Lot(qty: 2, cost: 100), Lot(qty: 5, cost: 300)]
    assert_eq(sell(mut lots, 3), 500)
