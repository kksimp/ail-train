## Best plot rectangle: the rectangle of farm cells with the largest total yield (gains and
## losses), by fixing a top and bottom row and running Kadane's maximum-run scan over column sums.

fn main()
    grid := [[2, -1, -4, 3, 1], [-3, 4, 2, -1, -2], [1, 3, -2, 5, -6], [-4, -1, 6, 2, 1], [3, -5, 1, -2, 4]]
    rows := grid.len()
    cols := grid[0].len()
    for r in grid
        print(r.map(|v| "{v:>3}").join(""))
    mut best := grid[0][0]
    mut box := [0, 0, 0, 0]
    for top in 0..rows
        mut sums := List[int]()
        for c in 0..cols
            sums.push(0)
        for bot in top..rows
            for c in 0..cols
                sums[c] += grid[bot][c]
            mut run := 0
            mut from := 0
            for c in 0..cols
                if run <= 0
                    run = sums[c]
                    from = c
                else
                    run += sums[c]
                if run > best
                    best = run
                    box = [top, from, bot, c]
    print("best total {best}")
    print("rows {box[0] + 1} to {box[2] + 1}, columns {box[1] + 1} to {box[3] + 1}")
    area := (box[2] - box[0] + 1) * (box[3] - box[1] + 1)
    print("{area} cells")

@test fn kadane_like()
    xs := [-2, 3, -1, 4, -5]
    mut run := 0
    mut best := xs[0]
    for x in xs
        run = if run <= 0 then x else run + x
        best = best.max(run)
    assert_eq(best, 6)
