## Venturi meter: Bernoulli's equation gives the flow from the pressure drop between pipe and throat,
## Q = A2 sqrt(2 dp / (rho (1 - (A2 / A1)^2))); four times the pressure drop only doubles the flow.

fn area(d float) float
    pi := 3.141592653589793
    pi * d * d / 4.0

fn flow(dp float, d1 float, d2 float, rho float) float
    a1 := area(d1)
    a2 := area(d2)
    beta := a2 / a1
    a2 * (2.0 * dp / (rho * (1.0 - beta * beta))).sqrt()

fn main()
    d1 := 0.1
    d2 := 0.05
    rho := 998.0
    print("pipe 100 mm, throat 50 mm, water")
    for dp in [500.0, 2000.0, 8000.0, 18000.0, 32000.0]
        q := flow(dp, d1, d2, rho)
        v := q / area(d2)
        litres := q * 1000.0
        print("dp {dp:>7.0} Pa: {litres:>6.2} L/s, throat speed {v:.2} m/s")
    ratio := flow(8000.0, d1, d2, rho) / flow(2000.0, d1, d2, rho)
    print("flow ratio for 4x the pressure drop: {ratio:.3}")

@test fn no_drop_no_flow()
    assert_eq(flow(0.0, 0.1, 0.05, 1000.0), 0.0)
