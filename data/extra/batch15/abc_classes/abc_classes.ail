## ABC analysis: items ranked by yearly usage value (units x unit cost); those making up the first 80% of
## the value are class A, the next 15% class B and the rest class C, so counting effort goes where money is.

struct Sku
    code str
    units int
    cost int

fn main()
    skus := [Sku(code: "BRG-10", units: 1200, cost: 450), Sku(code: "MTR-22", units: 85, cost: 21000), Sku(code: "SCR-04", units: 50000, cost: 3), Sku(code: "BLT-08", units: 9000, cost: 55), Sku(code: "PMP-31", units: 40, cost: 38000), Sku(code: "GSK-12", units: 6000, cost: 40), Sku(code: "VLV-17", units: 300, cost: 2900), Sku(code: "FLT-05", units: 2200, cost: 310), Sku(code: "WSH-01", units: 80000, cost: 1), Sku(code: "CPL-09", units: 700, cost: 640)]
    ranked := skus.sorted(by: |s| -(s.units * s.cost))
    grand := skus.fold(0, |acc, s| acc + s.units * s.cost)
    mut running := 0
    mut counts := {"A": 0, "B": 0, "C": 0}
    for s in ranked
        value := s.units * s.cost
        before := running * 100 / grand
        running += value
        cls := if before < 80 then "A" elif before < 95 then "B" else "C"
        counts[cls] += 1
        pct := running * 1000 / grand
        print("{s.code} {value:>9,} cumulative {pct / 10:>3}.{pct % 10}% class {cls}")
    for grade, n in counts
        print("class {grade}: {n} items")

@test fn value()
    s := Sku(code: "x", units: 3, cost: 7)
    assert_eq(s.units * s.cost, 21)
