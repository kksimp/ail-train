## Shelf bending: a shelf on two brackets under a uniform load w has moment M = w L^2 / 8 and peak
## stress M / Z with Z = b h^2 / 6; gives each board's stress for 900 mm of books and its longest safe span.

struct Board
    name str
    depth_mm float
    thick_mm float
    allow_mpa float

fn Board.modulus(self) float
    self.depth_mm * self.thick_mm * self.thick_mm / 6.0

fn Board.stress(self, w float, span float) float
    moment := w * span * span / 8.0
    moment / self.modulus()

fn Board.max_span(self, w float) float
    (8.0 * self.allow_mpa * self.modulus() / w).sqrt()

fn main()
    w := 0.36
    span := 900.0
    boards := [Board(name: "pine 18 mm", depth_mm: 250.0, thick_mm: 18.0, allow_mpa: 7.0), Board(name: "oak 20 mm", depth_mm: 250.0, thick_mm: 20.0, allow_mpa: 11.0), Board(name: "MDF 18 mm", depth_mm: 250.0, thick_mm: 18.0, allow_mpa: 4.0), Board(name: "chipboard 15 mm", depth_mm: 250.0, thick_mm: 15.0, allow_mpa: 3.0)]
    print("books at {w:.2} N/mm over {span:.0} mm")
    for b in boards
        s := b.stress(w, span)
        verdict := if s <= b.allow_mpa then "ok" else "too weak"
        print("{b.name:<16} {s:.2} MPa of {b.allow_mpa:.1} allowed: {verdict}, max span {b.max_span(w):.0} mm")

@test fn modulus()
    b := Board(name: "x", depth_mm: 6.0, thick_mm: 10.0, allow_mpa: 1.0)
    assert_eq(b.modulus(), 100.0)
