## Quantity discounts: with all-units price breaks, each tier's EOQ is computed at its own holding cost
## (25% of the price), raised to the tier's minimum if below it, and the tier with the lowest total cost wins.

struct Tier
    min_qty int
    price float

fn total_cost(demand float, setup float, q float, price float, rate float) float
    demand * price + demand * setup / q + rate * price * q / 2.0

fn main()
    demand := 5000.0
    setup := 60.0
    rate := 0.25
    tiers := [Tier(min_qty: 1, price: 5.0), Tier(min_qty: 500, price: 4.8), Tier(min_qty: 1500, price: 4.6), Tier(min_qty: 4000, price: 4.4)]
    mut best_q := 0.0
    mut best_cost := 1000000000.0
    for t in tiers
        e := (2.0 * demand * setup / (rate * t.price)).sqrt()
        q := if e < t.min_qty.to_float() then t.min_qty.to_float() else e
        c := total_cost(demand, setup, q, t.price, rate)
        note := if e < t.min_qty.to_float() then "raised to {t.min_qty}" else "EOQ fits"
        print("from {t.min_qty:>4} at {t.price:.2}: EOQ {e:>5.1}, order {q:>6.1} ({note}), yearly cost {c:.2}")
        if c < best_cost
            best_cost = c
            best_q = q
    print("order {best_q:.0} at a time for {best_cost:.2} a year")

@test fn purchase_part()
    assert_eq(total_cost(100.0, 0.0, 10.0, 2.0, 0.0), 200.0)
