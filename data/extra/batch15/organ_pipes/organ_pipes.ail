## Organ pipes: an open pipe sounds every harmonic, f = n v / (2 L), while a stopped pipe half as long
## gives the same fundamental with odd harmonics only, f = (2n - 1) v / (4 L); v = 331.3 + 0.606 T.

enum PipeKind
    Open
    Stopped

fn sound_speed(celsius float) float
    331.3 + 0.606 * celsius

fn harmonic(kind PipeKind, length float, n int, v float) float
    match kind
        Open => n.to_float() * v / (2.0 * length)
        Stopped => (2 * n - 1).to_float() * v / (4.0 * length)

fn main()
    v := sound_speed(20.0)
    print("speed of sound at 20 C: {v:.2} m/s")
    pipes := [(PipeKind.Open, 2.44), (PipeKind.Stopped, 1.22)]
    for p in pipes
        kind, length := p
        mut parts := List[str]()
        for n in 1..=4
            f := harmonic(kind, length, n, v)
            parts.push("{f:.1}")
        shown := parts.join(", ")
        print("{kind} {length:.2} m: {shown} Hz")
    for t in [10.0, 20.0, 30.0]
        f0 := harmonic(PipeKind.Open, 2.44, 1, sound_speed(t))
        print("open 2.44 m pipe at {t:.0} C: {f0:.2} Hz")

@test fn stopped_fundamental()
    assert_eq(harmonic(PipeKind.Stopped, 1.0, 1, 340.0), 85.0)
