## Receivables aging: unpaid invoices sorted into buckets by days past due (current, 1-30, 31-60, 61-90,
## over 90), with a bad-debt allowance of 1%, 3%, 10%, 25% and 50% of each bucket, all in cents.

struct Invoice
    customer str
    cents int
    due_day int

fn bucket(overdue int) int
    match overdue
        1..=30 => 1
        31..=60 => 2
        61..=90 => 3
        _ if overdue <= 0 => 0
        _ => 4

fn main()
    today := 200
    names := ["current", "1-30", "31-60", "61-90", "over 90"]
    allowance := [1, 3, 10, 25, 50]
    invoices := [Invoice(customer: "Abel", cents: 125000, due_day: 210), Invoice(customer: "Brook", cents: 48050, due_day: 188), Invoice(customer: "Cole", cents: 230000, due_day: 150), Invoice(customer: "Abel", cents: 61500, due_day: 131), Invoice(customer: "Dunn", cents: 15999, due_day: 95), Invoice(customer: "Brook", cents: 72000, due_day: 175), Invoice(customer: "Eve", cents: 38800, due_day: 60)]
    mut totals := [0, 0, 0, 0, 0]
    for inv in invoices
        totals[bucket(today - inv.due_day)] += inv.cents
    mut reserve := 0
    for i in 0..5
        r := totals[i] * allowance[i] / 100
        reserve += r
        print("{names[i]:<8} {totals[i] / 100:>6}.{totals[i] % 100:02}  allowance {r / 100:>5}.{r % 100:02}")
    owed := totals.sum()
    print("total {owed / 100}.{owed % 100:02}, allowance {reserve / 100}.{reserve % 100:02}")

@test fn buckets()
    assert_eq([bucket(-5), bucket(0), bucket(30), bucket(31), bucket(120)], [0, 0, 1, 2, 4])
