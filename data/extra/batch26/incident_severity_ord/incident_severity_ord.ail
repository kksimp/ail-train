## Incident queue: an empty `impl Ord` on the `Severity` enum orders variants as declared, and one on
## `Incident` orders by severity, then opening minute, then title, so `sorted()` gives the on-call order.

enum Severity
    Critical
    Major
    Minor

impl Ord for Severity

struct Incident
    sev Severity
    opened int
    title str

impl Ord for Incident

fn main()
    open := [
        Incident(sev: Severity.Minor, opened: 30, title: "typo on pricing page"),
        Incident(sev: Severity.Critical, opened: 55, title: "checkout down"),
        Incident(sev: Severity.Major, opened: 10, title: "slow search"),
        Incident(sev: Severity.Critical, opened: 20, title: "login errors"),
        Incident(sev: Severity.Minor, opened: 5, title: "broken footer link"),
        Incident(sev: Severity.Major, opened: 40, title: "emails delayed"),
    ]
    for i, inc in open.sorted().enumerate()
        print("{i + 1}. {inc.sev.name():<8} since minute {inc.opened:>2}: {inc.title}")
    for s in Severity.variants()
        n := open.count(|x| x.sev == s)
        print("{s.name()}: {n}")
    print("critical before minor: {Severity.Critical < Severity.Minor}")

@test fn enum_order()
    assert(Severity.Critical < Severity.Major)
