## Carrier quotes: a `Carrier` trait with a flat-rate, a per-started-kilo and a weight-band
## carrier in one `List[any Carrier]`; each parcel gets every quote and the cheapest carrier.

trait Carrier
    fn name(self) str
    fn quote(self, grams int) int
    fn line(self, grams int) str
        q := quote(grams)
        if q < 0
            return "{name()} n/a"
        "{name()} {q / 100}.{q % 100:02}"

struct Flat
    price int
    max_g int

struct PerKilo
    base int
    per_kg int

struct Banded
    limits List[int]
    prices List[int]

impl Carrier for Flat
    fn name(self) str
        "flat"
    fn quote(self, grams int) int
        if grams > max_g then -1 else price

impl Carrier for PerKilo
    fn name(self) str
        "per-kilo"
    fn quote(self, grams int) int
        base + per_kg * ((grams + 999) / 1000)

impl Carrier for Banded
    fn name(self) str
        "banded"
    fn quote(self, grams int) int
        for i in 0..limits.len()
            if grams <= limits[i]
                return prices[i]
        -1

fn main()
    mut carriers := List[any Carrier]()
    carriers.push(Flat(price: 890, max_g: 5000))
    carriers.push(PerKilo(base: 300, per_kg: 150))
    carriers.push(Banded(limits: [500, 2000, 10000], prices: [320, 760, 1490]))
    for g in [350, 1200, 4800, 9500, 12000]
        parts := [c.line(g) for c in carriers]
        offered := carriers.filter(|c| c.quote(g) >= 0)
        best := (offered.min(by: |c| c.quote(g)) else carriers[0]).name()
        joined := parts.join(" | ")
        print("{g:>5} g: {joined} -> {best}")

@test fn per_kilo_rounds_up()
    assert_eq(PerKilo(base: 300, per_kg: 150).quote(1001), 600)
