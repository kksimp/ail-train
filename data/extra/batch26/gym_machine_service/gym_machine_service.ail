## Gym machine service: a `Machine` trait with default `due` and `status` methods built on
## required ones; the rower overrides `due` to also count strokes, and the hall lists what needs service.

trait Machine
    fn tag(self) str
    fn hours(self) int
    fn every(self) int
    fn due(self) bool
        hours() >= every()
    fn status(self) str
        if due()
            return "{tag()}: service due at {hours()} h"
        "{tag()}: {every() - hours()} h to go"

struct Cardio
    kind str
    id str
    hrs int
    service_h int

struct Rower
    id str
    hrs int
    strokes int

impl Machine for Cardio
    fn tag(self) str
        "{kind} {id}"
    fn hours(self) int
        hrs
    fn every(self) int
        service_h

impl Machine for Rower
    fn tag(self) str
        "rower {id}"
    fn hours(self) int
        hrs
    fn every(self) int
        400
    fn due(self) bool
        hrs >= 400 or strokes >= 900000

fn main()
    mut hall := List[any Machine]()
    hall.push(Cardio(kind: "treadmill", id: "T1", hrs: 512, service_h: 500))
    hall.push(Cardio(kind: "treadmill", id: "T2", hrs: 230, service_h: 500))
    hall.push(Cardio(kind: "bike", id: "B1", hrs: 298, service_h: 300))
    hall.push(Rower(id: "R1", hrs: 120, strokes: 950000))
    hall.push(Rower(id: "R2", hrs: 390, strokes: 400000))
    for m in hall
        print(m.status())
    due := hall.count(|m| m.due())
    print("due now: {due} of {hall.len()}")
    if next_up := hall.filter(|m| not m.due()).min(by: |m| m.every() - m.hours())
        gap := next_up.every() - next_up.hours()
        print("next up: {next_up.tag()} in {gap} h")

@test fn strokes_make_rower_due()
    assert(Rower(id: "r", hrs: 10, strokes: 900000).due())
