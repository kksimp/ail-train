## Key cards: a hotel map from card number to room is changed by issue (`m[k] = v`) and revoke
## (`m.remove(k)`) events; door swipes check it with `get ... else`, and `push` groups live cards by room.

fn main()
    mut cards := Map[int, int]()
    events := [("issue", 501, 12), ("issue", 502, 14), ("issue", 503, 12), ("swipe", 502, 14), ("swipe", 503, 14), ("revoke", 501, 0), ("swipe", 501, 12), ("issue", 504, 15), ("swipe", 503, 12)]
    mut refused := 0
    for e in events
        kind, card, room := e
        if kind == "issue"
            cards[card] = room
            print("card {card} issued for room {room}")
        elif kind == "revoke"
            cards.remove(card)
            print("card {card} revoked")
        else
            opens := cards.get(card) else -1
            if opens == room
                print("card {card} opens room {room}")
            else
                refused += 1
                why := if opens < 0 then "unknown card" else "card is for room {opens}"
                print("card {card} refused at room {room}: {why}")
    mut by_room := Map[int, List[int]]()
    for card, room in cards
        by_room.push(room, card)
    for room in by_room.keys().sorted()
        print("room {room}: cards {by_room[room]}")
    print("{refused} refused swipes")

@test fn remove_key()
    mut m := {1: 2}
    m.remove(1)
    assert(not m.contains(1))
