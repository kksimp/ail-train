## Association pairs: a generic `Assoc[K, V]` keeps keys and values in two parallel lists and finds
## a key by `==` alone (no hashing); a travel adapter list and a room register share the one type.

struct Assoc[K, V]
    keys List[K]
    vals List[V]

fn Assoc.empty() Self
    Assoc(keys: [], vals: [])

fn Assoc[K Eq, V].put(mut self, k K, v V)
    for i in 0..self.keys.len()
        if self.keys[i] == k
            self.vals[i] = v
            return
    self.keys.push(k)
    self.vals.push(v)

fn Assoc[K Eq, V].get(self, k K) V?
    for i in 0..self.keys.len()
        if self.keys[i] == k
            return self.vals[i]
    none

fn main()
    mut plugs := Assoc[str, char].empty()
    plugs.put("UK", 'G')
    plugs.put("DE", 'F')
    plugs.put("US", 'A')
    plugs.put("IT", 'L')
    plugs.put("US", 'B')
    for country in ["UK", "DE", "JP", "US"]
        p := plugs.get(country) else '?'
        print("{country}: plug type {p}")
    print("{plugs.keys.len()} countries known")
    mut rooms := Assoc[int, str].empty()
    rooms.put(101, "Osei")
    rooms.put(102, "Lind")
    rooms.put(101, "Park")
    for r in [101, 102, 103]
        who := rooms.get(r) else "empty"
        print("room {r}: {who}")

@test fn put_replaces()
    mut a := Assoc[int, int].empty()
    a.put(1, 5)
    a.put(1, 7)
    assert_eq(a.get(1) else 0, 7)
