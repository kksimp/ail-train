## Tip jar: each shift's tips are added to one `Mutex` in a loop with `with jar as mut x`,
## which holds the lock for the read-modify-write; the total is then split evenly with the rest kept.

fn main()
    shifts := [[250, 100, 500], [0, 300], [125, 125, 125, 125], [1000]]
    jar := Mutex(0)
    for i in 0..shifts.len()
        with jar as mut x
            x += shifts[i].sum()
    for i, s in shifts.enumerate()
        print("shift {i + 1}: {s.len()} tips, {s.sum()}")
    total := jar.get()
    staff := ["Ana", "Ravi", "Joss"]
    share := total / staff.len()
    kept := total % staff.len()
    print("jar holds {total}")
    for name in staff
        print("{name} gets {share}")
    print("{kept} stays in the jar for next week")

@test fn with_updates()
    m := Mutex(1)
    with m as mut x
        x += 2
    assert_eq(m.get(), 3)
