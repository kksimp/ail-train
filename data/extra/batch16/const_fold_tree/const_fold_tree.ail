## Constant folding: an expression tree kept in a node list is simplified bottom up, computing
## subtrees whose leaves are all numbers and applying x*0, x*1 and x+0 rules around variables.

struct Node
    op str
    val int
    l int
    r int

struct Folded
    known bool
    val int
    text str

fn add_node(mut t List[Node], op str, val int, l int, r int) int
    t.push(Node(op: op, val: val, l: l, r: r))
    t.len() - 1

fn show(t List[Node], i int) str
    n := t[i]
    if n.op == "num"
        return "{n.val}"
    if n.l < 0
        return n.op
    a := show(t, n.l)
    b := show(t, n.r)
    "({a} {n.op} {b})"

fn leaf(f Folded) str
    if f.known then "{f.val}" else f.text

fn konst(v int) Folded
    Folded(known: true, val: v, text: "")

fn fold(t List[Node], i int) Folded
    n := t[i]
    if n.op == "num"
        return konst(n.val)
    if n.l < 0
        return Folded(known: false, val: 0, text: n.op)
    a := fold(t, n.l)
    b := fold(t, n.r)
    if a.known and b.known
        v := if n.op == "+" then a.val + b.val else a.val * b.val
        return konst(v)
    if n.op == "*" and ((a.known and a.val == 0) or (b.known and b.val == 0))
        return konst(0)
    one := if n.op == "*" then 1 else 0
    if a.known and a.val == one
        return b
    if b.known and b.val == one
        return a
    sa := leaf(a)
    sb := leaf(b)
    Folded(known: false, val: 0, text: "({sa} {n.op} {sb})")

fn main()
    mut t := List[Node]()
    x := add_node(mut t, "x", 0, -1, -1)
    y := add_node(mut t, "y", 0, -1, -1)
    n2 := add_node(mut t, "num", 2, -1, -1)
    n3 := add_node(mut t, "num", 3, -1, -1)
    n0 := add_node(mut t, "num", 0, -1, -1)
    n1 := add_node(mut t, "num", 1, -1, -1)
    m6 := add_node(mut t, "*", 0, n2, n3)
    e1 := add_node(mut t, "+", 0, m6, x)
    p1 := add_node(mut t, "+", 0, n1, n0)
    e2 := add_node(mut t, "*", 0, x, p1)
    s4 := add_node(mut t, "+", 0, n2, n2)
    y4 := add_node(mut t, "*", 0, y, s4)
    x0 := add_node(mut t, "+", 0, x, n0)
    e3 := add_node(mut t, "*", 0, x0, y4)
    z := add_node(mut t, "*", 0, n0, n3)
    yz := add_node(mut t, "+", 0, y, m6)
    e4 := add_node(mut t, "*", 0, yz, z)
    for e in [e1, e2, e3, e4]
        before := show(t, e)
        after := leaf(fold(t, e))
        print("{before:<26} => {after}")
    print("nodes in pool: {t.len()}")

@test fn folds_numbers()
    mut t := List[Node]()
    a := add_node(mut t, "num", 4, -1, -1)
    b := add_node(mut t, "num", 5, -1, -1)
    c := add_node(mut t, "*", 0, a, b)
    assert_eq(fold(t, c).val, 20)
