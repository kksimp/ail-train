## File system check: block ownership is rebuilt from every inode's block list and compared with the
## free-space bitmap, finding blocks claimed twice, owned blocks marked free and leaked blocks marked used.

fn main()
    inodes := {1: [2, 3, 4], 2: [5, 6, 4], 3: [10, 11], 4: List[int](), 5: [14, 15, 16]}
    marked := [0, 1, 2, 3, 5, 6, 10, 12, 13, 14, 15, 16]
    reserved := [0, 1]
    mut owner := Map[int, int]()
    mut problems := 0
    for ino, blocks in inodes
        for b in blocks
            if first := owner.get(b)
                print("block {b:>2}: claimed by inode {first} and inode {ino} (needs a copy)")
                problems += 1
            else
                owner[b] = ino
    mut fixed := marked
    for b in owner.keys().sorted()
        if not marked.contains(b)
            print("block {b:>2}: owned by inode {owner[b]} but marked free, marking used")
            fixed.push(b)
            problems += 1
    for b in marked
        if not owner.contains(b) and not reserved.contains(b)
            print("block {b:>2}: marked used but owned by no inode, freeing")
            fixed = fixed.filter(|x| x != b)
            problems += 1
    print("{problems} problems; bitmap now {fixed.sorted()}")

@test fn filter_frees()
    assert_eq([1, 2, 3].filter(|x| x != 2), [1, 3])
