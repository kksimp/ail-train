## Register colouring: Chaitin-style allocation simplifies the interference graph by removing
## variables with fewer than k neighbours, marks a spill candidate when stuck, then colours in reverse.

fn degree(adj List[List[bool]], removed List[bool], v int) int
    mut d := 0
    for u in 0..adj.len()
        if adj[v][u] and not removed[u]
            d += 1
    d

fn filled(n int, v int) List[int]
    mut xs := List[int]()
    for i in 0..n
        xs.push(v)
    xs

fn main()
    names := ["a", "b", "c", "d", "e", "f", "g"]
    edges := [[0, 1], [0, 2], [0, 3], [1, 2], [1, 3], [2, 3], [3, 4], [4, 5], [5, 6], [4, 6], [2, 4]]
    n := names.len()
    k := 3
    mut adj := List[List[bool]]()
    mut removed := List[bool]()
    for i in 0..n
        mut row := List[bool]()
        for j in 0..n
            row.push(false)
        adj.push(row)
        removed.push(false)
    for e in edges
        adj[e[0]][e[1]] = true
        adj[e[1]][e[0]] = true
    mut stack := List[int]()
    while stack.len() < n
        mut pick := -1
        for i in 0..n
            if not removed[i] and degree(adj, removed, i) < k
                pick = i
                break
        if pick < 0
            for i in 0..n
                if not removed[i] and (pick < 0 or degree(adj, removed, i) > degree(adj, removed, pick))
                    pick = i
            print("stuck: {names[pick]} is a spill candidate")
        removed[pick] = true
        stack.push(pick)
    mut colour := filled(n, -1)
    while v := stack.pop()
        mut used := Set[int]()
        for u in 0..n
            if adj[v][u] and colour[u] >= 0
                used.add(colour[u])
        mut c := 0
        while used.contains(c)
            c += 1
        if c < k
            colour[v] = c
            print("{names[v]} -> r{c}")
        else
            print("{names[v]} -> spilled to memory")

@test fn counts_neighbours()
    adj := [[false, true, true], [true, false, false], [true, false, false]]
    assert_eq(degree(adj, [false, false, true], 0), 1)
