## Rank and select on a bit vector: a count of ones is stored before every 8-bit block, so rank needs
## one table lookup plus a short in-block count, and select binary-searches positions using rank.

fn rank(bits List[int], blocks List[int], i int) int
    mut r := blocks[i / 8]
    for k in (i / 8 * 8)..i
        r += bits[k]
    r

fn select1(bits List[int], blocks List[int], k int) int
    mut lo := 0
    mut hi := bits.len()
    while lo < hi
        mid := (lo + hi) / 2
        if rank(bits, blocks, mid + 1) < k
            lo = mid + 1
        else
            hi = mid
    lo

fn main()
    text := "101100111000101101101111000010100011101111011001"
    bits := text.chars().map(|c| c.to_digit(10) else 0)
    mut blocks := [0]
    for b in 0..(bits.len() / 8)
        prev := blocks[b]
        blocks.push(prev + bits.slice(b * 8, b * 8 + 8).sum())
    print("{bits.len()} bits, block counts {blocks}")
    for i in [0, 5, 8, 21, 33, 48]
        brute := bits.slice(0, i).sum()
        print("rank({i:>2}) = {rank(bits, blocks, i):>2} ones before it (scan {brute})")
    for k in [1, 7, 15, 26]
        pos := select1(bits, blocks, k)
        print("select1({k:>2}) = position {pos:>2}, bit there is {bits[pos]}")

@test fn rank_zero()
    assert_eq(rank([1, 1], [0, 2], 0), 0)
