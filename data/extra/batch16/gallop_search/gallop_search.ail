## Galloping search: probes positions 1, 2, 4, 8 ... and stops at the first one past the target, then binary searches
## the last gap; targets near the front take few comparisons, unlike a plain binary search.

fn binary(xs List[int], target int, lo0 int, hi0 int, mut probes List[int]) int
    mut lo := lo0
    mut hi := hi0
    while lo < hi
        mid := (lo + hi) / 2
        probes[0] += 1
        if xs[mid] < target
            lo = mid + 1
        else
            hi = mid
    lo

fn gallop(xs List[int], target int, mut probes List[int]) int
    mut bound := 1
    while bound < xs.len()
        probes[0] += 1
        if xs[bound] >= target
            break
        bound *= 2
    binary(xs, target, bound / 2, bound.min(xs.len()), mut probes)

fn main()
    xs := [i * 3 + 1 for i in 0..200]
    for t in [4, 10, 25, 301, 598, 1000]
        mut g := [0]
        mut b := [0]
        at := gallop(xs, t, mut g)
        at2 := binary(xs, t, 0, xs.len(), mut b)
        found := if at < xs.len() and xs[at] == t then "found" else "absent"
        same := at == at2
        print("target {t:>4}: index {at:>3} {found:<6} gallop {g[0]:>2} probes, binary {b[0]:>2} (same index {same})")

@test fn finds_first()
    mut p := [0]
    assert_eq(gallop([1, 3, 5, 7], 5, mut p), 2)
