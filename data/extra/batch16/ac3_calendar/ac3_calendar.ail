## Arc consistency for a calendar: meetings take hours 9 to 13 under before/after and not-same-hour
## rules; AC-3 deletes any hour with no compatible hour in a related meeting, repeating while domains shrink.

fn allowed(kind str, x int, y int) bool
    if kind == "lt" then x < y elif kind == "gt" then x > y else x != y

fn flip(kind str) str
    if kind == "lt" then "gt" elif kind == "gt" then "lt" else "ne"

fn main()
    names := ["kickoff", "design", "review", "retro", "demo"]
    mut doms := [[9, 10, 11], [9, 10, 11, 12, 13], [9, 10, 11, 12, 13], [12, 13], [11, 12, 13]]
    rules := [[0, 1, 0], [1, 2, 0], [2, 4, 0], [2, 3, 1], [3, 4, 1]]
    mut arcs := List[List[int]]()
    for r in rules
        arcs.push([r[0], r[1], r[2], 0])
        arcs.push([r[1], r[0], r[2], 1])
    mut queue := arcs
    mut removed := 0
    while not queue.is_empty()
        arc := queue[0]
        queue = queue.slice(1)
        base := if arc[2] == 0 then "lt" else "ne"
        kind := if arc[3] == 1 then flip(base) else base
        x := arc[0]
        y := arc[1]
        keep := doms[x].filter(|a| doms[y].any(|b| allowed(kind, a, b)))
        if keep.len() < doms[x].len()
            removed += doms[x].len() - keep.len()
            print("{names[x]:<7} loses {doms[x].len() - keep.len()} hour(s) because of {names[y]}: now {keep}")
            doms[x] = keep
            for other in arcs
                if other[1] == x and other[0] != y
                    queue.push(other)
    print("{removed} hours removed")
    for i in 0..names.len()
        print("{names[i]:<7} {doms[i]}")

@test fn flips()
    assert_eq(flip("lt"), "gt")
    assert(allowed("ne", 9, 10))
