## Point quadtree: a square splits into four quarters once it holds more than two points, so dense
## areas get small cells; a rectangle count only opens cells that overlap it.

struct Quad
    x int
    y int
    size int
    pts List[int]
    kids List[int]

fn insert(mut pool List[Quad], node int, p int, xs List[int], ys List[int])
    if pool[node].kids.is_empty()
        if pool[node].pts.len() < 2 or pool[node].size == 1
            pool[node].pts.push(p)
            return
        h2 := pool[node].size / 2
        for k in 0..4
            pool.push(Quad(x: pool[node].x + (k % 2) * h2, y: pool[node].y + (k / 2) * h2, size: h2, pts: [], kids: []))
            pool[node].kids.push(pool.len() - 1)
        old := pool[node].pts
        pool[node].pts = List[int]()
        for moved in old
            insert(mut pool, node, moved, xs, ys)
    q := pool[node]
    half := q.size / 2
    kx := if xs[p] >= q.x + half then 1 else 0
    ky := if ys[p] >= q.y + half then 1 else 0
    insert(mut pool, q.kids[ky * 2 + kx], p, xs, ys)

fn count(pool List[Quad], node int, r List[int], mut opened List[int]) int
    q := pool[node]
    if q.x >= r[2] or q.x + q.size <= r[0] or q.y >= r[3] or q.y + q.size <= r[1]
        return 0
    opened[0] += 1
    if q.kids.is_empty()
        return q.pts.len()
    mut total := 0
    for k in q.kids
        total += count(pool, k, r, mut opened)
    total

fn main()
    xs := [3, 5, 6, 7, 40, 41, 50, 60, 10, 12, 33, 34, 35, 36, 2, 58]
    ys := [4, 6, 5, 7, 40, 44, 10, 60, 50, 52, 33, 35, 34, 36, 60, 2]
    mut pool := [Quad(x: 0, y: 0, size: 64, pts: [], kids: [])]
    for p in 0..xs.len()
        insert(mut pool, 0, p, xs, ys)
    leaves := pool.filter(|q| q.kids.is_empty())
    smallest := leaves.fold(64, |acc, q| acc.min(q.size))
    print("{xs.len()} points, {pool.len()} cells, {leaves.len()} leaves, smallest cell {smallest}")
    for r in [[0, 0, 16, 16], [32, 32, 48, 48], [0, 32, 64, 64], [20, 0, 30, 30]]
        mut opened := [0]
        got := count(pool, 0, r, mut opened)
        mut brute := 0
        for p in 0..xs.len()
            if xs[p] >= r[0] and xs[p] < r[2] and ys[p] >= r[1] and ys[p] < r[3]
                brute += 1
        print("box {r}: {got} points (check {brute}), opened {opened[0]} of {pool.len()} cells")

@test fn single_point()
    mut pool := [Quad(x: 0, y: 0, size: 8, pts: [], kids: [])]
    insert(mut pool, 0, 0, [1], [1])
    assert_eq(pool[0].pts, [0])
