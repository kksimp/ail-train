## Circuit breaker: three failures in a row open the circuit, so calls fail fast for 30 seconds;
## then one trial call is let through half-open, closing the circuit on success or reopening it on failure.

enum State
    Closed
    Open(at int)
    HalfOpen

struct Breaker
    state State
    fails int

fn label(s State) str
    match s
        Closed => "closed"
        Open(at) => "open, retry at {at}"
        HalfOpen => "half-open"

fn reopen_at(s State) int
    match s
        Open(at) => at
        _ => -1

fn Breaker.call(mut self, t int, ok bool) str
    u := reopen_at(self.state)
    if u >= 0
        if t < u
            return "rejected without calling"
        self.state = State.HalfOpen
    if self.state == State.HalfOpen
        if ok
            self.state = State.Closed
            self.fails = 0
            return "trial succeeded"
        self.state = State.Open(at: t + 30)
        return "trial failed"
    if ok
        self.fails = 0
        return "ok"
    self.fails += 1
    if self.fails >= 3
        self.state = State.Open(at: t + 30)
        return "failed, tripping"
    "failed ({self.fails} in a row)"

fn main()
    calls := [(0, true), (5, false), (8, false), (9, false), (12, true), (20, true), (42, false), (45, true), (80, true), (85, false), (86, false), (87, false), (130, true), (131, true)]
    mut b := Breaker(state: State.Closed, fails: 0)
    for t, ok in calls
        what := b.call(t, ok)
        print("t={t:>3}: {what:<25} now {label(b.state)}")

@test fn trips_after_three()
    mut b := Breaker(state: State.Closed, fails: 0)
    assert_eq(b.call(0, false), "failed (1 in a row)")
    assert_eq(b.call(1, false), "failed (2 in a row)")
    assert_eq(b.call(2, false), "failed, tripping")
