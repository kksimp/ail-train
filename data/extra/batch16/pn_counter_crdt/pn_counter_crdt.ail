## PN counter: seat bookings and cancellations on three replicas are kept as two grow-only vectors,
## plus and minus; merging slot-wise maxima of both gives the right total, unlike merging the net counts.

struct Pn
    me int
    plus List[int]
    minus List[int]

fn Pn.add(mut self, n int)
    if n >= 0
        self.plus[self.me] += n
    else
        self.minus[self.me] += 0 - n

fn Pn.merge(mut self, o Pn)
    for i in 0..3
        self.plus[i] = self.plus[i].max(o.plus[i])
        self.minus[i] = self.minus[i].max(o.minus[i])

fn Pn.value(self) int
    self.plus.sum() - self.minus.sum()

fn main()
    mut reps := [Pn(me: 0, plus: [0, 0, 0], minus: [0, 0, 0]), Pn(me: 1, plus: [0, 0, 0], minus: [0, 0, 0]), Pn(me: 2, plus: [0, 0, 0], minus: [0, 0, 0])]
    ops := [(0, 4), (1, 3), (0, -1), (2, 6), (1, -2), (2, -1), (0, 2)]
    for r, n in ops
        mut cur := reps[r]
        cur.add(n)
        reps[r] = cur
    local := reps.map(|p| p.value())
    print("local values {local}")
    naive := local.max() else 0
    for i in 0..3
        for j in 0..3
            if i != j
                mut mine := reps[i]
                mine.merge(reps[j])
                reps[i] = mine
    for p in reps
        print("replica {p.me}: plus {p.plus} minus {p.minus} = {p.value()}")
    print("merging net counts by max would give {naive}, true total {reps[0].value()}")

@test fn negative_goes_to_minus()
    mut p := Pn(me: 1, plus: [0, 0, 0], minus: [0, 0, 0])
    p.add(-3)
    assert_eq(p.minus, [0, 3, 0])
