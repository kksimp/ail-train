## Lottery scheduling: each process holds tickets and every time slice goes to the holder of a ticket
## drawn by a seeded generator, so shares follow the ticket counts on average without strict order.

fn main()
    names := ["A", "B", "C"]
    tickets := [100, 50, 25]
    total := tickets.sum()
    mut seed := 2026
    mut wins := [0, 0, 0]
    mut timeline := List[str]()
    quanta := 70
    for q in 0..quanta
        seed = (seed * 1103515245 + 12345) % 2147483648
        draw := (seed / 65536) % total
        mut acc := 0
        mut winner := 0
        for i in 0..3
            acc += tickets[i]
            if draw < acc
                winner = i
                break
        wins[winner] += 1
        timeline.push(names[winner])
    for row in timeline.chunks(35)
        print(row.join(""))
    for i in 0..3
        expected := quanta * tickets[i] / total
        print("{names[i]}: {tickets[i]:>3} tickets, won {wins[i]:>2} slices, expected {expected}")

@test fn ticket_total()
    assert_eq([100, 50, 25].sum(), 175)
