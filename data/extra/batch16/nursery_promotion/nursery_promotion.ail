## Generational collection: objects start in a nursery that is collected after every four
## allocations; a survivor ages by one, and one that survives two minor collections moves to the old space.

struct Obj
    id int
    dies int
    age int

fn main()
    lifetimes := [1, 2, 30, 1, 3, 1, 50, 2, 1, 9, 1, 1, 40, 2, 1, 6]
    mut nursery := List[Obj]()
    mut old := List[Obj]()
    mut copied := 0
    for t in 0..lifetimes.len()
        nursery.push(Obj(id: t, dies: t + lifetimes[t], age: 0))
        now := t + 1
        if now % 4 == 0
            mut keep := List[Obj]()
            mut dead := 0
            mut promoted := List[int]()
            for o in nursery
                if o.dies <= now
                    dead += 1
                elif o.age + 1 >= 2
                    old.push(Obj(id: o.id, dies: o.dies, age: o.age + 1))
                    promoted.push(o.id)
                else
                    keep.push(Obj(id: o.id, dies: o.dies, age: o.age + 1))
                    copied += 1
            nursery = keep
            print("minor gc at {now:>2}: freed {dead}, kept {keep.len()}, promoted {promoted}")
    end := lifetimes.len() + 20
    live_old := old.filter(|o| o.dies > end)
    print("old space before major gc: {old.len()}")
    print("major gc at {end}: {live_old.len()} live")
    print("nursery copies made: {copied}")

@test fn age_two_promotes()
    o := Obj(id: 1, dies: 99, age: 1)
    assert(o.age + 1 >= 2)
