## Dead store removal: one backward pass over straight-line code keeps a set of live variables;
## an assignment to a variable that is not live is dropped, otherwise its operands become live.

struct Stmt
    dst str
    args List[str]

fn render(s Stmt) str
    rhs := s.args.join(" + ")
    "{s.dst} = {rhs}"

fn sweep(code List[Stmt], results List[str]) List[bool]
    mut live := Map[str, bool]()
    for r in results
        live[r] = true
    mut keep := List[bool]()
    for s in code
        keep.push(false)
    mut i := code.len() - 1
    while i >= 0
        s := code[i]
        if live.get_or(s.dst, false)
            keep[i] = true
            live[s.dst] = false
            for a in s.args
                live[a] = true
        i -= 1
    keep

fn main()
    code := [Stmt(dst: "a", args: ["x", "y"]), Stmt(dst: "b", args: ["a", "a"]), Stmt(dst: "t", args: ["x", "x"]), Stmt(dst: "a", args: ["b", "z"]), Stmt(dst: "u", args: ["t", "y"]), Stmt(dst: "c", args: ["a", "b"]), Stmt(dst: "t", args: ["c", "y"])]
    keep := sweep(code, ["c"])
    mut kept := 0
    for i in 0..code.len()
        mark := if keep[i] then "keep" else "drop"
        print("{mark}  {render(code[i])}")
        if keep[i]
            kept += 1
    print("{kept} of {code.len()} statements kept")

@test fn unused_dropped()
    code := [Stmt(dst: "a", args: ["x"]), Stmt(dst: "b", args: ["x"])]
    assert_eq(sweep(code, ["b"]), [false, true])
