## Set diameter by rotating calipers: the convex hull is built by the monotone chain, then for each hull
## edge the farthest hull vertex is advanced around the hull, giving the farthest pair in linear time.

fn cross(o List[int], a List[int], b List[int]) int
    (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])

fn d2(a List[int], b List[int]) int
    (a[0] - b[0]) * (a[0] - b[0]) + (a[1] - b[1]) * (a[1] - b[1])

fn hull(pts List[List[int]]) List[List[int]]
    ps := pts.sorted(by: |p| (p[0], p[1]))
    mut lower := List[List[int]]()
    for p in ps
        while lower.len() >= 2 and cross(lower[lower.len() - 2], lower[lower.len() - 1], p) <= 0
            lower = lower.slice(0, lower.len() - 1)
        lower.push(p)
    mut upper := List[List[int]]()
    for p in ps.reversed()
        while upper.len() >= 2 and cross(upper[upper.len() - 2], upper[upper.len() - 1], p) <= 0
            upper = upper.slice(0, upper.len() - 1)
        upper.push(p)
    mut h := lower.slice(0, lower.len() - 1)
    h.extend(upper.slice(0, upper.len() - 1))
    h

fn main()
    pts := [[0, 0], [7, 2], [3, 9], [10, 10], [12, 4], [5, 5], [2, 3], [9, 1], [1, 7], [6, 12], [11, 8], [4, 2]]
    h := hull(pts)
    n := h.len()
    print("hull: {h}")
    mut best := 0
    mut pair := [0, 0]
    mut j := 1
    mut steps := 0
    for i in 0..n
        k := (i + 1) % n
        while cross(h[i], h[k], h[(j + 1) % n]).abs() > cross(h[i], h[k], h[j]).abs()
            j = (j + 1) % n
            steps += 1
        for cand in [i, k]
            if d2(h[cand], h[j]) > best
                best = d2(h[cand], h[j])
                pair = [cand, j]
    mut brute := 0
    for a in pts
        for b in pts
            brute = brute.max(d2(a, b))
    dist := best.to_float().sqrt()
    print("farthest pair {h[pair[0]]} and {h[pair[1]]}, squared distance {best}, distance {dist:.3}")
    print("calipers moved {steps} times; all {pts.len() * pts.len()} pairs give {brute}")

@test fn squared()
    assert_eq(d2([0, 0], [3, 4]), 25)
