## GCRA limiter: the generic cell rate algorithm keeps one number, the theoretical arrival time;
## a request is allowed unless it comes earlier than that time minus the burst tolerance.

struct Gcra
    interval int
    tolerance int
    tat int

fn Gcra.check(mut self, t int) int
    allowed_at := self.tat - self.tolerance
    if t < allowed_at
        return allowed_at - t
    self.tat = self.tat.max(t) + self.interval
    0

fn main()
    mut g := Gcra(interval: 10, tolerance: 25, tat: 0)
    times := [0, 1, 2, 3, 4, 20, 25, 40, 41, 42, 90, 91, 92, 93, 94]
    mut ok := 0
    for t in times
        wait := g.check(t)
        if wait == 0
            ok += 1
            print("t={t:>3} allowed, next theoretical arrival {g.tat}")
        else
            print("t={t:>3} limited, retry in {wait}")
    print("allowed {ok} of {times.len()}")

@test fn burst_of_three()
    mut g := Gcra(interval: 10, tolerance: 20, tat: 0)
    assert_eq(g.check(0), 0)
    assert_eq(g.check(0), 0)
    assert_eq(g.check(0), 0)
    assert_eq(g.check(0), 10)
