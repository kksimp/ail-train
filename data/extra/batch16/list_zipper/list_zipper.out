start      [] <intro> [rain drift pulse outro]
next       [intro] <rain> [drift pulse outro]
next       [intro rain] <drift> [pulse outro]
insert     [intro rain drift] <echo> [pulse outro]
prev       [intro rain] <drift> [echo pulse outro]
delete     [intro rain] <echo> [pulse outro]
next       [intro rain echo] <pulse> [outro]
next       [intro rain echo pulse] <outro> []
next       [intro rain echo pulse] <outro> []
delete     [intro rain echo] <pulse> []
