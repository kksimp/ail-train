## Bezout and inverses: the extended Euclidean algorithm writes gcd(a, b) as a*x + b*y, and when
## the gcd is 1 the x is the inverse of a modulo b; numbers sharing a factor with b have none.

fn ext_gcd(a int, b int) List[int]
    if b == 0
        return [a, 1, 0]
    r := ext_gcd(b, a % b)
    [r[0], r[2], r[1] - (a / b) * r[2]]

fn inverse(a int, m int) int ! str
    g := ext_gcd(a, m)
    if g[0] != 1
        return "{a} has no inverse mod {m} (gcd {g[0]})"
    ((g[1] % m) + m) % m

fn main()
    for pair in [[240, 46], [35, 64], [1001, 77], [99, 78]]
        a := pair[0]
        b := pair[1]
        g := ext_gcd(a, b)
        print("{a}*{g[1]} + {b}*{g[2]} = {g[0]}")
    mut row := List[int]()
    for a in 1..11
        row.push(inverse(a, 11) else 0)
    print("inverses mod 11 of 1..10: {row}")
    for a in [3, 4, 7, 13, 15]
        if v := inverse(a, 26)
            print("{a} * {v} = {a * v} = 1 mod 26")
        else err
            print(err)

@test fn small()
    v := inverse(3, 7) else 0
    assert_eq(v, 5)
