## Lucky numbers: start from the odd numbers, then repeatedly strike out every k-th survivor
## where k is the next survivor not yet used (3, 7, 9, ...); a sieve like Eratosthenes' but by position.

fn lucky(limit int) List[int]
    mut xs := [n for n in 1..=limit if n % 2 == 1]
    mut i := 1
    while i < xs.len() and xs[i] <= xs.len()
        k := xs[i]
        mut kept := List[int]()
        for j, v in xs.enumerate()
            if (j + 1) % k != 0
                kept.push(v)
        xs = kept
        i += 1
    xs

fn is_prime(n int) bool
    if n < 2
        return false
    mut d := 2
    while d * d <= n
        if n % d == 0
            return false
        d += 1
    true

fn main()
    small := lucky(200)
    print("lucky numbers to 200: {small}")
    big := lucky(10000)
    primes := [n for n in 2..=10000 if is_prime(n)]
    both := big.filter(is_prime)
    print("below 10000: {big.len()} lucky, {primes.len()} prime, {both.len()} both")
    print("first lucky primes: {both.take(10)}")
    twins := [i for i in 1..big.len() if big[i] - big[i - 1] == 2].len()
    print("lucky pairs two apart: {twins}")

@test fn start()
    assert_eq(lucky(25), [1, 3, 7, 9, 13, 15, 21, 25])
