## Rectangle union: compresses the distinct x and y edges into a small grid of cells, marks each
## cell by how many rectangles cover it, and sums the area covered once, twice and at least once.

fn main()
    rects := [[1, 1, 6, 4], [3, 2, 9, 7], [5, 0, 8, 3], [2, 5, 4, 9], [7, 6, 10, 8]]
    mut xset := Set[int]()
    mut yset := Set[int]()
    for r in rects
        xset.add(r[0])
        xset.add(r[2])
        yset.add(r[1])
        yset.add(r[3])
    xs := xset.sorted()
    ys := yset.sorted()
    mut by_depth := Map[int, int]()
    for i in 0..(xs.len() - 1)
        for j in 0..(ys.len() - 1)
            mut depth := 0
            for r in rects
                if r[0] <= xs[i] and xs[i + 1] <= r[2] and r[1] <= ys[j] and ys[j + 1] <= r[3]
                    depth += 1
            if depth > 0
                by_depth[depth] += (xs[i + 1] - xs[i]) * (ys[j + 1] - ys[j])
    mut covered := 0
    for d in by_depth.keys().sorted()
        print("covered by exactly {d}: {by_depth[d]}")
        covered += by_depth[d]
    total := rects.fold(0, |acc, r| acc + (r[2] - r[0]) * (r[3] - r[1]))
    print("union area {covered}, sum of areas {total}, grid {xs.len() - 1} x {ys.len() - 1} cells")


@test fn disjoint()
    r := [1, 1, 3, 4]
    assert_eq((r[2] - r[0]) * (r[3] - r[1]), 6)
