## Jacobi and Gauss-Seidel: iterative solvers for a diagonally dominant system; Jacobi uses only
## last sweep's values, Gauss-Seidel uses new values at once and needs about half the sweeps.

fn sweep_count(a List[List[float]], b List[float], seidel bool) List[float]
    n := b.len()
    mut x := [0.0 for i in 0..n]
    mut sweeps := 0
    while sweeps < 1000
        old := x
        for i in 0..n
            mut s := b[i]
            for j in 0..n
                if j != i
                    v := if seidel then x[j] else old[j]
                    s -= a[i][j] * v
            x[i] = s / a[i][i]
        sweeps += 1
        mut change := 0.0
        for i in 0..n
            if (x[i] - old[i]).abs() > change
                change = (x[i] - old[i]).abs()
        if change < 0.000000001
            break
    x.push(sweeps.to_float())
    x

fn main()
    a := [[10.0, -1.0, 2.0, 0.0], [-1.0, 11.0, -1.0, 3.0], [2.0, -1.0, 10.0, -1.0], [0.0, 3.0, -1.0, 8.0]]
    b := [6.0, 25.0, -11.0, 15.0]
    for seidel in [false, true]
        r := sweep_count(a, b, seidel)
        name := if seidel then "Gauss-Seidel" else "Jacobi"
        print("{name:<12} {r[4].to_int():>3} sweeps: [{r[0]:.6}, {r[1]:.6}, {r[2]:.6}, {r[3]:.6}]")
    c := [[4.0, 1.0, 1.0], [1.0, 5.0, 2.0], [1.0, 2.0, 6.0]]
    d := [7.0, -8.0, 6.0]
    for seidel in [false, true]
        r := sweep_count(c, d, seidel)
        name := if seidel then "Gauss-Seidel" else "Jacobi"
        print("{name:<12} {r[3].to_int():>3} sweeps: [{r[0]:.6}, {r[1]:.6}, {r[2]:.6}]")

@test fn diagonal()
    r := sweep_count([[2.0, 0.0], [0.0, 4.0]], [2.0, 2.0], true)
    assert_eq(r, [1.0, 0.5, 2.0])
