## Numerical derivatives: forward differences err in proportion to h and central differences to
## h^2, until rounding error takes over for very small h; shown for the derivative of sin at 1.

fn main()
    x := 1.0
    exact := x.cos()
    print("exact derivative of sin at 1: {exact:.12}")
    mut h := 0.1
    mut prev_f := 0.0
    mut prev_c := 0.0
    for _ in 0..4
        fwd := ((x + h).sin() - x.sin()) / h
        ctr := ((x + h).sin() - (x - h).sin()) / (2.0 * h)
        ef := (fwd - exact).abs()
        ec := (ctr - exact).abs()
        if prev_f > 0.0
            print("h {h:.4}: forward error {ef:.10} (/{prev_f / ef:.0}), central error {ec:.10} (/{prev_c / ec:.0})")
        else
            print("h {h:.4}: forward error {ef:.10}, central error {ec:.10}")
        prev_f = ef
        prev_c = ec
        h = h / 10.0
    print("each tenth of h cuts the forward error 10 times and the central error 100 times")
    xs := [0.0, 0.5, 1.0, 1.5, 2.0]
    second := [((v + 0.001).exp() - 2.0 * v.exp() + (v - 0.001).exp()) / 0.000001 for v in xs]
    shown := [fmt(s) for s in second].join(", ")
    print("second derivative of e^x at 0, 0.5, 1, 1.5, 2: {shown}")

fn fmt(v float) str
    "{v:.4}"

@test fn line()
    h := 0.25
    assert_eq(((3.0 + h) * 2.0 - 3.0 * 2.0) / h, 2.0)
