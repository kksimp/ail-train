## Bezier curves: de Casteljau's construction repeatedly interpolates between control points to
## evaluate a cubic curve, agreeing with the Bernstein polynomial form; chords estimate its length.

fn casteljau(xs List[float], t float) float
    mut p := xs
    mut n := p.len()
    while n > 1
        for i in 0..(n - 1)
            p[i] = (1.0 - t) * p[i] + t * p[i + 1]
        n -= 1
    p[0]

fn bernstein(xs List[float], t float) float
    s := 1.0 - t
    s * s * s * xs[0] + 3.0 * s * s * t * xs[1] + 3.0 * s * t * t * xs[2] + t * t * t * xs[3]

fn main()
    xs := [0.0, 1.0, 4.0, 6.0]
    ys := [0.0, 3.0, 4.0, 1.0]
    for i in 0..=5
        t := i.to_float() / 5.0
        x := casteljau(xs, t)
        y := casteljau(ys, t)
        same := (x - bernstein(xs, t)).abs() < 0.000000001 and (y - bernstein(ys, t)).abs() < 0.000000001
        print("t {t:.1}: ({x:.3}, {y:.3}) matches Bernstein form: {same}")
    for steps in [4, 16, 256]
        mut length := 0.0
        mut px := xs[0]
        mut py := ys[0]
        for i in 1..=steps
            t := i.to_float() / steps.to_float()
            x := casteljau(xs, t)
            y := casteljau(ys, t)
            length += ((x - px) * (x - px) + (y - py) * (y - py)).sqrt()
            px = x
            py = y
        print("length with {steps:>3} chords: {length:.5}")

@test fn ends()
    assert_eq(casteljau([0.0, 1.0, 4.0, 6.0], 1.0), 6.0)
