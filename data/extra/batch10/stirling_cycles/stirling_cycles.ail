## Stirling cycle numbers: c(n, k) counts permutations of n items with exactly k cycles, from
## c(n, k) = c(n-1, k-1) + (n-1) c(n-1, k); rows add up to n!, checked by counting cycles.

fn table(size int) List[List[int]]
    mut c := List[List[int]]()
    for n in 0..=size
        mut row := [0 for i in 0..=size]
        if n == 0
            row[0] = 1
        else
            for k in 1..=n
                row[k] = c[n - 1][k - 1] + (n - 1) * c[n - 1][k]
        c.push(row)
    c

fn cycles(perm List[int]) int
    mut seen := [false for i in 0..perm.len()]
    mut count := 0
    for s in 0..perm.len()
        if not seen[s]
            count += 1
            mut j := s
            while not seen[j]
                seen[j] = true
                j = perm[j]
    count

fn count_by_cycles(n int, mut perm List[int], mut used List[bool], mut counts List[int])
    if perm.len() == n
        counts[cycles(perm)] += 1
        return
    for v in 0..n
        if not used[v]
            used[v] = true
            perm.push(v)
            count_by_cycles(n, mut perm, mut used, mut counts)
            _ := perm.pop()
            used[v] = false

fn main()
    c := table(7)
    for n in 1..=7
        row := c[n].slice(1, n + 1)
        print("n = {n}: {row} sum {row.sum()}")
    mut perm := List[int]()
    mut used := [false, false, false, false, false]
    mut counts := [0, 0, 0, 0, 0, 0]
    count_by_cycles(5, mut perm, mut used, mut counts)
    print("counted cycles of all 120 orderings of 5: {counts.slice(1)}")

@test fn row_four()
    assert_eq(table(4)[4], [0, 6, 11, 6, 1])
