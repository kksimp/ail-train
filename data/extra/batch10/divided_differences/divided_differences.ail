## Divided differences: Newton's form of the interpolating polynomial is built from a table of
## divided differences, so adding one more data point just adds one more term; sqrt is the example.

fn table(xs List[float], ys List[float]) List[float]
    mut coef := ys
    n := xs.len()
    for level in 1..n
        mut i := n - 1
        while i >= level
            coef[i] = (coef[i] - coef[i - 1]) / (xs[i] - xs[i - level])
            i -= 1
    coef

fn newton_eval(xs List[float], coef List[float], x float) float
    mut result := coef[coef.len() - 1]
    mut i := coef.len() - 2
    while i >= 0
        result = result * (x - xs[i]) + coef[i]
        i -= 1
    result

fn main()
    mut xs := [1.0, 4.0, 9.0]
    mut ys := [1.0, 2.0, 3.0]
    for extra in [16.0, 25.0, 36.0]
        coef := table(xs, ys)
        cs := [fmt(c) for c in coef]
        shown := cs.join(", ")
        mut row := List[str]()
        for x in [2.0, 6.0, 12.0]
            row.push("p({x:.0}) = {newton_eval(xs, coef, x):.4} vs {x.sqrt():.4}")
        text := row.join("; ")
        print("{xs.len()} points, coefficients [{shown}]")
        print("    {text}")
        xs.push(extra)
        ys.push(extra.sqrt())

fn fmt(c float) str
    "{c:.6}"

@test fn line()
    c := table([0.0, 2.0], [1.0, 5.0])
    assert_eq(c, [1.0, 2.0])
