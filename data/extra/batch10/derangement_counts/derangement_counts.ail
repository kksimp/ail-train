## Derangements: ways to hand back n hats so nobody gets their own, D(n) = (n-1)(D(n-1) + D(n-2)),
## checked by brute force for small n; D(n)/n! quickly settles at 1/e = 0.367879...

fn brute(n int, pos int, mut used List[bool]) int
    if pos == n
        return 1
    mut total := 0
    for v in 0..n
        if v != pos and not used[v]
            used[v] = true
            total += brute(n, pos + 1, mut used)
            used[v] = false
    total

fn main()
    mut d := [1, 0]
    mut fact := [1, 1]
    for n in 2..=15
        d.push((n - 1) * (d[n - 1] + d[n - 2]))
        fact.push(fact[n - 1] * n)
    for n in 1..=7
        mut used := [false for i in 0..n]
        counted := brute(n, 0, mut used)
        print("n = {n}: D = {d[n]:>4}, brute force {counted:>4}, of {fact[n]:>4} orderings")

    for n in [10, 15]
        ratio := d[n].to_float() / fact[n].to_float()
        print("D({n}) = {d[n]}, share {ratio:.9}")
    one := 1.0
    print("1/e = {1.0 / one.exp():.9}")

@test fn four()
    mut used := [false, false, false, false]
    assert_eq(brute(4, 0, mut used), 9)
