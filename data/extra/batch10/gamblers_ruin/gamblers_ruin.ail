## Gambler's ruin: a player with i chips bets one chip a round until reaching N or going broke;
## with win chance p the success chance is (1 - r^i) / (1 - r^N), r = q/p; a seeded simulation agrees.

fn success(i int, n int, p float) float
    if p == 0.5
        return i.to_float() / n.to_float()
    r := (1.0 - p) / p
    (1.0 - r.pow(i.to_float())) / (1.0 - r.pow(n.to_float()))

struct Rng
    seed int

fn Rng.unit(mut self) float
    self.seed = (self.seed * 1103515245 + 12345) % 2147483648
    self.seed.to_float() / 2147483648.0

fn simulate(mut rng Rng, i int, n int, p float, runs int) float
    mut wins := 0
    for _ in 0..runs
        mut chips := i
        while chips > 0 and chips < n
            if rng.unit() < p
                chips += 1
            else
                chips -= 1
        if chips == n
            wins += 1
    wins.to_float() / runs.to_float()

fn main()
    mut rng := Rng(seed: 99)
    for p in [0.5, 0.49, 0.47, 0.4]
        for start in [10, 50]
            exact := success(start, 100, p)
            sim := simulate(mut rng, start, 100, p, 400)
            print("p {p:.2}, start {start:>2} of 100: exact {exact:.4}, simulated {sim:.4}")
    print("fair game expected rounds from 10 to 0 or 100: {10 * (100 - 10)}")

@test fn fair()
    assert_eq(success(3, 4, 0.5), 0.75)
