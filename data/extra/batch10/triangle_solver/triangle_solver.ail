## Triangle solver: from three sides, two sides and the angle between, or two angles and the side
## between, the law of cosines and the law of sines give the missing sides and angles in degrees.

enum Given
    Sss(a float, b float, c float)
    Sas(a float, angle_c float, b float)
    Asa(angle_a float, c float, angle_b float)

fn rad(d float) float
    d * 3.141592653589793 / 180.0

fn deg(r float) float
    r * 180.0 / 3.141592653589793

fn arccos(x float) float
    (1.0 - x * x).sqrt().atan2(x)

fn solve(g Given) List[float]
    match g
        Sss(a, b, c) =>
            ca := arccos((b * b + c * c - a * a) / (2.0 * b * c))
            cb := arccos((a * a + c * c - b * b) / (2.0 * a * c))
            [a, b, c, deg(ca), deg(cb), 180.0 - deg(ca) - deg(cb)]
        Sas(a, angle_c, b) =>
            c := (a * a + b * b - 2.0 * a * b * rad(angle_c).cos()).sqrt()
            ca := arccos((b * b + c * c - a * a) / (2.0 * b * c))
            [a, b, c, deg(ca), 180.0 - deg(ca) - angle_c, angle_c]
        Asa(angle_a, c, angle_b) =>
            angle_c := 180.0 - angle_a - angle_b
            k := c / rad(angle_c).sin()
            [k * rad(angle_a).sin(), k * rad(angle_b).sin(), c, angle_a, angle_b, angle_c]

fn main()
    cases := [Given.Sss(a: 3.0, b: 4.0, c: 5.0), Given.Sss(a: 7.0, b: 8.0, c: 9.0), Given.Sas(a: 10.0, angle_c: 40.0, b: 7.0), Given.Asa(angle_a: 35.0, c: 12.0, angle_b: 80.0)]
    for g in cases
        t := solve(g)
        s := (t[0] + t[1] + t[2]) / 2.0
        area := (s * (s - t[0]) * (s - t[1]) * (s - t[2])).sqrt()
        print("sides {t[0]:.3}, {t[1]:.3}, {t[2]:.3}; angles {t[3]:.2}, {t[4]:.2}, {t[5]:.2}; area {area:.3}")

@test fn right()
    t := solve(Given.Sss(a: 3.0, b: 4.0, c: 5.0))
    assert((t[5] - 90.0).abs() < 0.000001)
