## Self numbers: n is a self number when no m gives m + digitsum(m) = n; a generator table marks
## every reachable n, and some numbers like 101 have two generators.

fn digit_sum(n int) int
    mut x := n
    mut s := 0
    while x > 0
        s += x % 10
        x = x / 10
    s

fn main()
    limit := 10000
    mut makers := Map[int, List[int]]()
    for m in 1..=limit
        v := m + digit_sum(m)
        if v <= limit
            makers.push(v, m)
    selfs := [n for n in 1..=limit if not makers.contains(n)]
    small := selfs.filter(|x| x < 100)
    print("self numbers below 100: {small}")

    print("{selfs.len()} self numbers up to {limit}")
    for n in [21, 101, 1000, 1016]
        if not makers.contains(n)
            print("{n}: self number, no generator")
        else
            gens := makers[n]
            print("{n}: generated by {gens}")
    multi := [n for n in 1..=200 if makers.contains(n) and makers[n].len() > 1]
    print("numbers up to 200 with two generators: {multi}")

@test fn sum()
    assert_eq(digit_sum(1016), 8)
