## Archimedes' pi: perimeters of regular polygons outside and inside a circle of diameter 1 bound
## pi; doubling the sides takes the harmonic mean, then the geometric mean, from 6 sides to 96 and on.

fn main()
    three := 3.0
    mut outer := 2.0 * three.sqrt()
    mut inner := 3.0
    mut sides := 6
    pi := 3.141592653589793
    while sides <= 6144
        width := outer - inner
        print("{sides:>5} sides: {inner:.8} < pi < {outer:.8}  (gap {width:.9})")
        outer = 2.0 * outer * inner / (outer + inner)
        inner = (outer * inner).sqrt()
        sides *= 2
    print("pi = {pi:.8}")

@test fn hexagon()
    three := 3.0
    assert((2.0 * three.sqrt() - 3.4641016).abs() < 0.000001)
