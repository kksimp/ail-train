## Taxicab numbers: numbers that are a sum of two positive cubes in more than one way, like
## 1729 = 1^3 + 12^3 = 9^3 + 10^3; every pair a <= b is grouped in a Map by its sum.

fn main()
    limit := 100000
    mut ways := Map[int, List[str]]()
    mut a := 1
    while 2 * a * a * a <= limit
        mut b := a
        while a * a * a + b * b * b <= limit
            ways.push(a * a * a + b * b * b, "{a}^3 + {b}^3")
            b += 1
        a += 1
    mut found := 0
    for n in ways.keys().sorted()
        reps := ways[n]
        if reps.len() > 1
            found += 1
            shown := reps.join(" = ")
            print("{n:>6} = {shown}")
    print("{found} numbers below {limit} with two representations; {ways.len()} sums in all")

@test fn ramanujan()
    assert_eq(1 + 12 * 12 * 12, 9 * 9 * 9 + 10 * 10 * 10)
