## Natural cubic spline: piecewise cubics through data points with matching slopes and curvatures,
## zero curvature at the ends; the second derivatives come from a tridiagonal solve (Thomas algorithm).

fn curvatures(xs List[float], ys List[float]) List[float]
    n := xs.len()
    mut a := [0.0 for i in 0..n]
    mut b := [1.0 for i in 0..n]
    mut c := [0.0 for i in 0..n]
    mut d := [0.0 for i in 0..n]
    for i in 1..(n - 1)
        h0 := xs[i] - xs[i - 1]
        h1 := xs[i + 1] - xs[i]
        a[i] = h0
        b[i] = 2.0 * (h0 + h1)
        c[i] = h1
        d[i] = 6.0 * ((ys[i + 1] - ys[i]) / h1 - (ys[i] - ys[i - 1]) / h0)
    for i in 1..n
        w := a[i] / b[i - 1]
        b[i] -= w * c[i - 1]
        d[i] -= w * d[i - 1]
    mut m := [0.0 for i in 0..n]
    m[n - 1] = d[n - 1] / b[n - 1]
    mut i := n - 2
    while i >= 0
        m[i] = (d[i] - c[i] * m[i + 1]) / b[i]
        i -= 1
    m

fn spline_at(xs List[float], ys List[float], m List[float], x float) float
    mut k := 0
    while k < xs.len() - 2 and x > xs[k + 1]
        k += 1
    h := xs[k + 1] - xs[k]
    t1 := xs[k + 1] - x
    t0 := x - xs[k]
    m[k] * t1 * t1 * t1 / (6.0 * h) + m[k + 1] * t0 * t0 * t0 / (6.0 * h) + (ys[k] / h - m[k] * h / 6.0) * t1 + (ys[k + 1] / h - m[k + 1] * h / 6.0) * t0

fn main()
    pi := 3.141592653589793
    xs := [0.0, 0.7, 1.4, 2.1, 2.8, 3.5]
    ys := [xs[0].sin(), xs[1].sin(), xs[2].sin(), xs[3].sin(), xs[4].sin(), xs[5].sin()]
    m := curvatures(xs, ys)
    curv := [fmt(v) for v in m].join(", ")
    print("curvatures at the knots: {curv}")
    for x in [0.35, 1.0, pi / 2.0, 2.5, 3.2]
        s := spline_at(xs, ys, m, x)
        print("x {x:.3}: spline {s:.5}, sin {x.sin():.5}, error {(s - x.sin()).abs():.5}")

fn fmt(v float) str
    "{v:.4}"

@test fn through_knots()
    xs := [0.0, 1.0, 2.0]
    ys := [0.0, 1.0, 0.0]
    m := curvatures(xs, ys)
    assert((spline_at(xs, ys, m, 1.0) - 1.0).abs() < 0.000001)
