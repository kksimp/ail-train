## Pi series: Leibniz's 1 - 1/3 + 1/5 - ... crawls, Nilakantha's 3 + 4/(2*3*4) - 4/(4*5*6) + ...
## is far faster, and Wallis's product of (2n)^2 / ((2n-1)(2n+1)) creeps up on pi / 2.

fn leibniz(n int) float
    mut s := 0.0
    mut sign := 1.0
    for k in 0..n
        s += sign / (2 * k + 1).to_float()
        sign = -sign
    4.0 * s

fn nilakantha(n int) float
    mut s := 3.0
    mut sign := 1.0
    for k in 1..=n
        a := (2 * k).to_float()
        s += sign * 4.0 / (a * (a + 1.0) * (a + 2.0))
        sign = -sign
    s

fn wallis(n int) float
    mut p := 1.0
    for k in 1..=n
        t := (2 * k).to_float()
        p *= t * t / ((t - 1.0) * (t + 1.0))
    2.0 * p

fn main()
    pi := 3.141592653589793
    print("terms        Leibniz     Nilakantha         Wallis")
    for n in [1, 10, 100, 1000, 10000]
        l := leibniz(n)
        k := nilakantha(n)
        w := wallis(n)
        print("{n:>5}  {l:>13.10}  {k:>13.10}  {w:>13.10}")
    print("pi     {pi:>13.10}")
    print("Leibniz error after 10000 terms {(leibniz(10000) - pi).abs():.10}, about 1/10000")

@test fn first_terms()
    assert_eq(leibniz(1), 4.0)
    assert_eq(wallis(1), 2.0 * 4.0 / 3.0)
