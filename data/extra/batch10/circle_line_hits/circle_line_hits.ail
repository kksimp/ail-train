## Line meets circle: substituting the line p + t d into |x - c|^2 = r^2 gives a quadratic in t;
## its discriminant says miss, tangent or two hits, and the hits give the chord length.

struct Circle
    cx float
    cy float
    r float

fn hits(c Circle, px float, py float, dx float, dy float) List[List[float]]
    fx := px - c.cx
    fy := py - c.cy
    a := dx * dx + dy * dy
    b := 2.0 * (fx * dx + fy * dy)
    k := fx * fx + fy * fy - c.r * c.r
    disc := b * b - 4.0 * a * k
    if disc < 0.0
        return []
    if disc == 0.0
        t := -b / (2.0 * a)
        return [[px + t * dx, py + t * dy]]
    s := disc.sqrt()
    mut out := List[List[float]]()
    for t in [(-b - s) / (2.0 * a), (-b + s) / (2.0 * a)]
        out.push([px + t * dx, py + t * dy])
    out

fn main()
    c := Circle(cx: 2.0, cy: 1.0, r: 5.0)
    lines := [[-6.0, 1.0, 1.0, 0.0], [-3.0, 6.0, 1.0, 0.0], [-4.0, 9.0, 1.0, 0.0], [0.0, -7.0, 1.0, 2.0], [7.0, -3.0, -1.0, 3.0]]
    for l in lines
        pts := hits(c, l[0], l[1], l[2], l[3])
        start := "through ({l[0]}, {l[1]}) along ({l[2]}, {l[3]})"
        if pts.len() == 0
            print("{start}: misses")
        elif pts.len() == 1
            print("{start}: tangent at ({pts[0][0]:.3}, {pts[0][1]:.3})")
        else
            chord := ((pts[1][0] - pts[0][0]) * (pts[1][0] - pts[0][0]) + (pts[1][1] - pts[0][1]) * (pts[1][1] - pts[0][1])).sqrt()
            print("{start}: ({pts[0][0]:.3}, {pts[0][1]:.3}) and ({pts[1][0]:.3}, {pts[1][1]:.3}), chord {chord:.3}")

@test fn tangent()
    pts := hits(Circle(cx: 0.0, cy: 0.0, r: 1.0), -2.0, 1.0, 1.0, 0.0)
    assert_eq(pts, [[0.0, 1.0]])
