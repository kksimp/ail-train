## Recaman sequence: start at 0 and at step n go back n if that lands on a new positive number,
## otherwise forward n; values repeat despite the rule, and some small numbers come very late.

fn recaman(count int) List[int]
    mut seq := [0]
    mut seen := Set[int]()
    seen.add(0)
    for n in 1..count
        prev := seq[n - 1]
        back := prev - n
        v := if back > 0 and not seen.contains(back) then back else prev + n
        seq.push(v)
        seen.add(v)
    seq

fn main()
    seq := recaman(2000)
    print("first 20: {seq.take(20)}")
    mut first_at := Map[int, int]()
    mut repeats := List[str]()
    for i, v in seq.enumerate()
        if first_at.contains(v)
            if repeats.len() < 4
                repeats.push("{v} at steps {first_at[v]} and {i}")
        else
            first_at[v] = i
    for r in repeats
        print("repeat: {r}")
    mut missing := 1
    while first_at.contains(missing)
        missing += 1
    print("distinct values in 2000 steps: {first_at.len()}, smallest not yet reached: {missing}")
    top := seq.max() else 0
    print("largest value so far: {top}")

@test fn start()
    assert_eq(recaman(8), [0, 1, 3, 6, 2, 7, 13, 20])
