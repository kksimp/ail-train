## Pivot solve: Gaussian elimination with partial pivoting picks the largest entry in each column
## as the pivot (swapping rows), eliminates below it, then back-substitutes; residuals stay tiny.

fn solve(a0 List[List[float]], b0 List[float]) List[float]
    mut a := a0
    mut b := b0
    n := b.len()
    for col in 0..n
        mut best := col
        for r in (col + 1)..n
            if a[r][col].abs() > a[best][col].abs()
                best = r
        if best != col
            a.swap(col, best)
            b.swap(col, best)
        for r in (col + 1)..n
            f := a[r][col] / a[col][col]
            for c in col..n
                a[r][c] -= f * a[col][c]
            b[r] -= f * b[col]
    mut x := [0.0 for i in 0..n]
    mut row := n - 1
    while row >= 0
        mut s := b[row]
        for c in (row + 1)..n
            s -= a[row][c] * x[c]
        x[row] = s / a[row][row]
        row -= 1
    x

fn residual(a List[List[float]], b List[float], x List[float]) float
    mut worst := 0.0
    for i in 0..b.len()
        mut s := 0.0
        for j in 0..b.len()
            s += a[i][j] * x[j]
        if (s - b[i]).abs() > worst
            worst = (s - b[i]).abs()
    worst

fn main()
    a := [[0.0, 2.0, 1.0], [1.0, -2.0, -3.0], [-1.0, 1.0, 2.0]]
    b := [-8.0, 0.0, 3.0]
    x := solve(a, b)
    print("3x3 with a zero first pivot: x = {x[0]:.4}, y = {x[1]:.4}, z = {x[2]:.4}")
    print("largest residual below 1e-12: {residual(a, b, x) < 0.000000000001}")
    m := [[4.0, -2.0, 1.0, 3.0], [3.0, 6.0, -4.0, 2.0], [2.0, 1.0, 8.0, -5.0], [1.0, 3.0, -2.0, 7.0]]
    v := [20.0, -1.0, 10.0, 15.0]
    y := solve(m, v)
    for i in 0..4
        print("x{i + 1} = {y[i]:>9.5}")
    print("largest residual below 1e-12: {residual(m, v, y) < 0.000000000001}")

@test fn diagonal()
    assert_eq(solve([[2.0, 0.0], [0.0, 4.0]], [1.0, 1.0]), [0.5, 0.25])
