## Gauss-Legendre quadrature: n well-placed nodes with weights integrate polynomials up to degree
## 2n - 1 exactly; 2- and 3-point rules on e^x, x^5 and 1/(1 + x^2) compared with the true values.

fn g(kind int, x float) float
    match kind
        0 => x.exp()
        1 => x * x * x * x * x
        _ => 1.0 / (1.0 + x * x)

fn gauss(kind int, a float, b float, nodes List[float], weights List[float]) float
    half := (b - a) / 2.0
    mid := (b + a) / 2.0
    mut s := 0.0
    for i in 0..nodes.len()
        s += weights[i] * g(kind, mid + half * nodes[i])
    half * s

fn main()
    three := 3.0
    r3 := 1.0 / three.sqrt()
    three_fifths := 0.6
    q := three_fifths.sqrt()

    two_nodes := [-r3, r3]
    two_weights := [1.0, 1.0]
    three_nodes := [-q, 0.0, q]
    three_weights := [5.0 / 9.0, 8.0 / 9.0, 5.0 / 9.0]
    one := 1.0
    exact := [one.exp() - 1.0, 64.0 / 6.0, 3.141592653589793 / 4.0]
    names := ["e^x on [0, 1]", "x^5 on [0, 2]", "1/(1+x^2) on [0, 1]"]
    ends := [[0.0, 1.0], [0.0, 2.0], [0.0, 1.0]]
    for k in 0..3
        a := ends[k][0]
        b := ends[k][1]
        two := gauss(k, a, b, two_nodes, two_weights)
        thr := gauss(k, a, b, three_nodes, three_weights)
        print("{names[k]:<20} exact {exact[k]:.10}")
        print("    2 points {two:.10} (error {(two - exact[k]).abs():.10}), 3 points {thr:.10} (error {(thr - exact[k]).abs():.10})")

@test fn constant()
    assert((gauss(1, -1.0, 1.0, [0.0], [2.0])).abs() < 0.000001)
