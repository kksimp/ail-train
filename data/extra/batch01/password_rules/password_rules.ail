## Password rules: checks a candidate password against rules and reports the first rule it
## breaks as a typed `error enum`, matched to a hint for the user.

error enum Weak
    TooShort(len int) "too short: {len} characters"
    NoDigit "no digit"
    NoUpper "no capital letter"
    HasSpace "contains a space"
    Common(word str) "too common: {word}"

COMMON := ["password", "letmein", "qwerty"]

fn check(pw str) ! Weak
    if pw.len() < 8
        return TooShort(len: pw.len())
    if pw.contains(' ')
        return HasSpace
    if COMMON.contains(pw.to_lower())
        return Common(word: pw.to_lower())
    cs := pw.chars()
    if not cs.any(|c| c.is_digit())
        return NoDigit
    if not cs.any(|c| c.is_upper())
        return NoUpper

fn hint(e Weak) str
    match e
        TooShort(n) => "add {8 - n} more"
        NoDigit => "add a number"
        NoUpper => "add a capital"
        HasSpace => "remove spaces"
        Common => "pick something less common"

fn main()
    for pw in ["abc", "Password", "longenough", "longenough7", "Long enough7", "Longenough7"]
        check(pw) else err
            print("{pw}: {err}; {hint(err)}")
            continue
        print("{pw}: ok")

@test fn short_reports_length()
    assert_err(check("abc"), Weak.TooShort)

@test fn good_password_passes()
    check("Tr0ubadour")?
