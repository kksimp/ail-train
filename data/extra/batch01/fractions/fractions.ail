## Fractions: a `Frac` struct kept in lowest terms with a gcd, operators from `impl Add`,
## `Sub`, `Mul` and `Div`, and `impl Ord` by cross-multiplying for sorting.

struct Frac
    num int
    den int

fn gcd(a int, b int) int
    if b == 0 then a.abs() else gcd(b, a % b)

fn frac(n int, d int) Frac
    g := gcd(n, d)
    s := if d < 0 then -1 else 1
    Frac(num: s * n / g, den: s * d / g)

impl Add for Frac
    fn add(self, o Frac) Frac
        frac(num * o.den + o.num * den, den * o.den)

impl Sub for Frac
    fn sub(self, o Frac) Frac
        frac(num * o.den - o.num * den, den * o.den)

impl Mul for Frac
    fn mul(self, o Frac) Frac
        frac(num * o.num, den * o.den)

impl Div for Frac
    fn div(self, o Frac) Frac
        frac(num * o.den, den * o.num)

fn show(f Frac) str
    if f.den == 1 then "{f.num}" else "{f.num}/{f.den}"

fn main()
    a := frac(1, 2)
    b := frac(3, -4)
    print("a = {show(a)}, b = {show(b)}")
    print("a + b = {show(a + b)}")
    print("a - b = {show(a - b)}")
    print("a * b = {show(a * b)}")
    print("a / b = {show(a / b)}")
    mut h := frac(0, 1)
    for n in 1..=6
        h += frac(1, n)
    print("H(6) = {show(h)}")
    fs := [frac(2, 3), frac(1, 6), frac(5, 8), frac(-1, 3)]
    sorted := fs.sorted(by: |f| f.num * 120 / f.den)
    print(sorted.map(show).join(" < "))

@test fn lowest_terms()
    assert_eq(frac(6, 8), Frac(num: 3, den: 4))
    assert_eq(frac(2, -4), Frac(num: -1, den: 2))
