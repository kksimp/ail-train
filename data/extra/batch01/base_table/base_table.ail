## Base table: prints numbers in decimal, hex, binary and octal-free padded forms using
## the format specs `x`, `b`, `0` padding and `,`, and reads hex text back with `to_int(16)`.

fn octal(n int) str
    if n == 0
        return "0"
    mut digits := List[str]()
    mut v := n
    while v > 0
        digits.push("{v % 8}")
        v /= 8
    digits.reversed().join("")

fn main()
    for n in [0, 7, 10, 255, 4096, 65535]
        print("{n:>6} | {n:>5x} | {n:016b} | {octal(n):>6}")
    print("{1234567:,}")
    big := 48879
    print("{255:x} {big:x}")
    for text in ["ff", "7F", "zz", "1000"]
        v := text.to_int(16) else
            print("{text}: not hex")
            continue
        print("{text} = {v}")
    print(big.to_hex())

@test fn octal_matches_known_values()
    assert_eq(octal(8), "10")
    assert_eq(octal(511), "777")
    assert_eq(octal(0), "0")
