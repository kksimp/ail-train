## Merge sorted runs: merges two already sorted lists with two indexes, then merges many
## runs by folding, and counts how many comparisons each merge needed.

fn merge(a List[int], b List[int]) (List[int], int)
    mut out := List[int]()
    mut i := 0
    mut j := 0
    mut compares := 0
    while i < a.len() and j < b.len()
        compares += 1
        if a[i] <= b[j]
            out.push(a[i])
            i += 1
        else
            out.push(b[j])
            j += 1
    out.extend(a.slice(i))
    out.extend(b.slice(j))
    (out, compares)

fn main()
    runs := [[3, 9, 14], [1, 2, 20, 21], [], [5, 9], [0, 30]]
    mut acc := List[int]()
    mut total := 0
    for r in runs
        merged, c := merge(acc, r)
        acc = merged
        total += c
        print("{acc.map(|x| "{x}").join(" ")} ({c} compares)")
    print("total compares: {total}, sorted: {acc == acc.sorted()}")

@test fn keeps_duplicates()
    out, _ := merge([1, 3], [1, 2])
    assert_eq(out, [1, 1, 2, 3])
