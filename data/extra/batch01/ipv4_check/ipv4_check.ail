## IPv4 check: validates dotted IPv4 addresses (four parts, 0 to 255, no leading zeros),
## turns valid ones into a 32-bit number, and says whether they are private.

fn parse_ip(text str) int ! str
    parts := text.split(".")
    if parts.len() != 4
        return "needs 4 parts, has {parts.len()}"
    mut value := 0
    for p in parts
        if p.len() > 1 and p.starts_with("0")
            return "leading zero in '{p}'"
        n := p.to_int() else return "'{p}' is not a number"
        if n < 0 or n > 255
            return "{n} is out of range"
        value = value * 256 + n
    value

fn private(v int) bool
    a := v >> 24
    b := (v >> 16) & 255
    a == 10 or (a == 172 and b >= 16 and b <= 31) or (a == 192 and b == 168)

fn main()
    for ip in ["192.168.1.20", "8.8.8.8", "10.0.0.256", "172.20.3.4", "172.32.0.1", "1.2.3", "01.2.3.4", "a.b.c.d", "255.255.255.255"]
        if v := parse_ip(ip)
            kind := if private(v) then "private" else "public"
            print("{ip:<16} {v:>10} {kind}")
        else err
            print("{ip:<16} invalid: {err}")

@test fn top_address()
    assert_eq(parse_ip("255.255.255.255") else 0, 4294967295)

@test fn short_is_error()
    assert_err(parse_ip("1.2"))
