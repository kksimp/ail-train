## Middle values: the mean, median and mode(s) of several data sets, with the median of an
## even-sized set given as a half when needed, and every tied mode listed.

fn median_text(xs List[int]) str
    s := xs.sorted()
    n := s.len()
    if n % 2 == 1
        return "{s[n / 2]}"
    twice := s[n / 2 - 1] + s[n / 2]
    if twice % 2 == 0 then "{twice / 2}" else "{twice / 2}.5"

fn modes(xs List[int]) List[int]
    counts := xs.counts()
    best := counts.values().max() else 0
    counts.keys().filter(|k| counts[k] == best).sorted()

fn main()
    sets := [[3, 7, 7, 2, 9], [1, 2, 3, 4], [5, 5, 1, 1, 3], [10], [4, 8, 6, 2]]
    for xs in sets
        mean := xs.sum().to_float() / xs.len().to_float()
        print("{xs.map(|x| "{x}").join(",")}: mean {mean:.2}, median {median_text(xs)}, modes {modes(xs).map(|m| "{m}").join("/")}")

@test fn even_median()
    assert_eq(median_text([1, 2]), "1.5")
    assert_eq(median_text([2, 4]), "3")
