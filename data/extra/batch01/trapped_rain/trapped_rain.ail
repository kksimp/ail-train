## Trapped rain: how much water a row of walls holds after rain, from the highest wall to
## the left and right of each cell, and a drawing of the result.

fn water_levels(h List[int]) List[int]
    n := h.len()
    mut left := List[int]()
    mut best := 0
    for x in h
        best = best.max(x)
        left.push(best)
    mut right := [0 for _ in 0..n]
    best = 0
    for k in 0..n
        i := n - 1 - k
        best = best.max(h[i])
        right[i] = best
    [left[i].min(right[i]) - h[i] for i in 0..n]

fn main()
    walls := [0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1]
    w := water_levels(walls)
    print("water: {w.sum()}")
    top := walls.max() else 0
    for down in 0..top
        level := top - down
        mut row := List[str]()
        for i in 0..walls.len()
            row.push(if walls[i] >= level then "#" elif walls[i] + w[i] >= level then "~" else " ")
        print(row.join("").trim_end())
    print(water_levels([3, 0, 3]).sum())
    print(water_levels([]).sum())

@test fn bowl()
    assert_eq(water_levels([2, 0, 2]), [0, 2, 0])
