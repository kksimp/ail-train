## Harshad numbers: numbers divisible by the sum of their digits; finds runs of
## consecutive ones and the first number of each length of run.

fn digit_sum(n int) int
    mut v := n
    mut s := 0
    while v > 0
        s += v % 10
        v /= 10
    s

fn harshad(n int) bool
    n > 0 and n % digit_sum(n) == 0

fn main()
    first := [n for n in 1..200 if harshad(n)].take(15)
    print(first.join(" "))
    mut run := 0
    mut best := 0
    mut best_start := 0
    for n in 1..2000
        if harshad(n)
            run += 1
            if run > best
                best = run
                best_start = n - run + 1
        else
            run = 0
    print("longest run below 2000: {best} from {best_start}")
    print("count below 1000: {[n for n in 1..1000 if harshad(n)].len()}")

@test fn twelve_and_thirteen()
    assert(harshad(12))
    assert(not harshad(13))
