## Age in days: counts the days between two dates by converting each to a day number with
## the civil-from-days formula, and finds each person's next round-number day.

fn days_from_civil(y0 int, m int, d int) int
    y := if m <= 2 then y0 - 1 else y0
    era := (if y >= 0 then y else y - 399) / 400
    yoe := y - era * 400
    mp := (m + 9) % 12
    doy := (153 * mp + 2) / 5 + d - 1
    doe := yoe * 365 + yoe / 4 - yoe / 100 + doy
    era * 146097 + doe - 719468

fn parse(text str) int?
    p := text.split("-")
    if p.len() != 3
        return none
    y := p[0].to_int() else return none
    m := p[1].to_int() else return none
    d := p[2].to_int() else return none
    days_from_civil(y, m, d)

fn main()
    today := parse("2026-11-20") else 0
    for person in [("Ade", "1990-05-17"), ("Bea", "2000-02-29"), ("Cas", "2026-01-01"), ("Dov", "1969-07-20")]
        name, born := person
        b := parse(born) else continue
        age := today - b
        goal := (age / 1000 + 1) * 1000
        print("{name}: {age:,} days old, {goal:,} days in {goal - age} days")
    print(days_from_civil(1970, 1, 1))

@test fn epoch_is_zero()
    assert_eq(days_from_civil(1970, 1, 1), 0)
    assert_eq(days_from_civil(2000, 3, 1) - days_from_civil(2000, 2, 28), 2)
