## Sharpe ratio: a fund's average monthly return above the risk-free rate, divided by the standard
## deviation of its returns and scaled by sqrt(12), rewards return per unit of risk.

fn mean(xs List[float]) float
    xs.fold(0.0, |acc, x| acc + x) / xs.len().to_float()

fn stdev(xs List[float]) float
    m := mean(xs)
    ss := xs.fold(0.0, |acc, x| acc + (x - m) * (x - m))
    (ss / (xs.len() - 1).to_float()).sqrt()

fn main()
    rf := 0.25
    twelve := 12.0
    mut funds := Map[str, List[float]]()
    funds["steady bond"] = [0.4, 0.3, 0.5, 0.4, 0.2, 0.4, 0.3, 0.5, 0.4, 0.3, 0.4, 0.5]
    funds["global shares"] = [2.1, -1.5, 3.0, 0.8, -2.2, 1.9, 2.5, -0.7, 1.2, 0.4, -1.1, 2.8]
    funds["tech growth"] = [5.2, -4.8, 6.1, -3.0, 4.4, -5.5, 7.0, 1.0, -2.5, 3.8, -6.0, 6.5]
    mut best := ""
    mut best_s := -100.0
    for name, rets in funds
        m := mean(rets)
        sd := stdev(rets)
        sharpe := (m - rf) / sd * twelve.sqrt()
        print("{name:<13} mean {m:>5.2}% a month, sd {sd:>5.2}%, Sharpe {sharpe:>5.2}")
        if sharpe > best_s
            best = name
            best_s = sharpe
    print("best reward for risk: {best}")

@test fn spread()
    two := 2.0
    assert_eq(stdev([1.0, 3.0]), two.sqrt())
