## Earthworks: cut and fill between road stations by the average end area method,
## V = (A1 + A2) / 2 x L; fill shrinks by 10%, so cut covers only 0.9 of its volume as fill.

fn volumes(areas List[float], spacing float) List[float]
    mut out := List[float]()
    for i in 1..areas.len()
        out.push((areas[i - 1] + areas[i]) / 2.0 * spacing)
    out

fn main()
    stations := [0, 20, 40, 60, 80, 100]
    cut := [0.0, 12.5, 18.0, 6.0, 0.0, 0.0]
    fill := [4.0, 0.0, 0.0, 3.5, 14.0, 9.0]
    vc := volumes(cut, 20.0)
    vf := volumes(fill, 20.0)
    for i in 0..vc.len()
        print("station {stations[i]:>3} to {stations[i + 1]:>3}: cut {vc[i]:>5.1} m3, fill {vf[i]:>5.1} m3")
    total_cut := vc.fold(0.0, |acc, x| acc + x)
    total_fill := vf.fold(0.0, |acc, x| acc + x)
    usable := total_cut * 0.9
    print("cut {total_cut} m3 gives {usable:.1} m3 of fill; fill needed {total_fill} m3")
    if usable >= total_fill
        print("spare spoil {usable - total_fill:.1} m3 to haul away")
    else
        print("import {total_fill - usable:.1} m3 of fill")

@test fn prism()
    assert_eq(volumes([2.0, 4.0], 10.0), [30.0])
