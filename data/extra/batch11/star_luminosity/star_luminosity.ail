## Star brightness: the Stefan-Boltzmann law gives luminosity L / Lsun = (R / Rsun)^2 (T / 5772)^4,
## and Wien's law puts the peak of the glow at 2897772 / T nanometres, which sets the colour.

struct Star
    name str
    radius float
    temp float

fn colour(peak_nm float) str
    if peak_nm < 400.0 then "blue-white" elif peak_nm < 500.0 then "white" elif peak_nm < 600.0 then "yellow" elif peak_nm < 750.0 then "orange" else "red"

fn Star.luminosity(self) float
    t := self.temp / 5772.0
    self.radius * self.radius * t * t * t * t

fn main()
    stars := [Star(name: "Sun", radius: 1.0, temp: 5772.0), Star(name: "Sirius A", radius: 1.711, temp: 9940.0), Star(name: "Rigel", radius: 78.9, temp: 12100.0), Star(name: "Betelgeuse", radius: 764.0, temp: 3600.0), Star(name: "Proxima", radius: 0.154, temp: 3042.0), Star(name: "Arcturus", radius: 25.4, temp: 4286.0)]
    for s in stars
        peak := 2897772.0 / s.temp
        print("{s.name:<10} R {s.radius:>6.3} T {s.temp:>7.1} K: L {s.luminosity():>11.3} Lsun, peak {peak:>4.1} nm ({colour(peak)})")
    brightest := stars.max(by: |st| st.luminosity().to_int()) else stars[0]
    print("most luminous: {brightest.name}")

@test fn sun_is_one()
    sun := Star(name: "s", radius: 1.0, temp: 5772.0)
    assert_eq(sun.luminosity(), 1.0)
