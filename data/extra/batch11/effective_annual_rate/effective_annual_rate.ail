## Effective rate: a nominal yearly rate r compounded n times a year grows money by (1 + r / n)^n,
## so the effective annual rate is that minus 1; continuous compounding gives e^r - 1.

fn effective(r float, n int) float
    (1.0 + r / n.to_float()).pow(n.to_float()) - 1.0

fn main()
    periods := [("yearly", 1), ("half-yearly", 2), ("quarterly", 4), ("monthly", 12), ("daily", 365)]
    label := "continuous"
    for r in [0.05, 0.2]
        print("nominal {r * 100.0:.1}%:")
        for pd in periods
            name, n := pd
            print("  {name:<12} {effective(r, n) * 100.0:.4}%")
        cont := (r.exp() - 1.0) * 100.0
        print("  {label:<12} {cont:.4}%")
    grown := 1000.0 * (1.0 + effective(0.2, 12)).pow(5.0)
    print("1000 at 20% compounded monthly for 5 years: {grown:.2}")

@test fn yearly_is_nominal()
    assert((effective(0.07, 1) - 0.07).abs() < 0.000001)
