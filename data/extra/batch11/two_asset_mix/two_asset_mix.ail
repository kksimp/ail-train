## Two-asset portfolio: return is the weighted mean, risk is sqrt(w1^2 s1^2 + w2^2 s2^2 + 2 w1 w2 rho s1 s2);
## a low correlation makes a mix less risky than either part, least at w1 = (s2^2 - rho s1 s2) / (s1^2 + s2^2 - 2 rho s1 s2).

fn risk(w float, s1 float, s2 float, rho float) float
    v := 1.0 - w
    (w * w * s1 * s1 + v * v * s2 * s2 + 2.0 * w * v * rho * s1 * s2).sqrt()

fn main()
    r1 := 8.0
    s1 := 16.0
    r2 := 4.0
    s2 := 6.0
    rho := 0.1
    for pct in [0, 20, 40, 60, 80, 100]
        w := pct.to_float() / 100.0
        ret := w * r1 + (1.0 - w) * r2
        print("{pct:>3}% shares: return {ret:.2}%, risk {risk(w, s1, s2, rho):.2}%")
    best := (s2 * s2 - rho * s1 * s2) / (s1 * s1 + s2 * s2 - 2.0 * rho * s1 * s2)
    print("least risk at {best * 100.0:.1}% shares: {risk(best, s1, s2, rho):.2}%")

@test fn all_in_one()
    assert_eq(risk(1.0, 16.0, 6.0, 0.1), 16.0)
