## Flywheel storage: a spinning wheel holds E = I w^2 / 2 with w = 2 pi rpm / 60; a solid disc has
## I = m r^2 / 2 and a rim (ring) I = m r^2, so the same mass stores twice as much in a rim.

PI := 3.141592653589793

enum Shape
    Disc
    Rim

fn inertia(s Shape, kg float, r float) float
    match s
        Disc => kg * r * r / 2.0
        Rim => kg * r * r

fn energy(i float, rpm float) float
    w := 2.0 * PI * rpm / 60.0
    i * w * w / 2.0

fn main()
    disc := inertia(Shape.Disc, 100.0, 0.5)
    rim := inertia(Shape.Rim, 100.0, 0.5)
    print("100 kg, 0.5 m radius: disc I {disc} kg m2, rim I {rim} kg m2")
    for rpm in [1000.0, 3000.0, 6000.0, 10000.0]
        a := energy(disc, rpm) / 1000.0
        b := energy(rim, rpm) / 1000.0
        wh := energy(rim, rpm) / 3600.0
        print("{rpm:>7.1} rpm: disc {a:>7.1} kJ, rim {b:>7.1} kJ ({wh:.1} Wh)")
    gain := energy(disc, 6000.0) - energy(disc, 3000.0)
    seconds := gain / 5000.0
    print("spinning the disc from 3000 to 6000 rpm with 5 kW takes {seconds:.1} s")

@test fn quadruple()
    i := inertia(Shape.Disc, 2.0, 1.0)
    assert((energy(i, 200.0) / energy(i, 100.0) - 4.0).abs() < 0.000001)
