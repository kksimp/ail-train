## Decathlon scoring: a running event scores A (B - T)^C for time T and a field event A (M - B)^C
## for mark M (jumps in cm), each truncated to whole points; five first-day events are totalled.

struct Event
    name str
    a float
    b float
    c float
    track bool

fn Event.points(self, mark float) int
    gap := if self.track then self.b - mark else mark - self.b
    if gap <= 0.0
        return 0
    (self.a * gap.pow(self.c)).to_int()

fn main()
    events := [Event(name: "100 m", a: 25.4347, b: 18.0, c: 1.81, track: true), Event(name: "long jump", a: 0.14354, b: 220.0, c: 1.4, track: false), Event(name: "shot put", a: 51.39, b: 1.5, c: 1.05, track: false), Event(name: "high jump", a: 0.8465, b: 75.0, c: 1.42, track: false), Event(name: "400 m", a: 1.53775, b: 82.0, c: 1.81, track: true)]
    athletes := [("Ruiz", [10.9, 720.0, 14.2, 201.0, 49.1]), ("Okafor", [11.3, 690.0, 15.8, 195.0, 50.6]), ("Berg", [10.6, 745.0, 13.1, 189.0, 47.9])]
    mut leader := ""
    mut pts := -1
    for ath in athletes
        name, marks := ath
        mut parts := List[str]()
        mut total := 0
        for i, ev in events.enumerate()
            p := ev.points(marks[i])
            total += p
            parts.push("{p}")
        joined := parts.join(" ")
        print("{name:<7} {joined} = {total}")
        if total > pts
            leader = name
            pts = total
    print("leader after day one: {leader} with {pts}")

@test fn no_points_when_slow()
    e := Event(name: "x", a: 1.0, b: 18.0, c: 2.0, track: true)
    assert_eq(e.points(19.0), 0)
    assert_eq(e.points(16.0), 4)
