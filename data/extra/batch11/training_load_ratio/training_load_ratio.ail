## Training load: the acute:chronic workload ratio divides the last 7 days' average load by the
## last 28 days' average; 0.8 to 1.3 is the safe zone and above 1.5 warns of injury risk.

fn mean(xs List[int]) float
    xs.fold(0, |acc, x| acc + x).to_float() / xs.len().to_float()

fn zone(r float) str
    if r < 0.8 then "undertrained" elif r <= 1.3 then "safe" elif r <= 1.5 then "caution" else "danger"

fn main()
    mut loads := List[int]()
    for day in 0..42
        base := if day % 7 == 6 then 0 else 300 + (day % 3) * 50
        extra := if day >= 35 then 250 else 0
        loads.push(base + extra)
    for day in [27, 30, 34, 37, 41]
        hi := day + 1
        acute := mean(loads[(day - 6)..hi])
        chronic := mean(loads[(day - 27)..hi])
        r := acute / chronic
        print("day {day + 1}: acute {acute:.1}, chronic {chronic:.1}, ratio {r:.2} ({zone(r)})")

@test fn zones()
    assert_eq(zone(1.0), "safe")
    assert_eq(zone(1.6), "danger")
