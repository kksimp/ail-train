## Dividend growth model: a share paying D0 now, growing at g a year, is worth D0 (1 + g) / (r - g)
## to an investor wanting return r; the model fails when g reaches r, reported as an error.

fn share_value(d0 float, g float, r float) float ! str
    if g >= r
        return "growth {g * 100.0:.1}% is not below the required {r * 100.0:.1}%"
    d0 * (1.0 + g) / (r - g)

fn main()
    shares := [("water utility", 2.4, 0.02), ("supermarket", 1.1, 0.04), ("software", 0.5, 0.07), ("start-up", 0.2, 0.12)]
    r := 0.09
    for sh in shares
        name, d0, g := sh
        if v := share_value(d0, g, r)
            yld := d0 * (1.0 + g) / v * 100.0
            print("{name:<14} dividend {d0}, growth {g * 100.0:.1}%: worth {v:.2} (yield {yld:.2}%)")
        else err
            print("{name:<14} cannot value: {err}")
    price := 30.0
    implied := r - 2.4 * 1.02 / price
    print("at a price of {price}, the utility implies growth of {implied * 100.0:.2}%")

@test fn simple_value()
    v := share_value(1.0, 0.0, 0.1) else 0.0
    assert((v - 10.0).abs() < 0.000001)
