## Pearson square: to blend two ingredients of strengths a and b into strength t, take |b - t| parts
## of the first and |a - t| parts of the second; used here for milk fat and sugar syrups.

fn blend(a float, b float, target float, batch float) List[float]?
    lo := if a < b then a else b
    hi := if a < b then b else a
    if target < lo or target > hi
        return none
    pa := (b - target).abs()
    pb := (a - target).abs()
    share := pa / (pa + pb)
    [batch * share, batch * (1.0 - share)]

fn main()
    jobs := [("single cream from double cream and milk", 48.0, 3.5, 18.0, 10.0), ("ice cream base from cream and milk", 36.0, 3.5, 12.0, 4.0), ("half-fat milk from whole and skim", 3.5, 0.1, 1.7, 20.0), ("syrup 30% from 65% and water", 65.0, 0.0, 30.0, 2.0), ("cream at 60% fat", 48.0, 3.5, 60.0, 1.0)]
    for jb in jobs
        name, a, b, t, batch := jb
        if parts := blend(a, b, t, batch)
            print("{name}: {parts[0]:.2} L of {a}% + {parts[1]:.2} L of {b}% = {batch} L")
        else
            print("{name}: impossible, the target is outside {b}% to {a}%")

@test fn halfway_mix()
    p := blend(10.0, 0.0, 5.0, 2.0) else [0.0, 0.0]
    assert_eq(p, [1.0, 1.0])
