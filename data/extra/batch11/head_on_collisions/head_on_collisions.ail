## Collisions in one dimension: an elastic collision keeps momentum and kinetic energy, giving
## v1' = ((m1 - m2) v1 + 2 m2 v2) / (m1 + m2); a sticking collision shares one speed and loses energy.

struct Body
    kg float
    v float

fn energy(bodies List[Body]) float
    bodies.fold(0.0, |acc, b| acc + 0.5 * b.kg * b.v * b.v)

fn elastic(a Body, b Body) List[Body]
    total := a.kg + b.kg
    va := ((a.kg - b.kg) * a.v + 2.0 * b.kg * b.v) / total
    vb := ((b.kg - a.kg) * b.v + 2.0 * a.kg * a.v) / total
    [Body(kg: a.kg, v: va), Body(kg: b.kg, v: vb)]

fn main()
    cases := [("snooker balls", Body(kg: 0.17, v: 2.0), Body(kg: 0.17, v: 0.0)), ("ball hits bowling ball", Body(kg: 0.5, v: 4.0), Body(kg: 7.0, v: 0.0)), ("truck meets car", Body(kg: 3000.0, v: 10.0), Body(kg: 1000.0, v: -15.0))]
    for cs in cases
        name, a, b := cs
        after := elastic(a, b)
        shared := (a.kg * a.v + b.kg * b.v) / (a.kg + b.kg)
        before_e := energy([a, b])
        stuck_e := energy([Body(kg: a.kg + b.kg, v: shared)])
        lost := (1.0 - stuck_e / before_e) * 100.0
        print("{name}: elastic {after[0].v:.2} and {after[1].v:.2} m/s; stuck together {shared:.2} m/s, losing {lost:.1}% of the energy")

@test fn equal_masses_swap()
    out := elastic(Body(kg: 1.0, v: 3.0), Body(kg: 1.0, v: 0.0))
    assert_eq(out[0].v, 0.0)
    assert_eq(out[1].v, 3.0)
