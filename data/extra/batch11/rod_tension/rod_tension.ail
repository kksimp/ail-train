## Rods in tension: stress is F / A, strain is stress / E and the rod stretches strain * L; the
## safety factor is yield stress over working stress, flagged when it falls under 2.

PI := 3.141592653589793

struct Material
    name str
    e_gpa float
    yield_mpa float

fn stress_mpa(force_n float, dia_mm float) float
    requires dia_mm > 0.0
    area := PI * dia_mm * dia_mm / 4.0
    force_n / area

fn main()
    mats := [Material(name: "mild steel", e_gpa: 200.0, yield_mpa: 250.0), Material(name: "aluminium", e_gpa: 69.0, yield_mpa: 95.0), Material(name: "titanium", e_gpa: 114.0, yield_mpa: 880.0), Material(name: "brass", e_gpa: 100.0, yield_mpa: 200.0)]
    force := 20000.0
    length := 2000.0
    for dia in [12.0, 16.0]
        s := stress_mpa(force, dia)
        print("{dia} mm rod, 20 kN: stress {s:.1} MPa")
        for m in mats
            strain := s / (m.e_gpa * 1000.0)
            stretch := strain * length
            factor := m.yield_mpa / s
            flag := if factor < 2.0 then " LOW" else ""
            print("  {m.name:<10} stretch {stretch:.3} mm, safety {factor:.2}{flag}")

@test fn unit_area()
    s := stress_mpa(PI, 2.0)
    assert((s - 1.0).abs() < 0.000001)
