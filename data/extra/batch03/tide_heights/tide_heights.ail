## Tide heights: hourly sea levels in centimetres; finds high and low tides as local turning
## points, the tidal range, and the hours the harbour is deep enough (at least 180 cm).

fn turning_points(h List[int]) List[(int, str)]
    mut out := List[(int, str)]()
    for i in 1..h.len() - 1
        if h[i] > h[i - 1] and h[i] >= h[i + 1]
            out.push((i, "high"))
        elif h[i] < h[i - 1] and h[i] <= h[i + 1]
            out.push((i, "low"))
    out

fn main()
    h := [120, 150, 185, 210, 220, 205, 170, 130, 95, 70, 62, 75, 105, 145, 190, 225, 238, 226, 190, 150, 110, 80, 66, 72]
    for t in turning_points(h)
        hour, kind := t
        print("{kind:<4} at {hour:02}:00, {h[hour]} cm")
    top := h.max() else 0
    bottom := h.min() else 0
    print("range {top - bottom} cm")
    deep := [i for i in 0..h.len() if h[i] >= 180]
    first_deep := deep.first() else -1
    print("deep enough: {deep.len()} hours, first at {first_deep}:00")

@test fn simple_peak()
    assert_eq(turning_points([1, 3, 2]), [(1, "high")])
