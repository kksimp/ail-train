## Turn grid: rotates a square grid a quarter turn clockwise by transposing and reversing
## each row, prints every rotation, and checks four turns give the original back.

fn rotate(g List[List[int]]) List[List[int]]
    n := g.len()
    [[g[n - 1 - r][c] for r in 0..n] for c in 0..n]

fn show(g List[List[int]])
    for row in g
        print("  " + row.map(|x| "{x:>2}").join(" "))

fn main()
    mut g := [[1, 2, 3], [4, 5, 6], [7, 8, 9]]
    start := g
    for turn in 1..=4
        g = rotate(g)
        print("after {turn}:")
        show(g)
    print("back to start: {g == start}")
    big := [[r * 4 + c for c in 0..4] for r in 0..4]
    print("4x4 corner after one turn: {rotate(big)[0][0]}")

@test fn single_cell()
    assert_eq(rotate([[7]]), [[7]])
