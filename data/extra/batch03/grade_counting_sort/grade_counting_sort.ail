## Grade counting sort: sorts exam marks from 0 to 100 by counting each mark, then lists
## them high to low with a running rank, giving tied marks the same rank.

fn counting_sort(marks List[int]) List[int]
    mut counts := [0 for _ in 0..=100]
    for m in marks
        counts[m] += 1
    mut out := List[int]()
    for v in 0..=100
        for _ in 0..counts[v]
            out.push(v)
    out

fn main()
    marks := [72, 85, 72, 91, 60, 85, 85, 44, 100, 72, 58]
    ordered := counting_sort(marks).reversed()
    mut rank := 0
    for i, m in ordered.enumerate()
        if i == 0 or m != ordered[i - 1]
            rank = i + 1
        print("{rank:>2}. {m}")
    distinct := ordered.counts().len()
    print("distinct marks: {distinct}")

@test fn sorts()
    assert_eq(counting_sort([3, 0, 3, 1]), [0, 1, 3, 3])
