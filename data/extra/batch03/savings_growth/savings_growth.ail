## Savings growth: compound interest with monthly deposits, worked in whole cents with
## interest rounded down each month, compared for three yearly rates over ten years.

fn grow(start int, monthly int, rate_bp int, months int) int
    mut balance := start
    for _ in 0..months
        balance += balance * rate_bp / 120000
        balance += monthly
    balance

fn money(c int) str
    "{c / 100:,}.{c % 100:02}"

fn main()
    for rate in [200, 450, 700]
        b := grow(100000, 15000, rate, 120)
        paid := 100000 + 15000 * 120
        print("{rate / 100}.{rate % 100:02}%: {money(b)} (interest {money(b - paid)})")
    mut months := 0
    mut b := 100000
    while b < 1000000
        b += b * 450 / 120000
        b += 15000
        months += 1
    print("10,000.00 reached at 4.50% after {months / 12} years {months % 12} months")

@test fn no_interest()
    assert_eq(grow(100, 10, 0, 3), 130)
