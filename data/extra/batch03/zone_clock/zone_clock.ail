## Zone clock: converts a meeting time in UTC to several cities' local times using offsets
## in minutes, showing the day shift when the local time crosses midnight.

fn local(utc_min int, offset int) str
    total := utc_min + offset
    mut day := ""
    if total < 0
        day = "-1 day"
    elif total >= 1440
        day = "+1 day"
    m := (total % 1440 + 1440) % 1440
    text := "{m / 60:02}:{m % 60:02}"
    if day == "" then text else "{text} ({day})"

fn main()
    cities := [("London", 0), ("Oslo", 60), ("Kolkata", 330), ("Tokyo", 540), ("Auckland", 780), ("New York", -300), ("Honolulu", -600)]
    for meeting in [(9, 30), (22, 0)]
        h, mi := meeting
        utc := h * 60 + mi
        print("meeting at {h:02}:{mi:02} UTC")
        for c in cities
            name, offset := c
            print("  {name:<9} {local(utc, offset)}")

@test fn wraps_forward()
    assert_eq(local(23 * 60, 120), "01:00 (+1 day)")
