## Bracket strings: every balanced string of n bracket pairs, generated by adding an opening
## bracket while any are left and a closing one while it stays balanced; counts are Catalan.

fn gen(open_left int, close_left int, prefix str, mut out List[str])
    if open_left == 0 and close_left == 0
        out.push(prefix)
        return
    if open_left > 0
        gen(open_left - 1, close_left, "{prefix}(", mut out)
    if close_left > open_left
        gen(open_left, close_left - 1, "{prefix})", mut out)

fn main()
    mut three := List[str]()
    gen(3, 3, "", mut three)
    print("3 pairs: {three.join(" ")}")
    for n in 1..=8
        mut out := List[str]()
        gen(n, n, "", mut out)
        print("{n} pairs: {out.len()}")

@test fn one_pair()
    mut out := List[str]()
    gen(1, 1, "", mut out)
    assert_eq(out, ["()"])
