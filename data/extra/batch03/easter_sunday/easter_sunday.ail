## Easter Sunday: the date of Western Easter for a range of years by the anonymous Gregorian
## algorithm, all in integer arithmetic, with the earliest and latest found.

fn easter(y int) (int, int)
    a := y % 19
    b := y / 100
    c := y % 100
    d := b / 4
    e := b % 4
    f := (b + 8) / 25
    g := (b - f + 1) / 3
    h := (19 * a + b - d - g + 15) % 30
    i := c / 4
    k := c % 4
    l := (32 + 2 * e + 2 * i - h - k) % 7
    m := (a + 11 * h + 22 * l) / 451
    month := (h + l - 7 * m + 114) / 31
    day := (h + l - 7 * m + 114) % 31 + 1
    (month, day)

fn show(md (int, int)) str
    month, day := md
    name := if month == 3 then "March" else "April"
    "{day} {name}"

fn main()
    for y in [2024, 2025, 2026, 2027, 2028, 2038]
        print("{y}: {show(easter(y))}")
    years := [y for y in 2000..2100]
    earliest := years.min(by: |y| easter(y).0 * 100 + easter(y).1) else 0
    latest := years.max(by: |y| easter(y).0 * 100 + easter(y).1) else 0
    print("earliest 2000-2099: {earliest} ({show(easter(earliest))})")
    print("latest 2000-2099: {latest} ({show(easter(latest))})")

@test fn known_year()
    assert_eq(easter(2024), (3, 31))
