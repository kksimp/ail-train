## Timesheet hours: clock-in and clock-out times as "HH:MM" text; works out each shift's
## length, splits weekly hours into regular (up to 40) and overtime, and rejects bad times.

fn minutes(t str) int?
    parts := t.split(":")
    if parts.len() != 2
        return none
    h := parts[0].to_int() else return none
    m := parts[1].to_int() else return none
    if h < 0 or h > 23 or m < 0 or m > 59
        return none
    h * 60 + m

fn hm(total int) str
    "{total / 60}:{total % 60:02}"

fn main()
    shifts := [("08:00", "16:30"), ("07:45", "17:15"), ("09:00", "18:00"), ("8:30", "17:00"), ("10:00", "25:00"), ("06:15", "15:45")]
    mut worked := 0
    for s in shifts
        start, stop := s
        a := minutes(start) else
            print("{start}-{stop}: bad time")
            continue
        b := minutes(stop) else
            print("{start}-{stop}: bad time")
            continue
        worked += b - a
        print("{start}-{stop}: {hm(b - a)}")
    regular := worked.min(40 * 60)
    print("total {hm(worked)}, regular {hm(regular)}, overtime {hm(worked - regular)}")

@test fn parse_time()
    assert_eq(minutes("01:05") else 0, 65)
    assert_eq(minutes("12:60"), none)
