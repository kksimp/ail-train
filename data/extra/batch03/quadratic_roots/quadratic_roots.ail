## Quadratic roots: solves ax^2 + bx + c = 0 with the discriminant, reporting two real roots,
## one repeated root, or a complex pair, and checking real roots by substitution.

fn solve(a float, b float, c float) str
    d := b * b - 4.0 * a * c
    if d > 0.0
        s := d.sqrt()
        r1 := (-b + s) / (2.0 * a)
        r2 := (-b - s) / (2.0 * a)
        return "roots {r1:.4} and {r2:.4}"
    if d == 0.0
        return "repeated root {-b / (2.0 * a):.4}"
    re := -b / (2.0 * a)
    im := (-d).sqrt() / (2.0 * a)
    "complex {re:.4} +/- {im:.4}i"

fn main()
    for q in [(1.0, -3.0, 2.0), (1.0, 2.0, 1.0), (1.0, 2.0, 5.0), (2.0, 5.0, -3.0), (1.0, -1.0, -1.0), (4.0, 4.0, 5.0)]
        a, b, c := q
        print("{a}x^2 + {b}x + {c}: {solve(a, b, c)}")

@test fn simple()
    assert_eq(solve(1.0, -3.0, 2.0), "roots 2.0000 and 1.0000")
