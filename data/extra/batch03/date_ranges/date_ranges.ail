## Date ranges: day-of-year ranges for bookings; finds overlapping pairs, merges them into
## busy periods, and lists the free gaps in the year's first 60 days.

fn overlaps(a (int, int), b (int, int)) bool
    a.0 <= b.1 and b.0 <= a.1

fn merge(ranges List[(int, int)]) List[(int, int)]
    mut out := List[(int, int)]()
    for r in ranges.sorted()
        if out.is_empty() or out[out.len() - 1].1 < r.0 - 1
            out.push(r)
        else
            last := out[out.len() - 1]
            out[out.len() - 1] = (last.0, last.1.max(r.1))
    out

fn main()
    bookings := [(3, 7), (10, 12), (6, 9), (20, 25), (13, 14), (40, 44), (24, 30)]
    for i in 0..bookings.len()
        for j in i + 1..bookings.len()
            if overlaps(bookings[i], bookings[j])
                print("overlap: {bookings[i]} and {bookings[j]}")
    busy := merge(bookings)
    print("busy: {busy}")
    mut gaps := List[(int, int)]()
    mut day := 1
    for b in busy
        if b.0 > day
            gaps.push((day, b.0 - 1))
        day = b.1 + 1
    if day <= 60
        gaps.push((day, 60))
    print("free: {gaps}")

@test fn touching_ranges_merge()
    assert_eq(merge([(1, 2), (3, 4)]), [(1, 4)])
