## Card war: two players flip the top cards of their decks; the higher card takes both, and
## equal cards each go back to their owner; plays a fixed deal for a number of rounds.

fn main()
    mut a := Deque[int]()
    mut b := Deque[int]()
    for v in [9, 2, 13, 5, 7, 11, 3, 8]
        a.push_back(v)
    for v in [4, 12, 6, 5, 10, 1, 14, 2]
        b.push_back(v)
    mut round := 0
    while round < 12 and a.len() > 0 and b.len() > 0
        round += 1
        x := a.pop_front() else break
        y := b.pop_front() else break
        if x > y
            a.push_back(x)
            a.push_back(y)
        elif y > x
            b.push_back(y)
            b.push_back(x)
        else
            a.push_back(x)
            b.push_back(y)
        if round % 4 == 0
            print("after round {round}: A has {a.len()}, B has {b.len()}")
    mut leader := "nobody"
    if a.len() > b.len()
        leader = "A"
    elif b.len() > a.len()
        leader = "B"
    print("{round} rounds, leader {leader}")

@test fn deque_order()
    mut d := Deque[int]()
    d.push_back(1)
    d.push_back(2)
    assert_eq(d.pop_front() else 0, 1)
