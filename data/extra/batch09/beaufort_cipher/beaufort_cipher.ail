## Beaufort cipher: each letter becomes (key letter - message letter) mod 26 with a repeating key,
## a reciprocal cipher: running the same operation on the ciphertext gives the message back.

fn beaufort(text str, key str) str
    ks := key.chars()
    mut out := List[char]()
    mut i := 0
    for c in text.chars()
        if c.is_upper()
            k := ks[i % ks.len()].code() - 65
            v := ((k - (c.code() - 65)) % 26 + 26) % 26
            out.push(char.from_code(v + 65) else '?')
            i += 1
        else
            out.push(c)
    out.join("")

fn main()
    key := "FORTIFICATION"
    for msg in ["DEFEND THE EAST WALL", "HOLD FAST", "SEND MORE FLARES"]
        code := beaufort(msg, key)
        back := beaufort(code, key)
        print("{msg:<21} -> {code:<21} -> {back}")
    same := beaufort("AAAA", "WXYZ")
    print("with all A the output is the key itself: {same}")

@test fn reciprocal()
    assert_eq(beaufort(beaufort("HELLO", "KEY"), "KEY"), "HELLO")
