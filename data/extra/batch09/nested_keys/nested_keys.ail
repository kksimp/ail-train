## Indented keys: reads YAML-like "key: value" lines where two more spaces of indent mean a child
## key, keeping a stack of parent names to print each value under its full dotted path.

fn main()
    lines := ["app:", "  name: shop", "  server:", "    host: 0.0.0.0", "    port: 8080", "  cache:", "    size: 64", "db:", "  path: data.db", "   pool: 4", "  user: admin", "logging: off"]
    mut stack := List[str]()
    mut count := 0
    for i, line in lines.enumerate()
        trimmed := line.trim_start()
        indent := line.len() - trimmed.len()
        if indent % 2 != 0 or indent / 2 > stack.len()
            print("line {i + 1}: bad indent of {indent} spaces")
            continue
        while stack.len() > indent / 2
            _ := stack.pop()
        parts := trimmed.split(":", 2)
        key := parts[0].trim()
        value := parts[1].trim()
        if value == ""
            stack.push(key)
        else
            prefix := stack.join(".")
            path := if prefix == "" then key else "{prefix}.{key}"
            print("{path} = {value}")
            count += 1
    print("{count} values read")

@test fn halves()
    assert_eq("a: b".split(":", 2).len(), 2)
