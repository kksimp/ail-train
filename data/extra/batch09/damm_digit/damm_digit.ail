## Damm check digit: each digit moves an interim value through a 10 by 10 quasigroup table that has
## zeros on its diagonal; the check digit is the final value, so a valid number ends at zero.

fn table() List[List[int]]
    [[0, 3, 1, 7, 5, 9, 8, 6, 4, 2], [7, 0, 9, 2, 1, 5, 4, 8, 6, 3], [4, 2, 0, 6, 8, 7, 1, 3, 5, 9], [1, 7, 5, 0, 9, 8, 3, 4, 2, 6], [6, 1, 2, 3, 0, 4, 5, 9, 7, 8], [3, 6, 7, 4, 2, 0, 9, 5, 8, 1], [5, 8, 6, 9, 7, 2, 0, 1, 3, 4], [8, 9, 4, 5, 3, 6, 2, 0, 1, 7], [9, 4, 3, 8, 6, 1, 7, 2, 0, 5], [2, 5, 8, 1, 4, 3, 6, 7, 9, 0]]

fn interim(digits List[int]) int
    t := table()
    mut v := 0
    for d in digits
        v = t[v][d]
    v

fn main()
    for num in [[5, 7, 2], [1, 2, 3, 4, 5], [9, 8, 7, 6], [2, 0, 2, 6, 1, 1]]
        c := interim(num)
        shown := num.join("")
        print("{shown} -> check digit {c}, full number {shown}{c}")
    base := [3, 1, 4, 1, 5, 9, 2, 6]
    mut full := base
    full.push(interim(base))
    mut swaps := 0
    mut caught := 0
    for i in 0..full.len() - 1
        if full[i] != full[i + 1]
            mut bad := full
            bad.swap(i, i + 1)
            swaps += 1
            if interim(bad) != 0
                caught += 1
    mut typos := 0
    mut spotted := 0
    for i in 0..full.len()
        for d in 0..10
            if d != full[i]
                mut typo := full
                typo[i] = d
                typos += 1
                if interim(typo) != 0
                    spotted += 1
    digits := full.join("")
    print("{digits}: {caught} of {swaps} neighbour swaps and {spotted} of {typos} typos caught")

@test fn known()
    assert_eq(interim([5, 7, 2, 4]), 0)
