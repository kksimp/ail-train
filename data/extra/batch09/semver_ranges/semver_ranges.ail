## Version ranges: a caret range allows changes that keep the first non-zero part, a tilde range only
## patch changes, plus >= and exact matches; versions compare part by part through a derived ordering.

struct Version
    major int
    minor int
    patch int

impl Ord for Version

fn parse(s str) Version
    p := s.split(".").map(|x| x.to_int() else 0)
    Version(major: p[0], minor: p[1], patch: p[2])

fn upper(v Version, op str) Version
    if op == "~" or v.major == 0
        return Version(major: v.major, minor: v.minor + 1, patch: 0)
    Version(major: v.major + 1, minor: 0, patch: 0)

fn satisfies(v Version, spec str) bool
    if spec.starts_with(">=")
        return v >= parse(spec.slice(2))
    if spec.starts_with("^") or spec.starts_with("~")
        low := parse(spec.slice(1))
        high := upper(low, spec.slice(0, 1))
        return v >= low and v < high
    v == parse(spec)

fn main()
    versions := ["0.9.4", "1.0.0", "1.2.3", "1.2.9", "1.3.0", "1.10.1", "2.0.0", "0.2.5", "0.3.0"]
    for spec in ["^1.2.3", "~1.2.3", "^0.2.1", ">=1.3.0", "1.2.9"]
        hits := versions.filter(|s| satisfies(parse(s), spec))
        shown := if hits.is_empty() then "none" else hits.join(" ")
        print("{spec:<8} {shown}")
    newest := versions.map(|s| parse(s)).max() else parse("0.0.0")
    print("newest: {newest.major}.{newest.minor}.{newest.patch}")

@test fn ordering()
    assert(parse("1.10.0") > parse("1.9.9"))
