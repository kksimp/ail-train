1 + 2 * 3            (1 + (2 * 3))                = 7
(1 + 2) * 3          ((1 + 2) * 3)                = 9
2 ^ 3 ^ 2            (2 ^ (3 ^ 2))                = 512
- 2 ^ 2              (-(2 ^ 2))                   = -4
10 - 4 - 3           ((10 - 4) - 3)               = 3
64 / 4 / 2           ((64 / 4) / 2)               = 8
2 * (3 + 4) ^ 2 - 1  ((2 * ((3 + 4) ^ 2)) - 1)    = 97
