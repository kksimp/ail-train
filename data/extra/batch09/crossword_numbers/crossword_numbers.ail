## Crossword numbering: scanning row by row, a white square gets the next number when it starts an
## across entry (no white square to its left, one to its right) or a down entry (the same, vertically).

fn open(g List[List[char]], r int, c int) bool
    r >= 0 and c >= 0 and r < g.len() and c < g[0].len() and g[r][c] != '#'

fn read(g List[List[char]], r int, c int, dr int, dc int) str
    mut out := List[char]()
    mut i := r
    mut j := c
    while open(g, i, j)
        out.push(g[i][j])
        i += dr
        j += dc
    out.join("")

fn main()
    rows := ["SPA#C", "HOLDS", "ORE#A", "PET#R", "#S#BY"]
    g := rows.map(|r| r.chars())
    mut n := 0
    mut across := List[str]()
    mut down := List[str]()
    for r in 0..g.len()
        mut cells := List[str]()
        for c in 0..g[0].len()
            if not open(g, r, c)
                cells.push("##")
                continue
            starts_across := not open(g, r, c - 1) and open(g, r, c + 1)
            starts_down := not open(g, r - 1, c) and open(g, r + 1, c)
            if starts_across or starts_down
                n += 1
                cells.push("{n:>2}")
                if starts_across
                    across.push("{n} {read(g, r, c, 0, 1)}")
                if starts_down
                    down.push("{n} {read(g, r, c, 1, 0)}")
            else
                cells.push(" .")
        print(cells.join(" "))
    shown_across := across.join(", ")
    shown_down := down.join(", ")
    print("across: {shown_across}")
    print("down: {shown_down}")

@test fn edges()
    g := ["A#"].map(|r| r.chars())
    assert(not open(g, 0, 1))
