## Randomised quicksort: always taking the first element as pivot needs n(n-1)/2 comparisons on sorted input, while
## a pivot chosen by a seeded generator expects about 2 n ln n on any input; comparisons are counted for both.

struct Lcg
    state int

fn Lcg.next(mut self, n int) int
    self.state = (self.state * 1103515245 + 12345) % 2147483648
    (self.state >> 8) % n

fn sort(mut xs List[int], lo int, hi int, random bool, mut rng Lcg, mut count List[int])
    if lo >= hi
        return
    if random
        xs.swap(lo, lo + rng.next(hi - lo + 1))
    pivot := xs[lo]
    mut store := lo
    from := lo + 1
    for i in from..=hi
        count[0] += 1
        if xs[i] < pivot
            store += 1
            xs.swap(store, i)
    xs.swap(lo, store)
    sort(mut xs, lo, store - 1, random, mut rng, mut count)
    sort(mut xs, store + 1, hi, random, mut rng, mut count)

fn comparisons(input List[int], random bool, seed int) int
    mut xs := input
    mut rng := Lcg(state: seed)
    mut count := [0]
    sort(mut xs, 0, xs.len() - 1, random, mut rng, mut count)
    count[0]

fn main()
    n := 300
    sorted_in := [k for k in 0..n]
    mut shuffled := sorted_in
    mut rng := Lcg(state: 77)
    mut i := n - 1
    while i > 0
        shuffled.swap(i, rng.next(i + 1))
        i -= 1
    print("{n} keys; n(n-1)/2 = {n * (n - 1) / 2}")
    print("first pivot,  sorted input:   {comparisons(sorted_in, false, 1):>6}")
    print("first pivot,  shuffled input: {comparisons(shuffled, false, 1):>6}")
    for seed in [1, 2, 3]
        print("random pivot (seed {seed}), sorted: {comparisons(sorted_in, true, seed):>6}")

@test fn sorts()
    mut xs := [5, 3, 9, 1, 7]
    mut rng := Lcg(state: 4)
    mut count := [0]
    sort(mut xs, 0, 4, true, mut rng, mut count)
    assert_eq(xs, [1, 3, 5, 7, 9])
