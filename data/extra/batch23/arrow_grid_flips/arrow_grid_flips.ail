## 0-1 breadth-first search: on a grid of arrows, stepping the way a cell's arrow points is free and any other
## step costs one flip; a deque takes free steps at the front and paid ones at the back, giving the fewest flips.

fn min_flips(grid List[str]) int
    rows := grid.len()
    cols := grid[0].len()
    cells := [line.chars() for line in grid]
    mut dist := List[int]()
    count := rows * cols
    for _ in 0..count
        dist.push(1000000)
    dist[0] = 0
    mut dq := Deque[int]()
    dq.push_back(0)
    dr := [0, 0, 1, -1]
    dc := [1, -1, 0, 0]
    arrows := ['>', '<', 'v', '^']
    while u := dq.pop_front()
        r := u / cols
        c := u % cols
        for k in 0..4
            nr := r + dr[k]
            nc := c + dc[k]
            if nr >= 0 and nr < rows and nc >= 0 and nc < cols
                w := if cells[r][c] == arrows[k] then 0 else 1
                v := nr * cols + nc
                if dist[u] + w < dist[v]
                    dist[v] = dist[u] + w
                    if w == 0
                        dq.push_front(v)
                    else
                        dq.push_back(v)
    dist[rows * cols - 1]

fn main()
    grids := [[">>>>", "<<<<", ">>>>", "<<<<"], [">v<", "^<v", "<^<"], ["v>>v", ">^<v", "^<>v", "<<<>"]]
    for g in grids
        for line in g
            print(line)
        print("fewest flips from top-left to bottom-right: {min_flips(g)}")

@test fn free_path()
    assert_eq(min_flips([">>v", "<<v"]), 0)
