## Betweenness centrality (Brandes): a breadth-first search from each person counts shortest paths (sigma), then
## dependencies flow back in reverse order, delta(v) += sigma(v) / sigma(w) * (1 + delta(w)); halved for undirected.

fn betweenness(n int, links List[List[int]]) List[float]
    mut adj := List[List[int]]()
    mut score := List[float]()
    for _ in 0..n
        adj.push(List[int]())
        score.push(0.0)
    for l in links
        adj[l[0]].push(l[1])
        adj[l[1]].push(l[0])
    for s in 0..n
        mut sigma := List[int]()
        mut dist := List[int]()
        mut delta := List[float]()
        for v in 0..n
            sigma.push(0)
            dist.push(-1)
            delta.push(0.0)
        sigma[s] = 1
        dist[s] = 0
        mut order := [s]
        mut head := 0
        while head < order.len()
            u := order[head]
            head += 1
            for w in adj[u]
                if dist[w] < 0
                    dist[w] = dist[u] + 1
                    order.push(w)
                if dist[w] == dist[u] + 1
                    sigma[w] += sigma[u]
        mut i := order.len() - 1
        while i > 0
            node := order[i]
            for v in adj[node]
                if dist[v] == dist[node] - 1
                    delta[v] += sigma[v].to_float() / sigma[node].to_float() * (1.0 + delta[node])
            score[node] += delta[node]
            i -= 1
    [x / 2.0 for x in score]

fn main()
    names := ["Amy", "Bob", "Cal", "Dee", "Eli", "Fay", "Gil", "Hal"]
    links := [[0, 1], [0, 2], [1, 2], [2, 3], [3, 4], [3, 5], [4, 5], [5, 6], [6, 7], [4, 6]]
    b := betweenness(names.len(), links)
    ranked := [i for i in 0..names.len()].sorted(by: |k| -b[k])
    for i in ranked
        print("{names[i]:<4} {b[i]:>6.2}")

@test fn star_centre()
    b := betweenness(4, [[0, 1], [0, 2], [0, 3]])
    assert_eq(b[0], 3.0)
    assert_eq(b[1], 0.0)
