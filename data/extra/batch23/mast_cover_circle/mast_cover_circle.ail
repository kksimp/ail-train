## Smallest enclosing circle (Welzl's incremental method): after a seeded shuffle, each point outside the current
## circle must lie on the new boundary, so circles through one, two or three points are rebuilt as needed.

struct Circle
    x float
    y float
    r float

fn Circle.holds(self, p List[float]) bool
    dx := p[0] - self.x
    dy := p[1] - self.y
    (dx * dx + dy * dy).sqrt() <= self.r + 0.000000001

fn through_two(a List[float], b List[float]) Circle
    dx := a[0] - b[0]
    dy := a[1] - b[1]
    Circle(x: (a[0] + b[0]) / 2.0, y: (a[1] + b[1]) / 2.0, r: (dx * dx + dy * dy).sqrt() / 2.0)

fn through_three(a List[float], b List[float], c List[float]) Circle
    d := 2.0 * (a[0] * (b[1] - c[1]) + b[0] * (c[1] - a[1]) + c[0] * (a[1] - b[1]))
    sa := a[0] * a[0] + a[1] * a[1]
    sb := b[0] * b[0] + b[1] * b[1]
    sc := c[0] * c[0] + c[1] * c[1]
    ux := (sa * (b[1] - c[1]) + sb * (c[1] - a[1]) + sc * (a[1] - b[1])) / d
    uy := (sa * (c[0] - b[0]) + sb * (a[0] - c[0]) + sc * (b[0] - a[0])) / d
    dx := a[0] - ux
    dy := a[1] - uy
    Circle(x: ux, y: uy, r: (dx * dx + dy * dy).sqrt())

fn enclose(points List[List[int]], seed int) Circle
    mut ps := [[p[0].to_float(), p[1].to_float()] for p in points]
    mut s := seed
    mut i := ps.len() - 1
    while i > 0
        s = (s * 1103515245 + 12345) % 2147483648
        j := s / 65536 % (i + 1)
        ps.swap(i, j)
        i -= 1
    mut c := Circle(x: ps[0][0], y: ps[0][1], r: 0.0)
    for a in 1..ps.len()
        if not c.holds(ps[a])
            c = Circle(x: ps[a][0], y: ps[a][1], r: 0.0)
            for b in 0..a
                if not c.holds(ps[b])
                    c = through_two(ps[a], ps[b])
                    for k in 0..b
                        if not c.holds(ps[k])
                            c = through_three(ps[a], ps[b], ps[k])
    c

fn main()
    houses := [[2, 3], [9, 1], [5, 8], [12, 6], [7, 4], [3, 9], [10, 10], [6, 0], [1, 6]]
    for seed in [1, 7, 42]
        c := enclose(houses, seed)
        print("seed {seed:>2}: mast at ({c.x:.3}, {c.y:.3}), range {c.r:.3}")
    tri := enclose([[0, 0], [6, 0], [0, 8]], 3)
    print("right triangle 6-8-10: range {tri.r}, centre ({tri.x}, {tri.y})")

@test fn diameter()
    assert_eq(enclose([[0, 0], [4, 0]], 9).r, 2.0)
