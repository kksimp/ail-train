## Largest clear square: on a field map (. clear, T tree) the biggest square ending at a cell has side
## 1 + min(above, left, diagonal); one pass over the map finds the largest square plot with no trees.

fn biggest(field List[str]) List[int]
    rows := field.len()
    cols := field[0].len()
    mut side := List[List[int]]()
    mut best := 0
    mut br := 0
    mut bc := 0
    for r in 0..rows
        cs := field[r].chars()
        mut row := List[int]()
        for c in 0..cols
            mut v := 0
            if cs[c] == '.'
                v = 1
                if r > 0 and c > 0
                    v = 1 + side[r - 1][c].min(row[c - 1]).min(side[r - 1][c - 1])
            row.push(v)
            if v > best
                best = v
                br = r
                bc = c
        side.push(row)
    [best, br - best + 1, bc - best + 1]

fn main()
    field := ["..T.......", ".....T....", "T.........", ".......T..", "...T......", "..........", ".T.....T..", "....T....."]
    for line in field
        print(line)
    b := biggest(field)
    print("largest clear square: {b[0]} x {b[0]}, top-left at row {b[1]}, column {b[2]}")
    marked := biggest(["...", "...", "..T"])
    print("3 x 3 with one tree in a corner: {marked[0]} x {marked[0]}")

@test fn all_clear()
    assert_eq(biggest(["..", ".."])[0], 2)
