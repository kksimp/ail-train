## Longest balanced run of brackets: scan with a stack of indices that starts with -1; a ')' pops, and if the stack is
## then empty its index becomes the new base, otherwise the span back to the top of the stack is balanced.

fn longest(s str) List[int]
    mut stack := [-1]
    mut best := 0
    mut start := 0
    mut i := 0
    for c in s.chars()
        if c == '('
            stack.push(i)
        else
            _ := stack.pop()
            if stack.len() == 0
                stack.push(i)
            else
                span := i - stack[stack.len() - 1]
                if span > best
                    best = span
                    start = stack[stack.len() - 1] + 1
        i += 1
    [best, start]

fn main()
    for s in ["(()", ")()())", "()(()", "(()())())(", ")(((((()())()()))()(()))(", "))((", "()()()"]
        r := longest(s)
        stop := r[1] + r[0]
        piece := if r[0] == 0 then "-" else s.slice(r[1], stop)
        print("{s:<26} longest {r[0]:>2} at {r[1]:>2}: {piece}")

@test fn sample()
    assert_eq(longest(")()())"), [4, 1])
