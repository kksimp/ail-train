## Sum of distances in a tree by rerooting: one pass from the root gives subtree sizes and the root's total; moving
## the root to a child v then changes the total by n - 2 size(v), so every village's total costs O(1) more.

fn filled(n int, v int) List[int]
    mut out := List[int]()
    for _ in 0..n
        out.push(v)
    out

fn distance_sums(n int, edges List[List[int]]) List[int]
    mut adj := List[List[int]]()
    for _ in 0..n
        adj.push(List[int]())
    for e in edges
        adj[e[0]].push(e[1])
        adj[e[1]].push(e[0])
    mut parent := filled(n, -1)
    mut depth := filled(n, 0)
    mut order := [0]
    mut head := 0
    while head < order.len()
        u := order[head]
        head += 1
        for v in adj[u]
            if v != parent[u] and v != 0
                parent[v] = u
                depth[v] = depth[u] + 1
                order.push(v)
    mut size := filled(n, 1)
    mut i := n - 1
    while i >= 1
        size[parent[order[i]]] += size[order[i]]
        i -= 1
    mut ans := filled(n, 0)
    ans[0] = depth.sum()
    for j in 1..n
        node := order[j]
        ans[node] = ans[parent[node]] - size[node] + (n - size[node])
    ans

fn main()
    names := ["Ash", "Birch", "Cedar", "Dale", "Elm", "Fern", "Glen", "Holt", "Ivy"]
    tracks := [[0, 1], [0, 2], [1, 3], [1, 4], [2, 5], [5, 6], [5, 7], [7, 8]]
    sums := distance_sums(names.len(), tracks)
    for v in 0..names.len()
        print("{names[v]:<6} total walk to all others: {sums[v]:>2}")
    best := sums.min() else 0
    winners := [names[v] for v in 0..names.len() if sums[v] == best]
    shown := winners.join(", ")
    print("best meeting village: {shown} ({best})")

@test fn path_of_three()
    assert_eq(distance_sums(3, [[0, 1], [1, 2]]), [3, 2, 3])
