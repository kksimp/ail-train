## The 24 game: combine four numbers with + - * / and brackets to reach exactly 24; any two values are merged into
## one (both orders for - and /), recursively, with exact fractions so 8 / (3 - 8 / 3) is found too.

struct Frac
    num int
    den int

fn gcd(a int, b int) int
    if b == 0 then a else gcd(b, a % b)

fn frac(n int, d int) Frac
    g := gcd(n.abs(), d.abs()).max(1)
    s := if d < 0 then -1 else 1
    Frac(num: s * n / g, den: s * d / g)

fn search(vals List[Frac], exprs List[str]) str
    n := vals.len()
    if n == 1
        return if vals[0].num == 24 and vals[0].den == 1 then exprs[0] else ""
    for i in 0..n
        for j in 0..n
            if i != j
                rest := [k for k in 0..n if k != i and k != j]
                a := vals[i]
                b := vals[j]
                mut opts := List[Frac]()
                mut texts := List[str]()
                if i < j
                    opts.push(frac(a.num * b.den + b.num * a.den, a.den * b.den))
                    texts.push("({exprs[i]}+{exprs[j]})")
                    opts.push(frac(a.num * b.num, a.den * b.den))
                    texts.push("({exprs[i]}*{exprs[j]})")
                opts.push(frac(a.num * b.den - b.num * a.den, a.den * b.den))
                texts.push("({exprs[i]}-{exprs[j]})")
                if b.num != 0
                    opts.push(frac(a.num * b.den, a.den * b.num))
                    texts.push("({exprs[i]}/{exprs[j]})")
                for o in 0..opts.len()
                    mut nv := [vals[k2] for k2 in rest]
                    nv.push(opts[o])
                    mut ne := [exprs[k3] for k3 in rest]
                    ne.push(texts[o])
                    found := search(nv, ne)
                    if found != ""
                        return found
    ""

fn solve(hand List[int]) str
    vals := [frac(x, 1) for x in hand]
    exprs := ["{x}" for x in hand]
    e := search(vals, exprs)
    if e == "" then "no way" else e.slice(1, e.len() - 1)

fn main()
    for hand in [[4, 7, 8, 8], [1, 5, 5, 5], [3, 3, 8, 8], [6, 6, 6, 6], [1, 1, 1, 1], [2, 3, 5, 12], [1, 3, 4, 6]]
        print("{hand}: {solve(hand)}")

@test fn impossible()
    assert_eq(solve([1, 1, 1, 1]), "no way")
