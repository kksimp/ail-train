## Typo distance with swaps: optimal string alignment adds a fourth move to Levenshtein's table, swapping two
## neighbouring letters for cost 1, so "form" to "from" costs 1 instead of 2; each pair is scored both ways.

fn distance(a str, b str, swaps bool) int
    xs := a.chars()
    ys := b.chars()
    n := xs.len()
    m := ys.len()
    mut d := List[List[int]]()
    for i in 0..=n
        mut row := List[int]()
        for j in 0..=m
            first := if i == 0 then j elif j == 0 then i else 0
            row.push(first)
        d.push(row)
    for i in 1..=n
        for j in 1..=m
            cost := if xs[i - 1] == ys[j - 1] then 0 else 1
            mut best := (d[i - 1][j] + 1).min(d[i][j - 1] + 1).min(d[i - 1][j - 1] + cost)
            if swaps and i > 1 and j > 1 and xs[i - 1] == ys[j - 2] and xs[i - 2] == ys[j - 1]
                best = best.min(d[i - 2][j - 2] + 1)
            d[i][j] = best
    d[n][m]

fn main()
    pairs := [("form", "from"), ("recieve", "receive"), ("teh", "the"), ("acress", "caress"), ("kitten", "sitting"), ("abcdef", "badcfe"), ("ca", "abc")]
    mut saved := 0
    for pair in pairs
        a, b := pair
        lev := distance(a, b, false)
        osa := distance(a, b, true)
        saved += lev - osa
        print("{a:<8} {b:<8} levenshtein {lev}  with swaps {osa}")
    print("swaps saved {saved} edits in total")

@test fn one_swap()
    assert_eq(distance("ca", "ac", true), 1)
    assert_eq(distance("ca", "ac", false), 2)
