## Negative cycle search: Bellman-Ford from a virtual start (every distance 0) relaxes n times; a change in the last
## round means a loop of paths and time portals with negative total time, found by stepping back n predecessors.

fn find_cycle(n int, edges List[List[int]]) List[int]
    mut dist := [0 for x in 0..n]
    mut pred := [-1 for y in 0..n]
    mut last := -1
    for round in 0..n
        last = -1
        for e in edges
            if dist[e[0]] + e[2] < dist[e[1]]
                dist[e[1]] = dist[e[0]] + e[2]
                pred[e[1]] = e[0]
                last = e[1]
    if last < 0
        return List[int]()
    mut v := last
    for step in 0..n
        v = pred[v]
    mut cycle := [v]
    mut u := pred[v]
    while u != v
        cycle.push(u)
        u = pred[u]
    cycle.reverse()
    cycle

fn cost(edges List[List[int]], a int, b int) int
    for e in edges
        if e[0] == a and e[1] == b
            return e[2]
    0

fn show(title str, names List[str], edges List[List[int]])
    cycle := find_cycle(names.len(), edges)
    if cycle.len() == 0
        print("{title}: no loop goes back in time")
        return
    mut total := 0
    mut parts := List[str]()
    for i in 0..cycle.len()
        a := cycle[i]
        total += cost(edges, a, cycle[(i + 1) % cycle.len()])
        parts.push(names[a])
    parts.push(names[cycle[0]])
    route := parts.join(" -> ")
    print("{title}: {route} arrives {-total} hours before it left")

fn main()
    names := ["barn", "pond", "mill", "well", "orchard"]
    fair := [[0, 1, 3], [1, 2, 2], [2, 3, 4], [3, 0, -5], [1, 4, 1], [4, 2, 2], [3, 4, 6]]
    for e in fair
        print("  {names[e[0]]:<7} -> {names[e[1]]:<7} {e[2]:>3}")
    show("farm 1", names, fair)
    tilted := [[0, 1, 3], [1, 2, 2], [2, 3, 4], [3, 0, -5], [1, 4, 1], [4, 2, -4], [3, 4, 6]]
    show("farm 2", names, tilted)

@test fn two_node_loop()
    assert_eq(find_cycle(2, [[0, 1, 1], [1, 0, -3]]).len(), 2)
