## Exact cover by Knuth's Algorithm X: choose the uncovered item with the fewest candidate sets, try each set that
## holds it, drop every set that clashes with it, and recurse; a solution uses every item exactly once.

fn search(sets List[List[int]], items List[int], alive List[bool], mut chosen List[int], mut found List[str], mut nodes List[int])
    nodes[0] += 1
    if items.len() == 0
        mut names := List[str]()
        for pos in chosen
            letter := char.from_code(65 + pos) else '?'
            names.push("{letter}")
        found.push(names.join(" "))
        return
    mut pick := -1
    mut fewest := 1000
    for it in items
        c := [s for s in 0..sets.len() if alive[s] and sets[s].contains(it)].len()
        if c < fewest
            fewest = c
            pick = it
    for s in 0..sets.len()
        if alive[s] and sets[s].contains(pick)
            mut next_alive := alive
            for t in 0..sets.len()
                if next_alive[t] and sets[t].any(|x| sets[s].contains(x))
                    next_alive[t] = false
            rest := items.filter(|x| not sets[s].contains(x))
            chosen.push(s)
            search(sets, rest, next_alive, mut chosen, mut found, mut nodes)
            _ := chosen.pop()

fn solve(title str, sets List[List[int]], n int)
    items := [i for i in 1..=n]
    alive := [true for s in sets]
    mut chosen := List[int]()
    mut found := List[str]()
    mut nodes := [0]
    search(sets, items, alive, mut chosen, mut found, mut nodes)
    shown := if found.len() == 0 then "none" else found.join(" | ")
    print("{title}: {found.len()} exact covers ({nodes[0]} search nodes): {shown}")

fn main()
    knuth := [[1, 4, 7], [1, 4], [4, 5, 7], [3, 5, 6], [2, 3, 6, 7], [2, 7]]
    solve("Knuth's example", knuth, 7)
    teams := [[1, 2, 3], [4, 5, 6], [7, 8, 9], [1, 4, 7], [2, 5, 8], [3, 6, 9], [1, 5, 9], [3, 5, 7], [2, 6, 7], [4, 8, 3]]
    solve("teams of three for 9 people", teams, 9)
    none_case := [[1, 2], [2, 3], [1, 3]]
    solve("pairs over 3 items", none_case, 3)

@test fn simple_cover()
    mut chosen := List[int]()
    mut found := List[str]()
    mut nodes := [0]
    search([[1], [2], [1, 2]], [1, 2], [true, true, true], mut chosen, mut found, mut nodes)
    assert_eq(found.len(), 2)
