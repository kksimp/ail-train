## Counting shortest routes: Dijkstra's search on a tram network also carries, for every stop, how many routes
## reach it at the best time; an equal-time arrival adds its count and a faster one replaces it.

fn routes(n int, links List[List[int]], src int) List[List[int]]
    mut adj := List[List[List[int]]]()
    mut dist := List[int]()
    mut ways := List[int]()
    for _ in 0..n
        adj.push(List[List[int]]())
        dist.push(1000000)
        ways.push(0)
    for l in links
        adj[l[0]].push([l[1], l[2]])
        adj[l[1]].push([l[0], l[2]])
    dist[src] = 0
    ways[src] = 1
    mut h := Heap[int]()
    h.push(src)
    while code := h.pop()
        d := code / 100
        u := code % 100
        if d > dist[u]
            continue
        for e in adj[u]
            v := e[0]
            nd := d + e[1]
            if nd < dist[v]
                dist[v] = nd
                ways[v] = ways[u]
                h.push(nd * 100 + v)
            elif nd == dist[v]
                ways[v] += ways[u]
    [dist, ways]

fn main()
    stops := ["Depot", "Market", "Bridge", "Park", "School", "Museum", "Harbour", "Airport"]
    links := [[0, 1, 4], [0, 2, 3], [1, 3, 2], [2, 3, 3], [1, 4, 5], [3, 4, 3], [3, 5, 4], [4, 6, 2], [5, 6, 1], [2, 5, 7], [6, 7, 6], [4, 7, 8]]
    result := routes(stops.len(), links, 0)
    for v in 1..stops.len()
        print("{stops[v]:<8} {result[0][v]:>2} min, {result[1][v]} shortest routes")

@test fn square()
    r := routes(4, [[0, 1, 1], [1, 3, 1], [0, 2, 1], [2, 3, 1]], 0)
    assert_eq(r[1][3], 2)
