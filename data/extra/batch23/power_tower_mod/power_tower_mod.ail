## Power towers mod m: a^a^...^a is far too big to write, but a^E mod m only needs E mod phi(m) (plus phi(m) once E is
## at least phi(m)), so recursing down the chain m, phi(m), phi(phi(m)), ... gives the last digits; they settle quickly.

fn phi(m int) int
    mut result := m
    mut x := m
    mut p := 2
    while p * p <= x
        if x % p == 0
            while x % p == 0
                x = x / p
            result = result / p * (p - 1)
        p += 1
    if x > 1
        result = result / x * (x - 1)
    result

fn pow_mod(a int, e int, m int) int
    mut x := 1 % m
    mut base := a % m
    mut k := e
    while k > 0
        if (k & 1) == 1
            x = x * base % m
        base = base * base % m
        k = k >> 1
    x

fn capped(a int, h int, cap int) int
    mut v := 1
    for _ in 0..h
        mut r := 1
        mut i := 0
        while i < v and r < cap
            r = r * a
            i += 1
        v = r.min(cap)
    v

fn tower(a int, h int, m int) int
    if m == 1
        return 0
    if h == 0
        return 1 % m
    p := phi(m)
    true_exp := capped(a, h - 1, p)
    e := if true_exp < p then true_exp else tower(a, h - 1, p) + p
    pow_mod(a, e, m)

fn main()
    print("3^3^3 = 7625597484987 ends {tower(3, 3, 1000000)}, 2^2^2^2 = 65536 ends {tower(2, 4, 1000)}")
    for h in 1..=8
        print("{h} threes: last 8 digits {tower(3, h, 100000000):08}")
    for h in 3..=6
        print("{h} twos:   last 6 digits {tower(2, h, 1000000):06}")

@test fn small_towers()
    assert_eq(tower(3, 3, 1000), 987)
    assert_eq(tower(2, 4, 1000), 536)
