## Cheapest triangulation of a convex polygon: cost(i, j) = min over k between them of cost(i, k) + cost(k, j) +
## w_i w_k w_j, where a triangle's price is the product of its corner weights; stored splits list the triangles.

fn solve(w List[int], mut cost List[List[int]], mut cut List[List[int]])
    n := w.len()
    for i in 0..n
        mut row := List[int]()
        mut crow := List[int]()
        for col in 0..n
            row.push(0)
            crow.push(-1)
        cost.push(row)
        cut.push(crow)
    for gap in 2..n
        stop := n - gap
        for i in 0..stop
            j := i + gap
            lo := i + 1
            mut best := -1
            for k in lo..j
                c := cost[i][k] + cost[k][j] + w[i] * w[k] * w[j]
                if best < 0 or c < best
                    best = c
                    cut[i][j] = k
            cost[i][j] = best

fn triangles(cut List[List[int]], i int, j int, mut out List[str])
    if j - i < 2
        return
    k := cut[i][j]
    out.push("{i}-{k}-{j}")
    triangles(cut, i, k, mut out)
    triangles(cut, k, j, mut out)

fn main()
    for w in [[1, 2, 3], [3, 7, 4, 5], [1, 3, 1, 4, 1, 5], [5, 2, 8, 1, 6, 3, 7]]
        mut cost := List[List[int]]()
        mut cut := List[List[int]]()
        solve(w, mut cost, mut cut)
        mut out := List[str]()
        triangles(cut, 0, w.len() - 1, mut out)
        shown := out.join(" ")
        print("weights {w}: cost {cost[0][w.len() - 1]} using {shown}")

@test fn square()
    mut cost := List[List[int]]()
    mut cut := List[List[int]]()
    solve([3, 7, 4, 5], mut cost, mut cut)
    assert_eq(cost[0][3], 144)
