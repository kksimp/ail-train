## Painting a row of houses: no two neighbours may share a colour; cost(i, c) = price(i, c) + the cheapest other
## colour for house i - 1, and following the stored choices back gives the cheapest colour plan.

enum Paint
    Red
    Green
    Blue

fn plan(prices List[List[int]]) List[int]
    n := prices.len()
    mut cost := [prices[0]]
    mut from := [[-1, -1, -1]]
    for i in 1..n
        mut row := List[int]()
        mut via := List[int]()
        for c in 0..3
            mut best := -1
            for p in 0..3
                if p != c and (best < 0 or cost[i - 1][p] < cost[i - 1][best])
                    best = p
            row.push(prices[i][c] + cost[i - 1][best])
            via.push(best)
        cost.push(row)
        from.push(via)
    mut pick := 0
    for k in 1..3
        if cost[n - 1][k] < cost[n - 1][pick]
            pick = k
    mut colours := List[int]()
    mut at := n - 1
    while at >= 0
        colours.push(pick)
        pick = from[at][pick]
        at -= 1
    colours.reverse()
    colours.push(cost[n - 1][colours[n - 1]])
    colours

fn main()
    prices := [[17, 2, 17], [16, 16, 5], [14, 3, 19], [6, 12, 8], [11, 9, 4], [3, 15, 10], [8, 7, 13]]
    result := plan(prices)
    names := Paint.variants()
    for i in 0..prices.len()
        p := names[result[i]]
        print("house {i + 1}: {p.name():<5} costs {prices[i][result[i]]}")
    print("total {result[prices.len()]}")

@test fn two_houses()
    assert_eq(plan([[1, 5, 5], [1, 5, 2]]), [0, 2, 3])
