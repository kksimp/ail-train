## Hamiltonian cycle by backtracking: extend a path to an unused neighbour, undo on a dead end, and accept a full
## path whose last vertex touches the first; Hamilton's dodecahedron has one, the Petersen graph has none.

fn build(n int, edges List[List[int]]) List[List[int]]
    mut adj := List[List[int]]()
    for _ in 0..n
        adj.push(List[int]())
    for e in edges
        adj[e[0]].push(e[1])
        adj[e[1]].push(e[0])
    adj

fn extend(adj List[List[int]], mut path List[int], mut used List[bool], mut steps List[int]) bool
    steps[0] += 1
    last := path[path.len() - 1]
    if path.len() == adj.len()
        return adj[last].contains(path[0])
    for v in adj[last]
        if not used[v]
            used[v] = true
            path.push(v)
            if extend(adj, mut path, mut used, mut steps)
                return true
            _ := path.pop()
            used[v] = false
    false

fn tour(name str, adj List[List[int]])
    mut used := List[bool]()
    for i in 0..adj.len()
        used.push(i == 0)
    mut path := [0]
    mut steps := [0]
    if extend(adj, mut path, mut used, mut steps)
        shown := path.join("-")
        print("{name}: cycle {shown}-0")
    else
        print("{name}: no Hamiltonian cycle")
    print("  {steps[0]} search steps")

fn main()
    dodeca := [[0, 1], [1, 2], [2, 3], [3, 4], [4, 0], [0, 5], [1, 7], [2, 9], [3, 11], [4, 13], [5, 6], [6, 7], [7, 8], [8, 9], [9, 10], [10, 11], [11, 12], [12, 13], [13, 14], [14, 5], [6, 15], [8, 16], [10, 17], [12, 18], [14, 19], [15, 16], [16, 17], [17, 18], [18, 19], [19, 15]]
    petersen := [[0, 1], [1, 2], [2, 3], [3, 4], [4, 0], [0, 5], [1, 6], [2, 7], [3, 8], [4, 9], [5, 7], [7, 9], [9, 6], [6, 8], [8, 5]]
    tour("dodecahedron", build(20, dodeca))
    tour("petersen", build(10, petersen))
    tour("square", build(4, [[0, 1], [1, 2], [2, 3], [3, 0]]))

@test fn square_cycle()
    adj := build(4, [[0, 1], [1, 2], [2, 3], [3, 0]])
    mut path := [0]
    mut used := [true, false, false, false]
    mut steps := [0]
    assert(extend(adj, mut path, mut used, mut steps))
