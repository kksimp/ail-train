## Solovay-Strassen primality test: for a prime n every base a has a^((n-1)/2) = (a/n) mod n, where the Jacobi symbol
## (a/n) comes from quadratic reciprocity; composites fail for at least half the bases, even Carmichael numbers.

fn jacobi(a0 int, n0 int) int
    mut a := a0 % n0
    mut n := n0
    mut t := 1
    while a != 0
        while a % 2 == 0
            a = a / 2
            r := n % 8
            if r == 3 or r == 5
                t = -t
        tmp := a
        a = n
        n = tmp
        if a % 4 == 3 and n % 4 == 3
            t = -t
        a = a % n
    if n == 1 then t else 0

fn pow_mod(a int, e int, n int) int
    mut x := 1
    mut base := a % n
    mut k := e
    while k > 0
        if (k & 1) == 1
            x = x * base % n
        base = base * base % n
        k = k >> 1
    x

fn passes(a int, n int) bool
    j := jacobi(a, n)
    j != 0 and pow_mod(a, (n - 1) / 2, n) == (j + n) % n

fn main()
    syms := [jacobi(q, 15) for q in 1..15]
    print("(a/15) for a = 1..14: {syms}")
    for n in [91, 561, 1105, 1729, 15841]
        mut fermat := 0
        mut euler := 0
        for w in 1..n
            if pow_mod(w, n - 1, n) == 1
                fermat += 1
            if passes(w, n)
                euler += 1
        print("{n:>5}: Fermat liars {fermat:>5}, Euler liars {euler:>4} of {n - 1}")
    mut state := 7
    for n in [7919, 1729, 104729, 999999937, 999999929]
        mut verdict := "probably prime"
        for _ in 0..10
            state = (state * 1103515245 + 12345) % 2147483648
            pick := 2 + (state >> 8) % (n - 3)
            if not passes(pick, n)
                verdict = "composite"
        print("{n}: {verdict}")

@test fn symbol()
    assert_eq(jacobi(2, 15), 1)
