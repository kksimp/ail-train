## Counting topological orders: dp[mask] is the number of ways to put on exactly the clothes in mask first; an item
## may come next when every item it needs is already in mask, so dp[full] counts every valid dressing order.

fn count_orders(n int, pre List[int]) int
    total := 1 << n
    mut dp := List[int]()
    for _ in 0..total
        dp.push(0)
    dp[0] = 1
    for mask in 0..total
        if dp[mask] > 0
            for v in 0..n
                bit := 1 << v
                if (mask & bit) == 0 and (pre[v] & mask) == pre[v]
                    dp[mask | bit] += dp[mask]
    dp[total - 1]

fn needs(names List[str], rules List[List[str]]) List[int]
    mut pre := List[int]()
    for _ in 0..names.len()
        pre.push(0)
    for r in rules
        a := names.index_of(r[0]) else 0
        b := names.index_of(r[1]) else 0
        pre[b] = pre[b] | (1 << a)
    pre

fn main()
    names := ["vest", "shirt", "tie", "jacket", "pants", "belt", "socks", "shoes", "watch"]
    mut rules := List[List[str]]()
    print("no rules: {count_orders(names.len(), needs(names, rules))} orders")
    for r in [["vest", "shirt"], ["shirt", "tie"], ["tie", "jacket"], ["shirt", "belt"], ["pants", "belt"], ["belt", "jacket"], ["pants", "shoes"], ["socks", "shoes"], ["shirt", "watch"]]
        rules.push(r)
        c := count_orders(names.len(), needs(names, rules))
        print("+ {r[0]} before {r[1]}: {c} orders")

@test fn chain_and_free()
    assert_eq(count_orders(3, [0, 1, 2]), 1)
    assert_eq(count_orders(3, [0, 0, 0]), 6)
