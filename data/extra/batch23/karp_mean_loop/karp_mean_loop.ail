## Karp's minimum mean cycle: D[k][v] is the cheapest walk of exactly k legs ending at v (from anywhere); the best
## loop average is min over v of max over k of (D[n][v] - D[k][v]) / (n - k), compared as exact fractions.

INF := 1000000000

fn gcd(a int, b int) int
    if b == 0 then a else gcd(b, a % b)

fn min_mean(n int, edges List[List[int]]) List[int]
    mut d := List[List[int]]()
    mut start := List[int]()
    for _ in 0..n
        start.push(0)
    d.push(start)
    for k in 1..=n
        mut row := List[int]()
        for v in 0..n
            row.push(INF)
        for e in edges
            before := d[k - 1][e[0]]
            if before < INF and before + e[2] < row[e[1]]
                row[e[1]] = before + e[2]
        d.push(row)
    mut best_num := 0
    mut best_den := 0
    for v in 0..n
        if d[n][v] < INF
            mut wn := 0
            mut wd := 0
            for k in 0..n
                if d[k][v] < INF
                    num := d[n][v] - d[k][v]
                    den := n - k
                    if wd == 0 or num * wd > wn * den
                        wn = num
                        wd = den
            if wd > 0 and (best_den == 0 or wn * best_den < best_num * wd)
                best_num = wn
                best_den = wd
    if best_den == 0
        return [0, 0]
    g := gcd(best_num, best_den)
    [best_num / g, best_den / g]

fn main()
    graphs := [("depot loops", 5, [[0, 1, 4], [1, 2, 2], [2, 0, 3], [2, 3, 1], [3, 4, 2], [4, 2, 4], [1, 3, 5]]), ("ferry ring", 4, [[0, 1, 1], [1, 0, 5], [1, 2, 2], [2, 1, 2], [2, 3, 6], [3, 2, 4]]), ("one-way chain", 4, [[0, 1, 3], [1, 2, 3], [2, 3, 3]])]
    for g in graphs
        name, n, edges := g
        m := min_mean(n, edges)
        if m[1] == 0
            print("{name}: no loop at all")
        else
            avg := m[0].to_float() / m[1].to_float()
            print("{name}: cheapest loop averages {m[0]}/{m[1]} = {avg:.3} per leg")

@test fn two_way_pair()
    assert_eq(min_mean(2, [[0, 1, 2], [1, 0, 4]]), [3, 1])
