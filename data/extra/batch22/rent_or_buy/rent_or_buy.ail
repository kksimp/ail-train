## Rent or buy: over ten years a renter pays rent rising 3% a year and invests the 60,000 deposit at 5%;
## a buyer pays the mortgage and 1.5% upkeep while the home gains 3%; net wealth after costs decides.

fn grow(v int, pct int) int
    v * (100 + pct) / 100

fn main()
    mut rent := 1500
    mut invested := 60000
    mut rent_paid := 0
    mut value := 300000
    mut owed := 240000
    mut own_paid := 60000
    payment := 17268
    mut first_ahead := 0
    for year in 1..=10
        rent_paid += rent * 12
        rent = grow(rent, 3)
        invested = grow(invested, 5)
        upkeep := value * 15 / 1000
        own_paid += payment + upkeep
        owed = owed + owed * 6 / 100 - payment
        value = grow(value, 3)
        renter := invested - rent_paid
        owner := value - owed - own_paid
        if owner > renter and first_ahead == 0
            first_ahead = year
        if year % 2 == 0
            print("year {year:>2}: renter net {renter:>8}, owner net {owner:>8}, owed {owed}")
    if first_ahead > 0
        print("buying pulls ahead in year {first_ahead}")
    else
        print("renting stays ahead for all ten years")

@test fn three_percent()
    assert_eq(grow(1000, 3), 1030)
