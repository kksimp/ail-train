## Tariff effects: with demand 200 - 2p, home supply 2p - 20 and a world price of 40, a tariff t raises the home
## price to 40 + t; imports shrink, the state collects t per import, and two triangles of 2t^2 in all are lost.

fn demand(p int) int
    (200 - 2 * p).max(0)

fn supply(p int) int
    (2 * p - 20).max(0)

fn main()
    world := 40
    d0 := demand(world)
    s0 := supply(world)
    print("free trade: demand {d0}, home supply {s0}, imports {d0 - s0}")
    for t in [3, 6, 9, 12, 15]
        p := world + t
        d := demand(p)
        s := supply(p)
        imports := (d - s).max(0)
        revenue := t * imports
        consumers := t * (d0 + d) / 2
        producers := t * (s0 + s) / 2
        lost := consumers - producers - revenue
        print("tariff {t:>2}: price {p}, imports {imports:>3}, revenue {revenue:>3}, consumers lose {consumers:>4}, producers gain {producers:>4}, deadweight {lost}")

@test fn deadweight_formula()
    t := 6
    d := demand(46)
    s := supply(46)
    lost := t * (120 + d) / 2 - t * (60 + s) / 2 - t * (d - s)
    assert_eq(lost, 2 * t * t)
