## Hub and spoke: five depots swap pallets every day; trucking every lane direct is compared with sending all
## freight through a central hub, where loads merge into fuller trucks; trucks of 26 pallets, distances in km.

fn dist(a List[int], b List[int]) int
    (a[0] - b[0]).abs() + (a[1] - b[1]).abs()

fn trucks(pallets int) int
    (pallets + 25) / 26

fn main()
    names := ["A", "B", "C", "D", "E"]
    at := [[0, 40], [35, 10], [20, -30], [-25, -25], [-40, 15]]
    hub := [0, 0]
    demand := [[0, 8, 5, 12, 3], [6, 0, 9, 4, 7], [10, 3, 0, 6, 2], [4, 11, 7, 0, 5], [2, 6, 9, 3, 0]]
    mut pallets := 0
    mut direct_trucks := 0
    mut direct_km := 0
    for i in 0..5
        for j in 0..5
            if demand[i][j] > 0
                n := trucks(demand[i][j])
                pallets += demand[i][j]
                direct_trucks += n
                direct_km += n * dist(at[i], at[j])
    mut hub_trucks := 0
    mut hub_km := 0
    for k in 0..5
        out := demand[k].fold(0, |a, d| a + d)
        inn := demand.fold(0, |a, row| a + row[k])
        n := trucks(out) + trucks(inn)
        hub_trucks += n
        hub_km += n * dist(at[k], hub)
        print("{names[k]}: sends {out}, receives {inn}, {n} hub trucks over {dist(at[k], hub)} km")
    print("direct: 20 lanes, {direct_trucks} trucks, {direct_km} truck-km, fill {pallets * 100 / (direct_trucks * 26)}%")
    print("hub: 10 lanes, {hub_trucks} trucks, {hub_km} truck-km, fill {pallets * 200 / (hub_trucks * 26)}%")

@test fn truck_count()
    assert_eq(trucks(26), 1)
    assert_eq(trucks(27), 2)
