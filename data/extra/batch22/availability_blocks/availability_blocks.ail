## Availability blocks: a part is up MTBF / (MTBF + MTTR) of the time; parts in series multiply their availabilities,
## a spare in parallel fails only when both do, 1 - (1 - A)^2; one pump is compared with two side by side.

fn avail(mtbf float, mttr float) float
    mtbf / (mtbf + mttr)

fn parallel(a float) float
    down := 1.0 - a
    1.0 - down * down

fn main()
    pump := avail(1200.0, 24.0)
    control := avail(5000.0, 8.0)
    valve := avail(2500.0, 12.0)
    print("pump {pump:.5}, controller {control:.5}, valve {valve:.5}")
    single := pump * control * valve
    double := parallel(pump) * control * valve
    for d in [("one pump", single), ("two pumps", double)]
        name, a := d
        hours := (1.0 - a) * 8760.0
        print("{name:<9}: available {a:.5}, down about {hours:.1} hours a year")

@test fn spare_helps()
    assert_eq(parallel(0.5), 0.75)
    assert_eq(avail(90.0, 10.0), 0.9)
