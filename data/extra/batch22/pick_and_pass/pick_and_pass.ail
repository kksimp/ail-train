## Pick and pass: totes ride a conveyor through three pick zones in a fixed order; a zone works one tote at a
## time, so each tote leaves a zone at max(it arrived, the zone freed up) + its lines; the busiest zone sets the pace.

fn finish_times(lines List[List[int]]) List[List[int]]
    mut done := List[List[int]]()
    for o in 0..lines.len()
        mut row := List[int]()
        for z in 0..3
            arrived := if z == 0 then 0 else row[z - 1]
            freed := if o == 0 then 0 else done[o - 1][z]
            row.push(arrived.max(freed) + lines[o][z])
        done.push(row)
    done

fn main()
    lines := [[3, 1, 4], [2, 5, 1], [4, 2, 2], [1, 3, 5], [2, 2, 3]]
    done := finish_times(lines)
    for o in 0..lines.len()
        print("tote {o + 1}: lines {lines[o]}, leaves zones at {done[o]}")
    last := done[lines.len() - 1][2]
    for z in 0..3
        busy := lines.fold(0, |a, l| a + l[z])
        print("zone {z + 1}: busy {busy} of {last} minutes ({busy * 100 / last}%)")

@test fn one_tote()
    assert_eq(finish_times([[1, 2, 3]]), [[1, 3, 6]])
