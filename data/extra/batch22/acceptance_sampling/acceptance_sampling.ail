## Acceptance sampling: a lot is accepted when a sample of n holds at most c defectives; the binomial chance of
## that across defect rates is the plan's operating curve, and p x P(accept) is the outgoing quality after sorting.

fn accept_chance(n int, c int, p float) float
    q := 1.0 - p
    mut term := 1.0
    for _ in 0..n
        term *= q
    mut total := term
    for k in 0..c
        term = term * (n - k).to_float() / (k + 1).to_float() * p / q
        total += term
    total

fn main()
    print("rate   n=50,c=2   n=80,c=3   outgoing")
    for pct in [1, 2, 3, 4, 6, 8, 10]
        p := pct.to_float() / 100.0
        a := accept_chance(50, 2, p)
        b := accept_chance(80, 3, p)
        aoq := p * a * 100.0
        print("{pct:>3}%   {a:>8.4}   {b:>8.4}   {aoq:>6.3}%")

@test fn perfect_lots()
    assert_eq(accept_chance(50, 2, 0.0), 1.0)
