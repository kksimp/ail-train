## Net to gross: a payment promised "after deductions" is grossed up by binary search over whole cents for
## the smallest gross whose net (8% social above 500, tax bands of 0%, 20% and 40%) reaches the target.

fn net(gross int) int
    social := (gross - 50000).max(0) * 8 / 100
    band1 := (gross.min(400000) - 100000).max(0)
    band2 := (gross - 400000).max(0)
    tax := band1 * 20 / 100 + band2 * 40 / 100
    gross - social - tax

fn gross_for(target int) int
    mut lo := target
    mut hi := target * 3
    while lo < hi
        mid := (lo + hi) / 2
        if net(mid) >= target
            hi = mid
        else
            lo = mid + 1
    lo

fn money(c int) str
    cents := c % 100
    "{c / 100}.{cents:02}"

fn main()
    for target in [80000, 250000, 500000, 900000]
        g := gross_for(target)
        cost := g - net(g)
        pct := cost * 1000 / g
        print("net {money(target):>7} needs gross {money(g):>8} (deductions {money(cost)}, {pct / 10}.{pct % 10}%)")

@test fn below_tax()
    assert_eq(net(100000), 96000)
