## Service variability (Pollaczek-Khinchine): with Poisson arrivals at rate l, mean service 1/m and service variance
## v, the mean queue is (l^2 v + r^2) / (2 (1 - r)); at the same load, steadier service halves the queue.

fn queue_len(lam float, mean float, spread float) float
    r := lam * mean
    (lam * lam * spread + r * r) / (2.0 * (1.0 - r))

fn main()
    lam := 0.8
    kinds := [("fixed", 0.0), ("two-phase", 0.5), ("exponential", 1.0), ("very uneven", 4.0)]
    print("arrivals 0.8 a minute, service 1 minute on average")
    for k in kinds
        name, spread := k
        lq := queue_len(lam, 1.0, spread)
        wq := lq / lam
        total := lq + lam
        print("{name:<12} variance {spread:.1}: waiting {lq:.3}, wait {wq:.3} min, in system {total:.3}")
    for load in [5, 7, 9]
        l := load.to_float() / 10.0
        a := queue_len(l, 1.0, 0.0)
        b := queue_len(l, 1.0, 1.0)
        print("load 0.{load}: fixed {a:.3} against exponential {b:.3}")

@test fn half_load_fixed()
    assert_eq(queue_len(0.5, 1.0, 0.0), 0.25)
