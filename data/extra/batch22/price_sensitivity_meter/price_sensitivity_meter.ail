## Price sensitivity meter: each shopper names a too-cheap, cheap, expensive and too-expensive price; counting
## answers at each price, the optimal point is where too expensive first meets too cheap, the indifference point where expensive meets cheap.

struct Answer
    too_cheap int
    cheap int
    dear int
    too_dear int

fn main()
    raw := [[10, 15, 25, 35], [12, 18, 30, 40], [8, 14, 22, 30], [15, 20, 35, 50], [10, 16, 28, 38], [14, 22, 32, 45], [9, 13, 20, 28], [11, 17, 26, 36], [13, 19, 30, 42], [10, 15, 24, 33]]
    answers := [Answer(too_cheap: r[0], cheap: r[1], dear: r[2], too_dear: r[3]) for r in raw]
    mut optimal := 0
    mut indifferent := 0
    print("price  too-cheap  cheap  expensive  too-expensive")
    for i in 0..9
        p := 10 + 5 * i
        tc := answers.count(|a| a.too_cheap >= p)
        ch := answers.count(|a| a.cheap >= p)
        ex := answers.count(|a| a.dear <= p)
        te := answers.count(|a| a.too_dear <= p)
        print("{p:>5}  {tc:>9}  {ch:>5}  {ex:>9}  {te:>13}")
        if optimal == 0 and te >= tc
            optimal = p
        if indifferent == 0 and ex >= ch
            indifferent = p
    print("optimal price point about {optimal}, indifference point about {indifferent}")

@test fn counting()
    a := [Answer(too_cheap: 10, cheap: 15, dear: 25, too_dear: 35)]
    assert_eq(a.count(|x| x.too_dear <= 40), 1)
