## Debt avalanche and snowball: 600 a month pays four debts' minimums and the rest goes to one target debt,
## the highest rate first (avalanche) or the smallest balance first (snowball); months and interest compared, in cents.

struct Run
    months int
    interest int
    done List[int]

BALANCES := [450000, 120000, 800000, 250000]
RATES := [2199, 2499, 649, 999]
MINIMUMS := [9000, 4000, 25000, 6000]

fn pay_down(order List[int]) Run
    mut bal := BALANCES
    rates := RATES
    mins := MINIMUMS
    mut done := [0, 0, 0, 0]
    mut months := 0
    mut interest := 0
    while bal.any(|b| b > 0) and months < 600
        months += 1
        mut spare := 60000
        for i in 0..4
            if bal[i] > 0
                charge := bal[i] * rates[i] / 120000
                interest += charge
                bal[i] += charge
                part := mins[i].min(bal[i])
                bal[i] -= part
                spare -= part
        for i in order
            part := spare.min(bal[i])
            bal[i] -= part
            spare -= part
        for i in 0..4
            if bal[i] == 0 and done[i] == 0
                done[i] = months
    Run(months: months, interest: interest, done: done)

fn money(c int) str
    cents := c % 100
    "{c / 100}.{cents:02}"

fn main()
    names := ["card", "store", "car", "loan"]
    for i in 0..4
        frac := RATES[i] % 100
        print("{names[i]:<5} {money(BALANCES[i]):>7} at {RATES[i] / 100}.{frac:02}%, minimum {money(MINIMUMS[i])}")
    plans := [("avalanche", [1, 0, 3, 2]), ("snowball", [1, 3, 0, 2])]
    for plan in plans
        label, order := plan
        r := pay_down(order)
        mut parts := List[str]()
        for i in order
            parts.push("{names[i]} {r.done[i]}")
        joined := parts.join(", ")
        print("{label:<9}: debt free in {r.months} months, interest {money(r.interest)}; cleared {joined}")

@test fn avalanche_months()
    assert_eq(pay_down([1, 0, 3, 2]).months, 32)
