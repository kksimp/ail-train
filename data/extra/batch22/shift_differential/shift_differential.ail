## Shift differential: pay is added up minute by minute, with 1.50 an hour extra from 18:00 to 23:00 and
## 3.00 an hour extra from 23:00 to 07:00 on a 20.00 base rate; shifts may run past midnight.

fn rate_at(minute int) int
    h := (minute % 1440) / 60
    if h >= 18 and h < 23
        return 2150
    if h >= 23 or h < 7
        return 2300
    2000

fn shift_pay(start int, finish int) int
    mut total := 0
    for m in start..finish
        total += rate_at(m)
    total / 60

fn clock(m int) str
    h := (m % 1440) / 60
    mm := m % 60
    "{h:02}:{mm:02}"

fn money(c int) str
    cents := c % 100
    "{c / 100}.{cents:02}"

fn main()
    shifts := [("Mon", 540, 1020), ("Tue", 840, 1320), ("Wed", 1320, 1860), ("Thu", 1080, 1590), ("Sat", 300, 780)]
    mut week := 0
    mut extra := 0
    for s in shifts
        day, a, b := s
        pay := shift_pay(a, b)
        plain := (b - a) * 2000 / 60
        week += pay
        extra += pay - plain
        print("{day} {clock(a)}-{clock(b)}: {money(pay):>6} (premium {money(pay - plain)})")
    print("week {money(week)}, of which premium {money(extra)}")

@test fn day_shift()
    assert_eq(shift_pay(540, 1020), 16000)
