## Reinsurance layers: the insurer keeps each claim up to 100, a first layer pays the next 200 (200 xs 100), a
## second the next 500 (500 xs 300), and anything above 800 falls back on the insurer; amounts in thousands.

fn layer(claim int, attach int, size int) int
    (claim - attach).max(0).min(size)

fn main()
    claims := [40, 130, 260, 450, 900, 75, 320]
    mut kept := 0
    mut first := 0
    mut second := 0
    for c in claims
        l1 := layer(c, 100, 200)
        l2 := layer(c, 300, 500)
        own := c - l1 - l2
        kept += own
        first += l1
        second += l2
        print("claim {c:>3}: insurer {own:>3}, layer 1 {l1:>3}, layer 2 {l2:>3}")
    total := kept + first + second
    print("totals: insurer {kept}, layer 1 {first}, layer 2 {second} of {total}")
    hit := claims.count(|c| c > 300)
    print("{hit} claims reached the second layer")

@test fn bands()
    assert_eq(layer(900, 100, 200), 200)
    assert_eq(layer(900, 300, 500), 500)
    assert_eq(layer(50, 100, 200), 0)
