## Capital gains netting: sales held over a year are long-term, the rest short-term; each group is netted, a
## net loss in one offsets the other, rates are 30% short and 15% long, and at most 3,000 of loss is deducted a year.

struct Sale
    name str
    held int
    gain int

struct Outcome
    short int
    long int
    tax int
    deduct int
    carry int

fn settle(sales List[Sale], carry_in int) Outcome
    mut st := 0 - carry_in
    mut lt := 0
    for s in sales
        if s.held > 365
            lt += s.gain
        else
            st += s.gain
    mixed := st + lt
    if st < 0 and lt > 0
        if mixed >= 0
            lt = mixed
            st = 0
        else
            st = mixed
            lt = 0
    elif lt < 0 and st > 0
        if mixed >= 0
            st = mixed
            lt = 0
        else
            lt = mixed
            st = 0
    tax := st.max(0) * 30 / 100 + lt.max(0) * 15 / 100
    loss := 0 - (st.min(0) + lt.min(0))
    deduct := loss.min(3000)
    Outcome(short: st, long: lt, tax: tax, deduct: deduct, carry: loss - deduct)

fn main()
    years := [[Sale(name: "A", held: 200, gain: 5000), Sale(name: "B", held: 400, gain: -8000), Sale(name: "C", held: 90, gain: -2000), Sale(name: "D", held: 800, gain: 12000)], [Sale(name: "E", held: 30, gain: -9000), Sale(name: "F", held: 500, gain: 2000), Sale(name: "G", held: 100, gain: 1500)], [Sale(name: "H", held: 60, gain: 4000), Sale(name: "I", held: 700, gain: 6000)]]
    mut carry := 0
    for i, sales in years.enumerate()
        o := settle(sales, carry)
        print("year {i + 1}: short {o.short:>6}, long {o.long:>6}, tax {o.tax:>5}, deducted {o.deduct}, carried {o.carry}")
        carry = o.carry

@test fn loss_carries()
    o := settle([Sale(name: "x", held: 10, gain: -5000)], 0)
    assert_eq(o.deduct, 3000)
    assert_eq(o.carry, 2000)
