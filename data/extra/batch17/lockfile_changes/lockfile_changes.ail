## Lock file changes: compares two dependency lock lists and reports packages added, removed, upgraded
## or downgraded, naming whether each upgrade is a major, minor or patch step by comparing version parts as numbers.

fn parts(v str) List[int]
    v.split(".").map(|p| p.to_int() else 0)

fn compare(a str, b str) int
    pa := parts(a)
    pb := parts(b)
    for i in 0..3
        if pa[i] != pb[i]
            return if pa[i] < pb[i] then -1 else 1
    0

fn step(a str, b str) str
    pa := parts(a)
    pb := parts(b)
    if pa[0] != pb[0] then "major" elif pa[1] != pb[1] then "minor" else "patch"

fn main()
    old := {"react": "18.2.0", "lodash": "4.17.20", "axios": "0.27.2", "left-pad": "1.3.0", "express": "4.18.2", "chalk": "5.3.0"}
    new := {"react": "18.3.1", "lodash": "4.17.21", "axios": "1.6.0", "express": "4.18.2", "chalk": "4.1.2", "zod": "3.22.4"}
    mut counts := Map[str, int]()
    for name in old.keys().sorted()
        before := old[name]
        if after := new.get(name)
            c := compare(before, after)
            if c < 0
                kind := step(before, after)
                print("upgrade   {name:<9} {before} -> {after} ({kind})")
                counts[kind] += 1
            elif c > 0
                print("DOWNGRADE {name:<9} {before} -> {after}")
                counts["downgrade"] += 1
        else
            print("removed   {name:<9} {before}")
            counts["removed"] += 1
    for name in new.keys().sorted()
        if not old.contains(name)
            print("added     {name:<9} {new[name]}")
            counts["added"] += 1
    mut summary := List[str]()
    for k, v in counts
        summary.push("{v} {k}")
    shown := summary.join(", ")
    print("summary: {shown}")

@test fn numeric_parts()
    assert_eq(compare("1.10.0", "1.9.9"), 1)
    assert_eq(step("0.27.2", "1.6.0"), "major")
