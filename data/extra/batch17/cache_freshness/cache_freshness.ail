## Cache freshness: a shared cache reads Cache-Control (no-store, no-cache, s-maxage over max-age) and
## compares the response's lifetime with its current age (the Age header plus time spent in the cache).

fn directives(h str) Map[str, int]
    mut out := Map[str, int]()
    for part in h.split(",")
        p := part.trim().to_lower()
        if p == ""
            continue
        eq := p.find("=") else -1
        if eq < 0
            out[p] = -1
        else
            out[p.slice(0, eq)] = p.slice(eq + 1).to_int() else 0
    out

fn verdict(cc str, age int, resident int) str
    d := directives(cc)
    if d.contains("no-store")
        return "not stored"
    if d.contains("no-cache")
        return "stored, revalidate every time"
    lifetime := d.get("s-maxage") else (d.get("max-age") else 0)
    current := age + resident
    if lifetime > current
        return "fresh for {lifetime - current} more s"
    "stale by {current - lifetime} s"

fn main()
    cases := [("public, max-age=600", 30, 200), ("max-age=600, s-maxage=60", 0, 90), ("no-store", 0, 0), ("no-cache, max-age=3600", 10, 5), ("private, max-age=300", 280, 30), ("MAX-AGE=86400", 3600, 7200), ("", 0, 10)]
    for c in cases
        cc, age, resident := c
        shown := if cc == "" then "(none)" else cc
        print("{shown:<26} age {age:>4}+{resident:<4} {verdict(cc, age, resident)}")

@test fn shared_max()
    assert_eq(verdict("max-age=100, s-maxage=10", 0, 20), "stale by 10 s")
