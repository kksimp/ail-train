## Cut ranges: like the cut tool, a list such as "1,3-4" or "-2,5-" picks fields (or characters) by
## 1-based position; open ends run to the edge, and each position appears once, in order, whatever the list order.

fn picked(spec str, n int) List[int]
    mut keep := Set[int]()
    for part in spec.split(",")
        dash := part.find("-") else -1
        mut lo := 1
        mut hi := n
        if dash < 0
            lo = part.to_int() else 1
            hi = lo
        else
            if dash > 0
                lo = part.slice(0, dash).to_int() else 1
            if dash + 1 < part.len()
                hi = part.slice(dash + 1).to_int() else n
        for p in lo..=hi.min(n)
            keep.add(p)
    keep.sorted()

fn main()
    rows := ["id:name:shell:home:uid", "1:root:/bin/sh:/root:0", "2:ana:/bin/zsh:/home/ana:1000", "3:ben:/bin/bash:/home/ben:1001"]
    for spec in ["2", "1,3-4", "4-,1"]
        print("-f {spec}")
        for r in rows.slice(1)
            fields := r.split(":")
            idx := picked(spec, fields.len())
            picked_fields := idx.map(|i| fields[i - 1])
            joined := picked_fields.join(":")
            print("  {joined}")
    word := "2025-03-12T10:44:09"
    cs := word.chars()
    chosen := picked("1-4,12-", cs.len()).map(|i| cs[i - 1])
    short := chosen.join("")
    print("-c 1-4,12- {word} -> {short}")

@test fn open_ranges()
    assert_eq(picked("-2,4-", 5), [1, 2, 4, 5])
    assert_eq(picked("3,1-2,2", 9), [1, 2, 3])
