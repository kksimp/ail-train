## BM25 ranking: scores documents for a query by summing, per query word, its inverse document frequency
## times a saturating term-frequency factor (k1 = 1.2) that is damped for long documents (b = 0.75).

fn bm25(doc List[str], query List[str], docs List[List[str]], avg_len float) float
    k1 := 1.2
    b := 0.75
    n_docs := docs.len().to_float()
    mut score := 0.0
    for term in query
        cnt := docs.count(|d| d.contains(term))
        if cnt == 0
            continue
        n := cnt.to_float()
        idf := ((n_docs - n + 0.5) / (n + 0.5) + 1.0).ln()
        tf := doc.count(|w| w == term).to_float()
        len_norm := 1.0 - b + b * doc.len().to_float() / avg_len
        score += idf * tf * (k1 + 1.0) / (tf + k1 * len_norm)
    score

fn main()
    texts := ["cheap flights to rome and cheap hotels", "rome travel guide with museums and food", "flights flights flights booking", "cheap pasta recipes from rome", "hotel reviews in paris and rome near the museums and parks"]
    docs := texts.map(|t| t.words())
    avg_len := docs.map(|d| d.len()).sum().to_float() / docs.len().to_float()
    print("average length {avg_len:.1} words")
    for query in [["cheap", "flights"], ["rome", "museums"]]
        shown := query.join(" ")
        print("query: {shown}")
        mut scored := []
        for i, d in docs.enumerate()
            scored.push((i, bm25(d, query, docs, avg_len)))
        ranked := scored.sorted(by: |p| -(p.1 * 1000000.0).floor().to_int())
        for p in ranked.take(3)
            print("  {p.1:.3}  {texts[p.0]}")

@test fn absent_word()
    docs := [["a", "b"], ["c"]]
    assert_eq(bm25(["a", "b"], ["z"], docs, 1.5), 0.0)
