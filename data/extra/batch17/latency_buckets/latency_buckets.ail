## Latency buckets: request times go into cumulative histogram buckets (le=5, 10, 25 ... ms, plus +Inf),
## and a quantile is estimated by finding its bucket and interpolating linearly between the bucket's bounds.

fn estimate(bounds List[int], cum List[int], q float) float
    total := cum[cum.len() - 1]
    rank := q * total.to_float()
    mut prev := 0
    mut lower := 0
    for i in 0..bounds.len()
        if cum[i].to_float() >= rank
            inb := cum[i] - prev
            frac := (rank - prev.to_float()) / inb.to_float()
            return lower.to_float() + (bounds[i] - lower).to_float() * frac
        prev = cum[i]
        lower = bounds[i]
    bounds[bounds.len() - 1].to_float()

fn main()
    bounds := [5, 10, 25, 50, 100, 250, 500, 1000]
    times := [3, 7, 8, 12, 15, 18, 22, 24, 26, 31, 35, 42, 48, 55, 61, 70, 88, 95, 110, 130, 160, 210, 240, 260, 320, 480, 520, 900, 1500, 40]
    mut cum := List[int]()
    for b in bounds
        cum.push(times.count(|t| t <= b))
    cum.push(times.len())
    for i, b in bounds.enumerate()
        print("le={b:<5} {cum[i]:>3}")
    print("le=+Inf  {cum[cum.len() - 1]:>3}")
    for q in [0.5, 0.9, 0.99]
        est := estimate(bounds, cum, q)
        print("q{q}: about {est:.1} ms")

@test fn middle_of_bucket()
    est := estimate([10, 20], [2, 4, 4], 0.5)
    assert((est - 10.0).abs() < 0.000001)
