## Environment overrides: variables like APP_DB__POOL_SIZE map to the setting db.pool_size (prefix
## dropped, double underscore for a dot, lower case) and are converted to the type of that setting's default.

fn key_of(var str) str
    rest := var.strip_prefix("APP_") else ""
    rest.to_lower().replace("__", ".")

fn convert(default str, raw str) str ! str
    if default == "true" or default == "false"
        low := raw.to_lower()
        if low == "1" or low == "yes" or low == "true"
            return "true"
        if low == "0" or low == "no" or low == "false"
            return "false"
        return "'{raw}' is not a yes/no value"
    if default.to_int() != none
        n := raw.trim().to_int() else return "'{raw}' is not a whole number"
        return "{n}"
    raw

fn main()
    mut settings := {"db.pool_size": "4", "db.host": "localhost", "server.debug": "false", "server.port": "8080", "cache.ttl": "60"}
    env := [("APP_DB__POOL_SIZE", "16"), ("APP_SERVER__DEBUG", "yes"), ("HOME", "/root"), ("APP_SERVER__PORT", "80a"), ("APP_DB__HOST", "db.internal"), ("APP_CACHE__SIZE", "512"), ("APP_CACHE__TTL", " 300 ")]
    for e in env
        var, raw := e
        key := key_of(var)
        if key == ""
            continue
        old := settings.get(key) else ""
        if old == ""
            print("{var:<18} -> {key}: no such setting, ignored")
            continue
        if v := convert(old, raw)
            settings[key] = v
            print("{var:<18} -> {key}: {old} -> {v}")
        else err
            print("{var:<18} -> {key}: rejected, {err}")
    for k in settings.keys().sorted()
        print("  {k} = {settings[k]}")

@test fn names()
    assert_eq(key_of("APP_DB__POOL_SIZE"), "db.pool_size")
    assert_eq(convert("false", "1") else "", "true")
