## Evaluates one integer expression per line (+ - * /, unary minus, parentheses).
## Prints the value, `error` for a malformed line, or `div0` for a division by zero.
error enum EvalError
    Syntax "error"

struct Parser
    chars List[char]
    pos int
    div0 bool

fn Parser.peek(mut self) char
    while self.pos < self.chars.len() and self.chars[self.pos] == ' '
        self.pos += 1
    if self.pos < self.chars.len()
        return self.chars[self.pos]
    '\u{1}'

fn Parser.expr(mut self) int ! EvalError
    mut v := self.term()?
    while true
        c := self.peek()
        if c == '+'
            self.pos += 1
            v += self.term()?
        elif c == '-'
            self.pos += 1
            v -= self.term()?
        else
            break
    v

fn Parser.term(mut self) int ! EvalError
    mut v := self.atom()?
    while true
        c := self.peek()
        if c == '*'
            self.pos += 1
            v *= self.atom()?
        elif c == '/'
            self.pos += 1
            r := self.atom()?
            if r == 0
                self.div0 = true
                v = 0
            else
                v = v / r
        else
            break
    v

fn Parser.atom(mut self) int ! EvalError
    c := self.peek()
    if c == '-'
        self.pos += 1
        return 0 - self.atom()?
    if c == '('
        self.pos += 1
        v := self.expr()?
        if self.peek() != ')'
            return Syntax
        self.pos += 1
        return v
    if c.is_digit()
        mut n := 0
        while self.pos < self.chars.len() and self.chars[self.pos].is_digit()
            d := self.chars[self.pos].to_digit(10) else 0
            n = n * 10 + d
            self.pos += 1
        return n
    Syntax

fn main()
    for line in io.read_all().lines()
        if line.trim().is_empty()
            continue
        mut p := Parser(chars: line.chars(), pos: 0, div0: false)
        v := p.expr() else
            print("error")
            continue
        if p.peek() != '\u{1}'
            print("error")
        elif p.div0
            print("div0")
        else
            print(v)
