## Per-key token bucket rate limiter: each request is allowed or denied, followed by
## per-key allowed/denied totals.
struct Bucket
    tokens int
    last int
    allowed int
    denied int

fn parse_header(line str) List[int]
    f := line.words()
    if f.len() != 4 or f[0] != "capacity" or f[2] != "rate"
        return []
    c := f[1].to_int() else return []
    r := f[3].to_int() else return []
    if c < 1 or r < 0
        return []
    [c, r]

fn main()
    mut rows := List[str]()
    for line in io.read_all().lines()
        if not line.trim().is_empty()
            rows.push(line.trim())
    hdr := parse_header(rows.first() else "")
    if hdr.is_empty()
        print("bad header")
        return
    cap := hdr[0]
    rate := hdr[1]
    mut buckets := Map[str, Bucket]()
    mut out := List[str]()
    mut prev := 0
    for line in rows.skip(1)
        f := line.words()
        if f.len() != 2 and f.len() != 3
            out.push("? {line}")
            continue
        t := f[0].to_int() else
            out.push("? {line}")
            continue
        cost := if f.len() == 3 then (f[2].to_int() else 0) else 1
        if t < 0 or cost < 1 or t < prev
            out.push("? {line}")
            continue
        prev = t
        key := f[1]
        if not buckets.contains(key)
            buckets[key] = Bucket(tokens: cap, last: t, allowed: 0, denied: 0)
        mut b := buckets[key]
        b.tokens = cap.min(b.tokens + (t - b.last) * rate)
        b.last = t
        res := if b.tokens >= cost then "allow" else "deny"
        if b.tokens >= cost
            b.tokens -= cost
            b.allowed += 1
        else
            b.denied += 1
        buckets[key] = b
        out.push("{t} {key} {cost} {res} left={b.tokens}")
    for k, b in buckets
        out.push("{k} allowed={b.allowed} denied={b.denied}")
    print(out.join("\n"))
