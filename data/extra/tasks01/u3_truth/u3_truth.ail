## Boolean expression truth tables: recursive descent over ! & ^ | with variables a-z, up to 4 variables.
struct Parser
    toks List[char]
    pos int
    vals List[int]
    bad bool

fn Parser.peek(self) char
    if self.pos < self.toks.len()
        return self.toks[self.pos]
    '$'

fn Parser.parse_or(mut self) int
    mut v := self.parse_xor()
    while self.peek() == '|'
        self.pos += 1
        r := self.parse_xor()
        v = v | r
    v

fn Parser.parse_xor(mut self) int
    mut v := self.parse_and()
    while self.peek() == '^'
        self.pos += 1
        r := self.parse_and()
        v = v ^ r
    v

fn Parser.parse_and(mut self) int
    mut v := self.parse_not()
    while self.peek() == '&'
        self.pos += 1
        r := self.parse_not()
        v = v & r
    v

fn Parser.parse_not(mut self) int
    t := self.peek()
    if t == '!'
        self.pos += 1
        return 1 - self.parse_not()
    if t == '('
        self.pos += 1
        v := self.parse_or()
        if self.peek() == ')'
            self.pos += 1
        else
            self.bad = true
        return v
    if t == '0' or t == '1'
        self.pos += 1
        return t.code() - 48
    if t.is_lower()
        self.pos += 1
        return self.vals[t.code() - 97]
    self.bad = true
    0

## Evaluates the tokens with the given variable values; the bool says whether the syntax was bad.
fn run(toks List[char], vals List[int]) (int, bool)
    mut p := Parser(toks: toks, pos: 0, vals: vals, bad: false)
    v := p.parse_or()
    if p.pos != toks.len()
        p.bad = true
    (v, p.bad)

fn main()
    for raw in io.read_all().lines()
        line := raw.trim()
        if line.is_empty()
            continue
        print("expr: {line}")
        toks := line.chars().filter(|c| c != ' ')
        if toks.any(|c| not (c.is_lower() or "01!&|^()".contains(c)))
            print("syntax error")
            continue
        base := run(toks, [0 for i in 0..26])
        if base.1
            print("syntax error")
            continue
        mut used := [false for i in 0..26]
        for c in toks
            if c.is_lower()
                used[c.code() - 97] = true
        names := [i for i in 0..26 if used[i]]
        n := names.len()
        if n > 4
            print("too many variables")
            continue
        mut ones := 0
        mut total := 1
        if n == 0
            print("f = {base.0}")
            ones = base.0
        else
            total = 1 << n
            print("{names.map(|i| char.from_code(97 + i)).join(" ")} | f")
            for m in 0..total
                mut vals := [0 for i in 0..26]
                mut bits := List[int]()
                for j in 0..n
                    b := (m >> (n - 1 - j)) & 1
                    vals[names[j]] = b
                    bits.push(b)
                r := run(toks, vals)
                ones += r.0
                print("{bits.join(" ")} | {r.0}")
        if ones == total
            print("tautology")
        elif ones == 0
            print("contradiction")
        else
            print("contingent")
