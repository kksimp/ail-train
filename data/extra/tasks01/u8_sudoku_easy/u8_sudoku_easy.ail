## Solves a 9x9 sudoku read from stdin by backtracking over empty cells.
## Prints `invalid input` or `no solution` when the grid is unusable.
fn fits(g List[int], pos int, v int) bool
    r := pos / 9
    c := pos % 9
    for i in 0..9
        if i != c and g[r * 9 + i] == v
            return false
        if i != r and g[i * 9 + c] == v
            return false
    br := r / 3 * 3
    bc := c / 3 * 3
    for i in 0..3
        for j in 0..3
            p := (br + i) * 9 + bc + j
            if p != pos and g[p] == v
                return false
    true

fn solve(mut g List[int], start int) bool
    mut pos := start
    while pos < 81 and g[pos] != 0
        pos += 1
    if pos == 81
        return true
    for v in 1..=9
        if fits(g, pos, v)
            g[pos] = v
            if solve(mut g, pos + 1)
                return true
            g[pos] = 0
    false

fn parse(lines List[str]) List[int]?
    if lines.len() != 9
        return none
    mut g := List[int]()
    for l in lines
        cs := l.chars()
        if cs.len() != 9
            return none
        for ch in cs
            if ch == '.'
                g.push(0)
            else
                d := ch.to_digit(10) else return none
                if d == 0
                    return none
                g.push(d)
    g

fn main()
    mut lines := List[str]()
    for raw in io.read_all().lines()
        t := raw.trim()
        if not t.is_empty()
            lines.push(t)
    mut g := parse(lines) else
        print("invalid input")
        return
    mut clash := false
    for p in 0..81
        if g[p] != 0 and not fits(g, p, g[p])
            clash = true
    if clash or not solve(mut g, 0)
        print("no solution")
        return
    for r in 0..9
        print(g.slice(r * 9, r * 9 + 9).join(""))
