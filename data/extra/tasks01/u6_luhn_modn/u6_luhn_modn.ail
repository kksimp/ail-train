## Luhn mod N check characters for bases 10, 16 and 36: `gen N PAYLOAD` and `chk N PAYLOAD+CHECK`.
ALL := "0123456789abcdefghijklmnopqrstuvwxyz"

## The Luhn sum of s read right to left, starting with the given factor (1 or 2).
fn luhn_sum(alpha str, s str, start int) int
    n := alpha.len()
    mut factor := start
    mut total := 0
    for c in s.chars().reversed()
        code := alpha.find(c) else 0
        addend := factor * code
        factor = if factor == 2 then 1 else 2
        total += addend / n + addend % n
    total

fn main()
    for line in io.read_all().lines()
        if line.is_empty()
            continue
        parts := line.split(" ")
        if (parts[0] != "gen" and parts[0] != "chk") or parts.len() != 3
            print("bad command")
            continue
        n := if parts[1] == "10" then 10 elif parts[1] == "16" then 16 elif parts[1] == "36" then 36 else 0
        if n == 0
            print("error")
            continue
        alpha := ALL.slice(0, n)
        s := parts[2]
        need := if parts[0] == "gen" then 1 else 2
        if s.len() < need or not s.chars().all(|c| alpha.contains(c))
            print("error")
            continue
        if parts[0] == "gen"
            total := luhn_sum(alpha, s, 2)
            print(alpha.slice((n - total % n) % n, (n - total % n) % n + 1))
        else
            print(if luhn_sum(alpha, s, 1) % n == 0 then "valid" else "invalid")
