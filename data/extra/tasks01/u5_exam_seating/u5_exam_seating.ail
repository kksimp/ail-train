## Exam seating plan: students sorted by name fill even columns first, then odd columns.
fn is_num(s str) bool
    s.len() > 0 and s.len() < 6 and s.chars().all(|c| c.is_digit())

fn main()
    lines := io.read_all().lines()
    head := (lines.first() else "").words()
    if head.len() != 2 or not is_num(head[0]) or not is_num(head[1])
        print("error: bad header")
        return
    rows := head[0].to_int() else 0
    cols := head[1].to_int() else 0
    if rows < 1 or cols < 1
        print("error: bad header")
        return
    names := [l.trim() for l in lines.skip(1) if l.trim() != ""].sorted()
    if names.len() > rows * cols
        print("error: too many students ({names.len()} > {rows * cols})")
        return
    mut seats := [".".repeat(8) for i in 0..rows * cols]
    mut k := 0
    for p in 0..2
        for r in 0..rows
            for c in 0..cols
                if c % 2 == p and k < names.len()
                    n := names[k]
                    cut := if n.len() > 8 then n.slice(0, 8) else n
                    seats[r * cols + c] = cut.pad_right(8, ' ')
                    k += 1
    for r in 0..rows
        print(seats.slice(r * cols, r * cols + cols).join("|"))
