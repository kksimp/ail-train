## Builds a credit card statement from an opening balance and a list of charges and payments, all in integer cents.
## Interest is charged on the opening balance, rounded half up; the minimum payment is max(25.00, 2% rounded up).
fn money(c int) str
    sign := if c < 0 then "-" else ""
    a := c.abs()
    "{sign}{a / 100}.{a % 100:0>2}"

fn min_payment(bal int) int
    if bal <= 0
        return 0
    if bal <= 2500
        return bal
    pct := (bal * 2 + 99) / 100
    pct.max(2500)

fn main()
    lines := io.read_all().lines()
    head := (lines.first() else "").words()
    if head.len() != 2
        print("error: bad header")
        return
    apr := head[0].to_int() else
        print("error: bad header")
        return
    opening := head[1].to_int() else
        print("error: bad header")
        return
    if apr < 0 or apr > 5000 or opening < -1000000 or opening > 100000000
        print("error: bad header")
        return
    mut charges := 0
    mut payments := 0
    for k in 1..lines.len()
        w := lines[k].words()
        if w.is_empty()
            continue
        amt := (w.skip(1).first() else "x").to_int() else 0
        if amt < 1 or amt > 100000000 or not (w[0] == "C" or w[0] == "P")
            print("skipped line {k + 1}")
            continue
        if w[0] == "C"
            charges += amt
        else
            payments += amt
    interest := if opening > 0 then (opening * apr + 60000) / 120000 else 0
    bal := opening + charges - payments + interest
    print("opening: {money(opening)}")
    print("charges: {money(charges)}")
    print("payments: {money(payments)}")
    print("interest: {money(interest)}")
    print("new balance: {money(bal)}")
    print("minimum payment: {money(min_payment(bal))}")
