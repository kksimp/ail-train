## Applies blank-moves (U D L R) to a 15-puzzle board and reports the result.
## Rejects malformed boards, off-board moves and unknown move letters.
fn parse_board(lines List[str]) List[int]?
    if lines.len() < 4
        return none
    mut board := List[int]()
    for i in 0..4
        parts := lines[i].trim().split(" ")
        if parts.len() != 4
            return none
        for p in parts
            n := p.to_int() else return none
            if n < 0 or n > 15
                return none
            board.push(n)
    seen := board.sorted()
    for i in 0..16
        if seen[i] != i
            return none
    board

fn main()
    lines := io.read_all().split("\n")
    mut board := parse_board(lines) else
        print("invalid board")
        return
    moves := if lines.len() > 4 then lines[4].trim() else ""
    mut pos := board.index_of(0) else 0
    mut k := 0
    for ch in moves.chars()
        k += 1
        mut dr := 0
        mut dc := 0
        match ch
            'U' => dr = -1
            'D' => dr = 1
            'L' => dc = -1
            'R' => dc = 1
            _ =>
                print("bad move {k}")
                return
        nr := pos / 4 + dr
        nc := pos % 4 + dc
        if nr < 0 or nr > 3 or nc < 0 or nc > 3
            print("illegal move {k}")
            return
        np := nr * 4 + nc
        board.swap(pos, np)
        pos = np
    for r in 0..4
        print(board.slice(r * 4, r * 4 + 4).join(" "))
    mut solved := board[15] == 0
    for i in 0..15
        if board[i] != i + 1
            solved = false
    print(if solved then "solved" else "unsolved")
