## Left-to-right exact fraction calculator with reduced results.

struct Frac
    n int
    d int

fn gcd(a int, b int) int
    mut x := a.abs()
    mut y := b.abs()
    while y != 0
        t := x % y
        x = y
        y = t
    x

## Reduced fraction with a positive denominator (d must not be 0).
fn make(n int, d int) Frac
    g := gcd(n, d)
    mut nn := n / g
    mut dd := d / g
    if dd < 0
        nn = -nn
        dd = -dd
    if nn == 0
        dd = 1
    Frac(n: nn, d: dd)

fn all_digits(t str) bool
    if t.is_empty() or t.len() > 2
        return false
    for c in t.chars()
        if not c.is_digit()
            return false
    true

## An operand `N` or `N/D`, or none if malformed.
fn parse_operand(t str) Frac?
    neg := t.starts_with("-")
    body := t.strip_prefix("-") else t
    parts := body.split("/")
    if parts.len() > 2 or not all_digits(parts[0])
        return none
    mut d := 1
    if parts.len() == 2
        if not all_digits(parts[1])
            return none
        d = parts[1].to_int() else 0
    n := parts[0].to_int() else 0
    Frac(n: if neg then -n else n, d: d)

fn is_op(t str) bool
    t == "+" or t == "-" or t == "*" or t == "/"

## Applies one operator; none on division by zero.
fn apply(x Frac, op str, y Frac) Frac?
    match op
        "+" => make(x.n * y.d + y.n * x.d, x.d * y.d)
        "-" => make(x.n * y.d - y.n * x.d, x.d * y.d)
        "*" => make(x.n * y.n, x.d * y.d)
        _ =>
            if y.n == 0
                return none
            make(x.n * y.d, x.d * y.n)

fn show(f Frac) str
    if f.d == 1
        "{f.n}"
    else
        "{f.n}/{f.d}"

## Result text or an error text, as `ok:` / `err:` tagged pair.
fn evaluate(toks List[str]) (bool, str)
    mut operands := List[Frac]()
    mut ops := List[str]()
    for i in 0..toks.len()
        t := toks[i]
        if i % 2 == 0
            f := parse_operand(t) else return (false, "bad expression")
            if f.d == 0
                return (false, "zero denominator")
            operands.push(f)
        else
            if not is_op(t)
                return (false, "bad expression")
            ops.push(t)
    if toks.len() % 2 == 0 or operands.len() > 4
        return (false, "bad expression")
    mut acc := make(operands[0].n, operands[0].d)
    for i in 0..ops.len()
        acc = apply(acc, ops[i], operands[i + 1]) else return (false, "zero denominator")
    (true, show(acc))

fn main()
    mut lines := io.read_all().split("\n")
    if (lines.last() else "x") == ""
        lines.pop()
    mut count := 0
    for i in 0..lines.len()
        toks := lines[i].words()
        if toks.is_empty()
            continue
        ok, text := evaluate(toks)
        if ok
            print(text)
            count += 1
        else
            print("line {i + 1}: {text}")
    print("evaluated {count}")
