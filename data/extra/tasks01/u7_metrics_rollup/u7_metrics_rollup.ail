## Roll up metric samples into per-minute count, sum, min and max per name.

fn all_digits(s str) bool
    if s.is_empty()
        return false
    for ch in s.chars()
        if ch.code() < 48 or ch.code() > 57
            return false
    true

fn is_int(s str) bool
    if s.starts_with("-")
        return all_digits(s.slice(1))
    all_digits(s)

fn main()
    mut groups := Map[(int, str), List[int]]()
    mut bad := 0
    for l in io.read_all().lines()
        if l.is_empty()
            continue
        f := l.split(" ")
        if f.len() != 3 or not all_digits(f[0]) or f[1].is_empty() or not is_int(f[2])
            bad += 1
            continue
        ts := f[0].to_int() else 0
        v := f[2].to_int() else 0
        groups.push((ts / 60 * 60, f[1]), v)
    for key in groups.keys().sorted()
        v := groups[key]
        lo := v.min() else 0
        hi := v.max() else 0
        print("{key.0} {key.1} {v.len()} {v.sum()} {lo} {hi}")
    print("malformed: {bad}")
