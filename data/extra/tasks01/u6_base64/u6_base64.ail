## Base64 encoder and decoder over printable ASCII, one command per line (enc TEXT, dec DATA).
ALPHABET := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

## Encodes printable ASCII text as padded Base64.
fn encode(text str) str
    codes := [c.code() for c in text.chars()]
    alpha := ALPHABET.chars()
    mut out := List[char]()
    mut i := 0
    while i < codes.len()
        has1 := i + 1 < codes.len()
        has2 := i + 2 < codes.len()
        b1 := if has1 then codes[i + 1] else 0
        b2 := if has2 then codes[i + 2] else 0
        n := (codes[i] << 16) | (b1 << 8) | b2
        out.push(alpha[(n >> 18) & 63])
        out.push(alpha[(n >> 12) & 63])
        out.push(if has1 then alpha[(n >> 6) & 63] else '=')
        out.push(if has2 then alpha[n & 63] else '=')
        i += 3
    out.join("")

## Decodes Base64, or gives none when the data is invalid.
fn decode(text str) str?
    cs := text.chars()
    if cs.len() % 4 != 0
        return none
    alpha := ALPHABET.chars()
    mut vals := List[int]()
    mut pad := 0
    for c in cs
        if c == '='
            pad += 1
            vals.push(0)
        else
            if pad > 0
                return none
            idx := alpha.index_of(c) else return none
            vals.push(idx)
    if pad > 2
        return none
    mut out := List[char]()
    mut i := 0
    while i < vals.len()
        n := (vals[i] << 18) | (vals[i + 1] << 12) | (vals[i + 2] << 6) | vals[i + 3]
        count := if i + 4 == vals.len() then 3 - pad else 3
        for k in 0..count
            b := (n >> (16 - 8 * k)) & 255
            if b < 32 or b > 126
                return none
            out.push(char.from_code(b) else '?')
        i += 4
    out.join("")

fn main()
    for line in io.read_all().lines()
        if line.is_empty()
            continue
        parts := line.split(" ", 2)
        arg := if parts.len() > 1 then parts[1] else ""
        if parts[0] == "enc"
            print(encode(arg))
        elif parts[0] == "dec"
            r := decode(arg) else "invalid"
            print(r)
        else
            print("bad command")
