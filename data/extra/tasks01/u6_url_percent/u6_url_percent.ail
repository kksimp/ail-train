## URL percent-encoder and decoder for printable ASCII: `enc TEXT` and `dec TEXT`, one per line.
SAFE := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~"
HEXDIGITS := "0123456789ABCDEF"

fn encode(text str) str
    mut out := List[str]()
    for c in text.chars()
        if SAFE.contains(c)
            out.push("{c}")
        else
            code := c.code()
            hi := HEXDIGITS.slice(code / 16, code / 16 + 1)
            lo := HEXDIGITS.slice(code % 16, code % 16 + 1)
            out.push("%{hi}{lo}")
    out.join("")

## Decodes `%XX` and `+`, or gives none for a bad escape.
fn decode(text str) str?
    cs := text.chars()
    mut out := List[char]()
    mut i := 0
    while i < cs.len()
        c := cs[i]
        if c == '%'
            if i + 2 >= cs.len()
                return none
            h := cs[i + 1].to_digit(16) else return none
            l := cs[i + 2].to_digit(16) else return none
            code := h * 16 + l
            if code < 32 or code > 126
                return none
            out.push(char.from_code(code) else '?')
            i += 3
        elif c == '+'
            out.push(' ')
            i += 1
        else
            out.push(c)
            i += 1
    out.join("")

fn main()
    for line in io.read_all().lines()
        if line.is_empty()
            continue
        parts := line.split(" ", 2)
        arg := if parts.len() > 1 then parts[1] else ""
        if parts[0] == "enc"
            print(encode(arg))
        elif parts[0] == "dec"
            r := decode(arg) else "invalid"
            print(r)
        else
            print("bad command")
