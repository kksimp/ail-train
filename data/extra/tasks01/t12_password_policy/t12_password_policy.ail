## Password policy checker: for each input line prints OK, or FAIL followed by
## the comma-separated names of the rules it breaks.

fn is_symbol(c char) bool
    not c.is_alnum() and c != ' '

fn has_repeat(cs List[char]) bool
    for i in 2..cs.len()
        if cs[i] == cs[i - 1] and cs[i] == cs[i - 2]
            return true
    false

fn broken_rules(pw str) List[str]
    cs := pw.chars()
    mut out := List[str]()
    if cs.len() < 8
        out.push("short")
    if not cs.any(|c| c.is_upper())
        out.push("no-upper")
    if not cs.any(|c| c.is_lower())
        out.push("no-lower")
    if not cs.any(|c| c.is_digit())
        out.push("no-digit")
    if not cs.any(|c| is_symbol(c))
        out.push("no-symbol")
    if cs.contains(' ')
        out.push("space")
    if has_repeat(cs)
        out.push("repeat")
    out

fn main()
    for line in io.read_all().lines()
        if line.is_empty()
            continue
        rules := broken_rules(line)
        if rules.is_empty()
            print("{line}: OK")
        else
            print("{line}: FAIL {rules.join(",")}")
