## Counts the vertices of the convex hull of integer points (Andrew's monotone chain, no collinear corners).
fn parse_point(t str) (int, int)?
    w := t.words()
    if w.len() != 2
        return none
    x := w[0].to_int() else return none
    y := w[1].to_int() else return none
    (x, y)

fn cross(o (int, int), a (int, int), b (int, int)) int
    (a.0 - o.0) * (b.1 - o.1) - (a.1 - o.1) * (b.0 - o.0)

## One half of the chain over points already in order; keeps only left turns.
fn chain(pts List[(int, int)]) List[(int, int)]
    mut h := List[(int, int)]()
    for p in pts
        while h.len() >= 2 and cross(h[h.len() - 2], h[h.len() - 1], p) <= 0
            _ := h.pop()
        h.push(p)
    h

fn main()
    mut seen := Set[(int, int)]()
    for line in io.read_all().lines()
        p := parse_point(line.trim()) else continue
        seen.add(p)
    pts := seen.sorted()
    print("distinct {pts.len()}")
    if pts.len() <= 2
        print("hull {pts.len()}")
        return
    lower := chain(pts)
    upper := chain(pts.reversed())
    print("hull {lower.len() + upper.len() - 2}")
