## Reads `START END` date pairs (YYYY-MM-DD) and prints END - START in days.
## Prints `invalid` for a malformed line or a date that does not exist.
fn all_digits(s str) bool
    if s.is_empty()
        return false
    for ch in s.chars()
        if ch < '0' or ch > '9'
            return false
    true

fn is_leap(y int) bool
    (y % 4 == 0 and y % 100 != 0) or y % 400 == 0

fn month_days(y int, m int) int
    match m
        2 => if is_leap(y) then 29 else 28
        4 | 6 | 9 | 11 => 30
        _ => 31

## Days since 0001-01-01 for a valid date.
fn day_number(y int, m int, d int) int
    py := y - 1
    mut n := py * 365 + py / 4 - py / 100 + py / 400
    for k in 1..m
        n += month_days(y, k)
    n + d - 1

## Parses `YYYY-MM-DD` into a day number, or `none` if it is not a real date.
fn parse_date(t str) int?
    parts := t.split("-")
    if parts.len() != 3
        return none
    if parts[0].len() != 4 or parts[1].len() != 2 or parts[2].len() != 2
        return none
    if not (all_digits(parts[0]) and all_digits(parts[1]) and all_digits(parts[2]))
        return none
    y := parts[0].to_int() else return none
    m := parts[1].to_int() else return none
    d := parts[2].to_int() else return none
    if y < 1 or m < 1 or m > 12 or d < 1 or d > month_days(y, m)
        return none
    day_number(y, m, d)

fn main()
    for line in io.read_all().lines()
        toks := line.words()
        if toks.is_empty()
            continue
        if toks.len() != 2
            print("invalid")
            continue
        a := parse_date(toks[0]) else
            print("invalid")
            continue
        b := parse_date(toks[1]) else
            print("invalid")
            continue
        print(b - a)
