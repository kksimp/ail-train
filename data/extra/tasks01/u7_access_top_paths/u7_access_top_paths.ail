## Summarize a web access log: the three most requested paths,
## request counts per status class, and the number of malformed lines.

fn all_digits(s str) bool
    if s.is_empty()
        return false
    for ch in s.chars()
        if ch.code() < 48 or ch.code() > 57
            return false
    true

fn main()
    mut counts := Map[str, int]()
    mut classes := [0, 0, 0, 0, 0]
    mut bad := 0
    for line in io.read_all().lines()
        if line.is_empty()
            continue
        f := line.split(" ")
        if f.len() != 5 or f.any(|x| x.is_empty()) or not all_digits(f[3]) or not all_digits(f[4])
            bad += 1
            continue
        status := f[3].to_int() else 0
        if status < 100 or status > 599
            bad += 1
            continue
        counts[f[2]] += 1
        classes[status / 100 - 1] += 1
    print("top paths:")
    mut items := []
    for path, c in counts
        items.push((-c, path))
    for it in items.sorted().take(3)
        print("{-it.0} {it.1}")
    print("status:")
    for i in 0..5
        print("{i + 1}xx {classes[i]}")
    print("malformed: {bad}")
