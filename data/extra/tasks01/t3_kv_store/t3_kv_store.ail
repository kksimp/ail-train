## Key-value store: set/get/del/count/keys/incr over string values.
## `set` keeps the rest of the line as the value; other commands need exact word counts.

fn incr(mut db Map[str, str], key str) str
    cur := db.get(key) else "0"
    n := cur.to_int() else return "error: not an integer"
    db[key] = "{n + 1}"
    db[key]

fn run(mut db Map[str, str], line str) str
    p := line.split(" ", 3)
    cmd := p[0]
    n := line.split(" ").len()
    if cmd == "set" and p.len() == 3 and p[1] != "" and p[2] != ""
        db[p[1]] = p[2]
        return "ok"
    if cmd == "count" and n == 1
        return "{db.len()}"
    if cmd == "keys" and n == 1
        return if db.is_empty() then "(empty)" else db.keys().sorted().join(" ")
    if (cmd == "get" or cmd == "del" or cmd == "incr") and n == 2 and p[1] != ""
        key := p[1]
        if cmd == "get"
            return db.get(key) else "(nil)"
        if cmd == "incr"
            return incr(mut db, key)
        if db.contains(key)
            db.remove(key)
            return "deleted"
        return "missing"
    "error: bad command"

fn main()
    mut db := Map[str, str]()
    while true
        line := io.read_line() else break
        if line.is_empty()
            continue
        print(run(mut db, line))
