## Bowling score per line: each line is a full game's rolls; prints the total, `incomplete` or `invalid`.

fn parse_rolls(line str) List[int]?
    mut r := List[int]()
    for t in line.words()
        v := t.to_int() else return none
        if v < 0 or v > 10
            return none
        r.push(v)
    r

## Where the game ends (index after the last roll), or "incomplete" / "invalid" as the text.
fn game_end(r List[int]) int ! str
    n := r.len()
    mut i := 0
    for f in 0..9
        if i >= n
            return "incomplete"
        a := r[i]
        if a == 10
            i += 1
            continue
        if i + 1 >= n
            return "incomplete"
        if a + r[i + 1] > 10
            return "invalid"
        i += 2
    if i >= n
        return "incomplete"
    a := r[i]
    mut end := 0
    if a == 10
        if i + 2 >= n
            return "incomplete"
        b := r[i + 1]
        c := r[i + 2]
        if b < 10 and b + c > 10
            return "invalid"
        end = i + 3
    else
        if i + 1 >= n
            return "incomplete"
        b := r[i + 1]
        if a + b > 10
            return "invalid"
        if a + b == 10
            if i + 2 >= n
                return "incomplete"
            end = i + 3
        else
            end = i + 2
    if end < n
        return "invalid"
    end

fn total(r List[int], end int) int
    mut t := 0
    mut i := 0
    for f in 0..9
        if r[i] == 10
            t += 10 + r[i + 1] + r[i + 2]
            i += 1
        elif r[i] + r[i + 1] == 10
            t += 10 + r[i + 2]
            i += 2
        else
            t += r[i] + r[i + 1]
            i += 2
    for k in i..end
        t += r[k]
    t

fn score(line str) str
    r := parse_rolls(line) else return "invalid"
    end := game_end(r) else err
        return err
    "{total(r, end)}"

fn main()
    mut lines := io.read_all().split("\n")
    if (lines.last() else "x") == ""
        lines.pop()
    for l in lines
        print(score(l))
