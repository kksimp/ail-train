## Normalizes a list numbered with mixed arabic and roman numerals ("XIV. text", "7. text"):
## valid items are printed sorted by value as "ARABIC ROMAN TEXT", invalid lines are listed after.
struct Item
    n int
    text str

fn roman_value(c char) int
    match c
        'I' => 1
        'V' => 5
        'X' => 10
        'L' => 50
        'C' => 100
        'D' => 500
        'M' => 1000
        _ => 0

fn to_roman(n int) str
    values := [1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1]
    symbols := ["M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"]
    mut left := n
    mut out := List[str]()
    for i in 0..values.len()
        while left >= values[i]
            out.push(symbols[i])
            left -= values[i]
    out.join("")

fn parse_numeral(tok str) int?
    if tok.is_empty()
        return none
    cs := tok.chars()
    if cs.all(|c| c >= '0' and c <= '9')
        if cs[0] == '0' or cs.len() > 4
            return none
        n := tok.to_int() else return none
        if n >= 1 and n <= 3999
            return n
        return none
    if cs.all(|c| roman_value(c) > 0)
        mut total := 0
        for i in 0..cs.len()
            v := roman_value(cs[i])
            if i + 1 < cs.len() and v < roman_value(cs[i + 1])
                total -= v
            else
                total += v
        if total >= 1 and total <= 3999 and to_roman(total) == tok
            return total
    none

fn main()
    mut good := List[Item]()
    mut bad := List[str]()
    mut k := 0
    for line in io.read_all().lines()
        k += 1
        if line.trim().is_empty()
            continue
        dot := line.find(".") else
            bad.push("invalid line {k}: {line}")
            continue
        n := parse_numeral(line.slice(0, dot)) else
            bad.push("invalid line {k}: {line}")
            continue
        good.push(Item(n: n, text: line.slice(dot + 1).trim()))
    for it in good.sorted(by: |x| x.n)
        print("{it.n} {to_roman(it.n)} {it.text}".trim_end())
    for b in bad
        print(b)
