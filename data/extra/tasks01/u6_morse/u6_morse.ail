## Morse code translator: `enc TEXT` to dots and dashes, `dec CODE` back to text.
CHARS := "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

fn codes() List[str]
    [".-", "-...", "-.-.", "-..", ".", "..-.", "--.", "....", "..", ".---", "-.-", ".-..", "--",
     "-.", "---", ".--.", "--.-", ".-.", "...", "-", "..-", "...-", ".--", "-..-", "-.--", "--..",
     "-----", ".----", "..---", "...--", "....-", ".....", "-....", "--...", "---..", "----."]

## Encodes words of letters and digits, or gives none on any other character.
fn encode(text str) str?
    table := codes()
    mut words := List[str]()
    for w in text.words()
        mut letters := List[str]()
        for c in w.chars()
            i := CHARS.find(c.to_upper()) else return none
            letters.push(table[i])
        words.push(letters.join(" "))
    words.join(" / ")

## Decodes space-separated tokens (`/` is a word break), or gives none on an unknown token.
fn decode(text str) str?
    table := codes()
    mut out := List[str]()
    for tok in text.words()
        if tok == "/"
            out.push(" ")
        else
            i := table.index_of(tok) else return none
            out.push(CHARS.slice(i, i + 1))
    out.join("")

fn main()
    for line in io.read_all().lines()
        if line.is_empty()
            continue
        parts := line.split(" ", 2)
        arg := if parts.len() > 1 then parts[1] else ""
        if parts[0] == "enc"
            r := encode(arg) else "error"
            print(r)
        elif parts[0] == "dec"
            r := decode(arg) else "error"
            print(r)
        else
            print("bad command")
