## Computes progressive income tax from a bracket table: each bracket's tax is rounded half up, then summed.
## Prints the tax and the effective rate in percent for each income; reports bad brackets or bad income lines.
struct Bracket
    limit int
    rate int

fn money(c int) str
    "{c / 100}.{c % 100:0>2}"

fn percent(bps int) str
    "{bps / 100}.{bps % 100:0>2}%"

fn parse_brackets(line str) List[Bracket]?
    w := line.words()
    if w.is_empty()
        return none
    mut out := List[Bracket]()
    mut prev := 0
    for i in 0..w.len()
        parts := w[i].split(":")
        if parts.len() != 2
            return none
        rate := parts[1].to_int() else return none
        if rate < 0 or rate > 10000
            return none
        last := i == w.len() - 1
        if parts[0] == "inf"
            if not last
                return none
            out.push(Bracket(limit: -1, rate: rate))
        else
            if last
                return none
            lim := parts[0].to_int() else return none
            if lim <= prev
                return none
            prev = lim
            out.push(Bracket(limit: lim, rate: rate))
    out

fn tax(bs List[Bracket], income int) int
    mut total := 0
    mut lower := 0
    for b in bs
        if income <= lower
            break
        upper := if b.limit < 0 then income else income.min(b.limit)
        part := upper - lower
        total += (part * b.rate + 5000) / 10000
        lower = upper
    total

fn main()
    lines := io.read_all().lines()
    bs := parse_brackets(lines.first() else "") else
        print("error: bad brackets")
        return
    for k in 1..lines.len()
        s := lines[k].trim()
        if s.is_empty()
            continue
        income := s.to_int() else
            print("line {k + 1}: bad income")
            continue
        if income < 0 or income > 100000000000
            print("line {k + 1}: bad income")
            continue
        t := tax(bs, income)
        eff := if income == 0 then 0 else (t * 10000 * 2 + income) / (income * 2)
        print("income {money(income)} tax {money(t)} effective {percent(eff)}")
