## Returns processing: refund returned units at the sale price, reject returns that exceed what was sold,
## and put undamaged units back into stock.
struct Line
    qty int
    price int
    back int

fn digits(s str, lo int) int
    if s.is_empty()
        return lo - 1
    for c in s.chars()
        if not c.is_digit()
            return lo - 1
    n := s.to_int() else lo - 1
    if n >= lo then n else lo - 1

fn main()
    mut lines := io.read_all().split("\n")
    if (lines.last() else "x") == ""
        lines.pop()
    mut sales := Map[(str, str), Line]()
    mut stock := Map[str, int]()
    mut out := List[str]()
    mut total := 0
    for k in 0..lines.len()
        line := lines[k]
        if line.is_empty()
            continue
        f := line.split(" ")
        if f[0] == "sale" and f.len() == 5 and not f[1].is_empty() and not f[2].is_empty()
            q := digits(f[3], 1)
            p := digits(f[4], 0)
            if q >= 1 and p >= 0 and not sales.contains((f[1], f[2]))
                sales[(f[1], f[2])] = Line(qty: q, price: p, back: 0)
                continue
        elif f[0] == "return" and (f.len() == 4 or f.len() == 5) and not f[1].is_empty() and not f[2].is_empty()
            q := digits(f[3], 1)
            ok := f.len() == 4 or f[4] == "damaged"
            if q >= 1 and ok
                key := (f[1], f[2])
                if not sales.contains(key)
                    out.push("reject {f[1]} {f[2]} none")
                    continue
                ln := sales[key]
                if q > ln.qty - ln.back
                    out.push("reject {f[1]} {f[2]} excess")
                    continue
                sales[key].back += q
                c := q * ln.price
                total += c
                if f.len() == 4
                    stock[f[2]] += q
                out.push("refund {f[1]} {f[2]} {q} {c}")
                continue
        out.push("bad {k + 1}")
    for sku in stock.keys().sorted()
        out.push("restocked {sku} {stock[sku]}")
    out.push("refunds {total}")
    print(out.join("\n"))
