## Resting heart rate: the first week's average is the baseline; a 3-day rolling average 5 or more beats
## above it flags possible illness or overtraining, and the flagged days are listed with their averages.

fn avg(xs List[int]) float
    xs.sum().to_float() / xs.len().to_float()

fn main()
    hr := [58, 57, 59, 58, 60, 57, 58, 59, 61, 60, 63, 66, 68, 67, 64, 61, 59, 58, 62, 64, 66]
    base := avg(hr.take(7))
    print("baseline {base:.1} bpm")
    mut flagged := 0
    mut first := 0
    for i in 2..hr.len()
        roll := avg(hr.slice(i - 2, i + 1))
        if roll >= base + 5.0
            flagged += 1
            if first == 0
                first = i + 1
            over := roll - base
            print("day {i + 1}: 3-day average {roll:.1} (+{over:.1})")
    print("{flagged} days flagged, first on day {first}")
    peak := hr.max() else 0
    print("highest single reading {peak}")

@test fn mean()
    assert((avg([60, 61, 62]) - 61.0).abs() < 0.000001)
