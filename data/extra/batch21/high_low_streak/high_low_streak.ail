## High-low streak: a 52-card deck of values 1 to 13 is shuffled with a seeded Fisher-Yates; the player
## calls higher on 7 or below and lower above 7, an equal card loses, and the winning streaks are recorded.

fn next_state(s int) int
    (s * 1103515245 + 12345) % 2147483648

fn call(v int) str
    if v <= 7 then "higher" else "lower"

fn shuffled(seed int) List[int]
    mut deck := List[int]()
    for v in 1..=13
        for suit in 0..4
            deck.push(v)
    mut s := seed
    mut i := 51
    while i > 0
        s = next_state(s)
        j := (s >> 16) % (i + 1)
        deck.swap(i, j)
        i -= 1
    deck

fn main()
    deck := shuffled(31)
    first := deck.take(12)
    print("first cards: {first}")
    mut streaks := List[int]()
    mut run := 0
    mut right := 0
    for k in 1..deck.len()
        prev := deck[k - 1]
        cur := deck[k]
        won := if call(prev) == "higher" then cur > prev else cur < prev
        if won
            run += 1
            right += 1
        else
            if run > 0
                streaks.push(run)
            run = 0
    if run > 0
        streaks.push(run)
    best := streaks.max() else 0
    print("{right} of 51 calls right")
    print("{streaks.len()} streaks, best {best}")
    long := streaks.filter(|x| x >= 5).len()
    print("streaks of five or more: {long}")

@test fn calls()
    assert_eq(call(7), "higher")
    assert_eq(call(8), "lower")
    assert_eq(shuffled(5).len(), 52)
