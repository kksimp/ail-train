## Knitting gauge: a swatch of 22 stitches and 30 rows per 10 cm turns a body width (half the chest plus
## ease) into a cast-on rounded to the nearest multiple of 4 for the rib, and a body length into rows.

fn per_cm(cm int, per10 int) int
    (cm * per10 + 5) / 10

fn to_multiple(n int, m int) int
    (n + m / 2) / m * m

fn tenths(t int) str
    "{t / 10}.{t % 10}"

fn main()
    st := 22
    rows := 30
    ease := 8
    sizes := [("S", 86, 60), ("M", 96, 63), ("L", 106, 66), ("XL", 116, 69)]
    for s in sizes
        name, chest, length := s
        width := (chest + ease) / 2
        cast := to_multiple(per_cm(width, st), 4)
        body := per_cm(length, rows)
        knitted := cast * 100 / st
        tight := cast * 100 / 24
        print("{name:<2} chest {chest}: cast on {cast}, {body} rows; panel {tenths(knitted)} cm (at 24 st: {tenths(tight)} cm)")
    print("rib needs a multiple of 4: every cast-on above divides evenly")

@test fn rounding()
    assert_eq(to_multiple(103, 4), 104)
    assert_eq(to_multiple(101, 4), 100)
    assert_eq(per_cm(47, 22), 103)
