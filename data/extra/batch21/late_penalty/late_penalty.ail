## Late penalty: work handed in after the deadline plus a one-hour grace period loses 10% of the maximum
## mark for each started day late, and anything more than five days late scores zero.

fn days_late(after int) int
    late := after - 60
    if late <= 0 then 0 else (late + 1439) / 1440

fn final_mark(raw int, days int) int
    if days > 5 then 0 else (raw - days * 5).max(0)

fn main()
    deadline := 2 * 1440 + 17 * 60
    subs := [("Ana", 41, deadline - 30), ("Ben", 38, deadline + 45), ("Cy", 44, deadline + 61), ("Dot", 35, deadline + 1500), ("Eve", 47, deadline + 3 * 1440 + 100), ("Fin", 30, deadline + 6 * 1440), ("Gus", 4, deadline + 2000)]
    mut zero := 0
    for s in subs
        name, raw, at := s
        d := days_late(at - deadline)
        mark := final_mark(raw, d)
        if mark == 0
            zero += 1
        status := if d == 0 then "on time" else "{d} days late"
        print("{name:<4} {status:<12} {raw}/50 -> {mark}/50")
    print("{zero} pieces scored zero")

@test fn grace_hour()
    assert_eq(days_late(60), 0)
    assert_eq(days_late(61), 1)
    assert_eq(final_mark(47, 4), 27)
