## Sourdough build: a levain is built in stages counted back from bake time; each stage mixes 1 part seed
## with r parts flour and r parts water, so its seed is the target over 1 + 2r, rounded up.

struct Stage
    r int
    hours int

fn build(target int, stages List[Stage]) List[List[int]]
    mut rows := List[List[int]]()
    mut want := target
    for i in 0..stages.len()
        s := stages[stages.len() - 1 - i]
        parts := 1 + 2 * s.r
        seed := (want + parts - 1) / parts
        rows.insert(0, [seed, seed * s.r, seed * s.r])
        want = seed
    rows

fn clock(t int) str
    day := if t < 1440 then "Fri" else "Sat"
    m := t % 1440
    h := m / 60
    mm := m % 60
    "{day} {h:02}:{mm:02}"

fn main()
    stages := [Stage(r: 3, hours: 8), Stage(r: 2, hours: 5)]
    bake := 1440 + 9 * 60
    for loaves in 1..=3
        target := 180 * loaves
        rows := build(target, stages)
        mut t := bake
        for s in stages
            t -= s.hours * 60
        print("{loaves} loaf, {target} g levain, from {rows[0][0]} g of jar starter:")
        for i, row in rows.enumerate()
            print("  {clock(t)} feed {row[0]} g seed + {row[1]} g flour + {row[2]} g water")
            t += stages[i].hours * 60
    print("bake at {clock(bake)}")

@test fn one_stage()
    assert_eq(build(180, [Stage(r: 2, hours: 5)]), [[36, 72, 72]])
