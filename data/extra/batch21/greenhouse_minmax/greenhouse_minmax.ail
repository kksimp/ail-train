## Greenhouse min-max: a fortnight of min/max thermometer readings; nights at or below 2 C needed the heater,
## days at 27 C or more needed venting, and the widest daily swing and the mean of daily midpoints are given.

fn main()
    days := ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
    lows := [3, 1, 5, 2, 0, 4, 6, 8, 7, 2, 1, 3, 5, 6]
    highs := [18, 22, 27, 24, 19, 28, 31, 26, 23, 17, 21, 29, 25, 24]
    mut heater := List[str]()
    mut vent := List[str]()
    mut widest := 0
    for i in 0..lows.len()
        name := "{days[i % 7]} {i + 1}"
        if lows[i] <= 2
            heater.push(name)
        if highs[i] >= 27
            vent.push(name)
        if highs[i] - lows[i] > highs[widest] - lows[widest]
            widest = i
    h := heater.join(", ")
    v := vent.join(", ")
    print("heater nights ({heater.len()}): {h}")
    print("vent days ({vent.len()}): {v}")
    swing := highs[widest] - lows[widest]
    print("widest swing: day {widest + 1}, {lows[widest]} to {highs[widest]} C ({swing} degrees)")
    mid := zip(lows, highs).fold(0, |acc, p| acc + p.0 + p.1).to_float() / (2.0 * lows.len().to_float())
    print("mean midpoint {mid:.1} C")
    coldest := lows.min() else 0
    print("coldest night {coldest} C")

@test fn swing()
    assert_eq(zip([1, 2], [5, 9]).fold(0, |acc, p| acc + p.1 - p.0), 11)
