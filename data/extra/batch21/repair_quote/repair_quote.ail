## Repair quote: labour is billed in started quarter hours at 48.00 an hour, parts carry a 20% markup,
## and VAT at 20% is added to the whole; each bike job gets an itemised quote.

struct Job
    bike str
    minutes int
    parts List[(str, int)]

fn labour(minutes int) int
    (minutes + 14) / 15 * 1200

fn money(c int) str
    "{c / 100}.{c % 100:02}"

fn main()
    jobs := [Job(bike: "Raleigh", minutes: 50, parts: [("brake pads", 1200), ("cable", 450)]), Job(bike: "Brompton", minutes: 15, parts: [("tube", 600)]), Job(bike: "Trek", minutes: 95, parts: [("chain", 2500), ("cassette", 4200)]), Job(bike: "kids bike", minutes: 31, parts: [])]
    mut day := 0
    for j in jobs
        lab := labour(j.minutes)
        pc := j.parts.fold(0, |acc, p| acc + p.1 * 120 / 100)
        sub := lab + pc
        vat := sub / 5
        day += sub + vat
        names := j.parts.map(|p| p.0)
        what := if names.is_empty() then "no parts" else names.join(" and ")
        print("{j.bike:<9} {j.minutes} min labour {money(lab)}, parts {money(pc)} ({what}), VAT {money(vat)}, total {money(sub + vat)}")
    print("quotes for the day: {money(day)}")

@test fn quarters()
    assert_eq(labour(31), 3600)
    assert_eq(labour(15), 1200)
