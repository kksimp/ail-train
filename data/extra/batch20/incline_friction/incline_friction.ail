## Incline friction: a block on a ramp starts sliding only when tan(angle) beats the static friction
## coefficient; once moving it speeds up at g (sin a - mu_k cos a), which gives the time down a 3 m ramp.

PI := 3.141592653589793
G := 9.81

struct Surface
    name str
    mu_s float
    mu_k float

fn accel(angle_deg float, mu_k float) float
    a := angle_deg * PI / 180.0
    G * (a.sin() - mu_k * a.cos())

fn slips(angle_deg float, mu_s float) bool
    a := angle_deg * PI / 180.0
    a.tan() > mu_s

fn main()
    surfaces := [Surface(name: "wood on wood", mu_s: 0.5, mu_k: 0.3), Surface(name: "steel on ice", mu_s: 0.1, mu_k: 0.05), Surface(name: "rubber on concrete", mu_s: 0.9, mu_k: 0.7)]
    for s in surfaces
        tip := s.mu_s.atan() * 180.0 / PI
        print("{s.name}: starts sliding above {tip:.1} degrees")
        for ang in [10, 25, 40]
            angle := ang.to_float()
            if slips(angle, s.mu_s)
                acc := accel(angle, s.mu_k)
                t := (2.0 * 3.0 / acc).sqrt()
                print("  {ang} deg: slides, a = {acc:.2} m/s2, 3 m in {t:.2} s")
            else
                print("  {ang} deg: holds")

@test fn steep_ramp()
    assert(slips(45.0, 0.9))
    assert(not slips(10.0, 0.5))
