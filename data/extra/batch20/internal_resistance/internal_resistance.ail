## Battery internal resistance: two readings of terminal voltage at different currents give
## r = (V1 - V2) / (I2 - I1) and EMF = V1 + I1 r; the battery then delivers most power into a load equal to r.

struct Cell
    name str
    v1 float
    i1 float
    v2 float
    i2 float

fn Cell.r(self) float
    (self.v1 - self.v2) / (self.i2 - self.i1)

fn Cell.emf(self) float
    self.v1 + self.i1 * self.r()

fn Cell.volts_into(self, load float) float
    self.emf() * load / (load + self.r())

fn main()
    cells := [Cell(name: "AA alkaline", v1: 1.52, i1: 0.1, v2: 1.4, i2: 0.5), Cell(name: "Li-ion 18650", v1: 4.1, i1: 0.5, v2: 3.95, i2: 3.5), Cell(name: "car battery", v1: 12.6, i1: 5.0, v2: 10.4, i2: 200.0)]
    for c in cells
        r := c.r()
        e := c.emf()
        short := e / r
        maxp := e * e / (4.0 * r)
        print("{c.name}: EMF {e:.3} V, r {r * 1000.0:.1} mohm, short circuit {short:.1} A, best load power {maxp:.1} W")
        for load in [10.0, 1.0, 0.1]
            print("  into {load} ohm: {c.volts_into(load):.3} V")

@test fn two_readings()
    c := Cell(name: "x", v1: 10.0, i1: 1.0, v2: 8.0, i2: 3.0)
    assert_eq(c.r(), 1.0)
    assert_eq(c.emf(), 11.0)
