## Heat diffusion in a rod: the explicit scheme T[i] += r (T[i-1] - 2 T[i] + T[i+1]) with ends held at
## 100 C and 0 C creeps to a straight-line profile when r = alpha dt / dx^2 <= 0.5, and blows up when r is larger.

fn step(mut t List[float], r float)
    old := t.slice(0)
    for i in 1..t.len() - 1
        t[i] = old[i] + r * (old[i - 1] - 2.0 * old[i] + old[i + 1])

fn show(t List[float]) str
    t.map(|x| "{x:.1}").join(" ")

fn run(r float, steps int) List[float]
    mut t := [100.0, 20.0, 20.0, 20.0, 20.0, 20.0, 20.0, 20.0, 20.0, 20.0, 0.0]
    for _ in 0..steps
        step(mut t, r)
    t

fn main()
    for steps in [0, 5, 20, 80, 300]
        t := run(0.3, steps)
        print("r 0.3 after {steps:>3}: {show(t)}")
    wild := run(0.6, 40)
    mut worst := 0.0
    for x in wild
        if x.abs() > worst
            worst = x.abs()
    print("r 0.6 after  40: largest |T| {worst:.0}, the scheme is unstable")

@test fn steady_line()
    mut t := [10.0, 5.0, 0.0]
    step(mut t, 0.4)
    assert_eq(t, [10.0, 5.0, 0.0])
