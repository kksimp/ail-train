## Competing species: in the Lotka-Volterra competition model each species' growth is held back by its
## own numbers and by the rival's times a competition coefficient; weak rivalry lets both live, strong rivalry does not.

struct Scenario
    name str
    a12 float
    a21 float

fn run(s Scenario) List[float]
    mut n1 := 50.0
    mut n2 := 40.0
    r1 := 0.8
    r2 := 0.6
    k1 := 1000.0
    k2 := 800.0
    dt := 0.1
    for _ in 0..3000
        d1 := r1 * n1 * (1.0 - (n1 + s.a12 * n2) / k1)
        d2 := r2 * n2 * (1.0 - (n2 + s.a21 * n1) / k2)
        n1 += d1 * dt
        n2 += d2 * dt
    [n1, n2]

fn verdict(n List[float]) str
    if n[0] < 1.0 and n[1] < 1.0
        "both die out"
    elif n[1] < 1.0
        "species A wins"
    elif n[0] < 1.0
        "species B wins"
    else
        "they coexist"

fn main()
    print("A: r 0.8, K 1000; B: r 0.6, K 800; start 50 and 40")
    scenarios := [Scenario(name: "weak rivalry", a12: 0.5, a21: 0.4), Scenario(name: "A pushes hard", a12: 0.6, a21: 1.5), Scenario(name: "B pushes hard", a12: 1.6, a21: 0.5), Scenario(name: "equal rivals", a12: 1.0, a21: 1.0)]
    for s in scenarios
        n := run(s)
        print("{s.name:<14} a12 {s.a12} a21 {s.a21}: A {n[0]:>6.1}, B {n[1]:>6.1}, {verdict(n)}")
    a := (1000.0 - 0.5 * 800.0) / (1.0 - 0.5 * 0.4)
    b := (800.0 - 0.4 * 1000.0) / (1.0 - 0.5 * 0.4)
    print("weak rivalry equilibrium by hand: A {a:.1}, B {b:.1}")

@test fn verdicts()
    assert_eq(verdict([0.5, 300.0]), "species B wins")
    assert_eq(verdict([10.0, 20.0]), "they coexist")
