## Atwood machine: two masses over a pulley accelerate at a = (m1 - m2) g / (m1 + m2 + I / r^2);
## once the pulley has rotational inertia the rope tension differs on its two sides.

struct Pulley
    inertia float
    radius float

fn Pulley.effective_mass(self) float
    self.inertia / (self.radius * self.radius)

fn accel(m1 float, m2 float, p Pulley) float
    9.81 * (m1 - m2) / (m1 + m2 + p.effective_mass())

fn main()
    light := Pulley(inertia: 0.0, radius: 0.1)
    heavy := Pulley(inertia: 0.02, radius: 0.1)
    print("heavy pulley acts like {heavy.effective_mass():.2} kg more mass")
    pairs := [(2.0, 1.0), (5.0, 4.0), (10.0, 9.5), (3.0, 3.0)]
    for pr in pairs
        m1, m2 := pr
        a0 := accel(m1, m2, light)
        a1 := accel(m1, m2, heavy)
        t1 := m1 * (9.81 - a1)
        t2 := m2 * (9.81 + a1)
        print("{m1} kg vs {m2} kg: a = {a0:.3} light, {a1:.3} heavy, tensions {t1:.2} and {t2:.2} N")
    a := accel(2.0, 1.0, heavy)
    t := (2.0 / a).sqrt()
    print("2 kg vs 1 kg on the heavy pulley drops 1 m in {t:.3} s")

@test fn balanced()
    p := Pulley(inertia: 0.02, radius: 0.1)
    assert_eq(accel(3.0, 3.0, p), 0.0)
