## Genetic drift: in a Wright-Fisher population each generation's 2N gene copies are drawn at random from
## the last one's allele frequency; small populations wander fast to loss or fixation, big ones barely move.

struct Rng
    state int

fn Rng.uniform(mut self) float
    self.state = (self.state * 1103515245 + 12345) % 2147483648
    self.state.to_float() / 2147483648.0

fn drift(n int, p0 float, gens int, mut rng Rng) List[float]
    mut p := p0
    mut path := [p]
    for _ in 0..gens
        mut hits := 0
        mut draws := 0
        while draws < 2 * n
            draws += 1
            if rng.uniform() < p
                hits += 1
        p = hits.to_float() / (2 * n).to_float()
        path.push(p)
    path

fn main()
    mut rng := Rng(state: 7)
    for n in [5, 25, 250]
        path := drift(n, 0.5, 100, mut rng)
        marks := [0, 10, 20, 40, 60, 80, 100].map(|g| "{path[g]:.2}").join(" ")
        fixed := [g for g in 0..path.len() if path[g] == 0.0 or path[g] == 1.0]
        ending := if fixed.is_empty() then "both alleles remain" else "settled at generation {fixed[0]}"
        print("N {n:>3}: {marks} ({ending})")

@test fn fixed_stays()
    mut rng := Rng(state: 1)
    path := drift(10, 1.0, 5, mut rng)
    assert_eq(path[5], 1.0)
