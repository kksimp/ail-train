## Thevenin equivalent: a source behind a divider R1-R2 and a series R3 looks to any load like one
## source Vth = V R2 / (R1 + R2) behind Rth = R1 || R2 + R3; the load draws most power when it equals Rth.

fn parallel(a float, b float) float
    a * b / (a + b)

struct Thevenin
    volts float
    ohms float

fn Thevenin.load_power(self, load float) float
    i := self.volts / (self.ohms + load)
    i * i * load

fn main()
    v := 12.0
    r1 := 4000.0
    r2 := 6000.0
    r3 := 1000.0
    th := Thevenin(volts: v * r2 / (r1 + r2), ohms: parallel(r1, r2) + r3)
    print("Vth {th.volts:.2} V, Rth {th.ohms:.0} ohm")
    mut best := 0.0
    mut best_load := 0.0
    for load in [500.0, 1000.0, 2000.0, 3400.0, 5000.0, 10000.0]
        p := th.load_power(load)
        if p > best
            best = p
            best_load = load
        direct := v * parallel(r2, r3 + load) / (r1 + parallel(r2, r3 + load)) * load / (r3 + load)
        print("load {load:>6.0} ohm: {th.volts * load / (th.ohms + load):.3} V (direct {direct:.3} V), {p * 1000.0:.3} mW")
    print("most power at {best_load:.0} ohm: {best * 1000.0:.3} mW")

@test fn half_voltage_at_match()
    t := Thevenin(volts: 10.0, ohms: 50.0)
    assert((t.load_power(50.0) - 0.5).abs() < 0.000001)
