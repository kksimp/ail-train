## Haar wavelet: each level replaces pairs by their average and half-difference, so a smooth signal
## leaves tiny details; zeroing details below a threshold compresses it, and the inverse rebuilds an approximation.

fn forward(xs List[float]) List[float]
    mut out := xs.slice(0)
    mut n := xs.len()
    while n > 1
        mut tmp := out.slice(0)
        for i in 0..n / 2
            tmp[i] = (out[2 * i] + out[2 * i + 1]) / 2.0
            tmp[n / 2 + i] = (out[2 * i] - out[2 * i + 1]) / 2.0
        out = tmp
        n = n / 2
    out

fn inverse(cs List[float]) List[float]
    mut out := cs.slice(0)
    mut n := 1
    while n < cs.len()
        mut tmp := out.slice(0)
        for i in 0..n
            tmp[2 * i] = out[i] + out[n + i]
            tmp[2 * i + 1] = out[i] - out[n + i]
        out = tmp
        n = n * 2
    out

fn keep(i int, c float, limit float) float
    if i == 0 or c.abs() >= limit then c else 0.0

fn main()
    signal := [10.0, 12.0, 14.0, 14.0, 13.0, 30.0, 31.0, 29.0]
    cs := forward(signal)
    print("signal:       {signal}")
    print("coefficients: {cs}")
    for limit in [0.5, 1.5, 4.0]
        kept := cs.enumerate().map(|p| keep(p.0, p.1, limit))
        zeros := kept.count(|c| c == 0.0)
        back := inverse(kept)
        mut worst := 0.0
        for i in 0..signal.len()
            e := (back[i] - signal[i]).abs()
            if e > worst
                worst = e
        print("drop details under {limit}: {zeros} zeros, rebuilt {back}, worst error {worst}")

@test fn round_trip()
    xs := [4.0, 2.0, 5.0, 7.0]
    assert_eq(inverse(forward(xs)), xs)
