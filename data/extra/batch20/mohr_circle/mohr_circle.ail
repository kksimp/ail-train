## Mohr's circle: a plane stress state (sx, sy, txy) has centre (sx + sy) / 2 and radius
## sqrt(((sx - sy) / 2)^2 + txy^2); the principal stresses are centre +- radius at angle atan2(2 txy, sx - sy) / 2.

PI := 3.141592653589793

struct Stress
    name str
    sx float
    sy float
    txy float

fn Stress.centre(self) float
    (self.sx + self.sy) / 2.0

fn Stress.radius(self) float
    h := (self.sx - self.sy) / 2.0
    (h * h + self.txy * self.txy).sqrt()

fn Stress.on_plane(self, deg float) float
    a := 2.0 * deg * PI / 180.0
    self.centre() + (self.sx - self.sy) / 2.0 * a.cos() + self.txy * a.sin()

fn main()
    states := [Stress(name: "shaft surface", sx: 0.0, sy: 0.0, txy: 50.0), Stress(name: "bolt in tension", sx: 120.0, sy: 0.0, txy: 0.0), Stress(name: "bracket weld", sx: 80.0, sy: -40.0, txy: 30.0), Stress(name: "plate corner", sx: -60.0, sy: -20.0, txy: -25.0)]
    for s in states
        c := s.centre()
        r := s.radius()
        angle := (2.0 * s.txy).atan2(s.sx - s.sy) * 90.0 / PI
        print("{s.name}: s1 {c + r:.1} MPa, s2 {c - r:.1} MPa, max shear {r:.1} MPa, principal plane {angle:.1} deg")
        print("  normal stress on the 30 deg plane {s.on_plane(30.0):.1} MPa")

@test fn uniaxial()
    s := Stress(name: "x", sx: 100.0, sy: 0.0, txy: 0.0)
    assert_eq(s.radius(), 50.0)
    assert_eq(s.centre() + s.radius(), 100.0)
