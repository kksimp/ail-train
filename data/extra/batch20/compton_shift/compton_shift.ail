## Compton scattering: an X-ray photon bouncing off a free electron at angle theta comes out longer by
## 0.0024263 nm x (1 - cos theta); the energy it loses goes to the electron, most at 180 degrees.

PI := 3.141592653589793
SHIFT := 0.0024263

fn scattered(lam float, deg float) float
    lam + SHIFT * (1.0 - (deg * PI / 180.0).cos())

fn main()
    lam := 0.0709
    e_in := 1.23984 / lam
    print("molybdenum X-rays {lam} nm, {e_in:.2} keV")
    for deg in [0.0, 30.0, 60.0, 90.0, 120.0, 150.0, 180.0]
        out := scattered(lam, deg)
        e_out := 1.23984 / out
        given := e_in - e_out
        print("{deg:>5.0} deg: {out:.5} nm, electron gets {given:.3} keV ({given / e_in * 100.0:.2}%)")
    gamma := 0.00188
    back := scattered(gamma, 180.0)
    print("a 660 keV gamma ray backscattered keeps {gamma / back * 100.0:.1}% of its energy")

@test fn forward_unchanged()
    assert_eq(scattered(0.05, 0.0), 0.05)
