01100100 + 00110111 = 10011011 carry 0 overflow 1
  unsigned 100 + 55 -> 155, signed 100 + 55 -> -101
11001000 + 01100100 = 00101100 carry 1 overflow 0
  unsigned 200 + 100 -> 44, signed -56 + 100 -> 44
10011100 + 11001110 = 01101010 carry 1 overflow 1
  unsigned 156 + 206 -> 106, signed -100 + -50 -> 106
01100100 + 00110010 = 10010110 carry 0 overflow 1
  unsigned 100 + 50 -> 150, signed 100 + 50 -> -106
11111111 + 00000001 = 00000000 carry 1 overflow 0
  unsigned 255 + 1 -> 0, signed -1 + 1 -> 0
