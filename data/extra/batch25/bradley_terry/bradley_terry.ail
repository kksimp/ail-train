## Bradley-Terry strengths: team i beats team j with chance p_i / (p_i + p_j); repeating the update
## p_i = wins_i / sum over opponents of games_ij / (p_i + p_j), rescaled each round, fits the strengths to a season's results.

fn main()
    teams := ["Otters", "Herons", "Badgers", "Foxes"]
    wins := [[0, 4, 5, 6], [2, 0, 4, 5], [1, 2, 0, 4], [0, 1, 2, 0]]
    n := teams.len()
    mut p := [1.0, 1.0, 1.0, 1.0]
    for round in 0..200
        mut next := List[float]()
        for i in 0..n
            w := wins[i].sum().to_float()
            mut den := 0.0
            for j in 0..n
                if j != i
                    games := (wins[i][j] + wins[j][i]).to_float()
                    den += games / (p[i] + p[j])
            next.push(w / den)
        total := next.fold(0.0, |a, x| a + x)
        p = next.map(|x| x * n.to_float() / total)
    for i in 0..n
        print("{teams[i]:<8} won {wins[i].sum():>2}  strength {p[i]:.3}")
    for pair in [(0, 1), (0, 3), (1, 2), (2, 3)]
        i, j := pair
        chance := p[i] / (p[i] + p[j]) * 100.0
        print("{teams[i]} beat {teams[j]} {chance:.1}% of the time")

@test fn even()
    p := [1.0, 1.0]
    assert_eq(p[0] / (p[0] + p[1]), 0.5)
