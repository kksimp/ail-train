## ABC notation bar check: each note or rest is a unit length times an optional factor (2, /2, 3/2, /),
## counted in sixteenths of the unit; each bar's total is compared with the length the time signature asks for.

fn bar_lengths(music str) List[int]
    cs := music.chars()
    mut bars := List[int]()
    mut cur := 0
    mut i := 0
    while i < cs.len()
        c := cs[i]
        if c == '|'
            bars.push(cur)
            cur = 0
            i += 1
        elif "ABCDEFGabcdefgz".contains(c)
            i += 1
            while i < cs.len() and (cs[i] == ',' or cs[i] == '\'')
                i += 1
            mut num := 0
            while i < cs.len() and cs[i].is_digit()
                num = num * 10 + (cs[i].to_digit(10) else 0)
                i += 1
            if num == 0
                num = 1
            mut den := 1
            if i < cs.len() and cs[i] == '/'
                i += 1
                den = 0
                while i < cs.len() and cs[i].is_digit()
                    den = den * 10 + (cs[i].to_digit(10) else 0)
                    i += 1
                if den == 0
                    den = 2
            cur += 16 * num / den
        else
            i += 1
    bars

fn units_text(b int) str
    whole := b / 16
    mark := if b % 16 == 0 then "" else "+"
    "{whole}{mark}"

fn main()
    tunes := [("waltz", 6, "A2 B2 c2 | d3 c B2 | A4 z2 | G2 A B c2 | d6 |"), ("jig", 6, "d2c B2A | G3 A3 | B/c/d e3 | d2B A2G G |"), ("march", 8, "C,2 E,G, C2 E2 | ^F2 G2 _B2 A2 | G8 |"), ("reel", 8, "A/B/c dB AFDF | A2 FA d3/2e/f2 | g2 fe d4 |")]
    for t in tunes
        name, units, music := t
        bars := bar_lengths(music)
        want := units * 16
        shown := bars.map(|b| units_text(b)).join(" ")
        mut bad := List[int]()
        for i, b in bars.enumerate()
            if b != want
                bad.push(i + 1)
        verdict := if bad.is_empty() then "all bars full" else "wrong bars {bad}"
        print("{name:<6} want {units} units: {shown} -> {verdict}")

@test fn halves()
    assert_eq(bar_lengths("B/c/d e3 |"), [80])
    assert_eq(bar_lengths("A3/2G/ |"), [32])
