## Internal migration: an origin-destination table of movers between regions gives each region's
## in-flow, out-flow, net and gross migration, and the efficiency net / gross showing how one-sided its exchanges are.

fn main()
    names := ["North", "Coast", "Capital", "Valley", "South"]
    flows := [[0, 1200, 5400, 800, 300], [900, 0, 3100, 600, 700], [2100, 2600, 0, 1900, 2400], [500, 400, 2900, 0, 650], [350, 900, 1800, 700, 0]]
    n := names.len()
    mut biggest := (0, 0)
    for i in 0..n
        outflow := flows[i].sum()
        inflow := flows.fold(0, |a, row| a + row[i])
        net := inflow - outflow
        gross := inflow + outflow
        eff := net.to_float() / gross.to_float() * 100.0
        print("{names[i]:<8} in {inflow:>6,} out {outflow:>6,} net {net:>6} gross {gross:>6,} efficiency {eff:>6.1}%")
        for j in 0..n
            if flows[i][j] > flows[biggest.0][biggest.1]
                biggest = (i, j)
    total := flows.fold(0, |a, row| a + row.sum())
    print("{total:,} movers; largest stream {names[biggest.0]} -> {names[biggest.1]} ({flows[biggest.0][biggest.1]:,})")

@test fn nets_cancel()
    flows := [[0, 5], [3, 0]]
    inflow0 := flows[1][0]
    assert_eq(inflow0 - flows[0].sum(), -2)
