## Coptic and Ethiopian calendars: both have twelve 30-day months and a short thirteenth of 5 or 6 days,
## differing only in epoch; a Julian day number minus the epoch gives the year by (4 days + 1463) / 1461, then month and day.

fn jdn(y int, m int, d int) int
    a := (14 - m) / 12
    yy := y + 4800 - a
    mm := m + 12 * a - 3
    d + (153 * mm + 2) / 5 + 365 * yy + yy / 4 - yy / 100 + yy / 400 - 32045

fn convert(j int, epoch int, months List[str]) str
    year := (4 * (j - epoch) + 1463) / 1461
    start := epoch + 365 * (year - 1) + year / 4
    month := (j - start) / 30 + 1
    day := j - start - 30 * (month - 1) + 1
    "{day} {months[month - 1]} {year}"

fn main()
    coptic := ["Thout", "Paopi", "Hathor", "Koiak", "Tobi", "Meshir", "Paremhat", "Parmouti", "Pashons", "Paoni", "Epip", "Mesori", "Nasie"]
    ethiopian := ["Meskerem", "Tikimt", "Hidar", "Tahsas", "Tir", "Yekatit", "Megabit", "Miyazya", "Ginbot", "Sene", "Hamle", "Nehase", "Pagume"]
    dates := [(2023, 9, 11), (2023, 9, 12), (2024, 1, 7), (2024, 9, 11), (2025, 9, 6), (2026, 11, 21), (2000, 1, 1)]
    for t in dates
        y, m, d := t
        j := jdn(y, m, d)
        c := convert(j, 1825030, coptic)
        e := convert(j, 1724221, ethiopian)
        print("{y}-{m:02}-{d:02}  Coptic {c:<20} Ethiopian {e}")
    print("the Ethiopian year runs {1825030 - 1724221} days (276 years) ahead of the Coptic")

@test fn new_year()
    eth := ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m"]
    assert_eq(convert(jdn(2023, 9, 12), 1724221, eth), "1 a 2016")
