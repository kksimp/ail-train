## Equal divisions of the octave: an n-step tuning plays a just ratio r with the nearest step,
## round(n log2 r), and misses it by that many steps times 1200 / n cents minus 1200 log2 r.

fn log2(x float) float
    two := 2.0
    x.ln() / two.ln()

fn miss(n int, ratio float) float
    exact := 1200.0 * log2(ratio)
    steps := (n.to_float() * log2(ratio) + 0.5).floor()
    steps * 1200.0 / n.to_float() - exact

fn main()
    ratios := [1.5, 1.25, 1.75]
    print("EDO   fifth 3/2  third 5/4  seventh 7/4  total")
    mut best := 0
    mut best_total := 1000.0
    for n in [5, 7, 12, 19, 22, 31, 53]
        errs := ratios.map(|r| miss(n, r))
        total := errs.fold(0.0, |acc, e| acc + e.abs())
        if total < best_total
            best_total = total
            best = n
        print("{n:>3}   {errs[0]:>9.1}  {errs[1]:>9.1}  {errs[2]:>11.1}  {total:>5.1}")
    print("closest overall: {best}-EDO, {best_total:.2} cents off in all")

@test fn twelve_octave()
    assert(miss(12, 2.0).abs() < 0.000001)
    assert((miss(12, 1.5) + 1.955).abs() < 0.001)
