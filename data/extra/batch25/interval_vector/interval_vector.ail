## Interval vectors: every pair of pitch classes in a set is counted by interval class 1 to 6 (an
## interval and its inversion are one class); different sets with the same vector are Z-related.

fn vector(pcs List[int]) List[int]
    mut v := [0, 0, 0, 0, 0, 0]
    for i in 0..pcs.len()
        for j in i + 1..pcs.len()
            d := (pcs[j] - pcs[i] + 12) % 12
            ic := d.min(12 - d)
            if ic > 0
                v[ic - 1] += 1
    v

fn main()
    sets := [("major triad", [0, 4, 7]), ("augmented", [0, 4, 8]), ("diatonic", [0, 2, 4, 5, 7, 9, 11]), ("pentatonic", [0, 2, 4, 7, 9]), ("4-Z15", [0, 1, 4, 6]), ("4-Z29", [0, 1, 3, 7]), ("whole tone", [0, 2, 4, 6, 8, 10]), ("6-Z17", [0, 1, 2, 4, 7, 8]), ("6-Z43", [0, 1, 2, 5, 6, 8])]
    mut by_vector := Map[str, List[str]]()
    for s in sets
        name, pcs := s
        v := vector(pcs)
        key := v.map(|x| "{x}").join("")
        by_vector.push(key, name)
        counts := {x for x in v}
        distinct := counts.len() == 6
        tag := if distinct then " (every class a different count)" else ""
        print("{name:<12} <{key}>{tag}")
    for key, names in by_vector
        if names.len() > 1
            both := names.join(" and ")
            print("Z-related: {both} share <{key}>")

@test fn triad()
    assert_eq(vector([0, 4, 7]), [0, 0, 1, 1, 1, 0])
