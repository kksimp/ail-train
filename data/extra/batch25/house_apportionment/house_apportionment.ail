## Huntington-Hill apportionment: every state starts with one seat, and each further seat goes to the
## state with the highest priority value P / sqrt(n (n + 1)), n being the seats it already holds.

struct State
    name str
    people int
    seats int

fn priority(s State) float
    n := s.seats.to_float()
    s.people.to_float() / (n * (n + 1.0)).sqrt()

fn main()
    mut states := [State(name: "Arden", people: 3120000, seats: 1), State(name: "Brook", people: 1840000, seats: 1), State(name: "Corvel", people: 960000, seats: 1), State(name: "Dunne", people: 655000, seats: 1), State(name: "Elmar", people: 402000, seats: 1), State(name: "Fallow", people: 118000, seats: 1)]
    house := 20
    total := states.fold(0, |a, s| a + s.people)
    mut order := List[str]()
    first_extra := states.len() + 1
    for seat in first_extra..=house
        mut best := 0
        for i in 1..states.len()
            if priority(states[i]) > priority(states[best])
                best = i
        order.push("{seat}:{states[best].name}")
        states[best].seats += 1
    shown := order.join(" ")
    print("seats 7 to {house}: {shown}")
    for s in states
        quota := s.people.to_float() * house.to_float() / total.to_float()
        print("{s.name:<7} {s.people:>9,}  quota {quota:>5.2}  seats {s.seats}")

@test fn second_seat()
    s := State(name: "x", people: 1000, seats: 1)
    assert((priority(s) - 707.106781).abs() < 0.0001)
