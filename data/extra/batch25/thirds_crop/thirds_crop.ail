## Rule of thirds: the four crossings of the third lines are the strong points of a frame; each subject is
## measured against the nearest one (as % of the diagonal), and a 16:9 crop from a 4:3 photo slides to put it on a third line.

struct Spot
    name str
    x int
    y int

struct Hit
    px int
    py int
    d float

fn nearest(s Spot, w int, h int) Hit
    mut best := Hit(px: 0, py: 0, d: 1000000.0)
    for px in [w / 3, w * 2 / 3]
        for py in [h / 3, h * 2 / 3]
            dx := (s.x - px).to_float()
            dy := (s.y - py).to_float()
            d := (dx * dx + dy * dy).sqrt()
            if d < best.d
                best = Hit(px: px, py: py, d: d)
    best

fn crop_top(y int, h int, crop int) int
    mut best := 0
    mut gap := h
    for line in [crop / 3, crop * 2 / 3]
        top := (y - line).max(0).min(h - crop)
        miss := (y - top - line).abs()
        if miss < gap
            gap = miss
            best = top
    best

fn main()
    w := 4000
    h := 3000
    diag := 5000.0
    spots := [Spot(name: "lighthouse", x: 1300, y: 1050), Spot(name: "boat", x: 2000, y: 1500), Spot(name: "gull", x: 2700, y: 900), Spot(name: "rock", x: 3500, y: 2400), Spot(name: "child", x: 600, y: 2200)]
    for s in spots
        hit := nearest(s, w, h)
        px := hit.px
        py := hit.py
        share := hit.d / diag * 100.0
        tag := if share <= 5.0 then "on a third" else "off the thirds"
        top := crop_top(s.y, h, 2250)
        print("{s.name:<10} nearest ({px},{py}) at {share:>4.1}% {tag:<14} 16:9 crop top {top}")

@test fn crop()
    assert_eq(crop_top(1500, 3000, 2250), 750)
    assert_eq(crop_top(100, 3000, 2250), 0)
