## Smart quotes: a straight quote opens (“ or ‘) at the start or after a space or bracket and closes
## (” or ’) elsewhere, so apostrophes inside words become ’; --- becomes an em dash, -- an en dash and ... an ellipsis.

fn opens(prev char) bool
    prev == ' ' or prev == '(' or prev == '[' or prev == '—' or prev == '\n'

fn curl(text str) str
    t := text.replace("---", "—").replace("--", "–").replace("...", "…")
    mut out := List[char]()
    mut prev := ' '
    for c in t.chars()
        if c == '"'
            q := if opens(prev) then '“' else '”'
            out.push(q)
        elif c == '\''
            q := if opens(prev) then '‘' else '’'
            out.push(q)
        else
            out.push(c)
        prev = c
    out.join("")

fn main()
    lines := ["\"It's late,\" she said.", "The 'old' house---empty now---stood by the road.", "Pages 12--19 cover the '80s... mostly.", "He called it \"the best (and 'only') option.\"", "Don't stop; we're nearly there."]
    mut changed := 0
    for l in lines
        c := curl(l)
        changed += c.chars().count(|ch| "“”‘’—–…".contains(ch))
        print(c)
    print("{changed} typographic characters put in")

@test fn apostrophe()
    assert_eq(curl("it's"), "it’s")
    assert_eq(curl("\"hi\""), "“hi”")
