## Figured bass: a chord's root is the note whose intervals above it form a known triad or seventh chord,
## and the chord member in the bass picks the inversion and its figures (5/3, 6, 6/4; 7, 6/5, 4/3, 4/2).

fn analyse(notes List[int]) str
    names := ["C", "C#", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"]
    shapes := [([0, 4, 7], ""), ([0, 3, 7], "m"), ([0, 3, 6], "dim"), ([0, 4, 7, 10], "7"), ([0, 3, 7, 10], "m7"), ([0, 4, 7, 11], "maj7"), ([0, 3, 6, 10], "m7b5")]
    triad_figs := ["5/3", "6", "6/4"]
    seventh_figs := ["7", "6/5", "4/3", "4/2"]
    inversions := ["root position", "first inversion", "second inversion", "third inversion"]
    mut pcs := Set[int]()
    for n in notes
        pcs.add(n % 12)
    for r in pcs.sorted()
        mut rel := Set[int]()
        for p in pcs
            rel.add((p - r + 12) % 12)
        shape := rel.sorted()
        for s in shapes
            ivs, suffix := s
            if ivs == shape
                bass := (notes[0] % 12 - r + 12) % 12
                member := ivs.index_of(bass) else 0
                figs := if ivs.len() == 3 then triad_figs[member] else seventh_figs[member]
                return "{names[r]}{suffix} {inversions[member]} ({figs})"
    "unknown chord"

fn main()
    chords := [[48, 52, 55, 60], [52, 55, 60, 64], [43, 48, 52, 55], [43, 47, 50, 53], [47, 50, 53, 55], [50, 53, 55, 59], [41, 47, 50, 55], [45, 48, 52, 57], [50, 53, 59], [48, 53, 57, 62]]
    for c in chords
        print("{c} {analyse(c)}")

@test fn six_five()
    assert_eq(analyse([47, 50, 53, 55]), "G7 first inversion (6/5)")
    assert_eq(analyse([60, 62, 63]), "unknown chord")
