## Line measure: an average character is about half the font size wide, so a column holds about
## width * 2 / size characters; 45 to 75 reads comfortably, and width / 33 is the font size that gives the ideal 66.

fn verdict(cpl int) str
    if cpl < 45 then "too narrow" elif cpl > 75 then "too wide" else "comfortable"

fn main()
    layouts := [("phone", 320, 16), ("tablet", 600, 16), ("article", 680, 18), ("desktop", 960, 16), ("sidebar", 280, 14), ("wide hero", 1200, 20), ("print column", 450, 10)]
    mut ok := 0
    for l in layouts
        name, width, size := l
        cpl := width * 2 / size
        v := verdict(cpl)
        if v == "comfortable"
            ok += 1
        ideal := width.to_float() / 33.0
        print("{name:<12} {width:>4}px at {size}px: {cpl:>3} chars, {v:<11} (66 chars at {ideal:.1}px)")
    print("{ok} of {layouts.len()} layouts read comfortably; 66 chars at 16px needs {66 * 16 / 2}px")

@test fn tablet()
    assert_eq(600 * 2 / 16, 75)
    assert_eq(verdict(75), "comfortable")
