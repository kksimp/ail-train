## Right triangles: generates primitive Pythagorean triples with Euclid's formula from
## coprime m and n of opposite parity, sorted by hypotenuse, and counts triples by perimeter.

fn gcd(a int, b int) int
    if b == 0 then a else gcd(b, a % b)

fn triples(max_c int) List[(int, int, int)]
    mut out := List[(int, int, int)]()
    mut m := 2
    while m * m + 1 <= max_c
        for n in 1..m
            if (m - n) % 2 == 1 and gcd(m, n) == 1
                a := m * m - n * n
                b := 2 * m * n
                c := m * m + n * n
                if c <= max_c
                    out.push((a.min(b), a.max(b), c))
        m += 1
    out.sorted(by: |t| (t.2, t.0))

fn main()
    ts := triples(100)
    print("{ts.len()} primitive triples with c <= 100")
    for t in ts.take(8)
        print("  {t.0}^2 + {t.1}^2 = {t.2}^2")
    mut by_perimeter := Map[int, int]()
    for t in triples(1000)
        p := t.0 + t.1 + t.2
        mut k := p
        while k <= 1000
            by_perimeter[k] += 1
            k += p
    best := by_perimeter.keys().max(by: |p| (by_perimeter[p], -p)) else 0
    print("perimeter up to 1000 with most right triangles: {best} ({by_perimeter[best]})")

@test fn first_triple()
    assert_eq(triples(5), [(3, 4, 5)])
