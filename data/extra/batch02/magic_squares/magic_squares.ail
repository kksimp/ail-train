## Magic squares: checks that every row, column and both diagonals add up to the same
## total and that the square uses 1 to n*n once; builds odd squares by the Siamese method.

fn line_sums(sq List[List[int]]) List[int]
    n := sq.len()
    mut out := List[int]()
    for r in 0..n
        out.push(sq[r].sum())
    for c in 0..n
        out.push([sq[r][c] for r in 0..n].sum())
    out.push([sq[i][i] for i in 0..n].sum())
    out.push([sq[i][n - 1 - i] for i in 0..n].sum())
    out

fn is_magic(sq List[List[int]]) bool
    n := sq.len()
    mut seen := Set[int]()
    for row in sq
        for x in row
            seen.add(x)
    if seen.len() != n * n or seen.any(|x| x < 1 or x > n * n)
        return false
    sums := line_sums(sq)
    sums.all(|t| t == sums[0])

fn siamese(n int) List[List[int]]
    mut sq := List[List[int]]()
    for _ in 0..n
        sq.push([0 for _ in 0..n])
    mut r := 0
    mut c := n / 2
    for k in 1..=n * n
        sq[r][c] = k
        nr := (r - 1 + n) % n
        nc := (c + 1) % n
        if sq[nr][nc] != 0
            r = (r + 1) % n
        else
            r = nr
            c = nc
    sq

fn main()
    lo_shu := [[4, 9, 2], [3, 5, 7], [8, 1, 6]]
    print("lo shu: {is_magic(lo_shu)}")
    print("swapped: {is_magic([[9, 4, 2], [3, 5, 7], [8, 1, 6]])}")
    print("all fives: {is_magic([[5, 5, 5], [5, 5, 5], [5, 5, 5]])}")
    for n in [3, 5]
        sq := siamese(n)
        for row in sq
            print(row.map(|x| "{x:>3}").join(""))
        print("n={n}: magic {is_magic(sq)}, total {line_sums(sq)[0]}")

@test fn siamese_is_magic()
    assert(is_magic(siamese(7)))
