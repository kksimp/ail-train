## Hex board: cells on a hexagonal board in axial coordinates; the distance between cells,
## the six neighbours, and how many cells lie within a radius.

fn hex_distance(a (int, int), b (int, int)) int
    dq := a.0 - b.0
    dr := a.1 - b.1
    (dq.abs() + dr.abs() + (dq + dr).abs()) / 2

fn neighbours(c (int, int)) List[(int, int)]
    q, r := c
    [(q + 1, r), (q - 1, r), (q, r + 1), (q, r - 1), (q + 1, r - 1), (q - 1, r + 1)]

fn within(center (int, int), radius int) int
    mut n := 0
    for q in -radius..=radius
        for r in -radius..=radius
            if hex_distance(center, (center.0 + q, center.1 + r)) <= radius
                n += 1
    n

fn main()
    origin := (0, 0)
    for target in [(3, -1), (-2, 4), (0, 0), (5, -5), (-3, -2)]
        print("({target.0}, {target.1}) is {hex_distance(origin, target)} steps away")
    ns := neighbours((2, 2))
    print("neighbours of (2, 2): {ns.map(|c| "({c.0},{c.1})").join(" ")}")
    print("all at distance 1: {ns.all(|c| hex_distance(c, (2, 2)) == 1)}")
    for radius in 0..=4
        print("radius {radius}: {within(origin, radius)} cells")

@test fn ring_sizes()
    assert_eq(within((0, 0), 1), 7)
    assert_eq(within((5, 5), 2), 19)
