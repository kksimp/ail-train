## Golf card: compares each hole's strokes with par and names the result (eagle, birdie,
## par, bogey...) with `match` on the difference, then totals the round.

fn name_of(diff int) str
    if diff < -3
        "condor"
    elif diff > 2
        "+{diff}"
    else
        ["albatross", "eagle", "birdie", "par", "bogey", "double bogey"][diff + 3]

fn main()
    pars := [4, 3, 5, 4, 4, 3, 5, 4, 4]
    strokes := [4, 2, 6, 7, 3, 3, 3, 5, 4]
    mut names := Map[str, int]()
    for i, pair in zip(pars, strokes).enumerate()
        par, got := pair
        n := name_of(got - par)
        names[n] += 1
        print("hole {i + 1}: par {par}, {got} strokes, {n}")
    total := strokes.sum()
    diff := total - pars.sum()
    shown := if diff > 0 then "+{diff}" elif diff == 0 then "E" else "{diff}"
    print("round: {total} ({shown})")
    for k, v in names
        print("  {k}: {v}")

@test fn names()
    assert_eq(name_of(-1), "birdie")
    assert_eq(name_of(4), "+4")
    assert_eq(name_of(-4), "condor")
