## Cheapest route: the least total cost from the top-left to the bottom-right of a cost
## grid moving right or down, computed in one row of memory, compared with greedy moves.

fn cheapest(g List[List[int]]) int
    cols := g[0].len()
    mut row := [0 for _ in 0..cols]
    for r in 0..g.len()
        for c in 0..cols
            if r == 0 and c == 0
                row[c] = g[0][0]
            elif r == 0
                row[c] = row[c - 1] + g[r][c]
            elif c == 0
                row[c] = row[c] + g[r][c]
            else
                row[c] = row[c].min(row[c - 1]) + g[r][c]
    row[cols - 1]

fn greedy(g List[List[int]]) int
    mut r := 0
    mut c := 0
    mut total := g[0][0]
    while r < g.len() - 1 or c < g[0].len() - 1
        down := if r + 1 < g.len() then g[r + 1][c] else 1000000
        right := if c + 1 < g[0].len() then g[r][c + 1] else 1000000
        if down <= right
            r += 1
        else
            c += 1
        total += g[r][c]
    total

fn main()
    grids := [
        [[1, 3, 1], [1, 5, 1], [4, 2, 1]],
        [[1, 2, 3], [4, 5, 6]],
        [[1, 1, 9, 9], [9, 1, 9, 9], [9, 1, 1, 1], [9, 9, 9, 1]],
        [[2, 1, 50], [3, 40, 1], [1, 1, 1]],
    ]
    for g in grids
        print("best {cheapest(g)}, greedy {greedy(g)}")

@test fn classic()
    assert_eq(cheapest([[1, 3, 1], [1, 5, 1], [4, 2, 1]]), 7)
