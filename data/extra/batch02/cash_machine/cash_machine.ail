## Cash machine: pays out an amount with the fewest notes from a limited stock, trying
## larger notes first and backing off when the rest cannot be made; stock is updated.

fn pay(amount int, notes List[int], stock List[int], i int) List[int]?
    if amount == 0
        return [0 for _ in 0..notes.len()]
    if i >= notes.len()
        return none
    most := (amount / notes[i]).min(stock[i])
    mut k := most
    while k >= 0
        if rest := pay(amount - k * notes[i], notes, stock, i + 1)
            mut out := rest
            out[i] = k
            return out
        k -= 1
    none

fn main()
    notes := [100, 50, 20, 10]
    mut stock := [2, 1, 4, 3]
    for amount in [180, 260, 70, 30, 500, 15]
        if used := pay(amount, notes, stock, 0)
            parts := [("{notes[i]}x{used[i]}") for i in 0..notes.len() if used[i] > 0]
            for i in 0..notes.len()
                stock[i] -= used[i]
            print("{amount}: {parts.join(" ")}  stock now {stock.map(|s| "{s}").join("/")}")
        else
            print("{amount}: cannot pay")

@test fn backs_off_from_big_notes()
    used := pay(60, [50, 20], [1, 3], 0) else []
    assert_eq(used, [0, 3])
