## Number pyramid: the largest sum from the top of a number triangle to the bottom, moving
## to one of the two numbers below, worked from the bottom row up.

fn parse(text str) List[List[int]]
    text.lines().map(|l| l.words().map(|w| w.to_int() else 0))

fn max_path(rows List[List[int]]) int
    if rows.is_empty()
        return 0
    mut best := rows[rows.len() - 1]
    for k in 1..rows.len()
        r := rows.len() - 1 - k
        best = [rows[r][i] + best[i].max(best[i + 1]) for i in 0..rows[r].len()]
    best[0]

fn main()
    pyramid := parse("""
        3
        7 4
        2 4 6
        8 5 9 3
        """)
    print("rows: {pyramid.len()}, best: {max_path(pyramid)}")
    big := parse("""
        75
        95 64
        17 47 82
        18 35 87 10
        20 04 82 47 65
        19 01 23 75 03 34
        """)
    print("rows: {big.len()}, best: {max_path(big)}")
    print(max_path([[42]]))

@test fn small()
    assert_eq(max_path([[1], [2, 3]]), 4)
