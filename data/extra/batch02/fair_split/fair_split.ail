## Fair split: divides a pile of item values between two people so the totals are as close
## as possible, using a set of reachable sums, and reports both totals and the gap.

fn sums(values List[int]) Set[int]
    mut reach := {0}
    for v in values
        mut next_reach := reach
        for s in reach
            next_reach.add(s + v)
        reach = next_reach
    reach

fn fair(values List[int]) (int, int)
    total := values.sum()
    reach := sums(values)
    mut best := 0
    for s in reach
        if s * 2 <= total and s > best
            best = s
    (best, total - best)

fn main()
    for pile in [[3, 1, 4, 2, 2], [10, 20, 15, 5, 25], [1, 2, 3, 9], [7], List[int](), [8, 8, 8, 8]]
        a, b := fair(pile)
        print("{pile.map(|v| "{v}").join(",")}: {a} vs {b}, gap {b - a}")

@test fn equal_split_possible()
    assert_eq(fair([1, 5, 11, 5]), (11, 11))
