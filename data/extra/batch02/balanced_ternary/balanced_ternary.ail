## Balanced ternary: writes integers with the digits -1, 0 and 1 (shown as `-`, `0`, `+`),
## converts back, and checks the round trip for a range including negatives.

fn to_bt(n int) str
    if n == 0
        return "0"
    mut digits := List[str]()
    mut v := n
    while v != 0
        r := ((v % 3) + 3) % 3
        if r == 2
            digits.push("-")
            v = (v + 1) / 3
        else
            digits.push(if r == 1 then "+" else "0")
            v = (v - r) / 3
    digits.reversed().join("")

fn from_bt(s str) int
    mut n := 0
    for c in s.chars()
        d := match c
            '+' => 1
            '-' => -1
            _ => 0
        n = n * 3 + d
    n

fn main()
    for n in [0, 1, 2, 3, 8, -8, 100, -42, 364]
        t := to_bt(n)
        print("{n:>4} = {t:>7} -> {from_bt(t)}")
    bad := [n for n in -200..=200 if from_bt(to_bt(n)) != n]
    print("round trip failures: {bad.len()}")

@test fn negation_flips_digits()
    assert_eq(to_bt(5), "+--")
    assert_eq(to_bt(-5), "-++")
