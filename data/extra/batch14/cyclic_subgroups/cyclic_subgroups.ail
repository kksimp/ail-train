## Cyclic subgroups: in the clock group Z12 every subgroup is generated by n/d for a divisor d, has
## order d and phi(d) generators; the cosets of one subgroup split the group evenly, as Lagrange says.

fn gcd(a int, b int) int
    if b == 0 then a else gcd(b, a % b)

fn generated(g int, n int) List[int]
    mut out := [0]
    mut x := g % n
    while x != 0
        out.push(x)
        x = (x + g) % n
    out.sorted()

fn main()
    n := 12
    for d in 1..=n
        if n % d == 0
            sub := generated(n / d, n)
            gens := [g for g in 0..n if generated(g, n) == sub]
            print("order {d:>2}: {sub} generated by {gens}")
    h := generated(4, n)
    print("cosets of {h}:")
    mut covered := Set[int]()
    for a in 0..n
        if not covered.contains(a)
            coset := h.map(|x| (x + a) % n).sorted()
            for c in coset
                covered.add(c)
            print("  {a} + H = {coset}")
    print("12 elements / 3 per coset = {n / h.len()} cosets")

@test fn order_of_eight()
    assert_eq(generated(8, 12).len(), 12 / gcd(8, 12))
