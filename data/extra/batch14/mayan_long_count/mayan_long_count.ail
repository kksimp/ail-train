## Maya calendar: days since the creation date (Julian Day 584283) written in the Long Count
## (baktun.katun.tun.uinal.kin, bases 20, 20, 18, 20), with the 260-day Tzolkin and the 365-day Haab.

fn jdn(y int, m int, d int) int
    a := (14 - m) / 12
    yy := y + 4800 - a
    mm := m + 12 * a - 3
    d + (153 * mm + 2) / 5 + 365 * yy + yy / 4 - yy / 100 + yy / 400 - 32045

fn main()
    tz := ["Imix", "Ik", "Akbal", "Kan", "Chicchan", "Cimi", "Manik", "Lamat", "Muluc", "Oc", "Chuen", "Eb", "Ben", "Ix", "Men", "Cib", "Caban", "Etznab", "Cauac", "Ahau"]
    haab := ["Pop", "Uo", "Zip", "Zotz", "Tzec", "Xul", "Yaxkin", "Mol", "Chen", "Yax", "Zac", "Ceh", "Mac", "Kankin", "Muan", "Pax", "Kayab", "Cumku", "Uayeb"]
    dates := [[2012, 12, 21], [2026, 11, 21], [1969, 7, 20], [2000, 1, 1], [1500, 6, 15]]
    for dt in dates
        days := jdn(dt[0], dt[1], dt[2]) - 584283
        lc := [days / 144000, days / 7200 % 20, days / 360 % 20, days / 20 % 18, days % 20]
        long := lc.map(|v| "{v}").join(".")
        tn := (days + 3) % 13 + 1
        tname := tz[(days + 19) % 20]
        h := (days + 348) % 365
        print("{dt[0]}-{dt[1]:02}-{dt[2]:02}: day {days}, long count {long}, {tn} {tname} {h % 20} {haab[h / 20]}")
    print("the Calendar Round (Tzolkin and Haab together) repeats every lcm(260, 365) = 18980 days")

@test fn creation()
    assert_eq(jdn(2012, 12, 21) - 584283, 13 * 144000)
