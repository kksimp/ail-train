## Group axioms: builds the operation table of a small set and tests closure, an identity, inverses,
## associativity over all triples and commutativity; only some of the sets and operations form groups.

fn op(kind int, a int, b int, m int) int
    match kind
        0 => (a + b) % m
        1 => (a * b) % m
        2 => (a - b + m) % m
        _ => a ^ b

fn check(name str, xs List[int], kind int, m int) str
    n := xs.len()
    mut t := List[List[int]]()
    for a in xs
        mut row := List[int]()
        for b in xs
            r := op(kind, a, b, m)
            idx := xs.index_of(r) else -1
            if idx < 0
                return "{name}: not closed ({a}, {b} gives {r})"
            row.push(idx)
        t.push(row)
    mut e := -1
    for i in 0..n
        if [u for u in 0..n if t[i][u] == u and t[u][i] == u].len() == n
            e = i
    if e < 0
        return "{name}: closed, no identity"
    mut inv := true
    for i in 0..n
        if [v for v in 0..n if t[i][v] == e and t[v][i] == e].is_empty()
            inv = false
    mut assoc := true
    for a in 0..n
        for b in 0..n
            for c in 0..n
                if t[t[a][b]][c] != t[a][t[b][c]]
                    assoc = false
    mut comm := true
    for a in 0..n
        for b in 0..n
            if t[a][b] != t[b][a]
                comm = false
    verdict := if inv and assoc then "a group" else "not a group"
    "{name}: identity {xs[e]}, inverses {inv}, associative {assoc}, commutative {comm}: {verdict}"

fn main()
    print(check("Z4 under +", [0, 1, 2, 3], 0, 4))
    print(check("1..4 times mod 5", [1, 2, 3, 4], 1, 5))
    print(check("1..5 times mod 6", [1, 2, 3, 4, 5], 1, 6))
    print(check("1,3,5,7 times mod 8", [1, 3, 5, 7], 1, 8))
    print(check("0..3 under xor", [0, 1, 2, 3], 3, 0))
    print(check("0..2 minus mod 3", [0, 1, 2], 2, 3))
    print(check("0..4 times mod 5", [0, 1, 2, 3, 4], 1, 5))

@test fn xor_self()
    assert_eq(op(3, 2, 2, 0), 0)
