## Replicator dynamics: in hawk-dove (prize 4, fight cost 6) the hawk share x grows by
## dt x (1 - x)(hawk payoff - dove payoff); from any mix it settles at prize / cost = 2/3, the stable mix.

fn payoffs(x float) List[float]
    hawk := x * (4.0 - 6.0) / 2.0 + (1.0 - x) * 4.0
    dove := x * 0.0 + (1.0 - x) * 2.0
    [hawk, dove]

fn main()
    for start in [0.05, 0.5, 0.95]
        mut x := start
        mut trail := List[str]()
        for step in 0..=200
            if step % 40 == 0
                trail.push("{x:.4}")
            p := payoffs(x)
            x = x + 0.1 * x * (1.0 - x) * (p[0] - p[1])
        joined := trail.join(" -> ")
        print("start {start}: {joined}")
    p := payoffs(2.0 / 3.0)
    print("at 2/3 hawks: hawk earns {p[0]:.4}, dove earns {p[1]:.4}, so nobody gains by switching")

@test fn all_doves()
    assert_eq(payoffs(0.0)[1], 2.0)
