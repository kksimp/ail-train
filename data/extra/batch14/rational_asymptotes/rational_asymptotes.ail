## Rational function asymptotes: integer roots of the denominator are vertical asymptotes unless the
## numerator vanishes too (a hole); comparing degrees gives y = 0, the ratio of leading terms, or a slant line.

fn eval(p List[int], x int) int
    mut t := 0
    for c in p
        t = t * x + c
    t

fn gcd(a int, b int) int
    if b == 0 then a.abs() else gcd(b, a % b)

fn ratio(a int, b int) str
    g := gcd(a, b)
    s := if b < 0 then -1 else 1
    n := s * a / g
    d := s * b / g
    if d == 1 then "y = {n}" else "y = {n}/{d}"

fn line(a int, b int) str
    head := if a == 1 then "x" elif a == -1 then "-x" else "{a}x"
    tail := if b > 0 then " + {b}" elif b < 0 then " - {-b}" else ""
    "y = {head}{tail}"

fn main()
    cases := [("(2x^2 + 1) / (x^2 - 4)", [2, 0, 1], [1, 0, -4]), ("(x^2 - 1) / (x^2 + 2x - 3)", [1, 0, -1], [1, 2, -3]), ("(x^3 + 2x) / (x^2 - 1)", [1, 0, 2, 0], [1, 0, -1]), ("(3x + 6) / (x^2 + 1)", [3, 6], [1, 0, 1]), ("(x^2 + x - 6) / (x - 2)", [1, 1, -6], [1, -2]), ("x^4 / (x - 1)", [1, 0, 0, 0, 0], [1, -1])]
    for t in cases
        name, num, den := t
        mut vert := List[int]()
        mut holes := List[int]()
        for x in -10..=10
            if eval(den, x) == 0
                if eval(num, x) == 0
                    holes.push(x)
                else
                    vert.push(x)
        dn := num.len() - 1
        dd := den.len() - 1
        mut asym := "no line: it grows faster than any line"
        if dn < dd
            asym = "y = 0"
        elif dn == dd
            asym = ratio(num[0], den[0])
        elif dn == dd + 1
            asym = line(num[0], num[1] - num[0] * den[1])
        print("{name}")
        print("    vertical at {vert}, holes at {holes}, far away {asym}")

@test fn half()
    assert_eq(ratio(3, 6), "y = 1/2")
