## Discrete Fourier transform: X_k = sum of x_t e^(-2 pi i k t / N) for 8 samples of a weekly-ish cycle;
## the magnitudes show which frequencies are present and the inverse transform gives the samples back.

fn tidy(v float) float
    if v.abs() < 0.0005 then 0.0 else v

fn main()
    x := [4.0, 8.0, 6.0, 2.0, 4.0, 8.0, 6.0, 2.0]
    n := x.len()
    two_pi := 2.0 * 3.141592653589793
    mut re := List[float]()
    mut im := List[float]()
    for k in 0..n
        mut a := 0.0
        mut b := 0.0
        for t in 0..n
            ang := two_pi * (k * t).to_float() / n.to_float()
            a += x[t] * ang.cos()
            b -= x[t] * ang.sin()
        re.push(a)
        im.push(b)
        mag := (a * a + b * b).sqrt()
        print("bin {k}: magnitude {tidy(mag):.3}")
    mut back := List[str]()
    for t in 0..n
        mut s := 0.0
        for k in 0..n
            ang := two_pi * (k * t).to_float() / n.to_float()
            s += re[k] * ang.cos() - im[k] * ang.sin()
        v := tidy(s / n.to_float())
        back.push("{v:.3}")
    joined := back.join(", ")
    print("inverse: {joined}")
    print("only bins 0, 2 and 6 are lit: the pattern repeats every 4 samples")

@test fn constant_signal()
    assert_eq(tidy(0.0001), 0.0)
