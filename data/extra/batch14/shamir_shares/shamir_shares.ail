## Shamir secret sharing: the secret is f(0) of a random degree-2 polynomial mod the prime 7919, each
## holder gets a point, and any 3 points rebuild f(0) by Lagrange interpolation; 2 points give garbage.

fn pow_mod(base int, e int, m int) int
    mut result := 1
    mut b := base % m
    mut k := e
    while k > 0
        if k % 2 == 1
            result = result * b % m
        b = b * b % m
        k /= 2
    result

fn recover(xs List[int], ys List[int], p int) int
    mut total := 0
    for i in 0..xs.len()
        mut num := 1
        mut den := 1
        for j in 0..xs.len()
            if j != i
                num = num * (p - xs[j]) % p
                den = den * ((xs[i] - xs[j] + p) % p) % p
        term := ys[i] * num % p * pow_mod(den, p - 2, p) % p
        total = (total + term) % p
    total

fn main()
    p := 7919
    coef := [1234, 166, 94]
    mut shares := List[int]()
    for x in 1..=5
        y := (coef[0] + coef[1] * x + coef[2] * x * x) % p
        shares.push(y)
        print("holder {x} gets ({x}, {y})")
    for pick in [[1, 2, 3], [2, 4, 5], [1, 3, 5]]
        ys := pick.map(|x| shares[x - 1])
        print("holders {pick} rebuild {recover(pick, ys, p)}")
    two := [1, 2]
    print("holders {two} alone get {recover(two, [shares[0], shares[1]], p)}")

@test fn line_through()
    assert_eq(recover([1, 2], [3, 5], 7919), 1)
