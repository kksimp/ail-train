(x^3 - 6x^2 + 11x - 6) / (x - 1)
    quotient x^2 - 5x + 6, remainder 0, check true
(2x^4 + 3x^3 - x + 5) / (x^2 + x - 1)
    quotient 2x^2 + x + 1, remainder -x + 6, check true
(x^5 - 1) / (x - 1)
    quotient x^4 + x^3 + x^2 + x + 1, remainder 0, check true
(3x^3 - 2x + 7) / (x^2 + 4)
    quotient 3x, remainder -14x + 7, check true
