## Perfect power detection: writes each number as b^e with the largest exponent.
fn describe(n int) str
    mut b := 2
    while b * b <= n
        mut p := b * b
        mut e := 2
        while p < n
            p *= b
            e += 1
        if p == n
            return "{n} = {b}^{e}"
        b += 1
    "{n} is not a perfect power"

fn main()
    while line := io.read_line()
        t := line.trim()
        n := t.to_int() else 0
        if t.is_empty()
            continue
        if n < 2 or n > 1000000000000 or t.starts_with("-")
            print("{t}: invalid")
        else
            print(describe(n))
